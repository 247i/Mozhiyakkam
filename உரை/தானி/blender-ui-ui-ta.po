#. :src: bpy.types.ShaderNodeOutputWorld.is_active_output
msgid "True if this node is used as the active output"
msgstr "இந்த முனை செயலில் வெளியீடாகப் பயன்படுத்தப்பட்டால் உண்மை"

#. :src: bpy.types.ShaderNodeOutputLight.target
#. :src: bpy.types.ShaderNodeOutputLineStyle.target
#. :src: bpy.types.ShaderNodeOutputMaterial.target
#. :src: bpy.types.ShaderNodeOutputWorld.target
msgid "Which renderer and viewport shading types to use the shaders for"
msgstr "சேடர்களைப் பயன்படுத்த எந்த ரெண்டரர் மற்றும் வியூபோர்ட் நிழல் வகைகள்"

#. :src: bpy.types.ShaderNodeOutputLight.target:'ALL'
#. :src: bpy.types.ShaderNodeOutputLineStyle.target:'ALL'
#. :src: bpy.types.ShaderNodeOutputMaterial.target:'ALL'
#. :src: bpy.types.ShaderNodeOutputWorld.target:'ALL'
msgid ""
"Use shaders for all renderers and viewports, unless there exists a more "
"specific output"
msgstr ""
"ஒரு குறிப்பிட்ட வெளியீடு இல்லாவிட்டால், அனைத்து ரெண்டரர்கள் மற்றும் "
"காட்சியகங்களுக்கும் சேடர்களைப் பயன்படுத்தவும்"

#. :src: bpy.types.ShaderNodeOutputLight.target:'EEVEE'
#. :src: bpy.types.ShaderNodeOutputLineStyle.target:'EEVEE'
#. :src: bpy.types.ShaderNodeOutputMaterial.target:'EEVEE'
#. :src: bpy.types.ShaderNodeOutputWorld.target:'EEVEE'
msgid "Use shaders for EEVEE renderer"
msgstr "ஈவி ரெண்டரருக்கு சேடர்களைப் பயன்படுத்தவும்"

#. :src: bpy.types.ShaderNodeOutputLight.target:'CYCLES'
#. :src: bpy.types.ShaderNodeOutputLineStyle.target:'CYCLES'
#. :src: bpy.types.ShaderNodeOutputMaterial.target:'CYCLES'
#. :src: bpy.types.ShaderNodeOutputWorld.target:'CYCLES'
#. :src: bpy.types.CYCLES
msgid "Cycles"
msgstr "சுழற்சிகள்"

#. :src: bpy.types.ShaderNodeOutputLight.target:'CYCLES'
#. :src: bpy.types.ShaderNodeOutputLineStyle.target:'CYCLES'
#. :src: bpy.types.ShaderNodeOutputMaterial.target:'CYCLES'
#. :src: bpy.types.ShaderNodeOutputWorld.target:'CYCLES'
msgid "Use shaders for Cycles renderer"
msgstr "சுழற்சிகள் ரெண்டரருக்கு சேடர்களைப் பயன்படுத்துங்கள்"

#. :src: bpy.types.ShaderNodeOutputLineStyle
msgid "Line Style Output"
msgstr "வரி நடை வெளியீடு"

#. :src: bpy.types.ShaderNodeOutputMaterial
msgid "Material Output"
msgstr "மூலப்பொருள் வெளியீடு"

#. :src: bpy.types.ShaderNodeOutputMaterial
msgid "Output surface material information for use in rendering"
msgstr "ரெண்டரிங்கில் பயன்படுத்த மேற்பரப்பு மூலப்பொருள் செய்தி"

#. :src: bpy.types.ShaderNodeOutputWorld
msgid "World Output"
msgstr "உலக வெளியீடு"

#. :src: bpy.types.ShaderNodeOutputWorld
msgid "Output light color information to the scene's World"
msgstr "காட்சியின் உலகிற்கு ஒளி வண்ண தகவல்களை வெளியீடு செய்யுங்கள்"

#. :src: bpy.types.ShaderNodeParticleInfo
msgid "Particle Info"
msgstr "துகள் செய்தி"

#. :src: bpy.types.ShaderNodeParticleInfo
msgid ""
"Retrieve the data of the particle that spawned the object instance, for "
"example to give variation to multiple instances of an object"
msgstr ""
"பொருள் உதாரணத்தை உருவாக்கிய துகள் தரவை மீட்டெடுக்கவும், எடுத்துக்காட்டாக ஒரு"
" பொருளின் பல நிகழ்வுகளுக்கு மாறுபாட்டைக் கொடுக்க"

#. :src: bpy.types.ShaderNodePointInfo
msgid "Point Info"
msgstr "புள்ளி செய்தி"

#. :src: bpy.types.ShaderNodePointInfo
msgid "Retrieve information about points in a point cloud"
msgstr "புள்ளிகள் பற்றிய தகவல்களை ஒரு புள்ளி மேகக்கட்டத்தில் மீட்டெடுக்கவும்"

#. :src: bpy.types.ShaderNodeRGBCurve
msgid "Apply color corrections for each color channel"
msgstr "ஒவ்வொரு வண்ண சேனலுக்கும் வண்ண திருத்தங்களைப் பயன்படுத்துங்கள்"

#. :src: bpy.types.ShaderNodeRGBToBW
msgid "Convert a color's luminance to a grayscale value"
msgstr "ஒரு வண்ணத்தின் ஒளியை கிரேச்கேல் மதிப்புக்கு மாற்றவும்"

#. :src: bpy.types.ShaderNodeScript
msgid ""
"Generate an OSL shader from a file or text data-block.\n"
"Note: OSL shaders are not supported on all GPU backends"
msgstr ""
"ஒரு கோப்பு அல்லது உரை தரவு-தடுப்பிலிருந்து osl சேடரை உருவாக்கவும். \n"
" குறிப்பு: அனைத்து சிபியு பின்தளத்தில் osl சேடர்கள் ஆதரிக்கப்படவில்லை"

#. :src: bpy.types.ShaderNodeScript.bytecode
msgid "Bytecode"
msgstr "பைட்கோட்"

#. :src: bpy.types.ShaderNodeScript.bytecode
msgid "Compile bytecode for shader script node"
msgstr "சேடர் கைஉரை முனைக்கு பைட்கோடை தொகுக்கவும்"

#. :src: bpy.types.ShaderNodeScript.bytecode_hash
msgid "Bytecode Hash"
msgstr "பைட்கோட் ஆச்"

#. :src: bpy.types.ShaderNodeScript.bytecode_hash
msgid "Hash of compile bytecode, for quick equality checking"
msgstr "விரைவான சமத்துவ சோதனைக்கு, தொகுக்கும் பைட்கோடின் ஆச்"

#. :src: bpy.types.ShaderNodeScript.filepath
msgid "Shader script path"
msgstr "சேடர் கைஉரை பாதை"

#. :src: bpy.types.ShaderNodeScript.mode
msgid "Script Source"
msgstr "கைஉரை மூல"

#. :src: bpy.types.ShaderNodeScript.mode:'EXTERNAL'
msgid "Use external .osl or .oso file"
msgstr "வெளிப்புற .osl அல்லது .oso கோப்பைப் பயன்படுத்தவும்"

#. :src: bpy.types.ShaderNodeScript.script
msgid "Internal shader script to define the shader"
msgstr "சேடரை வரையறுக்க உள் சேடர் கைஉரை"

#. :src: bpy.types.ShaderNodeScript.use_auto_update
msgid "Auto Update"
msgstr "ஆட்டோ புதுப்பிப்பு"

#. :src: bpy.types.ShaderNodeScript.use_auto_update
msgid ""
"Automatically update the shader when the .osl file changes (external scripts"
" only)"
msgstr ""
".osl கோப்பு மாறும்போது தானாகவே சேடரை புதுப்பிக்கவும் (வெளிப்புற கைஉரைகள் "
"மட்டும்)"

#. :src: bpy.types.ShaderNodeSeparateColor
msgid "Split a color into its individual components using multiple models"
msgstr ""
"பல மாதிரிகளைப் பயன்படுத்தி ஒரு வண்ணத்தை அதன் தனிப்பட்ட கூறுகளாக பிரிக்கவும்"

#. :src: bpy.types.ShaderNodeSeparateXYZ
msgid "Separate XYZ"
msgstr "தனி xyz"

#. :src: bpy.types.ShaderNodeSeparateXYZ
msgid "Split a vector into its X, Y, and Z components"
msgstr "ஒரு திசையனை அதன் ஃச், ஒய் மற்றும் சட் கூறுகளாக பிரிக்கவும்"

#. :src: bpy.types.ShaderNodeShaderToRGB
msgid "Shader to RGB"
msgstr "சேடர் டு ஆர்சிபி"

#. :src: bpy.types.ShaderNodeShaderToRGB
msgid ""
"Convert rendering effect (such as light and shadow) to color. Typically used for non-photorealistic rendering, to apply additional effects on the output of BSDFs.\n"
"Note: only supported in EEVEE"
msgstr ""
"வழங்குதல் விளைவை (ஒளி மற்றும் நிழல் போன்றவை) வண்ணமாக மாற்றவும். பொதுவாக பி.எச்.டி.எஃப்.எச் இன் வெளியீட்டில் கூடுதல் விளைவுகளைப் பயன்படுத்த, ஃபோட்டோரிச்டிக் ரெண்டரிங்கிற்கு பொதுவாகப் பயன்படுத்தப்படுகிறது. \n"
" குறிப்பு: ஈவியில் மட்டுமே ஆதரிக்கப்படுகிறது"

#. :src: bpy.types.ShaderNodeSqueeze
msgid "Squeeze Value (Legacy)"
msgstr "கசக்கி மதிப்பு (மரபு)"

#. :src: bpy.types.ShaderNodeSubsurfaceScattering
msgid "Subsurface Scattering"
msgstr "மேற்பரப்பு சிதறல்"

#. :src: bpy.types.ShaderNodeSubsurfaceScattering
msgid ""
"Subsurface multiple scattering shader to simulate light entering the surface and bouncing internally.\n"
"Typically used for materials such as skin, wax, marble or milk"
msgstr ""
"மேற்பரப்பில் நுழையும் ஒளியை உருவகப்படுத்தவும், உள்நாட்டில் துள்ளவும் பல சிதறல் சேடர் மேற்பரப்பு. \n"
" பொதுவாக தோல், மெழுகு, பளிங்கு அல்லது பால் போன்ற மூலப்பொருட்களுக்கு பயன்படுத்தப்படுகிறது"

#. :src: bpy.types.ShaderNodeTangent
msgid "Generate a tangent direction for the Anisotropic BSDF"
msgstr ""
"அனிசோட்ரோபிக் பி.எச்.டி.எஃப் -க்கு ஒரு தொடர்ச்சியான திசையை உருவாக்கவும்"

#. :src: bpy.types.ShaderNodeTangent.axis
msgid "Axis for radial tangents"
msgstr "ரேடியல் தொடுகோடுகளுக்கான அச்சு"

#. :src: bpy.types.ShaderNodeTangent.axis:'X'
#. :src: bpy.types.UV_OT_align_rotation.axis:'X'
msgid "X axis"
msgstr "ஃச் அச்சு"

#. :src: bpy.types.ShaderNodeTangent.axis:'Y'
#. :src: bpy.types.UV_OT_align_rotation.axis:'Y'
msgid "Y axis"
msgstr "ஒய் அச்சு"

#. :src: bpy.types.ShaderNodeTangent.axis:'Z'
#. :src: bpy.types.UV_OT_align_rotation.axis:'Z'
msgid "Z axis"
msgstr "சட் அச்சு"

#. :src: bpy.types.ShaderNodeTangent.direction_type
msgid "Method to use for the tangent"
msgstr "தொடுகோடு பயன்படுத்த வேண்டிய முறை"

#. :src: bpy.types.ShaderNodeTangent.direction_type:'RADIAL'
msgid "Radial tangent around the X, Y or Z axis"
msgstr "ஃச், ஒய் அல்லது சட் அச்சைச் சுற்றி ரேடியல் தொடுகோடு"

#. :src: bpy.types.ShaderNodeTangent.direction_type:'UV_MAP'
msgid "Tangent from UV map"
msgstr "புறஊதா வரைபடத்திலிருந்து தொடுகோடு"

#. :src: bpy.types.ShaderNodeTangent.uv_map
msgid "UV Map for tangent generated from UV"
msgstr "புறஊதா இலிருந்து உருவாக்கப்பட்ட தொடுகோடு புறஊதா வரைபடம்"

#. :src: bpy.types.ShaderNodeTexBrick
msgid "Brick Texture"
msgstr "செங்கல் அமைப்பு"

#. :src: bpy.types.ShaderNodeTexBrick
msgid "Generate a procedural texture producing bricks"
msgstr "செங்கற்களை உருவாக்கும் ஒரு நடைமுறை அமைப்பை உருவாக்குங்கள்"

#. :src: bpy.types.ShaderNodeTexBrick.offset
#. :src: bpy.types.TextureNodeBricks.offset
msgid "Offset Amount"
msgstr "ஆஃப்செட் தொகை"

#. :src: bpy.types.ShaderNodeTexBrick.offset
#. :src: bpy.types.TextureNodeBricks.offset
msgid "Determines the brick offset of the various rows"
msgstr "பல்வேறு வரிசைகளின் செங்கல் ஆஃப்செட்டை தீர்மானிக்கிறது"

#. :src: bpy.types.ShaderNodeTexBrick.offset_frequency
#. :src: bpy.types.TextureNodeBricks.offset_frequency
msgid "Offset Frequency"
msgstr "ஆஃப்செட் அதிர்வெண்"

#. :src: bpy.types.ShaderNodeTexBrick.offset_frequency
msgid ""
"How often rows are offset. A value of 2 gives an even/uneven pattern of "
"rows."
msgstr ""
"வரிசைகள் எத்தனை முறை ஈடுசெய்யப்படுகின்றன. 2 இன் மதிப்பு வரிசைகளின் சம/சீரற்ற"
" வடிவத்தை அளிக்கிறது."

#. :src: bpy.types.ShaderNodeTexBrick.squash
#. :src: bpy.types.TextureNodeBricks.squash
msgid "Squash Amount"
msgstr "ச்குவாச் தொகை"

#. :src: bpy.types.ShaderNodeTexBrick.squash
#. :src: bpy.types.TextureNodeBricks.squash
msgid ""
"Factor to adjust the brick's width for particular rows determined by the "
"Offset Frequency"
msgstr ""
"ஆஃப்செட் அதிர்வெண்ணால் தீர்மானிக்கப்படும் குறிப்பிட்ட வரிசைகளுக்கு செங்கலின்"
" அகலத்தை சரிசெய்ய காரணி"

#. :src: bpy.types.ShaderNodeTexBrick.squash_frequency
#. :src: bpy.types.TextureNodeBricks.squash_frequency
msgid "Squash Frequency"
msgstr "ச்குவாச் அதிர்வெண்"

#. :src: bpy.types.ShaderNodeTexBrick.squash_frequency
msgid "How often rows consist of \"squished\" bricks"
msgstr "வரிசைகள் எத்தனை முறை \"ச்குவிச்\" செங்கற்களைக் கொண்டிருக்கின்றன"

#. :src: bpy.types.ShaderNodeTexBrick.texture_mapping
#. :src: bpy.types.ShaderNodeTexChecker.texture_mapping
#. :src: bpy.types.ShaderNodeTexEnvironment.texture_mapping
#. :src: bpy.types.ShaderNodeTexGabor.texture_mapping
#. :src: bpy.types.ShaderNodeTexGradient.texture_mapping
#. :src: bpy.types.ShaderNodeTexImage.texture_mapping
#. :src: bpy.types.ShaderNodeTexMagic.texture_mapping
#. :src: bpy.types.ShaderNodeTexNoise.texture_mapping
#. :src: bpy.types.ShaderNodeTexSky.texture_mapping
#. :src: bpy.types.ShaderNodeTexVoronoi.texture_mapping
#. :src: bpy.types.ShaderNodeTexWave.texture_mapping
#. :src: bpy.types.TexMapping
msgid "Texture coordinate mapping settings"
msgstr "அமைப்பு ஒருங்கிணைப்பு மேப்பிங் அமைப்புகள்"

#. :src: bpy.types.ShaderNodeTexChecker
msgid "Checker Texture"
msgstr "செக்கர் அமைப்பு"

#. :src: bpy.types.ShaderNodeTexChecker
msgid "Generate a checkerboard texture"
msgstr "செக்கர்போர்டு அமைப்பை உருவாக்கவும்"

#. :src: bpy.types.ShaderNodeTexCoord
msgid "Texture Coordinate"
msgstr "அமைப்பு ஒருங்கிணைப்பு"

#. :src: bpy.types.ShaderNodeTexCoord
msgid ""
"Retrieve multiple types of texture coordinates.\n"
"Typically used as inputs for texture nodes"
msgstr ""
"பல வகையான அமைப்பு ஒருங்கிணைப்புகளை மீட்டெடுக்கவும். \n"
" அமைப்பு முனைகளுக்கான உள்ளீடுகளாக பொதுவாகப் பயன்படுத்தப்படுகிறது"

#. :src: bpy.types.ShaderNodeTexCoord.from_instancer
#. :src: bpy.types.ShaderNodeUVMap.from_instancer
msgid "From Instancer"
msgstr "இன்ச்டான்சரிடமிருந்து"

#. :src: bpy.types.ShaderNodeTexCoord.from_instancer
#. :src: bpy.types.ShaderNodeUVMap.from_instancer
msgid "Use the parent of the instance object if possible"
msgstr "முடிந்தால் நிகழ்வு பொருளின் பெற்றோரைப் பயன்படுத்தவும்"

#. :src: bpy.types.ShaderNodeTexCoord.object
msgid ""
"Use coordinates from this object (for object texture coordinates output)"
msgstr ""
"இந்த பொருளிலிருந்து ஆயத்தொலைவுகளைப் பயன்படுத்தவும் (பொருள் அமைப்பு "
"வெளியீட்டை ஒருங்கிணைக்கிறது)"

#. :src: bpy.types.ShaderNodeTexEnvironment
msgid "Environment Texture"
msgstr "சுற்றுச்சூழல் அமைப்பு"

#. :src: bpy.types.ShaderNodeTexEnvironment
msgid ""
"Sample an image file as an environment texture. Typically used to light the "
"scene with the background node"
msgstr ""
"ஒரு படக் கோப்பை சுற்றுச்சூழல் அமைப்பாக மாதிரி. பொதுவாக பின்னணி முனையுடன் "
"காட்சியை ஒளிரச் செய்ய பயன்படுகிறது"

#. :src: bpy.types.ShaderNodeTexEnvironment.interpolation
#. :src: bpy.types.ShaderNodeTexImage.interpolation
#. :src: bpy.types.IMAGE_OT_convert_to_mesh_plane.interpolation
#. :src: bpy.types.IMAGE_OT_import_as_mesh_planes.interpolation
msgid "Texture interpolation"
msgstr "அமைப்பு இடைக்கணிப்பு"

#. :src: bpy.types.ShaderNodeTexEnvironment.interpolation:'Smart'
#. :src: bpy.types.ShaderNodeTexImage.interpolation:'Smart'
msgid "Smart"
msgstr "அறிவாளி"

#. :src: bpy.types.ShaderNodeTexEnvironment.interpolation:'Smart'
#. :src: bpy.types.ShaderNodeTexImage.interpolation:'Smart'
#. :src: bpy.types.IMAGE_OT_convert_to_mesh_plane.interpolation:'Smart'
#. :src: bpy.types.IMAGE_OT_import_as_mesh_planes.interpolation:'Smart'
msgid "Bicubic when magnifying, else bilinear (OSL only)"
msgstr "பெரிதாக்கும்போது பிக்யூபிக், வேறு பிலினியர் (ஓஎச்எல் மட்டும்)"

#. :src: bpy.types.ShaderNodeTexEnvironment.projection
#: scripts/startup/bl_ui/properties_texture.py:751
#: source/blender/editors/space_node/drawnode.cc:401
#: source/blender/nodes/geometry/nodes/node_geo_viewport_transform.cc:10
msgid "Projection"
msgstr "திட்டம்"

#. :src: bpy.types.ShaderNodeTexEnvironment.projection
msgid "Projection of the input image"
msgstr "உள்ளீட்டு படத்தின் திட்டம்"

#. :src: bpy.types.ShaderNodeTexEnvironment.projection:'EQUIRECTANGULAR'
msgid "Equirectangular or latitude-longitude projection"
msgstr "சமநிலை அல்லது அட்சரேகை-நீண்ட திட்டம்"

#. :src: bpy.types.ShaderNodeTexEnvironment.projection:'MIRROR_BALL'
msgid "Projection from an orthographic photo of a mirror ball"
msgstr "ஒரு கண்ணாடி பந்தின் ஆர்த்தோகிராஃபிக் புகைப்படத்திலிருந்து திட்டம்"

#. :src: bpy.types.ShaderNodeTexGabor
msgid "Gabor Texture"
msgstr "காபோர் அமைப்பு"

#. :src: bpy.types.ShaderNodeTexGabor
msgid "Generate Gabor noise"
msgstr "கபோர் சத்தத்தை உருவாக்குங்கள்"

#. :src: bpy.types.ShaderNodeTexGabor.gabor_type
msgid "The type of Gabor noise to evaluate"
msgstr "மதிப்பீடு செய்ய கபோர் சத்தத்தின் வகை"

#. :src: bpy.types.ShaderNodeTexGabor.gabor_type:'2D'
#. :src: bpy.types.ShaderNodeTexNoise.noise_dimensions:'2D'
#. :src: bpy.types.ShaderNodeTexVoronoi.voronoi_dimensions:'2D'
#. :src: bpy.types.ShaderNodeTexWhiteNoise.noise_dimensions:'2D'
msgid "Use the 2D vector (X, Y) as input. The Z component is ignored."
msgstr ""
"2 டி திசையன் (x, y) உள்ளீடாகப் பயன்படுத்தவும். சட் கூறு "
"புறக்கணிக்கப்படுகிறது."

#. :src: bpy.types.ShaderNodeTexGabor.gabor_type:'3D'
#. :src: bpy.types.ShaderNodeTexNoise.noise_dimensions:'3D'
#. :src: bpy.types.ShaderNodeTexVoronoi.voronoi_dimensions:'3D'
#. :src: bpy.types.ShaderNodeTexWhiteNoise.noise_dimensions:'3D'
msgid "Use the 3D vector (X, Y, Z) as input"
msgstr "3d திசையனை (x, ஒய், z) உள்ளீடாகப் பயன்படுத்தவும்"

#. :src: bpy.types.ShaderNodeTexGradient
msgid "Gradient Texture"
msgstr "சாய்வு அமைப்பு"

#. :src: bpy.types.ShaderNodeTexGradient
msgid ""
"Generate interpolated color and intensity values based on the input vector"
msgstr ""
"உள்ளீட்டு திசையனின் அடிப்படையில் இடைக்கணிப்பு வண்ணம் மற்றும் தீவிரம் "
"மதிப்புகளை உருவாக்குங்கள்"

#. :src: bpy.types.ShaderNodeTexIES
msgid "IES Texture"
msgstr "அதாவது அமைப்பு"

#. :src: bpy.types.ShaderNodeTexIES
msgid ""
"Match real world lights with IES files, which store the directional "
"intensity distribution of light sources"
msgstr ""
"உண்மையான உலக விளக்குகளை IES கோப்புகளுடன் பொருத்துங்கள், இது ஒளி மூலங்களின் "
"திசை தீவிரம் விநியோகத்தை சேமிக்கிறது"

#. :src: bpy.types.ShaderNodeTexIES.filepath
msgid "IES light path"
msgstr "அதாவது ஒளி பாதை"

#. :src: bpy.types.ShaderNodeTexIES.ies
msgid "IES Text"
msgstr "அதாவது உரை"

#. :src: bpy.types.ShaderNodeTexIES.ies
msgid "Internal IES file"
msgstr "உள் ies கோப்பு"

#. :src: bpy.types.ShaderNodeTexIES.mode
msgid "Whether the IES file is loaded from disk or from a text data-block"
msgstr "ies கோப்பு வட்டில் இருந்து ஏற்றப்பட்டதா அல்லது உரை தரவு-தடுப்பு"

#. :src: bpy.types.ShaderNodeTexIES.mode:'EXTERNAL'
msgid "Use external .ies file"
msgstr "வெளிப்புற .ies கோப்பைப் பயன்படுத்தவும்"

#. :src: bpy.types.ShaderNodeTexImage
msgid "Sample an image file as a texture"
msgstr "படக் கோப்பை ஒரு அமைப்பாக மாதிரி செய்யுங்கள்"

#. :src: bpy.types.ShaderNodeTexImage.projection
msgctxt "Image"
msgid "Projection"
msgstr "திட்டம்"

#. :src: bpy.types.ShaderNodeTexImage.projection
msgid "Method to project 2D image on object with a 3D texture vector"
msgstr "3d அமைப்பு திசையன் மூலம் பொருளில் 2d படத்தை திட்டமிடுவதற்கான முறை"

#. :src: bpy.types.ShaderNodeTexImage.projection:'FLAT'
#. :src: bpy.types.TexMapping.mapping:'FLAT'
#. :src: bpy.types.LineStyleTextureSlot.mapping:'FLAT'
#. :src: bpy.types.ParticleSettingsTextureSlot.mapping:'FLAT'
msgctxt "Image"
msgid "Flat"
msgstr "தட்டையானது"

#. :src: bpy.types.ShaderNodeTexImage.projection:'FLAT'
msgid ""
"Image is projected flat using the X and Y coordinates of the texture vector"
msgstr ""
"அமைப்பு திசையனின் ஃச் மற்றும் ஒய் ஆயத்தொகுதிகளைப் பயன்படுத்தி படம் "
"தட்டையானது என்று திட்டமிடப்பட்டுள்ளது"

#. :src: bpy.types.ShaderNodeTexImage.projection:'BOX'
msgctxt "Image"
msgid "Box"
msgstr "பெட்டி"

#. :src: bpy.types.ShaderNodeTexImage.projection:'BOX'
msgid ""
"Image is projected using different components for each side of the object "
"space bounding box"
msgstr ""
"பொருள் விண்வெளி எல்லை பெட்டியின் ஒவ்வொரு பக்கத்திற்கும் வெவ்வேறு கூறுகளைப் "
"பயன்படுத்தி படம் திட்டமிடப்பட்டுள்ளது"

#. :src: bpy.types.ShaderNodeTexImage.projection:'SPHERE'
#. :src: bpy.types.TexMapping.mapping:'SPHERE'
#. :src: bpy.types.LineStyleTextureSlot.mapping:'SPHERE'
#. :src: bpy.types.ParticleSettingsTextureSlot.mapping:'SPHERE'
msgctxt "Image"
msgid "Sphere"
msgstr "கோளம்"

#. :src: bpy.types.ShaderNodeTexImage.projection:'SPHERE'
msgid "Image is projected spherically using the Z axis as central"
msgstr "சட் அச்சை மையமாகப் பயன்படுத்தி படம் கோள ரீதியாக திட்டமிடப்பட்டுள்ளது"

#. :src: bpy.types.ShaderNodeTexImage.projection:'TUBE'
#. :src: bpy.types.TexMapping.mapping:'TUBE'
#. :src: bpy.types.LineStyleTextureSlot.mapping:'TUBE'
#. :src: bpy.types.ParticleSettingsTextureSlot.mapping:'TUBE'
msgctxt "Image"
msgid "Tube"
msgstr "குழாய்"

#. :src: bpy.types.ShaderNodeTexImage.projection:'TUBE'
msgid "Image is projected from the tube using the Z axis as central"
msgstr ""
"சட் அச்சை மையமாகப் பயன்படுத்தி குழாயிலிருந்து படம் திட்டமிடப்பட்டுள்ளது"

#. :src: bpy.types.ShaderNodeTexImage.projection_blend
msgid "Projection Blend"
msgstr "ப்ரொசெக்சன் கலவை"

#. :src: bpy.types.ShaderNodeTexImage.projection_blend
msgid "For box projection, amount of blend to use between sides"
msgstr "பெட்டி திட்டத்திற்கு, பக்கங்களுக்கு இடையில் பயன்படுத்த கலவையின் அளவு"

#. :src: bpy.types.ShaderNodeTexMagic
msgid "Generate a psychedelic color texture"
msgstr "ஒரு சைகடெலிக் வண்ண அமைப்பை உருவாக்குங்கள்"

#. :src: bpy.types.ShaderNodeTexMagic.turbulence_depth
msgid "Level of detail in the added turbulent noise"
msgstr "கூடுதல் கொந்தளிப்பான சத்தத்தில் விவரம் நிலை"

#. :src: bpy.types.ShaderNodeTexNoise
msgid "Generate fractal Perlin noise"
msgstr "ஃப்ராக்டல் பெர்லின் சத்தத்தை உருவாக்குங்கள்"

#. :src: bpy.types.ShaderNodeTexNoise.noise_dimensions
#. :src: bpy.types.ShaderNodeTexVoronoi.voronoi_dimensions
#. :src: bpy.types.ShaderNodeTexWhiteNoise.noise_dimensions
#: source/blender/editors/space_node/drawnode.cc:1408
msgctxt "Texture"
msgid "Dimensions"
msgstr "பரிமாணங்கள்"

#. :src: bpy.types.ShaderNodeTexNoise.noise_dimensions
#. :src: bpy.types.ShaderNodeTexVoronoi.voronoi_dimensions
#. :src: bpy.types.ShaderNodeTexWhiteNoise.noise_dimensions
msgid "Number of dimensions to output noise for"
msgstr "வெளியீட்டு சத்தத்திற்கு பரிமாணங்களின் எண்ணிக்கை"

#. :src: bpy.types.ShaderNodeTexNoise.noise_dimensions:'1D'
#. :src: bpy.types.ShaderNodeTexVoronoi.voronoi_dimensions:'1D'
#. :src: bpy.types.ShaderNodeTexWhiteNoise.noise_dimensions:'1D'
msgid "Use the scalar value W as input"
msgstr "அளவிடுதல் மதிப்பு w உள்ளீடாக பயன்படுத்தவும்"

#. :src: bpy.types.ShaderNodeTexNoise.noise_dimensions:'4D'
#. :src: bpy.types.ShaderNodeTexVoronoi.voronoi_dimensions:'4D'
#. :src: bpy.types.ShaderNodeTexWhiteNoise.noise_dimensions:'4D'
msgid "Use the 4D vector (X, Y, Z, W) as input"
msgstr "4d திசையன் (x, ஒய், சட், w) உள்ளீடாகப் பயன்படுத்தவும்"

#. :src: bpy.types.ShaderNodeTexNoise.noise_type
msgid "Type of the Noise texture"
msgstr "ஒலி அமைப்பின் வகை"

#. :src: bpy.types.ShaderNodeTexNoise.noise_type:'MULTIFRACTAL'
msgid ""
"More uneven result (varies with location), more similar to a real terrain"
msgstr ""
"மேலும் சீரற்ற முடிவு (இருப்பிடத்துடன் மாறுபடும்), உண்மையான நிலப்பரப்புக்கு "
"ஒத்ததாகும்"

#. :src: bpy.types.ShaderNodeTexNoise.noise_type:'RIDGED_MULTIFRACTAL'
msgid "Create sharp peaks"
msgstr "கூர்மையான சிகரங்களை உருவாக்கவும்"

#. :src: bpy.types.ShaderNodeTexNoise.noise_type:'HYBRID_MULTIFRACTAL'
msgid "Create peaks and valleys with different roughness values"
msgstr ""
"வெவ்வேறு கரடுமுரடான மதிப்புகளுடன் சிகரங்களையும் பள்ளத்தாக்குகளையும் "
"உருவாக்கவும்"

#. :src: bpy.types.ShaderNodeTexNoise.noise_type:'FBM'
msgid "The standard fractal Perlin noise"
msgstr "நிலையான ஃப்ராக்டல் பெர்லின் ஒலி"

#. :src: bpy.types.ShaderNodeTexNoise.noise_type:'HETERO_TERRAIN'
msgid ""
"Similar to Hybrid Multifractal creates a heterogeneous terrain, but with the"
" likeness of river channels"
msgstr ""
"கலப்பின மல்டிஃபிராக்டல் போன்ற ஒரு பன்முக நிலப்பரப்பை உருவாக்குகிறது, ஆனால் "
"நதி சேனல்களின் ஒற்றுமையுடன்"

#. :src: bpy.types.ShaderNodeTexNoise.normalize
msgid "Normalize outputs to 0.0 to 1.0 range"
msgstr "வெளியீடுகளை 0.0 முதல் 1.0 வரம்பிற்கு இயல்பாக்குங்கள்"

#. :src: bpy.types.ShaderNodeTexSky
msgid "Sky Texture"
msgstr "வான அமைப்பு"

#. :src: bpy.types.ShaderNodeTexSky
msgid "Generate a procedural sky texture"
msgstr "ஒரு நடைமுறை வான அமைப்பை உருவாக்குங்கள்"

#. :src: bpy.types.ShaderNodeTexSky.air_density
#: source/blender/editors/physics/rigidbody_object.cc:361
msgid "Air"
msgstr "காற்று"

#. :src: bpy.types.ShaderNodeTexSky.air_density
msgid ""
"Density of air molecules.\n"
"• 0 - No air.\n"
"• 1 - Clear day atmosphere.\n"
"• 2 - Highly polluted day"
msgstr ""
"காற்று மூலக்கூறுகளின் அடர்த்தி.\n"
" • 0 - காற்று இல்லை.\n"
" • 1 - தெளிவான நாள் வளிமண்டலம்.\n"
" • 2 - அதிக மாசுபட்ட நாள்"

#. :src: bpy.types.ShaderNodeTexSky.altitude
msgid "Altitude"
msgstr "உயரம்"

#. :src: bpy.types.ShaderNodeTexSky.altitude
msgid "Height from sea level"
msgstr "கடல் மட்டத்திலிருந்து உயரம்"

#. :src: bpy.types.ShaderNodeTexSky.dust_density
msgid "Dust"
msgstr "தூசி"

#. :src: bpy.types.ShaderNodeTexSky.dust_density
msgid ""
"Density of dust molecules and water droplets.\n"
"• 0 - No dust.\n"
"• 1 - Clear day atmosphere.\n"
"• 5 - City like atmosphere.\n"
"• 10 - Hazy day"
msgstr ""
"தூசி மூலக்கூறுகள் மற்றும் நீர் துளிகளின் அடர்த்தி.\n"
" • 0 - தூசி இல்லை.\n"
" • 1 - தெளிவான நாள் வளிமண்டலம்.\n"
" • 5 - வளிமண்டலம் போன்ற நகரம்.\n"
" • 10 - மங்கலான நாள்"

#. :src: bpy.types.ShaderNodeTexSky.ozone_density
msgid "Ozone"
msgstr "ஓசோன்"

#. :src: bpy.types.ShaderNodeTexSky.ozone_density
msgid ""
"Density of ozone layer.\n"
"• 0 - No ozone.\n"
"• 1 - Clear day atmosphere.\n"
"• 2 - City like atmosphere"
msgstr ""
"ஓசோன் அடுக்கின் அடர்த்தி.\n"
" • 0 - ஓசோன் இல்லை.\n"
" • 1 - தெளிவான நாள் வளிமண்டலம்.\n"
" • 2 - வளிமண்டலம் போன்ற நகரம்"

#. :src: bpy.types.ShaderNodeTexSky.sky_type
msgid "Sky Type"
msgstr "வான வகை"

#. :src: bpy.types.ShaderNodeTexSky.sky_type
msgid "Which sky model should be used"
msgstr "எந்த வான மாதிரியைப் பயன்படுத்த வேண்டும்"

#. :src: bpy.types.ShaderNodeTexSky.sky_type:'NISHITA'
msgid "Nishita"
msgstr "நிசிதா"

#. :src: bpy.types.ShaderNodeTexSky.sky_type:'NISHITA'
msgid "Nishita 1993 improved"
msgstr "நிசிதா 1993 மேம்பட்டது"

#. :src: bpy.types.ShaderNodeTexSky.sun_disc
msgid "Sun Disc"
msgstr "சன் டிச்க்"

#. :src: bpy.types.ShaderNodeTexSky.sun_disc
msgid "Include the sun itself in the output"
msgstr "வெளியீட்டில் சூரியனைச் சேர்க்கவும்"

#. :src: bpy.types.ShaderNodeTexSky.sun_elevation
msgid "Sun Elevation"
msgstr "சூரிய உயர்வு"

#. :src: bpy.types.ShaderNodeTexSky.sun_elevation
msgid "Sun angle from horizon"
msgstr "அடிவானத்திலிருந்து சூரிய கோணம்"

#. :src: bpy.types.ShaderNodeTexSky.sun_intensity
msgid "Sun Intensity"
msgstr "சூரிய தீவிரம்"

#. :src: bpy.types.ShaderNodeTexSky.sun_intensity
msgid "Strength of sun"
msgstr "சூரியனின் வலிமை"

#. :src: bpy.types.ShaderNodeTexSky.sun_rotation
msgid "Sun Rotation"
msgstr "சூரிய சுழற்சி"

#. :src: bpy.types.ShaderNodeTexSky.sun_rotation
msgid "Rotation of sun around zenith"
msgstr "செனித்தைச் சுற்றி சூரியனின் சுழற்சி"

#. :src: bpy.types.ShaderNodeTexSky.sun_size
msgid "Sun Size"
msgstr "சூரிய அளவு"

#. :src: bpy.types.ShaderNodeTexSky.sun_size
msgid "Size of sun disc"
msgstr "சன் வட்டின் அளவு"

#. :src: bpy.types.ShaderNodeTexVoronoi
msgid "Voronoi Texture"
msgstr "வோரோனோய் அமைப்பு"

#. :src: bpy.types.ShaderNodeTexVoronoi
msgid ""
"Generate Worley noise based on the distance to random points. Typically used"
" to generate textures such as stones, water, or biological cells"
msgstr ""
"சீரற்ற புள்ளிகளுக்கான தூரத்தின் அடிப்படையில் வொர்லி சத்தத்தை உருவாக்குங்கள்."
" பொதுவாக கற்கள், நீர் அல்லது உயிரியல் செல்கள் போன்ற அமைப்புகளை உருவாக்க "
"பயன்படுகிறது"

#. :src: bpy.types.ShaderNodeTexVoronoi.distance
msgid "The distance metric used to compute the texture"
msgstr "அமைப்பைக் கணக்கிடப் பயன்படுத்தப்படும் தூர மெட்ரிக்"

#. :src: bpy.types.ShaderNodeTexVoronoi.distance:'EUCLIDEAN'
#: scripts/startup/bl_ui/space_userpref.py:477
msgid "Euclidean"
msgstr "யூக்ளிடியன்"

#. :src: bpy.types.ShaderNodeTexVoronoi.distance:'EUCLIDEAN'
msgid "Euclidean distance"
msgstr "யூக்ளிடியன் தூரம்"

#. :src: bpy.types.ShaderNodeTexVoronoi.distance:'MANHATTAN'
msgid "Manhattan distance"
msgstr "மன்ஆட்டன் தூரம்"

#. :src: bpy.types.ShaderNodeTexVoronoi.distance:'CHEBYCHEV'
msgid "Chebychev distance"
msgstr "செபிசேவ் தூரம்"

#. :src: bpy.types.ShaderNodeTexVoronoi.distance:'MINKOWSKI'
msgid "Minkowski distance"
msgstr "மின்கோவ்ச்கி தூரம்"

#. :src: bpy.types.ShaderNodeTexVoronoi.feature
msgid "Feature Output"
msgstr "அம்ச வெளியீடு"

#. :src: bpy.types.ShaderNodeTexVoronoi.feature
msgid "The Voronoi feature that the node will compute"
msgstr "முனை கணக்கிடும் வோரோனோய் நற்பொருத்தம்"

#. :src: bpy.types.ShaderNodeTexVoronoi.feature:'F1'
msgid "F1"
msgstr "எஃப் 1"

#. :src: bpy.types.ShaderNodeTexVoronoi.feature:'F1'
msgid ""
"Computes the distance to the closest point as well as its position and color"
msgstr ""
"மிக நெருக்கமான இடத்திற்கும் அதன் நிலை மற்றும் வண்ணத்திற்கும் தூரத்தை "
"கணக்கிடுகிறது"

#. :src: bpy.types.ShaderNodeTexVoronoi.feature:'F2'
msgid "F2"
msgstr "எஃப் 2"

#. :src: bpy.types.ShaderNodeTexVoronoi.feature:'F2'
msgid ""
"Computes the distance to the second closest point as well as its position "
"and color"
msgstr ""
"இரண்டாவது மிக நெருக்கமான புள்ளியுக்கும் அதன் நிலை மற்றும் வண்ணத்திற்கும் "
"தூரத்தை கணக்கிடுகிறது"

#. :src: bpy.types.ShaderNodeTexVoronoi.feature:'SMOOTH_F1'
msgid "Smooth F1"
msgstr "மென்மையான எஃப் 1"

#. :src: bpy.types.ShaderNodeTexVoronoi.feature:'SMOOTH_F1'
msgid "Smoothed version of F1. Weighted sum of neighbor voronoi cells."
msgstr "F1 இன் மென்மையான பதிப்பு. அண்டை வோரோனோய் கலங்களின் எடையுள்ள தொகை."

#. :src: bpy.types.ShaderNodeTexVoronoi.feature:'DISTANCE_TO_EDGE'
msgid "Distance to Edge"
msgstr "விளிம்பிற்கு தூரம்"

#. :src: bpy.types.ShaderNodeTexVoronoi.feature:'DISTANCE_TO_EDGE'
msgid "Computes the distance to the edge of the voronoi cell"
msgstr "வோரோனோய் கலத்தின் விளிம்பிற்கு தூரத்தை கணக்கிடுகிறது"

#. :src: bpy.types.ShaderNodeTexVoronoi.feature:'N_SPHERE_RADIUS'
msgid "N-Sphere Radius"
msgstr "என்-ச்பியர் ஆரம்"

#. :src: bpy.types.ShaderNodeTexVoronoi.feature:'N_SPHERE_RADIUS'
msgid "Computes the radius of the n-sphere inscribed in the voronoi cell"
msgstr "வோரோனோய் கலத்தில் பொறிக்கப்பட்ட என்-ச்பியர் ஆரம் கணக்கிடுகிறது"

#. :src: bpy.types.ShaderNodeTexVoronoi.normalize
msgid "Normalize output Distance to 0.0 to 1.0 range"
msgstr "வெளியீட்டு தூரத்தை 0.0 முதல் 1.0 வரம்பிற்கு இயல்பாக்குங்கள்"

#. :src: bpy.types.ShaderNodeTexWave
msgid "Wave Texture"
msgstr "அலை அமைப்பு"

#. :src: bpy.types.ShaderNodeTexWave
msgid "Generate procedural bands or rings with noise"
msgstr "நடைமுறை பட்டைகள் அல்லது மோதிரங்களை சத்தத்துடன் உருவாக்குங்கள்"

#. :src: bpy.types.ShaderNodeTexWave.bands_direction
msgid "Bands Direction"
msgstr "பட்டைகள் திசை"

#. :src: bpy.types.ShaderNodeTexWave.bands_direction:'X'
msgid "Bands across X axis"
msgstr "ஃச் அச்சு முழுவதும் பட்டைகள்"

#. :src: bpy.types.ShaderNodeTexWave.bands_direction:'Y'
msgid "Bands across Y axis"
msgstr "ஒய் அச்சு முழுவதும் பட்டைகள்"

#. :src: bpy.types.ShaderNodeTexWave.bands_direction:'Z'
msgid "Bands across Z axis"
msgstr "சட் அச்சு முழுவதும் பட்டைகள்"

#. :src: bpy.types.ShaderNodeTexWave.bands_direction:'DIAGONAL'
msgid "Bands across diagonal axis"
msgstr "மூலைவிட்ட அச்சு முழுவதும் பட்டைகள்"

#. :src: bpy.types.ShaderNodeTexWave.rings_direction
msgid "Rings Direction"
msgstr "மோதிரங்கள் திசை"

#. :src: bpy.types.ShaderNodeTexWave.rings_direction:'X'
msgid "Rings along X axis"
msgstr "ஃச் அச்சில் மோதிரங்கள்"

#. :src: bpy.types.ShaderNodeTexWave.rings_direction:'Y'
msgid "Rings along Y axis"
msgstr "ஒய் அச்சுடன் மோதிரங்கள்"

#. :src: bpy.types.ShaderNodeTexWave.rings_direction:'Z'
msgid "Rings along Z axis"
msgstr "சட் அச்சுடன் மோதிரங்கள்"

#. :src: bpy.types.ShaderNodeTexWave.rings_direction:'SPHERICAL'
msgid "Rings along spherical distance"
msgstr "கோள தூரத்தில் மோதிரங்கள்"

#. :src: bpy.types.ShaderNodeTexWave.wave_profile
msgid "Wave Profile"
msgstr "அலை சுயவிவரம்"

#. :src: bpy.types.ShaderNodeTexWave.wave_profile:'SIN'
msgid "Use a standard sine profile"
msgstr "நிலையான சைன் சுயவிவரத்தைப் பயன்படுத்தவும்"

#. :src: bpy.types.ShaderNodeTexWave.wave_profile:'SAW'
msgid "Use a sawtooth profile"
msgstr "மரத்தூள் சுயவிவரத்தைப் பயன்படுத்தவும்"

#. :src: bpy.types.ShaderNodeTexWave.wave_profile:'TRI'
msgid "Triangle"
msgstr "முக்கோணம்"

#. :src: bpy.types.ShaderNodeTexWave.wave_profile:'TRI'
msgid "Use a triangle profile"
msgstr "முக்கோண சுயவிவரத்தைப் பயன்படுத்தவும்"

#. :src: bpy.types.ShaderNodeTexWave.wave_type
msgid "Wave Type"
msgstr "அலை வகை"

#. :src: bpy.types.ShaderNodeTexWave.wave_type:'BANDS'
msgid "Bands"
msgstr "பட்டைகள்"

#. :src: bpy.types.ShaderNodeTexWave.wave_type:'BANDS'
msgid "Use standard wave texture in bands"
msgstr "பட்டையில் நிலையான அலை அமைப்பைப் பயன்படுத்தவும்"

#. :src: bpy.types.ShaderNodeTexWave.wave_type:'RINGS'
#. :src: bpy.types.MESH_OT_primitive_uv_sphere_add.ring_count
#: source/blender/nodes/geometry/nodes/node_geo_mesh_primitive_uv_sphere.cc:19
msgid "Rings"
msgstr "மோதிரங்கள்"

#. :src: bpy.types.ShaderNodeTexWave.wave_type:'RINGS'
msgid "Use wave texture in rings"
msgstr "மோதிரங்களில் அலை அமைப்பைப் பயன்படுத்தவும்"

#. :src: bpy.types.ShaderNodeTexWhiteNoise
msgid "White Noise Texture"
msgstr "வெள்ளை ஒலி அமைப்பு"

#. :src: bpy.types.ShaderNodeTexWhiteNoise
msgid "Return a random value or color based on an input seed"
msgstr ""
"உள்ளீட்டு விதை அடிப்படையில் ஒரு சீரற்ற மதிப்பு அல்லது வண்ணத்தைத் தரவும்"

#. :src: bpy.types.ShaderNodeUVAlongStroke
msgid "UV Along Stroke"
msgstr "பக்கவாதத்துடன் புறஊதா"

#. :src: bpy.types.ShaderNodeUVAlongStroke.use_tips
msgid "Use Tips"
msgstr "உதவிக்குறிப்புகளைப் பயன்படுத்தவும்"

#. :src: bpy.types.ShaderNodeUVAlongStroke.use_tips
msgid "Lower half of the texture is for tips of the stroke"
msgstr "அமைப்பின் கீழ் பாதி பக்கவாதத்தின் உதவிக்குறிப்புகள்"

#. :src: bpy.types.ShaderNodeUVMap
msgid ""
"Retrieve a UV map from the geometry, or the default fallback if none is "
"specified"
msgstr ""
"எதுவும் குறிப்பிடப்படாவிட்டால் வடிவவியலில் இருந்து ஒரு புறஊதா வரைபடத்தை "
"மீட்டெடுக்கவும் அல்லது இயல்புநிலை குறைவடையும்"

#. :src: bpy.types.ShaderNodeUVMap.uv_map
msgid "UV coordinates to be used for mapping"
msgstr "மேப்பிங் செய்ய பயன்படுத்த வேண்டிய புறஊதா ஆயத்தொலைவுகள்"

#. :src: bpy.types.ShaderNodeValToRGB
msgid "Map values to colors with the use of a gradient"
msgstr "ஒரு சாய்வு பயன்பாட்டுடன் வண்ணங்களுக்கு வரைபட மதிப்புகள்"

#. :src: bpy.types.ShaderNodeValue
msgid "Input numerical values to other nodes in the tree"
msgstr "மரத்தின் பிற முனைகளுக்கு எண் மதிப்புகளை உள்ளிடவும்"

#. :src: bpy.types.ShaderNodeVectorCurve
msgid "Vector Curves"
msgstr "திசையன் வளைவுகள்"

#. :src: bpy.types.ShaderNodeVectorCurve
msgid "Map input vector components with curves"
msgstr "வளைவுகளுடன் உள்ளீட்டு திசையன் கூறுகளை வரைபடமாக்குகிறது"

#. :src: bpy.types.ShaderNodeVectorDisplacement
msgid "Displace the surface along an arbitrary direction"
msgstr "மேற்பரப்பை தன்னிச்சையான திசையில் இடமாற்றம் செய்யுங்கள்"

#. :src: bpy.types.ShaderNodeVectorDisplacement.space:'TANGENT'
msgid "Tangent space vector displacement mapping"
msgstr "தொடுகோடு விண்வெளி திசையன் இடப்பெயர்ச்சி மேப்பிங்"

#. :src: bpy.types.ShaderNodeVectorDisplacement.space:'OBJECT'
msgid "Object space vector displacement mapping"
msgstr "பொருள் விண்வெளி திசையன் இடப்பெயர்வு மேப்பிங்"

#. :src: bpy.types.ShaderNodeVectorDisplacement.space:'WORLD'
msgid "World space vector displacement mapping"
msgstr "உலக விண்வெளி திசையன் இடப்பெயர்வு மேப்பிங்"

#. :src: bpy.types.ShaderNodeVectorMath
msgid "Vector Math"
msgstr "திசையன் கணிதம்"

#. :src: bpy.types.ShaderNodeVectorMath
msgid "Perform vector math operation"
msgstr "திசையன் கணித செயல்பாட்டைச் செய்யுங்கள்"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'MULTIPLY'
msgid "Entry-wise multiply"
msgstr "நுழைவு வாரியாக பெருகும்"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'DIVIDE'
msgid "Entry-wise divide"
msgstr "நுழைவு வாரியாக பிளவு"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'CROSS_PRODUCT'
msgctxt "NodeTree"
msgid "Cross Product"
msgstr "குறுக்கு தயாரிப்பு"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'CROSS_PRODUCT'
msgid "A cross B"
msgstr "ஒரு குறுக்கு ஆ"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'PROJECT'
msgctxt "NodeTree"
msgid "Project"
msgstr "திட்டம்"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'PROJECT'
msgid "Project A onto B"
msgstr "திட்டத்திற்கு ஒரு திட்டம்"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'REFLECT'
msgctxt "NodeTree"
msgid "Reflect"
msgstr "பிரதிபலிக்கவும்"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'REFLECT'
msgid "Reflect A around the normal B. B doesn't need to be normalized."
msgstr "சாதாரண பி. பி ஐ இயல்பாக்க தேவையில்லை."

#. :src: bpy.types.ShaderNodeVectorMath.operation:'REFRACT'
msgctxt "NodeTree"
msgid "Refract"
msgstr "ரிஃபாக்ட்"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'REFRACT'
msgid ""
"For a given incident vector A, surface normal B and ratio of indices of "
"refraction, Ior, refract returns the refraction vector, R"
msgstr ""
"கொடுக்கப்பட்ட சம்பவ திசையன் a, மேற்பரப்பு இயல்பான பி மற்றும் ஒளிவிலகல் "
"குறியீடுகளின் விகிதம், ஐஓஆர், ஒளிவிலகல் திசையன், ஆர்"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'FACEFORWARD'
msgctxt "NodeTree"
msgid "Faceforward"
msgstr "முகம்"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'FACEFORWARD'
msgid ""
"Orients a vector A to point away from a surface B as defined by its normal "
"C. Returns (dot(B, C) < 0) ? A : -A"
msgstr ""
"அதன் இயல்பான சி வருமானத்தால் வரையறுக்கப்பட்டுள்ளபடி ஒரு மேற்பரப்பு b "
"இலிருந்து சுட்டிக்காட்ட ஒரு திசையன் a a orients? ப: -a"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'DOT_PRODUCT'
msgctxt "NodeTree"
msgid "Dot Product"
msgstr "டாட் தயாரிப்பு"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'DOT_PRODUCT'
msgid "A dot B"
msgstr "ஒரு புள்ளி ஆ"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'DISTANCE'
msgctxt "NodeTree"
msgid "Distance"
msgstr "தூரம்"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'DISTANCE'
msgid "Distance between A and B"
msgstr "a மற்றும் b க்கு இடையிலான தூரம்"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'LENGTH'
msgctxt "NodeTree"
msgid "Length"
msgstr "நீளம்"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'LENGTH'
msgid "Length of A"
msgstr "ஒரு நீளம்"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'SCALE'
msgctxt "NodeTree"
msgid "Scale"
msgstr "அளவு"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'SCALE'
msgid "A multiplied by Scale"
msgstr "அளவால் பெருக்கப்படுகிறது"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'NORMALIZE'
msgctxt "NodeTree"
msgid "Normalize"
msgstr "இயல்பாக்குங்கள்"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'NORMALIZE'
msgid "Normalize A"
msgstr "ஒரு இயல்பாக்கு a"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'ABSOLUTE'
msgid "Entry-wise absolute"
msgstr "நுழைவு வாரியாக முழுமையானது"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'POWER'
msgid "Entry-wise power"
msgstr "நுழைவு வாரியான ஆற்றல்"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'SIGN'
msgid "Entry-wise sign"
msgstr "நுழைவு வாரியான அடையாளம்"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'MINIMUM'
msgid "Entry-wise minimum"
msgstr "நுழைவு வாரியாக குறைந்தபட்சம்"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'MAXIMUM'
msgid "Entry-wise maximum"
msgstr "நுழைவு வாரியாக அதிகபட்சம்"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'FLOOR'
msgid "Entry-wise floor"
msgstr "நுழைவு வாரியான தளம்"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'CEIL'
msgid "Entry-wise ceil"
msgstr "நுழைவு வாரியான சீல்"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'FRACTION'
msgid "The fraction part of A entry-wise"
msgstr "நுழைவு வாரியாக பின்னம் பகுதி"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'MODULO'
msgid "Entry-wise modulo using fmod(A,B)"
msgstr "fmod (a, b) ஐப் பயன்படுத்தி நுழைவு வாரியான மாடுலோ"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'WRAP'
msgid "Entry-wise wrap(A,B)"
msgstr "நுழைவு வாரியான மடக்கு (ஏ, பி)"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'SNAP'
msgid "Round A to the largest integer multiple of B less than or equal A"
msgstr "a ஐ விட குறைவாகவோ அல்லது சமமாகவோ b இன் மிகப்பெரிய முழுஎண்ணுக்கு a"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'SINE'
msgid "Entry-wise sin(A)"
msgstr "நுழைவு வாரியான ஊழ்கம் (அ)"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'COSINE'
msgid "Entry-wise cos(A)"
msgstr "நுழைவு வாரியான காச் (அ)"

#. :src: bpy.types.ShaderNodeVectorMath.operation:'TANGENT'
msgid "Entry-wise tan(A)"
msgstr "நுழைவு வாரியான டான் (அ)"

#. :src: bpy.types.ShaderNodeVectorRotate
msgid "Vector Rotate"
msgstr "திசையன் சுழலும்"

#. :src: bpy.types.ShaderNodeVectorRotate
msgid "Rotate a vector around a pivot point (center)"
msgstr "ஒரு மைய புள்ளியை (மையம்) சுற்றி ஒரு திசையனை சுழற்றுங்கள்"

#. :src: bpy.types.ShaderNodeVectorRotate.invert
msgid "Invert the rotation angle"
msgstr "சுழற்சி கோணத்தை தலைகீழாக மாற்றவும்"

#. :src: bpy.types.ShaderNodeVectorRotate.rotation_type
msgid "Type of angle input"
msgstr "கோண உள்ளீடு வகை"

#. :src: bpy.types.ShaderNodeVectorRotate.rotation_type:'AXIS_ANGLE'
msgid "Rotate a point using axis angle"
msgstr "அச்சு கோணத்தைப் பயன்படுத்தி ஒரு புள்ளியை சுழற்றுங்கள்"

#. :src: bpy.types.ShaderNodeVectorRotate.rotation_type:'X_AXIS'
#. :src: bpy.types.EXPORT_SCENE_OT_fbx.primary_bone_axis:'X'
