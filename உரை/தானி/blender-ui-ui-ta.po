msgid "Path"
msgstr "பாதை"

#. :src: bpy.types.Curve.use_path
msgid "Enable the curve to become a translation path"
msgstr "வளைவை மொழிபெயர்ப்பு பாதையாக மாற்றவும்"

#. :src: bpy.types.Curve.use_path_clamp
msgid ""
"Clamp the curve path children so they can't travel past the start/end point "
"of the curve"
msgstr ""
"வளைவு பாதை குழந்தைகளைக் கட்டுப்படுத்துங்கள், இதனால் வளைவின் தொடக்க/இறுதி "
"புள்ளியைக் கடந்து அவர்களால் பயணிக்க முடியாது"

#. :src: bpy.types.Curve.use_path_follow
#. :src: bpy.types.Screen.use_follow
msgid "Follow"
msgstr "பின்தொடர்"

#. :src: bpy.types.Curve.use_path_follow
msgid "Make curve path children rotate along the path"
msgstr "வளைவு பாதையை பாதையில் சுழற்றுங்கள்"

#. :src: bpy.types.Curve.use_radius
msgid ""
"Option for paths and curve-deform: apply the curve radius to objects "
"following it and to deformed objects"
msgstr ""
"பாதைகள் மற்றும் வளைவு-டிஃபார்முக்கான விருப்பம்: வளைவு ஆரம் அதைப் பின்பற்றும்"
" பொருள்களுக்கும் சிதைந்த பொருள்களுக்கும் பயன்படுத்துங்கள்"

#. :src: bpy.types.Curve.use_stretch
msgid "Option for curve-deform: make deformed child stretch along entire path"
msgstr ""
"வளைவு-டிஃபார்முக்கான விருப்பம்: சிதைந்த குழந்தையை முழு பாதையிலும் நீட்டவும்"

#. :src: bpy.types.SurfaceCurve
msgid "Surface Curve"
msgstr "மேற்பரப்பு வளைவு"

#. :src: bpy.types.SurfaceCurve
msgid "Curve data-block used for storing surfaces"
msgstr "மேற்பரப்புகளை சேமிக்கப் பயன்படுத்தப்படும் வளைவு தரவு-தொகுதி"

#. :src: bpy.types.TextCurve
msgid "Text Curve"
msgstr "உரை வளைவு"

#. :src: bpy.types.TextCurve
msgid "Curve data-block used for storing text"
msgstr "உரையை சேமிக்கப் பயன்படுத்தப்படும் வளைவு தரவு-தொகுதி"

#. :src: bpy.types.TextCurve.active_textbox
msgid "Active Text Box"
msgstr "செயலில் உரை பெட்டி"

#. :src: bpy.types.TextCurve.align_x
#. :src: bpy.types.GeometryNodeStringToCurves.align_x
msgid "Horizontal Alignment"
msgstr "கிடைமட்ட சீரமைப்பு"

#. :src: bpy.types.TextCurve.align_x
#. :src: bpy.types.GeometryNodeStringToCurves.align_x
msgid "Text horizontal alignment from the object or text box center"
msgstr "பொருள் அல்லது உரை பெட்டி மையத்திலிருந்து கிடைமட்ட சீரமைப்பு உரை"

#. :src: bpy.types.TextCurve.align_x:'LEFT'
#. :src: bpy.types.GeometryNodeStringToCurves.align_x:'LEFT'
msgid "Align text to the left"
msgstr "உரையை இடதுபுறமாக சீரமைக்கவும்"

#. :src: bpy.types.TextCurve.align_x:'CENTER'
msgid "Center text"
msgstr "மைய உரை"

#. :src: bpy.types.TextCurve.align_x:'RIGHT'
#. :src: bpy.types.GeometryNodeStringToCurves.align_x:'RIGHT'
msgid "Align text to the right"
msgstr "உரையை வலதுபுறமாக சீரமைக்கவும்"

#. :src: bpy.types.TextCurve.align_x:'JUSTIFY'
