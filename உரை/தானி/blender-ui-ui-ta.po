msgid "Size"
msgstr "அளவு"

#. :src: bpy.types.FieldSettings.size
msgid "Size of the turbulence"
msgstr "கொந்தளிப்பின் அளவு"

#. :src: bpy.types.FieldSettings.source_object
msgid "Domain Object"
msgstr "டொமைன் பொருள்"

#. :src: bpy.types.FieldSettings.source_object
msgid "Select domain object of the smoke simulation"
msgstr "புகை உருவகப்படுத்துதலின் டொமைன் பொருளைத் தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.FieldSettings.strength
msgid "Strength of force field"
msgstr "படை புலத்தின் வலிமை"

#. :src: bpy.types.FieldSettings.texture
msgid "Texture to use as force"
msgstr "சக்தியாக பயன்படுத்த அமைப்பு"

#. :src: bpy.types.FieldSettings.texture_mode
msgid "Texture Mode"
msgstr "அமைப்பு முறை"

#. :src: bpy.types.FieldSettings.texture_mode
msgid ""
"How the texture effect is calculated (RGB and Curl need a RGB texture, else "
"Gradient will be used instead)"
msgstr ""
"அமைப்பு விளைவு எவ்வாறு கணக்கிடப்படுகிறது (rgb மற்றும் சுருட்டை ஒரு rgb "
"அமைப்பு தேவை, அதற்கு பதிலாக சாய்வு பயன்படுத்தப்படும்)"

#. :src: bpy.types.FieldSettings.texture_mode:'CURL'
msgid "Curl"
msgstr "சுருட்டை"

#. :src: bpy.types.FieldSettings.texture_mode:'GRADIENT'
#. :src: bpy.types.Brush.color_type:'GRADIENT'
#. :src: bpy.types.Brush.gradient
#. :src: bpy.types.GreasePencilTintModifier.tint_mode:'GRADIENT'
msgid "Gradient"
msgstr "சாய்வு"

