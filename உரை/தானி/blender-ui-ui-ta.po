#. :src: bpy.types.GREASE_PENCIL_OT_trace_image
msgctxt "Operator"
msgid "Trace Image to Grease Pencil"
msgstr "பென்சிலுக்கு கிரீச் செய்ய படத்தைக் கண்டறியவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_trace_image
msgid "Extract Grease Pencil strokes from image"
msgstr "படத்திலிருந்து பசை எழுதுகோல் வீச்சுகள் பிரித்தெடுக்கவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_trace_image.frame_number
msgid "Trace Frame"
msgstr "சுவடு சட்டகம்"

#. :src: bpy.types.GREASE_PENCIL_OT_trace_image.frame_number
msgid ""
"Used to trace only one frame of the image sequence, set to zero to trace all"
msgstr ""
"பட வரிசையின் ஒரு சட்டகத்தை மட்டுமே கண்டுபிடிக்கப் பயன்படுகிறது, அனைத்தையும் "
"கண்டுபிடிக்க பூச்சியமாக அமைக்கவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_trace_image.mode
msgid "Determines if trace simple image or full sequence"
msgstr "எளிய படம் அல்லது முழு வரிசையை நிலைநிறுத்தினால் தீர்மானிக்கிறது"

#. :src: bpy.types.GREASE_PENCIL_OT_trace_image.mode:'SINGLE'
msgid "Trace the current frame of the image"
msgstr "படத்தின் தற்போதைய சட்டகத்தைக் கண்டறியவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_trace_image.mode:'SEQUENCE'
msgid "Trace full sequence"
msgstr "முழு வரிசையையும் கண்டுபிடி"

#. :src: bpy.types.GREASE_PENCIL_OT_trace_image.target
msgid "Target Grease Pencil"
msgstr "இலக்கு கிரீச் பென்சில்"

#. :src: bpy.types.GREASE_PENCIL_OT_trace_image.target:'NEW'
msgid "New Object"
msgstr "புதிய பொருள்"

#. :src: bpy.types.GREASE_PENCIL_OT_trace_image.target:'SELECTED'
msgid "Selected Object"
msgstr "தேர்ந்தெடுக்கப்பட்ட பொருள்"

#. :src: bpy.types.GREASE_PENCIL_OT_trace_image.threshold
#: source/blender/nodes/composite/nodes/node_composite_despeckle.cc:39
msgid "Color Threshold"
msgstr "வண்ண வாசல்"

#. :src: bpy.types.GREASE_PENCIL_OT_trace_image.threshold
msgid "Determine the lightness threshold above which strokes are generated"
msgstr ""
"எந்த வீச்சுகள் உருவாக்கப்படுகிறது என்பதை மேலே லேசான வாசலைத் தீர்மானிக்கவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_trace_image.turnpolicy
msgid "Turn Policy"
msgstr "கொள்கையை திருப்புங்கள்"

#. :src: bpy.types.GREASE_PENCIL_OT_trace_image.turnpolicy
msgid ""
"Determines how to resolve ambiguities during decomposition of bitmaps into "
"paths"
msgstr ""
"பிட்மேப்ச் பாதைகளில் சிதைவின் போது தெளிவற்ற தன்மைகளை எவ்வாறு தீர்ப்பது "
"என்பதை தீர்மானிக்கிறது"

#. :src: bpy.types.GREASE_PENCIL_OT_trace_image.turnpolicy:'FOREGROUND'
msgid "Foreground"
msgstr "முன்புறம்"

#. :src: bpy.types.GREASE_PENCIL_OT_trace_image.turnpolicy:'FOREGROUND'
msgid "Prefers to connect foreground components"
msgstr "முன்புற கூறுகளை இணைக்க விரும்புகிறது"

#. :src: bpy.types.GREASE_PENCIL_OT_trace_image.turnpolicy:'BACKGROUND'
msgid "Prefers to connect background components"
msgstr "பின்னணி கூறுகளை இணைக்க விரும்புகிறது"

#. :src: bpy.types.GREASE_PENCIL_OT_trace_image.turnpolicy:'LEFT'
msgid "Always take a left turn"
msgstr "எப்போதும் இடது திருப்பத்தை எடுத்துக் கொள்ளுங்கள்"

#. :src: bpy.types.GREASE_PENCIL_OT_trace_image.turnpolicy:'RIGHT'
msgid "Always take a right turn"
msgstr "எப்போதும் சரியான திருப்பத்தை எடுத்துக் கொள்ளுங்கள்"

#. :src: bpy.types.GREASE_PENCIL_OT_trace_image.turnpolicy:'MINORITY'
msgid "Minority"
msgstr "சிறுபான்மை"

#. :src: bpy.types.GREASE_PENCIL_OT_trace_image.turnpolicy:'MINORITY'
msgid ""
"Prefers to connect the color that occurs least frequently in the local "
"neighborhood of the current position"
msgstr ""
"தற்போதைய நிலையின் உள்ளக சுற்றுப்புறத்தில் குறைந்த அளவில் நிகழும் வண்ணத்தை "
"இணைக்க விரும்புகிறது"

#. :src: bpy.types.GREASE_PENCIL_OT_trace_image.turnpolicy:'MAJORITY'
msgid "Majority"
msgstr "பெரும்பான்மை"

#. :src: bpy.types.GREASE_PENCIL_OT_trace_image.turnpolicy:'MAJORITY'
msgid ""
"Prefers to connect the color that occurs most frequently in the local "
"neighborhood of the current position"
msgstr ""
"தற்போதைய நிலையின் உள்ளக சுற்றுப்புறத்தில் அடிக்கடி நிகழும் வண்ணத்தை இணைக்க "
"விரும்புகிறது"

#. :src: bpy.types.GREASE_PENCIL_OT_trace_image.turnpolicy:'RANDOM'
msgid "Choose pseudo-randomly"
msgstr "போலி-சீரற்றதாகத் தேர்வுசெய்க"

#. :src: bpy.types.GREASE_PENCIL_OT_trace_image.use_current_frame
msgid "Start At Current Frame"
msgstr "தற்போதைய சட்டத்தில் தொடங்கவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_trace_image.use_current_frame
msgid "Trace Image starting in current image frame"
msgstr "தற்போதைய பட சட்டத்தில் தொடங்கும் படத்தைக் கண்டறியவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_vertex_brush_stroke
msgctxt "Operator"
msgid "Grease Pencil Paint Vertex"
msgstr "கிரீச் பென்சில் பெயிண்ட் வெர்டெக்ச்"

#. :src: bpy.types.GREASE_PENCIL_OT_vertex_brush_stroke
msgid "Draw on vertex colors in the active Grease Pencil object"
msgstr "செயலில் உள்ள கிரீச் பென்சில் பொருளில் வெர்டெக்ச் வண்ணங்களை வரையவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_vertex_color_brightness_contrast
#. :src: bpy.types.PAINT_OT_vertex_color_brightness_contrast
msgctxt "Operator"
msgid "Vertex Paint Brightness/Contrast"
msgstr "வெர்டெக்ச் வண்ணப்பூச்சு பிரகாசம்/மாறுபாடு"

#. :src: bpy.types.GREASE_PENCIL_OT_vertex_color_brightness_contrast
#. :src: bpy.types.PAINT_OT_vertex_color_brightness_contrast
msgid "Adjust vertex color brightness/contrast"
msgstr "வெர்டெக்ச் வண்ண பிரகாசம்/மாறுபாட்டை சரிசெய்யவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_vertex_color_hsv
#. :src: bpy.types.PAINT_OT_vertex_color_hsv
msgctxt "Operator"
msgid "Vertex Paint Hue/Saturation/Value"
msgstr "வெர்டெக்ச் பெயிண்ட் சாயல்/செறிவு/மதிப்பு"

#. :src: bpy.types.GREASE_PENCIL_OT_vertex_color_hsv
msgid "Adjust vertex color HSV values"
msgstr "வெர்டெக்ச் வண்ண hsv மதிப்புகளை சரிசெய்யவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_vertex_color_invert
#. :src: bpy.types.PAINT_OT_vertex_color_invert
msgctxt "Operator"
msgid "Vertex Paint Invert"
msgstr "வெர்டெக்ச் பெயிண்ட் தலைகீழ்"

#. :src: bpy.types.GREASE_PENCIL_OT_vertex_color_invert
#. :src: bpy.types.PAINT_OT_vertex_color_invert
msgid "Invert RGB values"
msgstr "rgb மதிப்புகளைத் தலைகீழ்"

#. :src: bpy.types.GREASE_PENCIL_OT_vertex_color_levels
#. :src: bpy.types.PAINT_OT_vertex_color_levels
msgctxt "Operator"
msgid "Vertex Paint Levels"
msgstr "வெர்டெக்ச் பெயிண்ட் நிலைகள்"

#. :src: bpy.types.GREASE_PENCIL_OT_vertex_color_levels
#. :src: bpy.types.PAINT_OT_vertex_color_levels
msgid "Adjust levels of vertex colors"
msgstr "வெர்டெக்ச் வண்ணங்களின் அளவை சரிசெய்யவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_vertex_color_levels.gain
#. :src: bpy.types.PAINT_OT_vertex_color_levels.gain
msgid "Value to multiply colors by"
msgstr "வண்ணங்களை பெருக்க மதிப்பு"

#. :src: bpy.types.GREASE_PENCIL_OT_vertex_color_levels.offset
#. :src: bpy.types.PAINT_OT_vertex_color_levels.offset
msgid "Value to add to colors"
msgstr "வண்ணங்களில் சேர்க்க மதிப்பு"

#. :src: bpy.types.GREASE_PENCIL_OT_vertex_color_set
msgctxt "Operator"
msgid "Vertex Paint Set Color"
msgstr "வெர்டெக்ச் பெயிண்ட் செட் நிறம்"

#. :src: bpy.types.GREASE_PENCIL_OT_vertex_color_set
msgid "Set active color to all selected vertex"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட அனைத்து வெர்டெக்சுக்கும் செயலில் வண்ணத்தை அமைக்கவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_vertex_group_normalize
#. :src: bpy.types.OBJECT_OT_vertex_group_normalize
msgctxt "Operator"
msgid "Normalize Vertex Group"
msgstr "வெர்டெக்ச் குழுவை இயல்பாக்குங்கள்"

#. :src: bpy.types.GREASE_PENCIL_OT_vertex_group_normalize
msgid "Normalize weights of the active vertex group"
msgstr "செயலில் உள்ள வெர்டெக்ச் குழுவின் எடைகளை இயல்பாக்குங்கள்"

#. :src: bpy.types.GREASE_PENCIL_OT_vertex_group_normalize_all
#. :src: bpy.types.OBJECT_OT_vertex_group_normalize_all
msgctxt "Operator"
msgid "Normalize All Vertex Groups"
msgstr "அனைத்து வெர்டெக்ச் குழுக்களையும் இயல்பாக்குங்கள்"

#. :src: bpy.types.GREASE_PENCIL_OT_vertex_group_normalize_all
msgid ""
"Normalize the weights of all vertex groups, so that for each vertex, the sum"
" of all weights is 1.0"
msgstr ""
"அனைத்து வெர்டெக்ச் குழுக்களின் எடைகளை இயல்பாக்குங்கள், இதனால் ஒவ்வொரு "
"வெர்டெக்சிற்கும், அனைத்து எடைகளின் கூட்டுத்தொகை 1.0 ஆகும்"

#. :src: bpy.types.GREASE_PENCIL_OT_vertex_group_normalize_all.lock_active
#. :src: bpy.types.OBJECT_OT_vertex_group_normalize_all.lock_active
msgid "Lock Active"
msgstr "பூட்டு செயலில்"

#. :src: bpy.types.GREASE_PENCIL_OT_vertex_group_normalize_all.lock_active
#. :src: bpy.types.OBJECT_OT_vertex_group_normalize_all.lock_active
msgid "Keep the values of the active group while normalizing others"
msgstr ""
"மற்றவர்களை இயல்பாக்கும்போது செயலில் உள்ள குழுவின் மதிப்புகளை வைத்திருங்கள்"

#. :src: bpy.types.GREASE_PENCIL_OT_vertex_group_smooth
msgctxt "Operator"
msgid "Smooth Vertex Group"
msgstr "மென்மையான வெர்டெக்ச் குழு"

#. :src: bpy.types.GREASE_PENCIL_OT_vertex_group_smooth
msgid "Smooth the weights of the active vertex group"
msgstr "செயலில் உள்ள வெர்டெக்ச் குழுவின் எடையை மென்மையாக்கவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_vertexmode_toggle
msgctxt "Operator"
msgid "Strokes Vertex Mode Toggle"
msgstr "ச்ட்ரோக்ச் வெர்டெக்ச் பயன்முறை மாறுகிறது"

#. :src: bpy.types.GREASE_PENCIL_OT_vertexmode_toggle
msgid "Enter/Exit vertex paint mode for Grease Pencil strokes"
msgstr ""
"பசை எழுதுகோல் வீச்சுகள் வெர்டெக்ச் பெயிண்ட் பயன்முறையை "
"உள்ளிடவும்/வெளியேறவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_weight_brush_stroke
msgctxt "Operator"
msgid "Grease Pencil Paint Weight"
msgstr "கிரீச் பென்சில் பெயிண்ட் எடை"

#. :src: bpy.types.GREASE_PENCIL_OT_weight_brush_stroke
msgid "Draw weight on stroke points in the active Grease Pencil object"
msgstr ""
"செயலில் உள்ள கிரீச் பென்சில் பொருளில் பக்கவாதம் புள்ளிகளில் எடை வரையவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_weight_invert
msgctxt "Operator"
msgid "Invert Weight"
msgstr "எடை தலைகீழ்"

#. :src: bpy.types.GREASE_PENCIL_OT_weight_invert
msgid "Invert the weight of active vertex group"
msgstr "செயலில் உள்ள வெர்டெக்ச் குழுவின் எடையை தலைகீழாக மாற்றவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_weight_sample
#. :src: bpy.types.PAINT_OT_weight_sample
msgctxt "Operator"
msgid "Weight Paint Sample Weight"
msgstr "எடை வண்ணப்பூச்சு மாதிரி எடை"

#. :src: bpy.types.GREASE_PENCIL_OT_weight_sample
msgid ""
"Set the weight of the Draw tool to the weight of the vertex under the mouse "
"cursor"
msgstr ""
"டிரா கருவியின் எடையை சுட்டி கர்சரின் கீழ் வெர்டெக்சின் எடைக்கு அமைக்கவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_weight_toggle_direction
msgctxt "Operator"
msgid "Weight Paint Toggle Direction"
msgstr "எடை வண்ணப்பூச்சு திசையை மாற்றவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_weight_toggle_direction
msgid "Toggle Add/Subtract for the weight paint draw tool"
msgstr "எடை வண்ணப்பூச்சு டிரா கருவியைச் சேர்/கழித்தல் மாற்று"

#. :src: bpy.types.GREASE_PENCIL_OT_weightmode_toggle
msgctxt "Operator"
msgid "Strokes Weight Mode Toggle"
msgstr "எடை பயன்முறை மாற்றுகிறது"

#. :src: bpy.types.GREASE_PENCIL_OT_weightmode_toggle
msgid "Enter/Exit weight paint mode for Grease Pencil strokes"
msgstr ""
