#. :src: bpy.types.FreestyleLineStyle.sort_key:'DISTANCE_FROM_CAMERA'
msgid ""
"Sort by distance from camera (closer lines lie on top of further lines)"
msgstr ""
"கேமராவிலிருந்து தூரத்தை வரிசைப்படுத்துங்கள் (மேலும் கோடுகளின் மேல் "
"நெருக்கமான கோடுகள் உள்ளன)"

#. :src: bpy.types.FreestyleLineStyle.sort_key:'2D_LENGTH'
#: scripts/startup/bl_ui/properties_freestyle.py:612
msgid "2D Length"
msgstr "2 டி நீளம்"

#. :src: bpy.types.FreestyleLineStyle.sort_key:'2D_LENGTH'
msgid ""
"Sort by curvilinear 2D length (longer lines lie on top of shorter lines)"
msgstr ""
"கர்விலினியர் 2 டி நீளத்தால் வரிசைப்படுத்துங்கள் (நீண்ட கோடுகள் குறுகிய "
"கோடுகளின் மேல் உள்ளன)"

#. :src: bpy.types.FreestyleLineStyle.sort_key:'PROJECTED_X'
msgid "Projected X"
msgstr "திட்டமிடப்பட்ட ஃச்"

#. :src: bpy.types.FreestyleLineStyle.sort_key:'PROJECTED_X'
msgid "Sort by the projected X value in the image coordinate system"
msgstr ""
"பட ஒருங்கிணைப்பு அமைப்பில் திட்டமிடப்பட்ட ஃச் மதிப்பால் வரிசைப்படுத்தவும்"

#. :src: bpy.types.FreestyleLineStyle.sort_key:'PROJECTED_Y'
msgid "Projected Y"
msgstr "திட்டமிடப்பட்ட ஒய்"

#. :src: bpy.types.FreestyleLineStyle.sort_key:'PROJECTED_Y'
msgid "Sort by the projected Y value in the image coordinate system"
msgstr ""
"பட ஒருங்கிணைப்பு அமைப்பில் திட்டமிடப்பட்ட ஒய் மதிப்பால் வரிசைப்படுத்தவும்"

#. :src: bpy.types.FreestyleLineStyle.sort_order
#: scripts/startup/bl_ui/properties_freestyle.py:693
msgid "Sort Order"
msgstr "வரிசைப்படுத்தும் முறை"

#. :src: bpy.types.FreestyleLineStyle.sort_order
msgid "Select the sort order"
msgstr "வரிசை வரிசையைத் தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.FreestyleLineStyle.sort_order:'DEFAULT'
msgid "Default order of the sort key"
msgstr "வரிசை விசையின் இயல்புநிலை வரிசை"

#. :src: bpy.types.FreestyleLineStyle.sort_order:'REVERSE'
msgid "Reverse order"
msgstr "பின்னோக்கு வரிசை"

#. :src: bpy.types.FreestyleLineStyle.split_dash1
msgid "Split Dash 1"
msgstr "பிளவு கோடு 1"

#. :src: bpy.types.FreestyleLineStyle.split_dash1
msgid "Length of the 1st dash for splitting"
msgstr "பிரிப்பதற்கான 1 வது கோடின் நீளம்"

#. :src: bpy.types.FreestyleLineStyle.split_dash2
msgid "Split Dash 2"
msgstr "பிளவு கோடு 2"

#. :src: bpy.types.FreestyleLineStyle.split_dash2
msgid "Length of the 2nd dash for splitting"
msgstr "பிரிப்பதற்கான 2 வது கோடின் நீளம்"

#. :src: bpy.types.FreestyleLineStyle.split_dash3
msgid "Split Dash 3"
msgstr "பிளவு கோடு 3"

#. :src: bpy.types.FreestyleLineStyle.split_dash3
msgid "Length of the 3rd dash for splitting"
msgstr "பிரிப்பதற்கான 3 வது கோடின் நீளம்"

#. :src: bpy.types.FreestyleLineStyle.split_gap1
msgid "Split Gap 1"
msgstr "பிளவு இடைவெளி 1"

#. :src: bpy.types.FreestyleLineStyle.split_gap1
msgid "Length of the 1st gap for splitting"
msgstr "பிரிப்பதற்கான 1 வது இடைவெளியின் நீளம்"

#. :src: bpy.types.FreestyleLineStyle.split_gap2
msgid "Split Gap 2"
msgstr "பிளவு இடைவெளி 2"

#. :src: bpy.types.FreestyleLineStyle.split_gap2
msgid "Length of the 2nd gap for splitting"
msgstr "பிரிப்பதற்கான 2 வது இடைவெளியின் நீளம்"

#. :src: bpy.types.FreestyleLineStyle.split_gap3
msgid "Split Gap 3"
msgstr "பிளவு இடைவெளி 3"

#. :src: bpy.types.FreestyleLineStyle.split_gap3
msgid "Length of the 3rd gap for splitting"
msgstr "பிரிப்பதற்கான 3 வது இடைவெளியின் நீளம்"

#. :src: bpy.types.FreestyleLineStyle.split_length
msgid "Split Length"
msgstr "பிளவு நீளம்"

#. :src: bpy.types.FreestyleLineStyle.split_length
msgid "Curvilinear 2D length for chain splitting"
msgstr "சங்கிலி பிரிப்பதற்கான வளைவு 2 டி நீளம்"

#. :src: bpy.types.FreestyleLineStyle.texture_slots
#. :src: bpy.types.Material.texture_paint_slots
#. :src: bpy.types.ParticleSettings.texture_slots
msgid "Texture slots defining the mapping and influence of textures"
msgstr "அமைப்புகளின் மேப்பிங் மற்றும் செல்வாக்கை வரையறுக்கும் அமைப்பு இடங்கள்"

#. :src: bpy.types.FreestyleLineStyle.texture_spacing
msgid "Texture Spacing"
msgstr "அமைப்பு இடைவெளி"

#. :src: bpy.types.FreestyleLineStyle.texture_spacing
msgid "Spacing for textures along stroke length"
msgstr "வீச்சு நீளத்துடன் அமைப்புகளுக்கான இடைவெளி"

#. :src: bpy.types.FreestyleLineStyle.thickness
msgid "Base line thickness, possibly modified by line thickness modifiers"
msgstr ""
"அடிப்படை வரி தடிமன், வரி தடிமன் மாற்றியமைப்பாளர்களால் மாற்றியமைக்கப்படலாம்"

#. :src: bpy.types.FreestyleLineStyle.thickness_modifiers
#. :src: bpy.types.LineStyleThicknessModifiers
msgid "Thickness Modifiers"
msgstr "தடிமன் மாற்றியமைப்பாளர்கள்"

#. :src: bpy.types.FreestyleLineStyle.thickness_modifiers
msgid "List of line thickness modifiers"
msgstr "வரி தடிமன் மாற்றிகளின் பட்டியல்"

#. :src: bpy.types.FreestyleLineStyle.thickness_position
msgid "Thickness Position"
msgstr "தடிமன் நிலை"

#. :src: bpy.types.FreestyleLineStyle.thickness_position
msgid ""
"Thickness position of silhouettes and border edges (applicable when plain "
"chaining is used with the Same Object option)"
msgstr ""
"சில்அவுட்டுகள் மற்றும் எல்லை விளிம்புகளின் தடிமன் நிலை (அதே பொருள் "
"விருப்பத்துடன் வெற்று சங்கிலி பயன்படுத்தப்படும்போது பொருந்தும்)"

#. :src: bpy.types.FreestyleLineStyle.thickness_position:'CENTER'
msgid "Silhouettes and border edges are centered along stroke geometry"
msgstr ""
"நிழற்படங்கள் மற்றும் எல்லை விளிம்புகள் வீச்சு வடிவவியலுடன் மையமாக உள்ளன"

#. :src: bpy.types.FreestyleLineStyle.thickness_position:'INSIDE'
msgid "Silhouettes and border edges are drawn inside of stroke geometry"
msgstr ""
"வீச்சு வடிவவியலின் உள்ளே நிழற்படங்கள் மற்றும் எல்லை விளிம்புகள் "
"வரையப்படுகின்றன"

#. :src: bpy.types.FreestyleLineStyle.thickness_position:'OUTSIDE'
msgid "Silhouettes and border edges are drawn outside of stroke geometry"
msgstr ""
"வீச்சு வடிவவியலுக்கு வெளியே நிழற்படங்கள் மற்றும் எல்லை விளிம்புகள் "
"வரையப்படுகின்றன"

#. :src: bpy.types.FreestyleLineStyle.thickness_position:'RELATIVE'
msgid "Silhouettes and border edges are shifted by a user-defined ratio"
msgstr ""
"சில்அவுட்டுகள் மற்றும் எல்லை விளிம்புகள் பயனர் வரையறுக்கப்பட்ட விகிதத்தால் "
"மாற்றப்படுகின்றன"

#. :src: bpy.types.FreestyleLineStyle.thickness_ratio
msgid "Thickness Ratio"
msgstr "தடிமன் விகிதம்"

#. :src: bpy.types.FreestyleLineStyle.thickness_ratio
msgid ""
"A number between 0 (inside) and 1 (outside) specifying the relative position"
" of stroke thickness"
msgstr ""
"வீச்சு தடிமன் ஒப்பீட்டு நிலையைக் குறிக்கும் 0 (உள்ளே) மற்றும் 1 (வெளியே) "
"க்கு இடையில் ஒரு எண்"

#. :src: bpy.types.FreestyleLineStyle.use_angle_max
msgid "Use Max 2D Angle"
msgstr "அதிகபட்ச 2 டி கோணத்தைப் பயன்படுத்தவும்"

#. :src: bpy.types.FreestyleLineStyle.use_angle_max
msgid "Split chains at points with angles larger than the maximum 2D angle"
msgstr ""
"அதிகபட்ச 2 டி கோணத்தை விட பெரிய கோணங்களுடன் புள்ளிகளில் சங்கிலிகளைப் "
"பிரிக்கவும்"

#. :src: bpy.types.FreestyleLineStyle.use_angle_min
msgid "Use Min 2D Angle"
msgstr "மணித்துளி 2 டி கோணத்தைப் பயன்படுத்தவும்"

#. :src: bpy.types.FreestyleLineStyle.use_angle_min
msgid "Split chains at points with angles smaller than the minimum 2D angle"
msgstr ""
"குறைந்தபட்ச 2 டி கோணத்தை விட சிறிய கோணங்களுடன் புள்ளிகளில் சங்கிலிகளைப் "
"பிரிக்கவும்"

#. :src: bpy.types.FreestyleLineStyle.use_chain_count
msgid "Use Chain Count"
msgstr "சங்கிலி எண்ணிக்கையைப் பயன்படுத்தவும்"

#. :src: bpy.types.FreestyleLineStyle.use_chain_count
msgid "Enable the selection of first N chains"
msgstr "முதல் n சங்கிலிகளின் தேர்வை இயக்கவும்"

#. :src: bpy.types.FreestyleLineStyle.use_chaining
#. :src: bpy.types.VIEWLAYER_PT_freestyle_linestyle_strokes_chaining
#: source/blender/modifiers/intern/MOD_lineart.cc:731
msgid "Chaining"
msgstr "சங்கிலி"

#. :src: bpy.types.FreestyleLineStyle.use_chaining
msgid "Enable chaining of feature edges"
msgstr "அம்ச விளிம்புகளின் சங்கிலியை இயக்கவும்"

#. :src: bpy.types.FreestyleLineStyle.use_dashed_line
#. :src: bpy.types.VIEWLAYER_PT_freestyle_linestyle_strokes_dashedline
msgid "Dashed Line"
msgstr "கோடிட்ட வரி"

#. :src: bpy.types.FreestyleLineStyle.use_dashed_line
msgid "Enable or disable dashed line"
msgstr "கோடு கோட்டை இயக்கவும் அல்லது முடக்கவும்"

#. :src: bpy.types.FreestyleLineStyle.use_length_max
msgid "Use Max 2D Length"
msgstr "அதிகபட்சம் 2 டி நீளத்தைப் பயன்படுத்தவும்"

#. :src: bpy.types.FreestyleLineStyle.use_length_max
msgid "Enable the selection of chains by a maximum 2D length"
msgstr "அதிகபட்சம் 2 டி நீளத்தால் சங்கிலிகளைத் தேர்ந்தெடுப்பதை இயக்கவும்"

#. :src: bpy.types.FreestyleLineStyle.use_length_min
msgid "Use Min 2D Length"
msgstr "மணித்துளி 2 டி நீளத்தைப் பயன்படுத்தவும்"

#. :src: bpy.types.FreestyleLineStyle.use_length_min
msgid "Enable the selection of chains by a minimum 2D length"
msgstr "சங்கிலிகளைத் தேர்ந்தெடுப்பதை குறைந்தபட்சம் 2 டி நீளத்தால் இயக்கவும்"

#. :src: bpy.types.FreestyleLineStyle.use_nodes
#. :src: bpy.types.Light.use_nodes
#. :src: bpy.types.Material.use_nodes
#. :src: bpy.types.Texture.use_nodes
msgid "Use Nodes"
msgstr "முனைகளைப் பயன்படுத்துங்கள்"

#. :src: bpy.types.FreestyleLineStyle.use_nodes
msgid "Use shader nodes for the line style"
msgstr "வரி பாணிக்கு சேடர் முனைகளைப் பயன்படுத்தவும்"

#. :src: bpy.types.FreestyleLineStyle.use_same_object
msgid "Same Object"
msgstr "அதே பொருள்"

#. :src: bpy.types.FreestyleLineStyle.use_same_object
msgid "If true, only feature edges of the same object are joined"
msgstr ""
"உண்மை என்றால், அதே பொருளின் அம்ச விளிம்புகள் மட்டுமே இணைக்கப்படுகின்றன"

#. :src: bpy.types.FreestyleLineStyle.use_sorting
#. :src: bpy.types.VIEWLAYER_PT_freestyle_linestyle_strokes_sorting
msgid "Sorting"
msgstr "வரிசைப்படுத்துதல்"

#. :src: bpy.types.FreestyleLineStyle.use_sorting
msgid "Arrange the stacking order of strokes"
msgstr "வீச்சுகள் அடுக்கி வைக்கும் வரிசையை ஏற்பாடு செய்யுங்கள்"

#. :src: bpy.types.FreestyleLineStyle.use_split_length
msgid "Use Split Length"
msgstr "பிளவு நீளத்தைப் பயன்படுத்தவும்"

#. :src: bpy.types.FreestyleLineStyle.use_split_length
msgid "Enable chain splitting by curvilinear 2D length"
msgstr "வளைவு 2 டி நீளத்தால் சங்கிலி பிளவுகளை இயக்கவும்"

#. :src: bpy.types.FreestyleLineStyle.use_split_pattern
msgid "Use Split Pattern"
msgstr "பிளவு வடிவத்தைப் பயன்படுத்தவும்"

#. :src: bpy.types.FreestyleLineStyle.use_split_pattern
msgid "Enable chain splitting by dashed line patterns"
msgstr "கோடுள்ள வரி வடிவங்களால் சங்கிலி பிளவுகளை இயக்கவும்"

#. :src: bpy.types.FreestyleLineStyle.use_texture
msgid "Use Textures"
msgstr "அமைப்புகளைப் பயன்படுத்துங்கள்"

#. :src: bpy.types.FreestyleLineStyle.use_texture
msgid "Enable or disable textured strokes"
msgstr "கடினமான வீச்சுகள் இயக்கவும் அல்லது முடக்கவும்"

#. :src: bpy.types.GreasePencilv3
msgid "Grease Pencil data-block"
msgstr "பசை எழுதுகோல் தரவு-தொகுதி"

#. :src: bpy.types.GreasePencilv3.ghost_after_range
msgid ""
"Maximum number of frames to show after current frame (0 = don't show any "
"frames after current)"
msgstr ""
"தற்போதைய சட்டகத்திற்குப் பிறகு காண்பிக்க அதிகபட்ச பிரேம்கள் (0 = "
"மின்னோட்டத்திற்குப் பிறகு எந்த பிரேம்களையும் காட்ட வேண்டாம்)"

#. :src: bpy.types.GreasePencilv3.ghost_before_range
msgid ""
"Maximum number of frames to show before current frame (0 = don't show any "
"frames before current)"
msgstr ""
"தற்போதைய சட்டகத்திற்கு முன் காட்ட அதிகபட்ச பிரேம்களின் எண்ணிக்கை (0 = "
"மின்னோட்டத்திற்கு முன் எந்த பிரேம்களையும் காட்ட வேண்டாம்)"

#. :src: bpy.types.GreasePencilv3.layer_groups
msgid "Layer Groups"
msgstr "அடுக்கு குழுக்கள்"

#. :src: bpy.types.GreasePencilv3.layer_groups
msgid "Grease Pencil layer groups"
msgstr "கிரீச் பென்சில் அடுக்கு குழுக்கள்"

#. :src: bpy.types.GreasePencilv3.layers
msgid "Grease Pencil layers"
msgstr "கிரீச் பென்சில் அடுக்குகள்"

#. :src: bpy.types.GreasePencilv3.onion_factor
msgid "Onion Opacity"
msgstr "வெங்காய ஒளிபுகாநிலை"

#. :src: bpy.types.GreasePencilv3.onion_factor
msgid "Change fade opacity of displayed onion frames"
msgstr "காட்டப்பட்ட வெங்காய பிரேம்களின் மங்கலான ஒளிபுகாநிலையை மாற்றவும்"

#. :src: bpy.types.GreasePencilv3.onion_keyframe_type
msgctxt "GPencil"
msgid "Filter by Type"
msgstr "வகை மூலம் வடிகட்டவும்"

#. :src: bpy.types.GreasePencilv3.onion_keyframe_type
msgid "Type of keyframe (for filtering)"
msgstr "கீஃப்ரேமின் வகை (வடிகட்டுவதற்கு)"

#. :src: bpy.types.GreasePencilv3.onion_keyframe_type:'ALL'
msgctxt "GPencil"
msgid "All"
msgstr "அனைத்தும்"

#. :src: bpy.types.GreasePencilv3.onion_keyframe_type:'ALL'
msgid "Include all Keyframe types"
msgstr "அனைத்து கீஃப்ரேம் வகைகளையும் சேர்க்கவும்"

#. :src: bpy.types.GreasePencilv3.onion_mode
msgid "Mode to display frames"
msgstr "பிரேம்களைக் காண்பிப்பதற்கான பயன்முறை"

#. :src: bpy.types.GreasePencilv3.onion_mode:'ABSOLUTE'
msgid "Frames in absolute range of the scene frame"
msgstr "காட்சி சட்டத்தின் முழுமையான வரம்பில் பிரேம்கள்"

#. :src: bpy.types.GreasePencilv3.onion_mode:'RELATIVE'
msgid "Frames in relative range of the Grease Pencil keyframes"
msgstr "பசை எழுதுகோல் கீஃப்ரேம்களின் ஒப்பீட்டு வரம்பில் பிரேம்கள்"

