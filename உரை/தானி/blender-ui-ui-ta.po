#. :src: bpy.types.GREASE_PENCIL_OT_frame_clean_duplicate.selected
msgid "Only delete selected keyframes"
msgstr "தேர்ந்தெடுக்கப்பட்ட கீஃப்ரேம்களை மட்டுமே நீக்கு"

#. :src: bpy.types.GREASE_PENCIL_OT_frame_duplicate
msgctxt "Operator"
