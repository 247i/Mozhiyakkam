#: source/blender/editors/space_info/info_stats.cc:839
#: source/blender/modifiers/intern/MOD_particleinstance.cc:632
#: source/blender/nodes/composite/nodes/node_composite_file_output.cc:359
msgid "Layers"
msgstr "அடுக்குகள்"

#. :src: bpy.types.Action.layers
msgid "The list of layers that make up this Action"
msgstr "இந்த செயலை உருவாக்கும் அடுக்குகளின் பட்டியல்"

#. :src: bpy.types.Action.pose_markers
msgid "Pose Markers"
msgstr "குறிப்பான்கள் போச்"

#. :src: bpy.types.Action.pose_markers
msgid "Markers specific to this action, for labeling poses"
msgstr "இந்த செயலுக்கு குறிப்பிட்ட குறிப்பான்கள், போச்களை லேபிளிடுவதற்கு"

#. :src: bpy.types.Action.slots
msgid "The list of slots in this Action"
msgstr "இந்த செயலில் இடங்களின் பட்டியல்"

#. :src: bpy.types.Action.use_cyclic
msgid "Cyclic Animation"
msgstr "சுழற்சி அனிமேசன்"

#. :src: bpy.types.Action.use_cyclic
msgid ""
"The action is intended to be used as a cycle looping over its manually set "
"playback frame range (enabling this doesn't automatically make it loop)"
msgstr ""
"இந்த நடவடிக்கை அதன் கைமுறையாக அமைக்கப்பட்ட பிளேபேக் பிரேம் வரம்பைக் "
"காட்டிலும் சுழற்சியாகப் பயன்படுத்தப்பட வேண்டும் (இது தானாகவே அதை சுழற்றாது)"

#. :src: bpy.types.Action.use_frame_range
msgid "Manual Frame Range"
msgstr "கையேடு பிரேம் வரம்பு"

#. :src: bpy.types.Action.use_frame_range
msgid ""
"Manually specify the intended playback frame range for the action (this "
"range is used by some tools, but does not affect animation evaluation)"
msgstr ""
"செயலுக்கான நோக்கம் கொண்ட பிளேபேக் பிரேம் வரம்பை கைமுறையாகக் குறிப்பிடவும் "
"(இந்த வரம்பு சில கருவிகளால் பயன்படுத்தப்படுகிறது, ஆனால் அனிமேசன் மதிப்பீட்டை"
" பாதிக்காது)"

#. :src: bpy.types.Annotation
msgid "Freehand annotation sketchbook"
msgstr "ஃப்ரீஏண்ட் சிறுகுறிப்பு ச்கெட்ச்புக்"

