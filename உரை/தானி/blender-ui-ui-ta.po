msgstr "அதன் பெற்றோர் குழுவில் உருப்படியின் நிலை"

#. :src: bpy.types.NodeTreeInterfacePanel
msgid "Declaration of a node panel"
msgstr "ஒரு முனை குழுவின் அறிவிப்பு"

#. :src: bpy.types.NodeTreeInterfacePanel.default_closed
msgid "Default Closed"
msgstr "இயல்புநிலை மூடப்பட்டது"

#. :src: bpy.types.NodeTreeInterfacePanel.default_closed
msgid "Panel is closed by default on new nodes"
msgstr "புதிய முனைகளில் இயல்புநிலையாக குழு மூடப்பட்டுள்ளது"

#. :src: bpy.types.NodeTreeInterfacePanel.description
msgid "Panel description"
msgstr "குழு விளக்கம்"

#. :src: bpy.types.NodeTreeInterfacePanel.interface_items
msgid "Items in the node panel"
msgstr "முனை பேனலில் உள்ள உருப்படிகள்"

#. :src: bpy.types.NodeTreeInterfacePanel.name
msgid "Panel name"
msgstr "குழு பெயர்"

#. :src: bpy.types.NodeTreeInterfacePanel.persistent_uid
msgid "Persistent Identifier"
msgstr "தொடர்ச்சியான அடையாளங்காட்டி"

#. :src: bpy.types.NodeTreeInterfacePanel.persistent_uid
msgid "Unique identifier for this panel within this node tree"
msgstr "இந்த முனை மரத்திற்குள் இந்த பேனலுக்கான தனிப்பட்ட அடையாளங்காட்டி"

#. :src: bpy.types.NodeTreeInterfaceSocket
msgid "Node Tree Interface Socket"
msgstr "முனை மர இடைமுக சாக்கெட்"

#. :src: bpy.types.NodeTreeInterfaceSocket
msgid "Declaration of a node socket"
msgstr "ஒரு முனை சாக்கெட் அறிவிப்பு"

#. :src: bpy.types.NodeTreeInterfaceSocket.attribute_domain
msgid ""
"Attribute domain used by the geometry nodes modifier to create an attribute "
"output"
msgstr ""
"பண்புக்கூறு வெளியீட்டை உருவாக்க வடிவியல் முனைகள் மாற்றியமைப்பாளரால் "
"பயன்படுத்தப்படும் பண்புக்கூறு டொமைன்"

#. :src: bpy.types.NodeTreeInterfaceSocket.bl_socket_idname
msgid "Socket Type Name"
msgstr "சாக்கெட் வகை பெயர்"

#. :src: bpy.types.NodeTreeInterfaceSocket.bl_socket_idname
msgid "Name of the socket type"
msgstr "சாக்கெட் வகையின் பெயர்"

#. :src: bpy.types.NodeTreeInterfaceSocket.default_attribute_name
msgid "Default Attribute"
msgstr "இயல்புநிலை பண்புக்கூறு"

#. :src: bpy.types.NodeTreeInterfaceSocket.default_attribute_name
msgid ""
"The attribute name used by default when the node group is used by a geometry"
" nodes modifier"
msgstr ""
"நெட் குழு ஒரு வடிவியல் முனைகள் மாற்றியமைப்பாளரால் பயன்படுத்தப்படும்போது "
"இயல்புநிலையாகப் பயன்படுத்தப்படும் பண்புக்கூறு பெயர்"

#. :src: bpy.types.NodeTreeInterfaceSocket.default_input
msgid "Default Input"
msgstr "இயல்புநிலை உள்ளீடு"

#. :src: bpy.types.NodeTreeInterfaceSocket.default_input
msgid "Input to use when the socket is unconnected. Requires \"Hide Value\"."
msgstr "சாக்கெட் இணைக்கப்படும்போது பயன்படுத்த உள்ளீடு. \"மதிப்பை மறை\" தேவை."

#. :src: bpy.types.NodeTreeInterfaceSocket.default_input:'VALUE'
msgid "The node socket's default value"
msgstr "முனை சாக்கெட்டின் இயல்புநிலை மதிப்பு"

#. :src: bpy.types.NodeTreeInterfaceSocket.default_input:'INDEX'
msgid "The index from the context"
msgstr "சூழலில் இருந்து குறியீடு"

#. :src: bpy.types.NodeTreeInterfaceSocket.default_input:'ID_OR_INDEX'
msgid "ID or Index"
msgstr "ஐடி அல்லது குறியீட்டு"

#. :src: bpy.types.NodeTreeInterfaceSocket.default_input:'ID_OR_INDEX'
msgid "The \"id\" attribute if available, otherwise the index"
msgstr "கிடைத்தால் \"ஐடி\" பண்புக்கூறு, இல்லையெனில் குறியீடு"

#. :src: bpy.types.NodeTreeInterfaceSocket.default_input:'NORMAL'
msgid "The geometry's normal direction"
msgstr "வடிவவியலின் இயல்பான திசை"

#. :src: bpy.types.NodeTreeInterfaceSocket.default_input:'POSITION'
msgid "The position from the context"
msgstr "சூழலில் இருந்து நிலை"

#. :src: bpy.types.NodeTreeInterfaceSocket.default_input:'INSTANCE_TRANSFORM'
msgid "Transformation of each instance from the geometry context"
msgstr "வடிவியல் சூழலில் இருந்து ஒவ்வொரு நிகழ்வின் மாற்றமும்"

#. :src: bpy.types.NodeTreeInterfaceSocket.default_input:'HANDLE_LEFT'
msgid "The left Bezier control point handle from the context"
msgstr "சூழலில் இருந்து இடது பெசியர் கட்டுப்பாட்டு புள்ளி கைப்பிடி"

#. :src: bpy.types.NodeTreeInterfaceSocket.default_input:'HANDLE_RIGHT'
msgid "The right Bezier control point handle from the context"
msgstr "சூழலில் இருந்து சரியான பெசியர் கட்டுப்பாட்டு புள்ளி கைப்பிடி"

#. :src: bpy.types.NodeTreeInterfaceSocket.description
msgid "Socket description"
msgstr "சாக்கெட் விளக்கம்"

#. :src: bpy.types.NodeTreeInterfaceSocket.force_non_field
#: source/blender/editors/space_node/node_socket_tooltip.cc:824
msgid "Single Value"
msgstr "ஒற்றை மதிப்பு"

#. :src: bpy.types.NodeTreeInterfaceSocket.force_non_field
msgid ""
"Only allow single value inputs rather than field.\n"
"Deprecated. Will be remove in 5.0."
msgstr ""
"புலத்தை விட ஒற்றை மதிப்பு உள்ளீடுகளை மட்டுமே அனுமதிக்கவும். \n"
"மதிப்பிடப்பட்டது. 5.0 இல் அகற்றப்படும்."

#. :src: bpy.types.NodeTreeInterfaceSocket.hide_in_modifier
msgid "Hide in Modifier"
msgstr "மாற்றியமைப்பில் மறைக்கவும்"

#. :src: bpy.types.NodeTreeInterfaceSocket.hide_in_modifier
msgid "Don't show the input value in the geometry nodes modifier interface"
msgstr ""
"வடிவியல் முனைகள் மாற்றியமைக்கும் இடைமுகத்தில் உள்ளீட்டு மதிப்பைக் காட்ட "
"வேண்டாம்"

#. :src: bpy.types.NodeTreeInterfaceSocket.hide_value
msgid "Hide the socket input value even when the socket is not connected"
msgstr "சாக்கெட் இணைக்கப்படாதபோது கூட சாக்கெட் உள்ளீட்டு மதிப்பை மறைக்கவும்"

#. :src: bpy.types.NodeTreeInterfaceSocket.in_out
msgid "Input/Output Type"
msgstr "உள்ளீடு/வெளியீட்டு வகை"

#. :src: bpy.types.NodeTreeInterfaceSocket.in_out
msgid "Input or output socket type"
msgstr "உள்ளீடு அல்லது வெளியீட்டு சாக்கெட் வகை"

#. :src: bpy.types.NodeTreeInterfaceSocket.in_out:'INPUT'
msgid "Generate a input node socket"
msgstr "உள்ளீட்டு முனை சாக்கெட்டை உருவாக்கவும்"

#. :src: bpy.types.NodeTreeInterfaceSocket.in_out:'OUTPUT'
msgid "Generate a output node socket"
msgstr "வெளியீட்டு முனை சாக்கெட்டை உருவாக்கவும்"

#. :src: bpy.types.NodeTreeInterfaceSocket.is_inspect_output
msgid "Is Inspect Output"
msgstr "வெளியீட்டை ஆய்வு செய்யுங்கள்"

#. :src: bpy.types.NodeTreeInterfaceSocket.is_inspect_output
msgid "Take link out of node group to connect to root tree output node"
msgstr ""
"ரூட் மர வெளியீட்டு முனையுடன் இணைக்க முனை குழுவிலிருந்து இணைப்பை எடுத்துக் "
"கொள்ளுங்கள்"

#. :src: bpy.types.NodeTreeInterfaceSocket.is_panel_toggle
msgid "Is Panel Toggle"
msgstr "பேனல் மாற்று"

#. :src: bpy.types.NodeTreeInterfaceSocket.is_panel_toggle
msgid "This socket is meant to be used as the toggle in its panel header"
msgstr "இந்த சாக்கெட் அதன் பேனல் தலைப்பில் மாற்றமாக பயன்படுத்தப்பட வேண்டும்"

#. :src: bpy.types.NodeTreeInterfaceSocket.layer_selection_field
#: source/blender/modifiers/intern/MOD_datatransfer.cc:269
#: source/blender/modifiers/intern/MOD_datatransfer.cc:333
#: source/blender/modifiers/intern/MOD_datatransfer.cc:350
#: source/blender/modifiers/intern/MOD_datatransfer.cc:365
msgid "Layer Selection"
msgstr "அடுக்கு தேர்வு"

#. :src: bpy.types.NodeTreeInterfaceSocket.layer_selection_field
msgid "Take Grease Pencil Layer or Layer Group as selection field"
msgstr ""
"பசை எழுதுகோல் அடுக்கு அல்லது அடுக்கு குழுவை தேர்வு புலமாக எடுத்துக் "
"கொள்ளுங்கள்"

#. :src: bpy.types.NodeTreeInterfaceSocket.menu_expanded
msgid "Menu Expanded"
msgstr "பட்டியல் விரிவாக்கப்பட்டது"

#. :src: bpy.types.NodeTreeInterfaceSocket.menu_expanded
msgid "Draw the menu socket as an expanded drop-down menu"
msgstr "விரிவாக்கப்பட்ட கீழ்தோன்றும் மெனுவாக பட்டியல் சாக்கெட்டை வரையவும்"

#. :src: bpy.types.NodeTreeInterfaceSocket.socket_type
msgid "Type of the socket generated by this interface item"
msgstr "இந்த இடைமுக உருப்படியால் உருவாக்கப்பட்ட சாக்கெட் வகை"

#. :src: bpy.types.NodeTreeInterfaceSocketBool
msgid "Boolean Node Socket Interface"
msgstr "பூலியன் முனை சாக்கெட் இடைமுகம்"

#. :src: bpy.types.NodeTreeInterfaceSocketBundle
msgid "Bundle Node Socket Interface"
msgstr "மூட்டை முனை சாக்கெட் இடைமுகம்"

#. :src: bpy.types.NodeTreeInterfaceSocketClosure
msgid "Closure Node Socket Interface"
msgstr "மூடல் முனை சாக்கெட் இடைமுகம்"

#. :src: bpy.types.NodeTreeInterfaceSocketCollection
msgid "Collection Node Socket Interface"
msgstr "சேகரிப்பு முனை சாக்கெட் இடைமுகம்"

#. :src: bpy.types.NodeTreeInterfaceSocketColor
msgid "Color Node Socket Interface"
msgstr "வண்ண முனை சாக்கெட் இடைமுகம்"

