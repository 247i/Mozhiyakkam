msgid "Simple interpolation between adjacent pixels"
msgstr "அருகிலுள்ள பிக்சல்களுக்கு இடையில் எளிய இடைக்கணிப்பு"

#. :src: bpy.types.MovieTrackingStabilization.filter_type:'BICUBIC'
#. :src: bpy.types.CompositorNodeCornerPin.interpolation:'BICUBIC'
