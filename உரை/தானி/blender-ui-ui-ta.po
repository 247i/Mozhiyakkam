msgstr "%s ' %s' ஐப் படிக்க முடியாது: %s"

#: source/blender/windowmanager/intern/wm_operators.cc:1376
msgid "%s '%s' not found"
msgstr "%s '%s' காணப்படவில்லை"

#: source/blender/windowmanager/intern/wm_operators.cc:1381
