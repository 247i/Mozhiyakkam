msgid "Fill the ripped region"
msgstr "கிழிந்த மண்டலத்தை நிரப்பவும்"

#. :src: bpy.types.MESH_OT_rip_edge
#. :src: bpy.types.MESH_OT_rip_edge_move
msgctxt "Operator"
msgid "Extend Vertices"
msgstr "செங்குத்துகளை நீட்டிக்கவும்"

