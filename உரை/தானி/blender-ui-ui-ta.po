#. :src: bpy.types.Material.refraction_depth
msgid "Refraction Depth"
msgstr "ஒளிவிலகல் ஆழம்"

#. :src: bpy.types.Material.refraction_depth
msgid ""
"Approximate the thickness of the object to compute two refraction events (0 "
"is disabled) (Deprecated)"
msgstr ""
"இரண்டு ஒளிவிலகல் நிகழ்வுகளை கணக்கிட பொருளின் தடிமன் தோராயமாக (0 "
"முடக்கப்பட்டுள்ளது) (நீக்கப்பட்டது)"

#. :src: bpy.types.Material.roughness
msgid "Roughness of the material"
msgstr "மூலப்பொருளின் கடினத்தன்மை"

#. :src: bpy.types.Material.show_transparent_back
#. :src: bpy.types.IMAGE_OT_convert_to_mesh_plane.show_transparent_back
#. :src: bpy.types.IMAGE_OT_import_as_mesh_planes.show_transparent_back
msgid "Show Backface"
msgstr "பேக்ஃபேசைக் காட்டு"

#. :src: bpy.types.Material.show_transparent_back
msgid ""
"Render multiple transparent layers (may introduce transparency sorting "
"problems) (Deprecated: use 'use_tranparency_overlap')"
msgstr ""
"பல வெளிப்படையான அடுக்குகளை வழங்கவும் (வெளிப்படைத்தன்மை வரிசையாக்க சிக்கல்களை"
" அறிமுகப்படுத்தலாம்) (நீக்கப்பட்டது: 'USE_TRANPARENCY_OVERLAP' ஐப் "
"பயன்படுத்தவும்)"

#. :src: bpy.types.Material.specular_color
#. :src: bpy.types.LineStyleAlphaModifier_Material.material_attribute:'SPEC'
#. :src: bpy.types.LineStyleColorModifier_Material.material_attribute:'SPEC'
#. :src:
#. bpy.types.LineStyleThicknessModifier_Material.material_attribute:'SPEC'
#. :src: bpy.types.UserSolidLight.specular_color
msgid "Specular Color"
msgstr "ஏகப்பட்ட நிறம்"

#. :src: bpy.types.Material.specular_color
msgid "Specular color of the material"
msgstr "மூலப்பொருளின் ஏகப்பட்ட நிறம்"

#. :src: bpy.types.Material.specular_intensity
#. :src: bpy.types.NWPrincipledPreferences.specular
#: scripts/startup/bl_ui/properties_material.py:180
#: scripts/startup/bl_ui/properties_view_layer.py:128
#: scripts/startup/bl_ui/space_userpref.py:2775
#: source/blender/nodes/shader/nodes/node_shader_bsdf_principled.cc:132
#: source/blender/nodes/shader/nodes/node_shader_eevee_specular.cc:11
msgid "Specular"
msgstr "மென்"

#. :src: bpy.types.Material.specular_intensity
msgid "How intense (bright) the specular reflection is"
msgstr "ஏகப்பட்ட பிரதிபலிப்பு எவ்வளவு தீவிரமானது (பிரகாசமானது)"

#. :src: bpy.types.Material.surface_render_method
msgid "Surface Render Method"
msgstr "மேற்பரப்பு வழங்கல் முறை"

#. :src: bpy.types.Material.surface_render_method
msgid "Controls the blending and the compatibility with certain features"
msgstr ""
"கலப்பு மற்றும் சில அம்சங்களுடன் பொருந்தக்கூடிய தன்மையைக் கட்டுப்படுத்துகிறது"

#. :src: bpy.types.Material.surface_render_method:'DITHERED'
#. :src: bpy.types.IMAGE_OT_convert_to_mesh_plane.render_method:'DITHERED'
#. :src: bpy.types.IMAGE_OT_import_as_mesh_planes.render_method:'DITHERED'
msgid "Dithered"
msgstr "டைவ்"

#. :src: bpy.types.Material.surface_render_method:'DITHERED'
msgid ""
"Allows for grayscale hashed transparency, and compatible with render passes "
"and raytracing. Also known as deferred rendering."
msgstr ""
"கிரேச்கேல் ஆசெட் வெளிப்படைத்தன்மையை அனுமதிக்கிறது, மேலும் வழங்குதல் பாச்கள் "
"மற்றும் ரேட்ரேசிங்குடன் இணக்கமானது. ஒத்திவைக்கப்பட்ட வழங்குதல் என்றும் "
"அழைக்கப்படுகிறது."

#. :src: bpy.types.Material.surface_render_method:'BLENDED'
#. :src: bpy.types.IMAGE_OT_convert_to_mesh_plane.render_method:'BLENDED'
#. :src: bpy.types.IMAGE_OT_import_as_mesh_planes.render_method:'BLENDED'
msgid "Blended"
msgstr "கலக்கப்பட்டது"

#. :src: bpy.types.Material.surface_render_method:'BLENDED'
msgid ""
"Allows for colored transparency, but incompatible with render passes and "
"raytracing. Also known as forward rendering."
msgstr ""
"வண்ண வெளிப்படைத்தன்மையை அனுமதிக்கிறது, ஆனால் வழங்குதல் பாச்கள் மற்றும் "
"ரேட்ரேசிங்குடன் பொருந்தாது. முன்னோக்கி வழங்குதல் என்றும் அழைக்கப்படுகிறது."

#. :src: bpy.types.Material.texture_paint_images
msgid "Texture Slot Images"
msgstr "அமைப்பு ச்லாட் படங்கள்"

#. :src: bpy.types.Material.texture_paint_images
msgid "Texture images used for texture painting"
msgstr "அமைப்பு ஓவியத்திற்கு பயன்படுத்தப்படும் அமைப்பு படங்கள்"

#. :src: bpy.types.Material.texture_paint_slots
#. :src: bpy.types.LineStyleTextureSlots
#. :src: bpy.types.VIEW3D_PT_slots_projectpaint
#. :src: bpy.types.ParticleSettingsTextureSlots
#: scripts/startup/bl_ui/space_view3d_toolbar.py:572
msgid "Texture Slots"
msgstr "அமைப்பு இடங்கள்"

#. :src: bpy.types.Material.thickness_mode
#. :src: bpy.types.SolidifyModifier.nonmanifold_thickness_mode
#: source/blender/modifiers/intern/MOD_solidify.cc:88
msgid "Thickness Mode"
msgstr "தடிமன் பயன்முறை"

#. :src: bpy.types.Material.thickness_mode
msgid "Approximation used to model the light interactions inside the object"
msgstr ""
"பொருளின் உள்ளே ஒளி இடைவினைகளை மாதிரியாகப் பயன்படுத்த பயன்படும் தோராயம்"

#. :src: bpy.types.Material.thickness_mode:'SPHERE'
msgid ""
"Approximate the object as a sphere whose diameter is equal to the thickness "
"defined by the node tree"
msgstr ""
"முனை மரத்தால் வரையறுக்கப்பட்ட தடிமன் சமமாக இருக்கும் ஒரு கோளமாக பொருளை "
"தோராயமாக மதிப்பிடுங்கள்"

#. :src: bpy.types.Material.thickness_mode:'SLAB'
msgid "Slab"
msgstr "ச்லாப்"

#. :src: bpy.types.Material.thickness_mode:'SLAB'
msgid ""
"Approximate the object as an infinite slab of thickness defined by the node "
"tree"
msgstr ""
"முனை மரத்தால் வரையறுக்கப்பட்ட தடிமன் எல்லையற்ற அடுக்காக பொருளை தோராயமாக "
"மதிப்பிடுங்கள்"

#. :src: bpy.types.Material.use_backface_culling
#. :src: bpy.types.IMAGE_OT_convert_to_mesh_plane.use_backface_culling
#. :src: bpy.types.IMAGE_OT_import_as_mesh_planes.use_backface_culling
#. :src: bpy.types.ToolSettings.use_snap_backface_culling
#. :src: bpy.types.View3DShading.show_backface_culling
#: scripts/startup/bl_ui/properties_material.py:253
#: scripts/startup/bl_ui/space_view3d_toolbar.py:1402
msgid "Backface Culling"
msgstr "பேக்ஃபேச் கலிங்"

#. :src: bpy.types.Material.use_backface_culling
#. :src: bpy.types.View3DShading.show_backface_culling
msgid "Use back face culling to hide the back side of faces"
msgstr "முகங்களின் பின்புறத்தை மறைக்க பின்புற முகத்தை பயன்படுத்தவும்"

#. :src: bpy.types.Material.use_backface_culling_lightprobe_volume
msgid "Light Probe Volume Backface Culling"
msgstr "ஒளி ஆய்வு தொகுதி பேக்ஃபேச் குறைத்தல்"

#. :src: bpy.types.Material.use_backface_culling_lightprobe_volume
msgid ""
"Consider material single sided for light probe volume capture. Additionally "
"helps rejecting probes inside the object to avoid light leaks."
msgstr ""
"ஒளி ஆய்வு தொகுதி பிடிப்புக்கு பொருள் ஒற்றை பக்கத்தைக் கவனியுங்கள். கூடுதலாக "
"ஒளி கசிவைத் தவிர்க்க பொருளுக்குள் ஆய்வுகளை நிராகரிக்க உதவுகிறது."

#. :src: bpy.types.Material.use_backface_culling_shadow
msgid "Shadow Backface Culling"
msgstr "நிழல் பேக்ஃபேச் குறைத்தல்"

#. :src: bpy.types.Material.use_backface_culling_shadow
msgid "Use back face culling when casting shadows"
msgstr "நிழல்களை அனுப்பும்போது முகம் வெட்டுவதை பின்புறமாகப் பயன்படுத்துங்கள்"

#. :src: bpy.types.Material.use_nodes
msgid "Use shader nodes to render the material"
msgstr "மூலப்பொருளை வழங்க சேடர் முனைகளைப் பயன்படுத்தவும்"

#. :src: bpy.types.Material.use_preview_world
msgid "Preview World"
msgstr "முன்னோட்டம் உலகம்"

#. :src: bpy.types.Material.use_preview_world
msgid "Use the current world background to light the preview render"
msgstr ""
"முன்னோட்ட ரெண்டரை ஒளிரச் செய்ய தற்போதைய உலக பின்னணியைப் பயன்படுத்தவும்"

#. :src: bpy.types.Material.use_raytrace_refraction
#. :src: bpy.types.Material.use_screen_refraction
msgid "Raytrace Transmission"
msgstr "ரேட்ரேச் பரிமாற்றம்"

#. :src: bpy.types.Material.use_raytrace_refraction
msgid ""
"Use raytracing to determine transmitted color instead of using only light "
"probes. This prevents the surface from contributing to the lighting of "
"surfaces not using this setting."
msgstr ""
"ஒளி ஆய்வுகளை மட்டுமே பயன்படுத்துவதற்குப் பதிலாக கடத்தப்பட்ட வண்ணத்தைத் "
"தீர்மானிக்க ரேட்ரேசிங்கைப் பயன்படுத்தவும். இந்த அமைப்பைப் பயன்படுத்தாத "
"மேற்பரப்புகளின் விளக்குகளுக்கு மேற்பரப்பு பங்களிப்பதை இது தடுக்கிறது."

#. :src: bpy.types.Material.use_screen_refraction
msgid ""
"Use raytracing to determine transmitted color instead of using only light "
"probes. This prevents the surface from contributing to the lighting of "
"surfaces not using this setting. Deprecated: use 'use_raytrace_refraction'."
msgstr ""
"ஒளி ஆய்வுகளை மட்டுமே பயன்படுத்துவதற்குப் பதிலாக கடத்தப்பட்ட வண்ணத்தைத் "
"தீர்மானிக்க ரேட்ரேசிங்கைப் பயன்படுத்தவும். இந்த அமைப்பைப் பயன்படுத்தாத "
"மேற்பரப்புகளின் விளக்குகளுக்கு மேற்பரப்பு பங்களிப்பதை இது தடுக்கிறது. "
"நீக்கப்பட்டது: 'USE_RAYTRACE_REFRACTION' ஐப் பயன்படுத்தவும்."

#. :src: bpy.types.Material.use_sss_translucency
msgid "Subsurface Translucency"
msgstr "மேற்பரப்பு ஒளிஊடுருவல்"

#. :src: bpy.types.Material.use_sss_translucency
msgid "Add translucency effect to subsurface (Deprecated)"
msgstr ""
"மேற்பரப்புக்கு (நீக்கப்பட்ட) ஒளிஊடுருவல் விளைவைச் சேர்க்கவும் "
"(நீக்கப்பட்டது)"

#. :src: bpy.types.Material.use_thickness_from_shadow
msgid "Thickness From Shadow"
msgstr "நிழலில் இருந்து தடிமன்"

#. :src: bpy.types.Material.use_thickness_from_shadow
msgid ""
"Use the shadow maps from shadow casting lights to refine the thickness "
"defined by the material node tree"
msgstr ""
"பொருள் முனை மரத்தால் வரையறுக்கப்பட்ட தடிமன் செம்மைப்படுத்த நிழல் வார்ப்பு "
"விளக்குகளிலிருந்து நிழல் வரைபடங்களைப் பயன்படுத்தவும்"

#. :src: bpy.types.Material.use_transparency_overlap
msgid "Use Transparency Overlap"
msgstr "வெளிப்படைத்தன்மை ஒன்றுடன் ஒன்று பயன்படுத்தவும்"

#. :src: bpy.types.Material.use_transparency_overlap
#. :src: bpy.types.IMAGE_OT_convert_to_mesh_plane.show_transparent_back
#. :src: bpy.types.IMAGE_OT_import_as_mesh_planes.show_transparent_back
msgid ""
"Render multiple transparent layers (may introduce transparency sorting "
"problems)"
msgstr ""
"பல வெளிப்படையான அடுக்குகளை வழங்கவும் (வெளிப்படைத்தன்மை வரிசையாக்க சிக்கல்களை"
" அறிமுகப்படுத்தலாம்)"

#. :src: bpy.types.Material.use_transparent_shadow
msgid "Transparent Shadows"
msgstr "வெளிப்படையான நிழல்கள்"

#. :src: bpy.types.Material.use_transparent_shadow
msgid ""
"Use transparent shadows for this material if it contains a Transparent BSDF,"
" disabling will render faster but not give accurate shadows"
msgstr ""
"இந்த மூலப்பொருள் வெளிப்படையான பி.எச்.டி.எஃப் இருந்தால் வெளிப்படையான "
"நிழல்களைப் பயன்படுத்துங்கள், முடக்குவது வேகமாக வழங்கப்படும், ஆனால் "
"துல்லியமான நிழல்களைக் கொடுக்காது"

#. :src: bpy.types.Material.volume_intersection_method
msgid "Volume Intersection Method"
msgstr "தொகுதி குறுக்குவெட்டு முறை"

#. :src: bpy.types.Material.volume_intersection_method
msgid "Determines which inner part of the mesh will produce volumetric effect"
msgstr ""
"கண்ணி எந்த உள் பகுதி அளவீட்டு விளைவை உருவாக்கும் என்பதை தீர்மானிக்கிறது"

#. :src: bpy.types.Material.volume_intersection_method:'FAST'
#. :src: bpy.types.MetaBall.update_method:'FAST'
#. :src: bpy.types.CompositorNodeDenoise.prefilter:'FAST'
#. :src: bpy.types.CompositorNodeDenoise.quality:'FAST'
#. :src: bpy.types.PointCache.compression:'FAST'
#. :src: bpy.types.PointCacheItem.compression:'FAST'
#. :src: bpy.types.CyclesRenderSettings.denoising_prefilter:'FAST'
#. :src: bpy.types.CyclesRenderSettings.denoising_quality:'FAST'
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_prefilter:'FAST'
#. :src: bpy.types.CyclesRenderSettings.preview_denoising_quality:'FAST'
#. :src: bpy.types.RenderSettings.compositor_denoise_final_quality:'FAST'
#. :src: bpy.types.RenderSettings.compositor_denoise_preview_quality:'FAST'
#: source/blender/editors/space_view3d/view3d_navigate_walk.cc:1520
msgid "Fast"
msgstr "வேகமாக"

#. :src: bpy.types.Material.volume_intersection_method:'FAST'
msgid ""
"Each face is considered as a medium interface. Gives correct results for "
"manifold geometry that contains no inner parts."
msgstr ""
"ஒவ்வொரு முகமும் ஒரு நடுத்தர இடைமுகமாக கருதப்படுகிறது. உள் பாகங்கள் இல்லாத "
"பன்மடங்கு வடிவவியலுக்கு சரியான முடிவுகளைத் தருகிறது."

