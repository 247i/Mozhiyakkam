msgid "Top"
msgstr "மேலே"

#. :src: bpy.types.FluidDomainSettings.use_collision_border_top
msgid "Enable collisions with top domain border"
msgstr "சிறந்த டொமைன் எல்லையுடன் மோதல்களை இயக்கவும்"

#. :src: bpy.types.FluidDomainSettings.use_color_ramp
#. :src: bpy.types.PHYSICS_PT_viewport_display_color
msgid "Grid Display"
msgstr "கட்டம் காட்சி"

#. :src: bpy.types.FluidDomainSettings.use_color_ramp
msgid ""
"Render a simulation field while mapping its voxels values to the colors of a"
" ramp or using a predefined color code"
msgstr ""
"ஒரு உருவகப்படுத்துதல் புலத்தை ஒரு வளைவின் வண்ணங்களுக்கு மேப்பிங் செய்யும் "
"போது அல்லது முன் வரையறுக்கப்பட்ட வண்ணக் குறியீட்டைப் பயன்படுத்தும் போது ஒரு "
"உருவகப்படுத்துதல் புலத்தை வழங்கவும்"

#. :src: bpy.types.FluidDomainSettings.use_diffusion
msgid "Use Diffusion"
msgstr "பரவலைப் பயன்படுத்துங்கள்"

#. :src: bpy.types.FluidDomainSettings.use_diffusion
msgid "Enable fluid diffusion settings (e.g. viscosity, surface tension)"
msgstr ""
"திரவ பரவல் அமைப்புகளை இயக்கவும் (எ.கா. பாகுத்தன்மை, மேற்பரப்பு பதற்றம்)"

#. :src: bpy.types.FluidDomainSettings.use_dissolve_smoke
msgid "Dissolve Smoke"
msgstr "புகையை கரைக்கவும்"

#. :src: bpy.types.FluidDomainSettings.use_dissolve_smoke
msgid "Let smoke disappear over time"
msgstr "காலப்போக்கில் புகை மறைந்துவிடும்"

#. :src: bpy.types.FluidDomainSettings.use_dissolve_smoke_log
msgid "Logarithmic Dissolve"
msgstr "மடக்கை கரைக்கவும்"

#. :src: bpy.types.FluidDomainSettings.use_dissolve_smoke_log
msgid ""
"Dissolve smoke in a logarithmic fashion. Dissolves quickly at first, but "
"lingers longer."
msgstr ""
"புகையை ஒரு மடக்கை பாணியில் கரைக்கவும். முதலில் விரைவாக கரைந்து போகிறது, "
"ஆனால் நீண்ட காலம் நீடிக்கிறது."

#. :src: bpy.types.FluidDomainSettings.use_flip_particles
msgid "Create liquid particle system"
msgstr "திரவ துகள் அமைப்பை உருவாக்கவும்"

#. :src: bpy.types.FluidDomainSettings.use_foam_particles
#: scripts/startup/bl_ui/properties_physics_fluid.py:947
#: source/blender/modifiers/intern/MOD_ocean.cc:539
msgid "Foam"
msgstr "நுரை"

#. :src: bpy.types.FluidDomainSettings.use_foam_particles
msgid "Create foam particle system"
msgstr "நுரை துகள் அமைப்பை உருவாக்கவும்"

#. :src: bpy.types.FluidDomainSettings.use_fractions
#: scripts/startup/bl_ui/properties_physics_fluid.py:519
msgid "Fractional Obstacles"
msgstr "பகுதியளவு தடைகள்"

#. :src: bpy.types.FluidDomainSettings.use_fractions
msgid "Fractional obstacles improve and smoothen the fluid-obstacle boundary"
msgstr "பகுதியளவு தடைகள் திரவ-தடுப்பு எல்லையை மேம்படுத்தி மென்மையாக்குகின்றன"

#. :src: bpy.types.FluidDomainSettings.use_guide
msgid "Use Guiding"
msgstr "வழிகாட்டுதலைப் பயன்படுத்துங்கள்"

#. :src: bpy.types.FluidDomainSettings.use_guide
msgid "Enable fluid guiding"
msgstr "திரவ வழிகாட்டலை இயக்கவும்"

#. :src: bpy.types.FluidDomainSettings.use_mesh
msgid "Use Mesh"
msgstr "மெச் பயன்படுத்தவும்"

#. :src: bpy.types.FluidDomainSettings.use_mesh
msgid "Enable fluid mesh (using amplification)"
msgstr "திரவ கண்ணி (பெருக்கத்தைப் பயன்படுத்தி) இயக்கவும்"

#. :src: bpy.types.FluidDomainSettings.use_noise
msgid "Use Noise"
msgstr "ஒலி பயன்படுத்தவும்"

#. :src: bpy.types.FluidDomainSettings.use_noise
msgid "Enable fluid noise (using amplification)"
msgstr "திரவ சத்தத்தை இயக்கவும் (பெருக்கத்தைப் பயன்படுத்துதல்)"

#. :src: bpy.types.FluidDomainSettings.use_slice
#. :src: bpy.types.PHYSICS_PT_viewport_display_slicing
#. :src: bpy.types.VolumeDisplay.use_slice
msgid "Slice"
msgstr "துண்டு"

#. :src: bpy.types.FluidDomainSettings.use_slice
#. :src: bpy.types.VolumeDisplay.use_slice
msgid "Perform a single slice of the domain object"
msgstr "டொமைன் பொருளின் ஒற்றை துண்டு செய்யுங்கள்"

#. :src: bpy.types.FluidDomainSettings.use_speed_vectors
#: scripts/startup/bl_ui/properties_physics_fluid.py:856
msgid "Speed Vectors"
msgstr "வேக திசையன்கள்"

#. :src: bpy.types.FluidDomainSettings.use_speed_vectors
msgid ""
"Caches velocities of mesh vertices. These will be used (automatically) when "
"rendering with motion blur enabled."
msgstr ""
"கண்ணி செங்குத்துகளின் விரைவு. இயக்க மங்கலான இயக்கப்பட்டிருக்கும்போது இவை "
"பயன்படுத்தப்படும் (தானாகவே)."

#. :src: bpy.types.FluidDomainSettings.use_spray_particles
#: scripts/startup/bl_ui/properties_physics_fluid.py:946
msgid "Spray"
msgstr "தெளிப்பு"

#. :src: bpy.types.FluidDomainSettings.use_spray_particles
msgid "Create spray particle system"
msgstr "தெளிப்பு துகள் அமைப்பை உருவாக்கவும்"

#. :src: bpy.types.FluidDomainSettings.use_tracer_particles
msgid "Tracer"
msgstr "ட்ரேசர்"

#. :src: bpy.types.FluidDomainSettings.use_tracer_particles
msgid "Create tracer particle system"
msgstr "ட்ரேசர் துகள் அமைப்பை உருவாக்கவும்"

#. :src: bpy.types.FluidDomainSettings.use_viscosity
msgid "Use Viscosity"
msgstr "பாகுத்தன்மையைப் பயன்படுத்துங்கள்"

#. :src: bpy.types.FluidDomainSettings.use_viscosity
msgid "Simulate fluids with high viscosity using a special solver"
msgstr ""
"ஒரு சிறப்பு தீர்வைப் பயன்படுத்தி அதிக பாகுத்தன்மையுடன் திரவங்களை "
"உருவகப்படுத்துங்கள்"

#. :src: bpy.types.FluidDomainSettings.vector_display_type:'NEEDLE'
msgid "Needle"
msgstr "ஊசி"

#. :src: bpy.types.FluidDomainSettings.vector_display_type:'NEEDLE'
msgid "Display vectors as needles"
msgstr "திசையன்களை ஊசிகளாகக் காண்பி"

#. :src: bpy.types.FluidDomainSettings.vector_display_type:'STREAMLINE'
msgid "Streamlines"
msgstr "நெறிப்படுத்துகிறது"

#. :src: bpy.types.FluidDomainSettings.vector_display_type:'STREAMLINE'
msgid "Display vectors as streamlines"
msgstr "திசையன்களை நெறிப்படுத்தலாகக் காண்பி"

#. :src: bpy.types.FluidDomainSettings.vector_display_type:'MAC'
#: scripts/startup/bl_ui/properties_physics_fluid.py:1523
msgid "MAC Grid"
msgstr "மேக் கட்டம்"

#. :src: bpy.types.FluidDomainSettings.vector_display_type:'MAC'
msgid "Display vector field as MAC grid"
msgstr "திசையன் புலத்தை மேக் கட்டமாகக் காண்பி"

#. :src: bpy.types.FluidDomainSettings.vector_field
msgid "Vector field to be represented by the display vectors"
msgstr "காட்சி திசையன்களால் குறிப்பிடப்பட வேண்டிய திசையன் புலம்"

#. :src: bpy.types.FluidDomainSettings.vector_field:'FLUID_VELOCITY'
msgid "Fluid Velocity"
msgstr "திரவ விரைவு"

#. :src: bpy.types.FluidDomainSettings.vector_field:'FLUID_VELOCITY'
msgid "Velocity field of the fluid domain"
msgstr "திரவ களத்தின் திசைவேக புலம்"

#. :src: bpy.types.FluidDomainSettings.vector_field:'GUIDE_VELOCITY'
msgid "Guide Velocity"
msgstr "வழிகாட்டி விரைவு"

#. :src: bpy.types.FluidDomainSettings.vector_field:'GUIDE_VELOCITY'
msgid "Guide velocity field of the fluid domain"
msgstr "திரவ களத்தின் வழிகாட்டும் திசைவேக புலம்"

#. :src: bpy.types.FluidDomainSettings.vector_field:'FORCE'
msgid "Force field of the fluid domain"
msgstr "திரவ களத்தின் படை புலம்"

#. :src: bpy.types.FluidDomainSettings.vector_scale
msgid "Multiplier for scaling the vectors"
msgstr "திசையன்களை அளவிடுவதற்கான பெருக்கி"

#. :src: bpy.types.FluidDomainSettings.vector_scale_with_magnitude
msgid "Magnitude"
msgstr "அளவு"

#. :src: bpy.types.FluidDomainSettings.vector_scale_with_magnitude
msgid "Scale vectors with their magnitudes"
msgstr "திசையன்களை அவற்றின் அளவுகளுடன் அளவிடவும்"

#. :src: bpy.types.FluidDomainSettings.vector_show_mac_x
msgid "Show X-component of MAC Grid"
msgstr "மேக் கட்டத்தின் எக்ச்-கூறைக் காட்டு"

#. :src: bpy.types.FluidDomainSettings.vector_show_mac_y
msgid "Show Y-component of MAC Grid"
msgstr "மேக் கட்டத்தின் ஒய்-கூறு காட்டு"

#. :src: bpy.types.FluidDomainSettings.vector_show_mac_z
msgid "Show Z-component of MAC Grid"
msgstr "மேக் கட்டத்தின் இசட்-கூறைக் காட்டு"

#. :src: bpy.types.FluidDomainSettings.velocity_grid
#. :src: bpy.types.Volume.velocity_grid
msgid "Velocity Grid"
msgstr "விரைவு கட்டம்"

#. :src: bpy.types.FluidDomainSettings.velocity_grid
msgid "Smoke velocity grid"
msgstr "புகை விரைவு கட்டம்"

#. :src: bpy.types.FluidDomainSettings.velocity_scale
#. :src: bpy.types.Volume.velocity_scale
#. :src: bpy.types.MeshSequenceCacheModifier.velocity_scale
msgid "Velocity Scale"
msgstr "திசைவேக அளவு"

#. :src: bpy.types.FluidDomainSettings.velocity_scale
#. :src: bpy.types.Volume.velocity_scale
msgid "Factor to control the amount of motion blur"
msgstr "இயக்க மங்கலின் அளவைக் கட்டுப்படுத்த காரணி"

#. :src: bpy.types.FluidDomainSettings.viscosity_base
msgid "Viscosity Base"
msgstr "பாகுத்தன்மை அடிப்படை"

#. :src: bpy.types.FluidDomainSettings.viscosity_base
msgid ""
"Viscosity setting: value that is multiplied by 10 to the power of "
"(exponent*-1)"
msgstr "பாகுத்தன்மை அமைத்தல்: மதிப்பு 10 ஆல் பெருக்கப்படும் (அதிவேக*-1)"

#. :src: bpy.types.FluidDomainSettings.viscosity_exponent
msgid "Viscosity Exponent"
msgstr "பாகுத்தன்மை அடுக்கு"

#. :src: bpy.types.FluidDomainSettings.viscosity_exponent
msgid ""
"Negative exponent for the viscosity value (to simplify entering small values"
" e.g. 5*10^-6)"
msgstr ""
"பாகுத்தன்மை மதிப்புக்கான எதிர்மறை அடுக்கு (சிறிய மதிப்புகளை உள்ளிடுவதை "
"எளிதாக்க எ.கா. 5*10^-6)"

#. :src: bpy.types.FluidDomainSettings.viscosity_value
msgid ""
"Viscosity of liquid (higher values result in more viscous fluids, a value of"
" 0 will still apply some viscosity)"
msgstr ""
"திரவத்தின் பாகுத்தன்மை (அதிக மதிப்புகள் அதிக பிசுபிசுப்பு திரவங்களை "
"விளைவிக்கின்றன, 0 இன் மதிப்பு இன்னும் சில பாகுத்தன்மையைப் பயன்படுத்தும்)"

#. :src: bpy.types.FluidDomainSettings.vorticity
msgid "Amount of turbulence and rotation in smoke"
msgstr "கொந்தளிப்பின் அளவு மற்றும் புகையில் சுழற்சி"

#. :src: bpy.types.FluidEffectorSettings
#. :src: bpy.types.FluidModifier.effector_settings
msgid "Effector Settings"
msgstr "செயல்திறன் அமைப்புகள்"

#. :src: bpy.types.FluidEffectorSettings
msgid "Smoke collision settings"
msgstr "புகை மோதல் அமைப்புகள்"

#. :src: bpy.types.FluidEffectorSettings.effector_type
msgid "Effector Type"
msgstr "செயல்திறன் வகை"

#. :src: bpy.types.FluidEffectorSettings.effector_type
msgid "Change type of effector in the simulation"
msgstr "உருவகப்படுத்துதலில் செயல்திறனை மாற்றவும்"

