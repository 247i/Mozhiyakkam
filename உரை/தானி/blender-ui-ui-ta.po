#. :src: bpy.types.GeometryNodeCornersOfFace
msgid "Retrieve corners that make up a face"
msgstr "முகத்தை உருவாக்கும் மூலைகளை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeCornersOfVertex
msgid "Corners of Vertex"
msgstr "வெர்டெக்சின் மூலைகள்"

#. :src: bpy.types.GeometryNodeCornersOfVertex
msgid "Retrieve face corners connected to vertices"
msgstr "செங்குத்துகளுடன் இணைக்கப்பட்ட முக மூலைகளை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeCurveArc
msgid "Generate a poly spline arc"
msgstr "பாலி ச்ப்லைன் வளைவை உருவாக்குங்கள்"

#. :src: bpy.types.GeometryNodeCurveArc.mode
#. :src: bpy.types.GeometryNodeCurvePrimitiveCircle.mode
#. :src: bpy.types.GeometryNodeCurvePrimitiveLine.mode
msgid "Method used to determine radius and placement"
msgstr "ஆரம் மற்றும் வேலைவாய்ப்பை தீர்மானிக்க பயன்படுத்தப்படும் முறை"

#. :src: bpy.types.GeometryNodeCurveArc.mode:'POINTS'
msgid ""
"Define arc by 3 points on circle. Arc is calculated between start and end "
"points"
msgstr ""
"வட்டத்தில் 3 புள்ளிகளால் வளைவை வரையறுக்கவும். தொடக்க மற்றும் இறுதி "
"புள்ளிகளுக்கு இடையில் arc கணக்கிடப்படுகிறது"

#. :src: bpy.types.GeometryNodeCurveArc.mode:'RADIUS'
msgid "Define radius with a float"
msgstr "ஆரம் ஒரு மிதவையுடன் வரையறுக்கவும்"

#. :src: bpy.types.GeometryNodeCurveEndpointSelection
msgid "Endpoint Selection"
msgstr "இறுதிப்புள்ளி தேர்வு"

#. :src: bpy.types.GeometryNodeCurveEndpointSelection
msgid ""
"Provide a selection for an arbitrary number of endpoints in each spline"
msgstr ""
"ஒவ்வொரு ச்ப்லைனிலும் தன்னிச்சையான எண்ணிக்கையிலான இறுதிப் புள்ளிகளுக்கு ஒரு "
"தேர்வை வழங்கவும்"

#. :src: bpy.types.GeometryNodeCurveHandleTypeSelection
msgid "Handle Type Selection"
msgstr "வகை தேர்வைக் கையாளவும்"

#. :src: bpy.types.GeometryNodeCurveHandleTypeSelection
msgid "Provide a selection based on the handle types of Bézier control points"
msgstr ""
"பெசியர் கட்டுப்பாட்டு புள்ளிகளின் கைப்பிடி வகைகளின் அடிப்படையில் ஒரு தேர்வை "
"வழங்கவும்"

#. :src: bpy.types.GeometryNodeCurveHandleTypeSelection.handle_type:'FREE'
#. :src: bpy.types.GeometryNodeCurveSetHandles.handle_type:'FREE'
#. :src: bpy.types.CURVES_OT_handle_type_set.type:'FREE'
#. :src: bpy.types.GREASE_PENCIL_OT_set_handle_type.type:'FREE'
msgid ""
"The handle can be moved anywhere, and doesn't influence the point's other "
"handle"
msgstr ""
"கைப்பிடியை எங்கும் நகர்த்தலாம், மேலும் புள்ளியின் மற்ற கைப்பிடியை பாதிக்காது"

#. :src: bpy.types.GeometryNodeCurveHandleTypeSelection.handle_type:'AUTO'
#. :src: bpy.types.GeometryNodeCurveSetHandles.handle_type:'AUTO'
#. :src: bpy.types.CURVES_OT_handle_type_set.type:'AUTO'
#. :src: bpy.types.GREASE_PENCIL_OT_set_handle_type.type:'AUTO'
msgid "The location is automatically calculated to be smooth"
msgstr "இருப்பிடம் தானாகவே மென்மையாக கணக்கிடப்படுகிறது"

#. :src: bpy.types.GeometryNodeCurveHandleTypeSelection.handle_type:'VECTOR'
#. :src: bpy.types.GeometryNodeCurveSetHandles.handle_type:'VECTOR'
#. :src: bpy.types.CURVES_OT_handle_type_set.type:'VECTOR'
#. :src: bpy.types.GREASE_PENCIL_OT_set_handle_type.type:'VECTOR'
msgid "The location is calculated to point to the next/previous control point"
msgstr ""
"அடுத்த/முந்தைய கட்டுப்பாட்டு புள்ளியை சுட்டிக்காட்ட இருப்பிடம் "
"கணக்கிடப்படுகிறது"

#. :src: bpy.types.GeometryNodeCurveHandleTypeSelection.handle_type:'ALIGN'
#. :src: bpy.types.GeometryNodeCurveSetHandles.handle_type:'ALIGN'
#. :src: bpy.types.CURVES_OT_handle_type_set.type:'ALIGN'
#. :src: bpy.types.GREASE_PENCIL_OT_set_handle_type.type:'ALIGN'
msgid ""
"The location is constrained to point in the opposite direction as the other "
"handle"
msgstr ""
"மற்ற கைப்பிடியைப் போல எதிர் திசையில் சுட்டிக்காட்ட இருப்பிடம் "
"கட்டுப்படுத்தப்பட்டுள்ளது"

#. :src: bpy.types.GeometryNodeCurveHandleTypeSelection.mode
msgid "Whether to check the type of left and right handles"
msgstr "இடது மற்றும் வலது கைப்பிடிகளின் வகையை சரிபார்க்க வேண்டுமா"

#. :src: bpy.types.GeometryNodeCurveHandleTypeSelection.mode:'LEFT'
#. :src: bpy.types.GeometryNodeCurveSetHandles.mode:'LEFT'
#. :src: bpy.types.GeometryNodeSetCurveHandlePositions.mode:'LEFT'
msgid "Use the left handles"
msgstr "இடது கைப்பிடிகளைப் பயன்படுத்தவும்"

#. :src: bpy.types.GeometryNodeCurveHandleTypeSelection.mode:'RIGHT'
#. :src: bpy.types.GeometryNodeCurveSetHandles.mode:'RIGHT'
#. :src: bpy.types.GeometryNodeSetCurveHandlePositions.mode:'RIGHT'
msgid "Use the right handles"
msgstr "வலது கைப்பிடிகளைப் பயன்படுத்தவும்"

#. :src: bpy.types.GeometryNodeCurveLength
msgid "Retrieve the length of all splines added together"
msgstr ""
"ஒன்றாகச் சேர்க்கப்பட்ட அனைத்து ச்ப்லைன்களின் நீளத்தையும் மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeCurveOfPoint
msgid "Curve of Point"
msgstr "புள்ளி வளைவு"

#. :src: bpy.types.GeometryNodeCurveOfPoint
msgid "Retrieve the curve a control point is part of"
msgstr "வளைவை மீட்டெடுக்கவும் ஒரு கட்டுப்பாட்டு புள்ளி ஒரு பகுதியாகும்"

#. :src: bpy.types.GeometryNodeCurvePrimitiveBezierSegment
msgid "Bézier Segment"
msgstr "பெசியர் பிரிவு"

#. :src: bpy.types.GeometryNodeCurvePrimitiveBezierSegment
msgid "Generate a 2D Bézier spline from the given control points and handles"
msgstr ""
"கொடுக்கப்பட்ட கட்டுப்பாட்டு புள்ளிகள் மற்றும் கைப்பிடிகளிலிருந்து 2 டி "
"பெசியர் ச்ப்லைனை உருவாக்கவும்"

#. :src: bpy.types.GeometryNodeCurvePrimitiveBezierSegment.mode
msgid "Method used to determine control handles"
msgstr "கட்டுப்பாட்டு கைப்பிடிகளை தீர்மானிக்க பயன்படுத்தப்படும் முறை"

#. :src: bpy.types.GeometryNodeCurvePrimitiveBezierSegment.mode:'POSITION'
msgid "The start and end handles are fixed positions"
msgstr "தொடக்க மற்றும் இறுதி கைப்பிடிகள் நிலையான நிலைகள்"

#. :src: bpy.types.GeometryNodeCurvePrimitiveBezierSegment.mode:'OFFSET'
msgid "The start and end handles are offsets from the spline's control points"
msgstr ""
"தொடக்க மற்றும் இறுதி கைப்பிடிகள் ச்ப்லைனின் கட்டுப்பாட்டு புள்ளிகளிலிருந்து "
"ஆஃப்செட்டுகள்"

#. :src: bpy.types.GeometryNodeCurvePrimitiveCircle
msgid "Curve Circle"
msgstr "வளைவு வட்டம்"

#. :src: bpy.types.GeometryNodeCurvePrimitiveCircle
msgid "Generate a poly spline circle"
msgstr "பாலி ச்ப்லைன் வட்டத்தை உருவாக்குங்கள்"

#. :src: bpy.types.GeometryNodeCurvePrimitiveCircle.mode:'POINTS'
msgid "Define the radius and location with three points"
msgstr "ஆரம் மற்றும் இருப்பிடத்தை மூன்று புள்ளிகளுடன் வரையறுக்கவும்"

#. :src: bpy.types.GeometryNodeCurvePrimitiveCircle.mode:'RADIUS'
msgid "Define the radius with a float"
msgstr "ஆரம் ஒரு மிதவையுடன் வரையறுக்கவும்"

#. :src: bpy.types.GeometryNodeCurvePrimitiveLine
msgid "Curve Line"
msgstr "வளைவு வரி"

#. :src: bpy.types.GeometryNodeCurvePrimitiveLine
msgid "Generate a poly spline line with two points"
msgstr "இரண்டு புள்ளிகளுடன் பாலி ச்ப்லைன் வரியை உருவாக்கவும்"

#. :src: bpy.types.GeometryNodeCurvePrimitiveLine.mode:'POINTS'
msgid "Define the start and end points of the line"
msgstr "வரியின் தொடக்க மற்றும் இறுதி புள்ளிகளை வரையறுக்கவும்"

#. :src: bpy.types.GeometryNodeCurvePrimitiveLine.mode:'DIRECTION'
msgid "Define a line with a start point, direction and length"
msgstr "தொடக்க புள்ளி, திசை மற்றும் நீளத்துடன் ஒரு வரியை வரையறுக்கவும்"

#. :src: bpy.types.GeometryNodeCurvePrimitiveQuadrilateral
msgid "Quadrilateral"
msgstr "நாற்கர"

#. :src: bpy.types.GeometryNodeCurvePrimitiveQuadrilateral
msgid "Generate a polygon with four points"
msgstr "நான்கு புள்ளிகளுடன் பலகோணத்தை உருவாக்குங்கள்"

#. :src: bpy.types.GeometryNodeCurvePrimitiveQuadrilateral.mode:'RECTANGLE'
msgid "Create a rectangle"
msgstr "ஒரு செவ்வகத்தை உருவாக்கவும்"

#. :src:
#. bpy.types.GeometryNodeCurvePrimitiveQuadrilateral.mode:'PARALLELOGRAM'
msgid "Parallelogram"
msgstr "இணைகரம்"

#. :src:
#. bpy.types.GeometryNodeCurvePrimitiveQuadrilateral.mode:'PARALLELOGRAM'
msgid "Create a parallelogram"
msgstr "ஒரு இணையான வரைபடத்தை உருவாக்கவும்"

#. :src: bpy.types.GeometryNodeCurvePrimitiveQuadrilateral.mode:'TRAPEZOID'
msgid "Trapezoid"
msgstr "ட்ரெப்சாய்டு"

#. :src: bpy.types.GeometryNodeCurvePrimitiveQuadrilateral.mode:'TRAPEZOID'
msgid "Create a trapezoid"
msgstr "ஒரு ட்ரெப்சாய்டை உருவாக்கவும்"

#. :src: bpy.types.GeometryNodeCurvePrimitiveQuadrilateral.mode:'KITE'
msgid "Kite"
msgstr "காத்தாடி"

#. :src: bpy.types.GeometryNodeCurvePrimitiveQuadrilateral.mode:'KITE'
msgid "Create a Kite / Dart"
msgstr "ஒரு காத்தாடி / டார்ட் உருவாக்கவும்"

#. :src: bpy.types.GeometryNodeCurvePrimitiveQuadrilateral.mode:'POINTS'
msgid "Create a quadrilateral from four points"
msgstr "நான்கு புள்ளிகளிலிருந்து ஒரு நாற்காலியை உருவாக்கவும்"

#. :src: bpy.types.GeometryNodeCurveQuadraticBezier
msgid "Quadratic Bézier"
msgstr "இருபடி பெசியர்"

#. :src: bpy.types.GeometryNodeCurveQuadraticBezier
msgid ""
"Generate a poly spline in a parabola shape with control points positions"
msgstr ""
"கட்டுப்பாட்டு புள்ளிகள் நிலைகளுடன் ஒரு பரபோலா வடிவத்தில் பாலி ச்ப்லைனை "
"உருவாக்குங்கள்"

#. :src: bpy.types.GeometryNodeCurveSetHandles
msgid "Set Handle Type"
msgstr "கைப்பிடி வகையை அமைக்கவும்"

#. :src: bpy.types.GeometryNodeCurveSetHandles
msgid "Set the handle type for the control points of a Bézier curve"
msgstr "பெசியர் வளைவின் கட்டுப்பாட்டு புள்ளிகளுக்கு கைப்பிடி வகையை அமைக்கவும்"

#. :src: bpy.types.GeometryNodeCurveSetHandles.mode
#. :src: bpy.types.GeometryNodeSetCurveHandlePositions.mode
msgid "Whether to update left and right handles"
msgstr "இடது மற்றும் வலது கைப்பிடிகளைப் புதுப்பிக்க வேண்டுமா"

#. :src: bpy.types.GeometryNodeCurveSpiral
msgid "Spiral"
msgstr "சுழல்"

#. :src: bpy.types.GeometryNodeCurveSpiral
msgid "Generate a poly spline in a spiral shape"
msgstr "சுழல் வடிவத்தில் பாலி ச்ப்லைனை உருவாக்குங்கள்"

#. :src: bpy.types.GeometryNodeCurveSplineType
msgid "Set Spline Type"
msgstr "ச்ப்லைன் வகையை அமைக்கவும்"

#. :src: bpy.types.GeometryNodeCurveSplineType
msgid "Change the type of curves"
msgstr "வளைவுகளின் வகையை மாற்றவும்"

#. :src: bpy.types.GeometryNodeCurveSplineType.spline_type
msgid "The curve type to change the selected curves to"
msgstr "தேர்ந்தெடுக்கப்பட்ட வளைவுகளை மாற்ற வளைவு வகை"

#. :src: bpy.types.GeometryNodeCurveSplineType.spline_type:'CATMULL_ROM'
#. :src: bpy.types.CURVES_OT_curve_type_set.type:'CATMULL_ROM'
#. :src: bpy.types.GREASE_PENCIL_OT_convert_curve_type.type:'CATMULL_ROM'
#. :src: bpy.types.GREASE_PENCIL_OT_set_curve_type.type:'CATMULL_ROM'
msgid "Catmull Rom"
msgstr "கேட்மல் ரோம்"

#. :src: bpy.types.GeometryNodeCurveSplineType.spline_type:'NURBS'
msgid "NURBS"
msgstr "nurbs"

#. :src: bpy.types.GeometryNodeCurveStar
msgid "Star"
msgstr "விண்மீன்"

#. :src: bpy.types.GeometryNodeCurveStar
msgid ""
"Generate a poly spline in a star pattern by connecting alternating points of"
" two circles"
msgstr ""
"இரண்டு வட்டங்களின் மாற்று புள்ளிகளை இணைப்பதன் மூலம் ஒரு நட்சத்திர வடிவத்தில்"
" பாலி ச்ப்லைனை உருவாக்குங்கள்"

#. :src: bpy.types.GeometryNodeCurveToMesh
msgid "Curve to Mesh"
msgstr "மெச் வரை வளைவு"

#. :src: bpy.types.GeometryNodeCurveToMesh
msgid ""
"Convert curves into a mesh, optionally with a custom profile shape defined "
"by curves"
msgstr ""
"வளைவுகளால் வரையறுக்கப்பட்ட தனிப்பயன் சுயவிவர வடிவத்துடன் விருப்பமாக வளைவுகளை"
" ஒரு கண்ணிமையாக மாற்றவும்"

#. :src: bpy.types.GeometryNodeCurveToPoints
msgid "Curve to Points"
msgstr "புள்ளிகளுக்கு வளைவு"

#. :src: bpy.types.GeometryNodeCurveToPoints
msgid "Generate a point cloud by sampling positions along curves"
msgstr ""
"வளைவுகளுடன் நிலைகளை மாதிரி செய்வதன் மூலம் ஒரு புள்ளி மேகத்தை உருவாக்குங்கள்"

#. :src: bpy.types.GeometryNodeCurveToPoints.mode
msgid "How to generate points from the input curve"
msgstr "உள்ளீட்டு வளைவிலிருந்து புள்ளிகளை எவ்வாறு உருவாக்குவது"

#. :src: bpy.types.GeometryNodeCurveToPoints.mode:'EVALUATED'
#. :src: bpy.types.SpaceSpreadsheet.object_eval_state:'EVALUATED'
#. :src: bpy.types.SpreadsheetTableIDGeometry.object_eval_state:'EVALUATED'
msgid "Evaluated"
msgstr "மதிப்பீடு செய்யப்பட்டது"

#. :src: bpy.types.GeometryNodeCurveToPoints.mode:'EVALUATED'
msgid ""
"Create points from the curve's evaluated points, based on the resolution "
"attribute for NURBS and Bézier splines"
msgstr ""
"வளைவின் மதிப்பிடப்பட்ட புள்ளிகளிலிருந்து புள்ளிகளை உருவாக்கவும், இது nurbs "
"மற்றும் bézier splines க்கான தெளிவுத்திறன் பண்புக்கூறு அடிப்படையில்"

#. :src: bpy.types.GeometryNodeCurveToPoints.mode:'COUNT'
msgid ""
"Sample each spline by evenly distributing the specified number of points"
msgstr ""
"குறிப்பிட்ட எண்ணிக்கையிலான புள்ளிகளை சமமாக விநியோகிப்பதன் மூலம் ஒவ்வொரு "
"ச்ப்லைனையும் மாதிரி"

#. :src: bpy.types.GeometryNodeCurveToPoints.mode:'LENGTH'
msgid ""
"Sample each spline by splitting it into segments with the specified length"
msgstr ""
"ஒவ்வொரு ச்ப்லைனையும் குறிப்பிட்ட நீளத்துடன் பிரிவுகளாகப் பிரிப்பதன் மூலம் "
"மாதிரி"

#. :src: bpy.types.GeometryNodeCurvesToGreasePencil
msgid "Curves to Grease Pencil"
msgstr "பென்சில் கிரீச் செய்ய வளைவுகள்"

#. :src: bpy.types.GeometryNodeCurvesToGreasePencil
msgid "Convert the curves in each top-level instance into Grease Pencil layer"
msgstr ""
"ஒவ்வொரு உயர் மட்ட நிகழ்விலும் உள்ள வளைவுகளை கிரீச் பென்சில் அடுக்காக "
"மாற்றவும்"

#. :src: bpy.types.GeometryNodeCustomGroup
msgid "Geometry Custom Group"
msgstr "வடிவியல் தனிப்பயன் குழு"

#. :src: bpy.types.GeometryNodeCustomGroup
msgid "Custom Geometry Group Node for Python nodes"
msgstr "பைதான் முனைகளுக்கான தனிப்பயன் வடிவியல் குழு முனை"

#. :src: bpy.types.GeometryNodeDeformCurvesOnSurface
msgid "Deform Curves on Surface"
msgstr "மேற்பரப்பில் வளைவுகளை சிதைக்கவும்"

#. :src: bpy.types.GeometryNodeDeformCurvesOnSurface
msgid ""
"Translate and rotate curves based on changes between the object's original "
"and evaluated surface mesh"
msgstr ""
"பொருளின் அசல் மற்றும் மதிப்பிடப்பட்ட மேற்பரப்பு கண்ணுக்கு இடையிலான "
"மாற்றங்களின் அடிப்படையில் வளைவுகளை மொழிபெயர்த்து சுழற்றுங்கள்"

#. :src: bpy.types.GeometryNodeDeleteGeometry
#. :src: bpy.types.SCULPT_OT_face_set_edit.mode:'DELETE_GEOMETRY'
msgid "Delete Geometry"
msgstr "வடிவவியலை நீக்கு"

#. :src: bpy.types.GeometryNodeDeleteGeometry
msgid "Remove selected elements of a geometry"
msgstr "வடிவவியலின் தேர்ந்தெடுக்கப்பட்ட கூறுகளை அகற்று"

#. :src: bpy.types.GeometryNodeDeleteGeometry.domain
msgid "Which domain to delete in"
msgstr "எந்த டொமைன் நீக்க வேண்டும்"

#. :src: bpy.types.GeometryNodeDeleteGeometry.mode
msgid "Which parts of the mesh component to delete"
msgstr "கண்ணி கூறுகளின் எந்த பகுதிகள் நீக்க வேண்டும்"

#. :src: bpy.types.GeometryNodeDeleteGeometry.mode:'EDGE_FACE'
#. :src: bpy.types.MESH_OT_delete.type:'EDGE_FACE'
msgid "Only Edges & Faces"
msgstr "விளிம்புகள் மற்றும் முகங்கள் மட்டுமே"

#. :src: bpy.types.GeometryNodeDeleteGeometry.mode:'ONLY_FACE'
#. :src: bpy.types.MESH_OT_delete.type:'ONLY_FACE'
msgid "Only Faces"
msgstr "முகம் மட்டுமே"

#. :src: bpy.types.GeometryNodeDistributePointsInGrid
msgid "Distribute Points in Grid"
msgstr "கட்டத்தில் புள்ளிகளை விநியோகிக்கவும்"

#. :src: bpy.types.GeometryNodeDistributePointsInGrid
msgid "Generate points inside a volume grid"
msgstr "ஒரு தொகுதி கட்டத்திற்குள் புள்ளிகளை உருவாக்குங்கள்"

#. :src: bpy.types.GeometryNodeDistributePointsInGrid.mode
#. :src: bpy.types.GeometryNodeDistributePointsOnFaces.distribute_method
msgid "Distribution Method"
msgstr "விநியோக முறை"

#. :src: bpy.types.GeometryNodeDistributePointsInGrid.mode
#. :src: bpy.types.GeometryNodeDistributePointsOnFaces.distribute_method
#: source/blender/nodes/geometry/nodes/node_geo_distribute_points_in_volume.cc:49
msgid "Method to use for scattering points"
msgstr "சிதறல் புள்ளிகளுக்கு பயன்படுத்த முறை"

#. :src: bpy.types.GeometryNodeDistributePointsInGrid.mode:'DENSITY_RANDOM'
msgid "Distribute points randomly inside of the volume"
msgstr "தொகுதியின் உள்ளே புள்ளிகளை தோராயமாக விநியோகிக்கவும்"

#. :src: bpy.types.GeometryNodeDistributePointsInGrid.mode:'DENSITY_GRID'
msgid "Distribute the points in a grid pattern inside of the volume"
msgstr "அளவின் உள்ளே ஒரு கட்ட வடிவத்தில் புள்ளிகளை விநியோகிக்கவும்"

#. :src: bpy.types.GeometryNodeDistributePointsInVolume
msgid "Distribute Points in Volume"
msgstr "அளவிலான புள்ளிகளை விநியோகிக்கவும்"

#. :src: bpy.types.GeometryNodeDistributePointsInVolume
msgid "Generate points inside a volume"
msgstr "ஒரு தொகுதிக்குள் புள்ளிகளை உருவாக்குங்கள்"

#. :src: bpy.types.GeometryNodeDistributePointsOnFaces
msgid "Distribute Points on Faces"
msgstr "முகங்களில் புள்ளிகளை விநியோகிக்கவும்"

#. :src: bpy.types.GeometryNodeDistributePointsOnFaces
msgid "Generate points spread out on the surface of a mesh"
msgstr "ஒரு கண்ணி மேற்பரப்பில் பரவிய புள்ளிகளை உருவாக்குங்கள்"

#. :src:
#. bpy.types.GeometryNodeDistributePointsOnFaces.distribute_method:'RANDOM'
msgid "Distribute points randomly on the surface"
msgstr "புள்ளிகளை தோராயமாக மேற்பரப்பில் விநியோகிக்கவும்"

#. :src:
#. bpy.types.GeometryNodeDistributePointsOnFaces.distribute_method:'POISSON'
msgid "Poisson Disk"
msgstr "பாய்சன் வட்டு"

#. :src:
#. bpy.types.GeometryNodeDistributePointsOnFaces.distribute_method:'POISSON'
msgid ""
"Distribute the points randomly on the surface while taking a minimum "
"distance between points into account"
msgstr ""
"புள்ளிகளுக்கு இடையில் குறைந்தபட்ச தூரத்தை கணக்கில் எடுத்துக்கொள்ளும் போது "
"புள்ளிகளை தோராயமாக மேற்பரப்பில் விநியோகிக்கவும்"

#. :src: bpy.types.GeometryNodeDistributePointsOnFaces.use_legacy_normal
msgid "Legacy Normal"
msgstr "மரபு இயல்பானது"

#. :src: bpy.types.GeometryNodeDistributePointsOnFaces.use_legacy_normal
msgid ""
"Output the normal and rotation values that have been output before the node "
"started taking smooth normals into account"
msgstr ""
"முனை மென்மையான இயல்புகளை கணக்கில் எடுத்துக்கொள்ளத் தொடங்குவதற்கு முன்பு "
"வெளியீட்டில் இருந்த இயல்பான மற்றும் சுழற்சி மதிப்புகளை வெளியீடு செய்யுங்கள்"

#. :src: bpy.types.GeometryNodeDualMesh
#: source/blender/nodes/geometry/nodes/node_geo_dual_mesh.cc:22
msgid "Dual Mesh"
msgstr "இரட்டை கண்ணி"

#. :src: bpy.types.GeometryNodeDualMesh
msgid "Convert Faces into vertices and vertices into faces"
msgstr "முகங்களை செங்குத்துகளாகவும் செங்குத்துகளாகவும் முகங்களாக மாற்றவும்"

#. :src: bpy.types.GeometryNodeDuplicateElements
msgid "Duplicate Elements"
msgstr "நகல் கூறுகள்"

#. :src: bpy.types.GeometryNodeDuplicateElements
msgid "Generate an arbitrary number copies of each selected input element"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட ஒவ்வொரு உள்ளீட்டு உறுப்பின் தன்னிச்சையான எண் நகல்களை "
"உருவாக்கவும்"

#. :src: bpy.types.GeometryNodeDuplicateElements.domain
msgid "Which domain to duplicate"
msgstr "எந்த டொமைன் நகல்"

#. :src: bpy.types.GeometryNodeEdgePathsToCurves
msgid "Edge Paths to Curves"
msgstr "வளைவுகளுக்கு விளிம்பு பாதைகள்"

#. :src: bpy.types.GeometryNodeEdgePathsToCurves
msgid "Output curves following paths across mesh edges"
msgstr "கண்ணி விளிம்புகள் முழுவதும் பாதைகளைத் தொடர்ந்து வெளியீட்டு வளைவுகள்"

#. :src: bpy.types.GeometryNodeEdgePathsToSelection
msgid "Edge Paths to Selection"
msgstr "தேர்வுக்கான விளிம்பு பாதைகள்"

#. :src: bpy.types.GeometryNodeEdgePathsToSelection
msgid "Output a selection of edges by following paths across mesh edges"
msgstr ""
"கண்ணி விளிம்புகள் முழுவதும் பாதைகளைப் பின்பற்றுவதன் மூலம் விளிம்புகளின் "
"தேர்வை உருவாக்குங்கள்"

#. :src: bpy.types.GeometryNodeEdgesOfCorner
msgid "Edges of Corner"
msgstr "மூலையின் விளிம்புகள்"

#. :src: bpy.types.GeometryNodeEdgesOfCorner
msgid "Retrieve the edges on both sides of a face corner"
msgstr "முகம் மூலையின் இருபுறமும் விளிம்புகளை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeEdgesOfVertex
msgid "Edges of Vertex"
msgstr "வெர்டெக்சின் விளிம்புகள்"

#. :src: bpy.types.GeometryNodeEdgesOfVertex
msgid "Retrieve the edges connected to each vertex"
msgstr "ஒவ்வொரு வெர்டெக்சுடனும் இணைக்கப்பட்ட விளிம்புகளை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeEdgesToFaceGroups
#: source/blender/nodes/geometry/nodes/node_geo_edges_to_face_groups.cc:40
msgid "Edges to Face Groups"
msgstr "குழுக்களை எதிர்கொள்ள விளிம்புகள்"

#. :src: bpy.types.GeometryNodeEdgesToFaceGroups
msgid "Group faces into regions surrounded by the selected boundary edges"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட எல்லை விளிம்புகளால் சூழப்பட்ட பகுதிகளில் குழு முகங்கள்"

#. :src: bpy.types.GeometryNodeExtrudeMesh
msgid "Extrude Mesh"
msgstr "எக்ச்ட்ரூட் மெச்"

#. :src: bpy.types.GeometryNodeExtrudeMesh
msgid ""
"Generate new vertices, edges, or faces from selected elements and move them "
"based on an offset while keeping them connected by their boundary"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட கூறுகளிலிருந்து புதிய செங்குத்துகள், விளிம்புகள் அல்லது "
"முகங்களை உருவாக்கி, அவற்றை ஆஃப்செட்டின் அடிப்படையில் நகர்த்தவும், அவற்றை "
"அவற்றின் எல்லையால் இணைக்கவும்"

#. :src: bpy.types.GeometryNodeFaceOfCorner
msgid "Face of Corner"
msgstr "மூலையின் முகம்"

#. :src: bpy.types.GeometryNodeFaceOfCorner
msgid "Retrieve the face each face corner is part of"
msgstr "ஒவ்வொரு முகம் மூலையும் ஒரு பகுதியாகும்"

#. :src: bpy.types.GeometryNodeFieldAtIndex
msgid "Evaluate at Index"
msgstr "குறியீட்டில் மதிப்பீடு செய்யுங்கள்"

#. :src: bpy.types.GeometryNodeFieldAtIndex
msgid "Retrieve data of other elements in the context's geometry"
msgstr "சூழலின் வடிவவியலில் பிற கூறுகளின் தரவை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeFieldAtIndex.domain
#. :src: bpy.types.GeometryNodeFieldOnDomain.domain
msgid "Domain the field is evaluated in"
msgstr "டொமைன் புலம் மதிப்பீடு செய்யப்படுகிறது"

#. :src: bpy.types.GeometryNodeFieldAverage
msgid "Field Average"
msgstr "புலம் சராசரி"

#. :src: bpy.types.GeometryNodeFieldAverage
msgid "Calculate the mean and median of a given field"
msgstr "கொடுக்கப்பட்ட புலத்தின் சராசரி மற்றும் சராசரியைக் கணக்கிடுங்கள்"

#. :src: bpy.types.GeometryNodeFieldAverage.data_type
#. :src: bpy.types.GeometryNodeFieldMinAndMax.data_type
#. :src: bpy.types.GeometryNodeFieldVariance.data_type
msgid "Type of data the outputs are calculated from"
msgstr "தரவு வகை வெளியீடுகள் கணக்கிடப்படுகின்றன"

#. :src: bpy.types.GeometryNodeFieldMinAndMax
msgid "Field Min & Max"
msgstr "புலம் மின் & மேக்ச்"

#. :src: bpy.types.GeometryNodeFieldMinAndMax
msgid "Calculate the minimum and maximum of a given field"
msgstr ""
"கொடுக்கப்பட்ட புலத்தின் குறைந்தபட்ச மற்றும் அதிகபட்சத்தைக் கணக்கிடுங்கள்"

#. :src: bpy.types.GeometryNodeFieldOnDomain
msgid "Evaluate on Domain"
msgstr "டொமைனில் மதிப்பீடு செய்யுங்கள்"

#. :src: bpy.types.GeometryNodeFieldOnDomain
msgid ""
"Retrieve values from a field on a different domain besides the domain from "
"the context"
msgstr ""
"சூழலில் இருந்து டொமைனைத் தவிர வேறு களத்தில் ஒரு புலத்திலிருந்து மதிப்புகளை "
"மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeFieldVariance
msgid "Field Variance"
msgstr "புல மாறுபாடு"

#. :src: bpy.types.GeometryNodeFieldVariance
msgid "Calculate the standard deviation and variance of a given field"
msgstr ""
"கொடுக்கப்பட்ட புலத்தின் நிலையான விலகல் மற்றும் மாறுபாட்டைக் கணக்கிடுங்கள்"

#. :src: bpy.types.GeometryNodeFillCurve
msgid "Fill Curve"
msgstr "வளைவு நிரப்பவும்"

#. :src: bpy.types.GeometryNodeFillCurve
msgid ""
"Generate a mesh on the XY plane with faces on the inside of input curves"
msgstr ""
"உள்ளீட்டு வளைவுகளின் உட்புறத்தில் முகங்களுடன் xy விமானத்தில் ஒரு கண்ணி "
"உருவாக்கவும்"

#. :src: bpy.types.GeometryNodeFilletCurve
msgid "Fillet Curve"
msgstr "ஃபில்லட் வளைவு"

#. :src: bpy.types.GeometryNodeFilletCurve
msgid "Round corners by generating circular arcs on each control point"
msgstr ""
"ஒவ்வொரு கட்டுப்பாட்டு புள்ளியிலும் வட்ட வளைவுகளை உருவாக்குவதன் மூலம் சுற்று "
"மூலைகள்"

#. :src: bpy.types.GeometryNodeFlipFaces
msgid "Flip Faces"
msgstr "முகங்கள்"

#. :src: bpy.types.GeometryNodeFlipFaces
msgid ""
"Reverse the order of the vertices and edges of selected faces, flipping "
"their normal direction"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட முகங்களின் செங்குத்துகள் மற்றும் விளிம்புகளின் வரிசையை "
"மாற்றியமைத்து, அவற்றின் இயல்பான திசையை புரட்டுகிறது"

#. :src: bpy.types.GeometryNodeForeachGeometryElementInput
msgid "For Each Geometry Element Input"
msgstr "ஒவ்வொரு வடிவியல் உறுப்பு உள்ளீட்டிற்கும்"

#. :src: bpy.types.GeometryNodeForeachGeometryElementInput.paired_output
#. :src: bpy.types.GeometryNodeRepeatInput.paired_output
#. :src: bpy.types.GeometryNodeSimulationInput.paired_output
#. :src: bpy.types.NodeClosureInput.paired_output
msgid "Paired Output"
msgstr "இணை வெளியீடு"

#. :src: bpy.types.GeometryNodeForeachGeometryElementInput.paired_output
#. :src: bpy.types.GeometryNodeRepeatInput.paired_output
#. :src: bpy.types.GeometryNodeSimulationInput.paired_output
#. :src: bpy.types.NodeClosureInput.paired_output
msgid "Zone output node that this input node is paired with"
msgstr "இந்த உள்ளீட்டு முனை சோடியாக இருக்கும் மண்டல வெளியீட்டு முனை"

#. :src: bpy.types.GeometryNodeForeachGeometryElementOutput
msgid "For Each Geometry Element Output"
msgstr "ஒவ்வொரு வடிவியல் உறுப்பு வெளியீட்டிற்கும்"

#. :src: bpy.types.GeometryNodeForeachGeometryElementOutput.active_main_index
msgid "Active Main Item Index"
msgstr "செயலில் உள்ள முதன்மை உருப்படி அட்டவணை"

#. :src: bpy.types.GeometryNodeForeachGeometryElementOutput.domain
msgid "Geometry domain that is iterated over"
msgstr "வடிவியல் டொமைன் மீண்டும் செயல்படுத்தப்படுகிறது"

#. :src: bpy.types.GeometryNodeForeachGeometryElementOutput.inspection_index
#. :src: bpy.types.GeometryNodeRepeatOutput.inspection_index
msgid "Inspection Index"
msgstr "ஆய்வு அட்டவணை"

#. :src: bpy.types.GeometryNodeForeachGeometryElementOutput.inspection_index
#. :src: bpy.types.GeometryNodeRepeatOutput.inspection_index
msgid ""
"Iteration index that is used by inspection features like the viewer node or "
"socket inspection"
msgstr ""
"பார்வையாளர் முனை அல்லது சாக்கெட் ஆய்வு போன்ற ஆய்வு அம்சங்களால் "
"பயன்படுத்தப்படும் மறு செய்கை குறியீடு"

#. :src: bpy.types.GeometryNodeGeometryToInstance
msgid "Geometry to Instance"
msgstr "உதாரணத்திற்கு வடிவியல்"

#. :src: bpy.types.GeometryNodeGeometryToInstance
msgid ""
"Convert each input geometry into an instance, which can be much faster than "
"the Join Geometry node when the inputs are large"
msgstr ""
"ஒவ்வொரு உள்ளீட்டு வடிவவியலையும் ஒரு நிகழ்வாக மாற்றவும், இது உள்ளீடுகள் "
"பெரியதாக இருக்கும்போது சாக் வடிவியல் முனையை விட மிக வேகமாக இருக்கும்"

#. :src: bpy.types.GeometryNodeGetNamedGrid
msgid "Get Named Grid"
