#. :src: bpy.types.GreasePencilArrayModifier.constant_offset
#: source/blender/modifiers/intern/MOD_grease_pencil_array.cc:295
msgid "Constant Offset"
msgstr "நிலையான ஆஃப்செட்"

#. :src: bpy.types.ArrayModifier.use_constant_offset
msgid "Add a constant offset"
msgstr "நிலையான ஆஃப்செட்டைச் சேர்க்கவும்"

#. :src: bpy.types.ArrayModifier.use_merge_vertices
#. :src: bpy.types.MirrorModifier.use_mirror_merge
#. :src: bpy.types.ScrewModifier.use_merge_vertices
#. :src: bpy.types.IMPORT_SCENE_OT_gltf.merge_vertices
#. :src: bpy.types.WM_OT_ply_import.merge_verts
#: scripts/startup/bl_ui/space_view3d.py:4575
msgid "Merge Vertices"
msgstr "செங்குத்துகளை ஒன்றிணைக்கவும்"

#. :src: bpy.types.ArrayModifier.use_merge_vertices
msgid "Merge vertices in adjacent duplicates"
msgstr "அருகிலுள்ள நகல்களில் செங்குத்துகளை ஒன்றிணைக்கவும்"

#. :src: bpy.types.ArrayModifier.use_merge_vertices_cap
msgid "Merge End Vertices"
msgstr "இறுதி செங்குத்துகளை ஒன்றிணைக்கவும்"

#. :src: bpy.types.ArrayModifier.use_merge_vertices_cap
msgid "Merge vertices in first and last duplicates"
msgstr "முதல் மற்றும் கடைசி நகல்களில் செங்குத்துகளை ஒன்றிணைக்கவும்"

#. :src: bpy.types.ArrayModifier.use_object_offset
#. :src: bpy.types.GreasePencilArrayModifier.use_object_offset
msgid "Add another object's transformation to the total offset"
msgstr "மொத்த ஆஃப்செட்டில் மற்றொரு பொருளின் மாற்றத்தை சேர்க்கவும்"

#. :src: bpy.types.ArrayModifier.use_relative_offset
#. :src: bpy.types.GreasePencilArrayModifier.relative_offset
#: source/blender/modifiers/intern/MOD_grease_pencil_array.cc:288
msgid "Relative Offset"
msgstr "உறவினர் ஆஃப்செட்"

#. :src: bpy.types.ArrayModifier.use_relative_offset
#. :src: bpy.types.GreasePencilArrayModifier.use_relative_offset
msgid "Add an offset relative to the object's bounding box"
msgstr "பொருளின் எல்லை பெட்டியுடன் தொடர்புடைய ஆஃப்செட்டைச் சேர்க்கவும்"

#. :src: bpy.types.BevelModifier
msgid "Bevel Modifier"
msgstr "பெவெல் மாற்றியமைப்பாளர்"

#. :src: bpy.types.BevelModifier
msgid "Bevel modifier to make edges and vertices more rounded"
msgstr ""
"விளிம்புகள் மற்றும் செங்குத்துகளை மேலும் வட்டமானதாக மாற்ற பெவல் "
"மாற்றியமைப்பாளர்"

#. :src: bpy.types.BevelModifier.affect
#. :src: bpy.types.MESH_OT_bevel.affect
#: scripts/startup/bl_ui/properties_grease_pencil_common.py:60
#: scripts/startup/bl_ui/properties_paint_common.py:1330
#: scripts/startup/bl_ui/properties_physics_common.py:302
#: scripts/startup/bl_ui/properties_physics_field.py:124
#: scripts/startup/bl_ui/properties_physics_field.py:137
#: scripts/startup/bl_ui/space_image.py:1080
#: scripts/startup/bl_ui/space_view3d.py:7716
#: source/blender/editors/mesh/editmesh_bevel.cc:209
msgid "Affect"
msgstr "பாதிக்கிறது"

#. :src: bpy.types.BevelModifier.affect
#. :src: bpy.types.MESH_OT_bevel.affect
msgid "Affect edges or vertices"
msgstr "விளிம்புகள் அல்லது செங்குத்துகளை பாதிக்கும்"

#. :src: bpy.types.BevelModifier.affect:'VERTICES'
#. :src: bpy.types.MESH_OT_bevel.affect:'VERTICES'
msgid "Affect only vertices"
msgstr "செங்குத்துகளை மட்டுமே பாதிக்கிறது"

#. :src: bpy.types.BevelModifier.affect:'EDGES'
#. :src: bpy.types.MESH_OT_bevel.affect:'EDGES'
msgid "Affect only edges"
msgstr "விளிம்புகளை மட்டுமே பாதிக்கும்"

#. :src: bpy.types.BevelModifier.angle_limit
msgid "Angle above which to bevel edges"
msgstr "விளிம்புகளைத் தூண்டுவதற்கு மேலே கோணம்"

#. :src: bpy.types.BevelModifier.custom_profile
msgid "The path for the custom profile"
msgstr "தனிப்பயன் சுயவிவரத்திற்கான பாதை"

#. :src: bpy.types.BevelModifier.edge_weight
msgid "Edge Weight"
msgstr "விளிம்பு எடை"

#. :src: bpy.types.BevelModifier.edge_weight
msgid "Attribute name for edge weight"
msgstr "விளிம்பு எடைக்கு பண்புக்கூறு பெயர்"

#. :src: bpy.types.BevelModifier.face_strength_mode
#. :src: bpy.types.MESH_OT_mod_weighted_strength.face_strength
#: scripts/startup/bl_ui/space_toolsystem_toolbar.py:932
#: source/blender/editors/mesh/editmesh_bevel.cc:962
msgid "Face Strength"
msgstr "முகம் வலிமை"

#. :src: bpy.types.BevelModifier.face_strength_mode
msgid "Whether to set face strength, and which faces to set it on"
msgstr "முக வலிமையை அமைக்க வேண்டுமா, அதை அமைக்க எந்த முகம்"

#. :src: bpy.types.BevelModifier.face_strength_mode:'FSTR_NONE'
#. :src: bpy.types.MESH_OT_bevel.face_strength_mode:'NONE'
msgid "Do not set face strength"
msgstr "முக வலிமையை அமைக்க வேண்டாம்"

#. :src: bpy.types.BevelModifier.face_strength_mode:'FSTR_NEW'
#. :src: bpy.types.FILE_OT_external_operation.operation:'NEW'
#. :src: bpy.types.MESH_OT_bevel.face_strength_mode:'NEW'
#. :src: bpy.types.OBJECT_OT_link_to_collection.is_new
#. :src: bpy.types.OBJECT_OT_move_to_collection.is_new
#. :src: bpy.types.SCENE_OT_new_sequencer.type:'NEW'
#. :src: bpy.types.SCENE_OT_view_layer_add.type:'NEW'
#. :src: bpy.types.SEQUENCER_OT_scene_strip_add_new.type:'NEW'
#. :src: bpy.types.BatchRenameAction.set_method:'NEW'
#: source/blender/editors/interface/templates/interface_template_id.cc:930
#: source/blender/editors/interface/templates/interface_template_search.cc:205
msgid "New"
msgstr "புதிய"

#. :src: bpy.types.BevelModifier.face_strength_mode:'FSTR_NEW'
#. :src: bpy.types.MESH_OT_bevel.face_strength_mode:'NEW'
msgid "Set face strength on new faces only"
msgstr "புதிய முகங்களில் மட்டுமே முக வலிமையை அமைக்கவும்"

#. :src: bpy.types.BevelModifier.face_strength_mode:'FSTR_AFFECTED'
#. :src: bpy.types.MESH_OT_bevel.face_strength_mode:'AFFECTED'
msgid "Affected"
msgstr "பாதிக்கப்பட்டது"

#. :src: bpy.types.BevelModifier.face_strength_mode:'FSTR_AFFECTED'
msgid "Set face strength on new and affected faces only"
msgstr "புதிய மற்றும் பாதிக்கப்பட்ட முகங்களில் மட்டுமே முக வலிமையை அமைக்கவும்"

#. :src: bpy.types.BevelModifier.face_strength_mode:'FSTR_ALL'
#. :src: bpy.types.MESH_OT_bevel.face_strength_mode:'ALL'
msgid "Set face strength on all faces"
msgstr "எல்லா முகங்களிலும் முக வலிமையை அமைக்கவும்"

#. :src: bpy.types.BevelModifier.harden_normals
#. :src: bpy.types.MESH_OT_bevel.harden_normals
msgid "Harden Normals"
msgstr "ஆர்டன் நார்மல்ச்"

#. :src: bpy.types.BevelModifier.harden_normals
#. :src: bpy.types.MESH_OT_bevel.harden_normals
msgid "Match normals of new faces to adjacent faces"
msgstr "அருகிலுள்ள முகங்களுக்கு புதிய முகங்களின் இயல்புநிலைகள் பொருந்துகின்றன"

#. :src: bpy.types.BevelModifier.limit_method
msgid "Limit Method"
msgstr "வரம்பு முறை"

#. :src: bpy.types.BevelModifier.limit_method:'NONE'
msgid "Bevel the entire mesh by a constant amount"
msgstr "முழு கண்ணி ஒரு நிலையான அளவு மூலம் பெவல்"

#. :src: bpy.types.BevelModifier.limit_method:'ANGLE'
msgid "Only bevel edges with sharp enough angles between faces"
msgstr ""
"முகங்களுக்கு இடையில் போதுமான கோணங்களைக் கொண்ட பெவல் விளிம்புகள் மட்டுமே"

#. :src: bpy.types.BevelModifier.limit_method:'WEIGHT'
msgid "Use bevel weights to determine how much bevel is applied in edge mode"
msgstr ""
"எட்ச் பயன்முறையில் பெவல் எவ்வளவு பயன்படுத்தப்படுகிறது என்பதை தீர்மானிக்க "
"பெவல் எடைகளைப் பயன்படுத்தவும்"

#. :src: bpy.types.BevelModifier.limit_method:'VGROUP'
msgid "Use vertex group weights to select whether vertex or edge is beveled"
msgstr ""
"வெர்டெக்ச் குழு எடைகளைப் பயன்படுத்தவும் வெர்டெக்ச் அல்லது எட்ச் பெவல் "
"செய்யப்பட்டதா என்பதைத் தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.BevelModifier.loop_slide
#. :src: bpy.types.MESH_OT_bevel.loop_slide
msgid "Loop Slide"
msgstr "லூப் ச்லைடு"

#. :src: bpy.types.BevelModifier.loop_slide
msgid "Prefer sliding along edges to having even widths"
msgstr "அகலங்களைக் கொண்டிருப்பதற்கு விளிம்புகளில் சறுக்குவதை விரும்புங்கள்"

#. :src: bpy.types.BevelModifier.mark_seam
#. :src: bpy.types.MESH_OT_bevel.mark_seam
#. :src: bpy.types.UV_OT_seams_from_islands.mark_seams
msgid "Mark Seams"
msgstr "மார்க் சீம்கள்"

#. :src: bpy.types.BevelModifier.mark_seam
#. :src: bpy.types.MESH_OT_bevel.mark_seam
msgid "Mark Seams along beveled edges"
msgstr "மார்க் சீம்கள் பெவல் விளிம்புகளுடன்"

#. :src: bpy.types.BevelModifier.mark_sharp
#. :src: bpy.types.MESH_OT_bevel.mark_sharp
#. :src: bpy.types.UV_OT_seams_from_islands.mark_sharp
msgid "Mark Sharp"
msgstr "மார்க் சார்ப்"

#. :src: bpy.types.BevelModifier.mark_sharp
#. :src: bpy.types.MESH_OT_bevel.mark_sharp
msgid "Mark beveled edges as sharp"
msgstr "மார்க் கூர்மையான விளிம்புகளைத் தூண்டினார்"

#. :src: bpy.types.BevelModifier.material
msgid "Material index of generated faces, -1 for automatic"
msgstr "உருவாக்கப்பட்ட முகங்களின் மூலப்பொருள் குறியீடு, தானியங்கி -1"

#. :src: bpy.types.BevelModifier.miter_inner
#. :src: bpy.types.MESH_OT_bevel.miter_inner
msgid "Inner Miter"
msgstr "உள் மிட்டர்"

#. :src: bpy.types.BevelModifier.miter_inner
#. :src: bpy.types.MESH_OT_bevel.miter_inner
msgid "Pattern to use for inside of miters"
msgstr "மைட்டர்களின் உள்ளே பயன்படுத்த வேண்டிய முறை"

#. :src: bpy.types.BevelModifier.miter_inner:'MITER_SHARP'
#. :src: bpy.types.MESH_OT_bevel.miter_inner:'SHARP'
msgid "Inside of miter is sharp"
msgstr "மிட்டரின் உள்ளே கூர்மையானது"

#. :src: bpy.types.BevelModifier.miter_inner:'MITER_ARC'
#. :src: bpy.types.BevelModifier.miter_outer:'MITER_ARC'
#. :src: bpy.types.GeometryNodeCurveArc
#. :src: bpy.types.GREASE_PENCIL_OT_primitive_arc.type:'ARC'
#. :src: bpy.types.GREASE_PENCIL_OT_primitive_box.type:'ARC'
#. :src: bpy.types.GREASE_PENCIL_OT_primitive_circle.type:'ARC'
#. :src: bpy.types.GREASE_PENCIL_OT_primitive_curve.type:'ARC'
#. :src: bpy.types.GREASE_PENCIL_OT_primitive_line.type:'ARC'
#. :src: bpy.types.GREASE_PENCIL_OT_primitive_polyline.type:'ARC'
#. :src: bpy.types.MESH_OT_bevel.miter_inner:'ARC'
#. :src: bpy.types.MESH_OT_bevel.miter_outer:'ARC'
msgid "Arc"
msgstr "வில்"

#. :src: bpy.types.BevelModifier.miter_inner:'MITER_ARC'
#. :src: bpy.types.MESH_OT_bevel.miter_inner:'ARC'
msgid "Inside of miter is arc"
msgstr "மிட்டரின் உள்ளே வில் உள்ளது"

#. :src: bpy.types.BevelModifier.miter_outer
#. :src: bpy.types.MESH_OT_bevel.miter_outer
msgid "Outer Miter"
msgstr "வெளிப்புற மிட்டர்"

#. :src: bpy.types.BevelModifier.miter_outer
#. :src: bpy.types.MESH_OT_bevel.miter_outer
msgid "Pattern to use for outside of miters"
msgstr "மைட்டர்களுக்கு வெளியே பயன்படுத்த வேண்டிய முறை"

#. :src: bpy.types.BevelModifier.miter_outer:'MITER_SHARP'
#. :src: bpy.types.MESH_OT_bevel.miter_outer:'SHARP'
msgid "Outside of miter is sharp"
msgstr "மிட்டருக்கு வெளியே கூர்மையானது"

#. :src: bpy.types.BevelModifier.miter_outer:'MITER_PATCH'
#. :src: bpy.types.MESH_OT_bevel.miter_outer:'PATCH'
msgid "Patch"
msgstr "இணைப்பு"

#. :src: bpy.types.BevelModifier.miter_outer:'MITER_PATCH'
#. :src: bpy.types.MESH_OT_bevel.miter_outer:'PATCH'
msgid "Outside of miter is squared-off patch"
msgstr "மிட்டருக்கு வெளியே ச்கொயர்-ஆஃப் ஒட்டு உள்ளது"

#. :src: bpy.types.BevelModifier.miter_outer:'MITER_ARC'
#. :src: bpy.types.MESH_OT_bevel.miter_outer:'ARC'
msgid "Outside of miter is arc"
msgstr "மிட்டருக்கு வெளியே வில் உள்ளது"

#. :src: bpy.types.BevelModifier.offset_type
#. :src: bpy.types.MESH_OT_bevel.offset_type
#: source/blender/editors/mesh/editmesh_bevel.cc:179
msgid "Width Type"
msgstr "அகலம் வகை"

#. :src: bpy.types.BevelModifier.offset_type
msgid "What distance Width measures"
msgstr "என்ன தூர அகல நடவடிக்கைகள்"

#. :src: bpy.types.BevelModifier.offset_type:'OFFSET'
#. :src: bpy.types.MESH_OT_bevel.offset_type:'OFFSET'
msgid "Amount is offset of new edges from original"
msgstr "தொகை அசலில் இருந்து புதிய விளிம்புகளை ஈடுசெய்யும்"

#. :src: bpy.types.BevelModifier.offset_type:'WIDTH'
#. :src: bpy.types.MESH_OT_bevel.offset_type:'WIDTH'
msgid "Amount is width of new face"
msgstr "தொகை புதிய முகத்தின் அகலம்"

#. :src: bpy.types.BevelModifier.offset_type:'DEPTH'
#. :src: bpy.types.MESH_OT_bevel.offset_type:'DEPTH'
msgid "Amount is perpendicular distance from original edge to bevel face"
msgstr "அளவு அசல் விளிம்பிலிருந்து முகத்தைத் தூண்டுவதற்கு செங்குத்தாக தூரம்"

#. :src: bpy.types.BevelModifier.offset_type:'PERCENT'
#. :src: bpy.types.MESH_OT_bevel.offset_type:'PERCENT'
#. :src: bpy.types.TransformStrip.translation_unit:'PERCENT'
msgid "Percent"
msgstr "விழுக்காடு"

#. :src: bpy.types.BevelModifier.offset_type:'PERCENT'
#. :src: bpy.types.MESH_OT_bevel.offset_type:'PERCENT'
msgid "Amount is percent of adjacent edge length"
msgstr "அளவு அருகிலுள்ள விளிம்பு நீளத்தின் விழுக்காடு"

#. :src: bpy.types.BevelModifier.offset_type:'ABSOLUTE'
#. :src: bpy.types.MESH_OT_bevel.offset_type:'ABSOLUTE'
msgid "Amount is absolute distance along adjacent edge"
msgstr "அளவு என்பது அருகிலுள்ள விளிம்பில் முழுமையான தூரம்"

#. :src: bpy.types.BevelModifier.profile
msgid "The profile shape (0.5 = round)"
msgstr "சுயவிவர வடிவம் (0.5 = சுற்று)"

#. :src: bpy.types.BevelModifier.profile_type
#. :src: bpy.types.MESH_OT_bevel.profile_type
#: source/blender/editors/mesh/editmesh_bevel.cc:218
msgid "Profile Type"
msgstr "சுயவிவர வகை"

#. :src: bpy.types.BevelModifier.profile_type
#. :src: bpy.types.MESH_OT_bevel.profile_type
msgid "The type of shape used to rebuild a beveled section"
msgstr ""
"ஒரு பெவெல்ட் பகுதியை மீண்டும் உருவாக்க பயன்படுத்தப்படும் வடிவத்தின் வகை"

#. :src: bpy.types.BevelModifier.profile_type:'SUPERELLIPSE'
#. :src: bpy.types.MESH_OT_bevel.profile_type:'SUPERELLIPSE'
msgid "Superellipse"
msgstr "சூப்பரெல்லிப்ச்"

#. :src: bpy.types.BevelModifier.profile_type:'SUPERELLIPSE'
#. :src: bpy.types.MESH_OT_bevel.profile_type:'SUPERELLIPSE'
msgid "The profile can be a concave or convex curve"
msgstr "சுயவிவரம் ஒரு குழிவான அல்லது குவிந்த வளைவாக இருக்கலாம்"

#. :src: bpy.types.BevelModifier.profile_type:'CUSTOM'
#. :src: bpy.types.MESH_OT_bevel.profile_type:'CUSTOM'
msgid "The profile can be any arbitrary path between its endpoints"
msgstr ""
"சுயவிவரம் அதன் இறுதிப் புள்ளிகளுக்கு இடையில் எந்த தன்னிச்சையான பாதையாக "
"இருக்கலாம்"

#. :src: bpy.types.BevelModifier.segments
msgid "Number of segments for round edges/verts"
msgstr "சுற்று விளிம்புகள்/வெர்ட்டுகளுக்கான பிரிவுகளின் எண்ணிக்கை"

