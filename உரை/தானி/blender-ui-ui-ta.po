msgid "Dead"
msgstr "இறந்துவிட்டார்"

#. :src: bpy.types.ExplodeModifier.show_dead
msgid "Show mesh when particles are dead"
msgstr "துகள்கள் இறந்தவுடன் கண்ணி காட்டு"

#. :src: bpy.types.ExplodeModifier.show_unborn
msgid "Show mesh when particles are unborn"
msgstr "துகள்கள் பிறக்காதபோது கண்ணி காட்டு"

#. :src: bpy.types.ExplodeModifier.use_edge_cut
msgid "Cut Edges"
msgstr "வெட்டு விளிம்புகள்"

#. :src: bpy.types.ExplodeModifier.use_edge_cut
msgid "Cut face edges for nicer shrapnel"
msgstr "நல்ல சிறு துண்டுக்கு முக விளிம்புகளை வெட்டுங்கள்"

#. :src: bpy.types.ExplodeModifier.use_size
msgid "Use particle size for the shrapnel"
msgstr "சிறு துண்டுக்கு துகள் அளவைப் பயன்படுத்துங்கள்"

#. :src: bpy.types.FluidModifier
msgid "Fluid Modifier"
msgstr "திரவ மாற்றியமைப்பாளர்"

#. :src: bpy.types.FluidModifier
msgid "Fluid simulation modifier"
msgstr "திரவ உருவகப்படுத்துதல் மாற்றியமைப்பாளர்"

#. :src: bpy.types.FluidModifier.fluid_type:'DOMAIN'
msgid "Container of the fluid simulation"
msgstr "திரவ உருவகப்படுத்துதலின் கொள்கலன்"

#. :src: bpy.types.FluidModifier.fluid_type:'FLOW'
msgid "Add or remove fluid to a domain object"
msgstr "ஒரு டொமைன் பொருளில் திரவத்தைச் சேர்க்கவும் அல்லது அகற்றவும்"

#. :src: bpy.types.FluidModifier.fluid_type:'EFFECTOR'
