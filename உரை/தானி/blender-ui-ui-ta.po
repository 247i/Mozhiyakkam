msgstr "தேர்ந்தெடுக்கப்பட்ட குறைந்த நாற்கை"

#. :src: bpy.types.Itasc.solver:'DLS'
msgid "DLS"
msgstr "டி.எல்.எச்"

#. :src: bpy.types.Itasc.solver:'DLS'
msgid "Damped Least Square with Numerical Filtering"
msgstr "எண் வடிகட்டலுடன் குறைந்தது சதுரத்தை நனைத்தது"

