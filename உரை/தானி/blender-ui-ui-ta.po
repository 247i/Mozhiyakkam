#. :src: bpy.types.FreestyleLineSet
#. :src: bpy.types.VIEWLAYER_PT_freestyle_lineset
msgid "Freestyle Line Set"
msgstr "ஃப்ரீபாணி வரி தொகுப்பு"

#. :src: bpy.types.FreestyleLineSet
msgid "Line set for associating lines and style parameters"
msgstr "கோடுகள் மற்றும் பாணி அளவுருக்களை இணைப்பதற்கான வரி அமைக்கப்பட்டுள்ளது"

#. :src: bpy.types.FreestyleLineSet.collection
msgid "A collection of objects based on which feature edges are selected"
msgstr ""
"எந்த அம்ச விளிம்புகள் தேர்ந்தெடுக்கப்படுகின்றன என்பதை அடிப்படையாகக் கொண்ட "
"பொருட்களின் தொகுப்பு"

#. :src: bpy.types.FreestyleLineSet.collection_negation
msgid "Collection Negation"
msgstr "சேகரிப்பு மறுப்பு"

#. :src: bpy.types.FreestyleLineSet.collection_negation
msgid ""
"Specify either inclusion or exclusion of feature edges belonging to a "
"collection of objects"
msgstr ""
"பொருள்களின் தொகுப்பிற்கு சொந்தமான அம்ச விளிம்புகளைச் சேர்ப்பது அல்லது "
"விலக்குவதைக் குறிப்பிடவும்"

#. :src: bpy.types.FreestyleLineSet.collection_negation:'INCLUSIVE'
#. :src: bpy.types.FreestyleLineSet.edge_type_negation:'INCLUSIVE'
#. :src: bpy.types.FreestyleLineSet.face_mark_negation:'INCLUSIVE'
msgid "Inclusive"
msgstr "உள்ளடக்கிய"

#. :src: bpy.types.FreestyleLineSet.collection_negation:'INCLUSIVE'
msgid "Select feature edges belonging to some object in the group"
msgstr ""
"குழுவில் உள்ள சில பொருளுக்கு சொந்தமான அம்ச விளிம்புகளைத் தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.FreestyleLineSet.collection_negation:'EXCLUSIVE'
#. :src: bpy.types.FreestyleLineSet.edge_type_negation:'EXCLUSIVE'
#. :src: bpy.types.FreestyleLineSet.face_mark_negation:'EXCLUSIVE'
msgid "Exclusive"
msgstr "பிரத்தியேக"

#. :src: bpy.types.FreestyleLineSet.collection_negation:'EXCLUSIVE'
msgid "Select feature edges not belonging to any object in the group"
msgstr ""
"குழுவில் உள்ள எந்தவொரு பொருளுக்கும் சொந்தமில்லாத அம்ச விளிம்புகளைத் "
"தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.FreestyleLineSet.edge_type_combination
msgid "Edge Type Combination"
msgstr "விளிம்பு வகை சேர்க்கை"

#. :src: bpy.types.FreestyleLineSet.edge_type_combination
msgid ""
"Specify a logical combination of selection conditions on feature edge types"
msgstr ""
"அம்ச விளிம்பு வகைகளில் தேர்வு நிலைமைகளின் தர்க்கரீதியான கலவையைக் "
"குறிப்பிடவும்"

#. :src: bpy.types.FreestyleLineSet.edge_type_combination:'OR'
msgid "Logical OR"
msgstr "தர்க்கரீதியான அல்லது"

#. :src: bpy.types.FreestyleLineSet.edge_type_combination:'OR'
msgid "Select feature edges satisfying at least one of edge type conditions"
msgstr ""
"எட்ச் வகை நிபந்தனைகளில் ஒன்றை திருப்திப்படுத்தும் அம்ச விளிம்புகளைத் "
"தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.FreestyleLineSet.edge_type_combination:'AND'
msgid "Logical AND"
msgstr "தர்க்கரீதியான மற்றும்"

#. :src: bpy.types.FreestyleLineSet.edge_type_combination:'AND'
msgid "Select feature edges satisfying all edge type conditions"
msgstr ""
"அனைத்து விளிம்பு வகை நிபந்தனைகளையும் நிறைவு செய்யும் அம்ச விளிம்புகளைத் "
"தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.FreestyleLineSet.edge_type_negation
msgid "Edge Type Negation"
msgstr "விளிம்பு வகை மறுப்பு"

#. :src: bpy.types.FreestyleLineSet.edge_type_negation
msgid ""
"Specify either inclusion or exclusion of feature edges selected by edge "
"types"
msgstr ""
"விளிம்பு வகைகளால் தேர்ந்தெடுக்கப்பட்ட அம்ச விளிம்புகளைச் சேர்ப்பது அல்லது "
"விலக்குவதைக் குறிப்பிடவும்"

#. :src: bpy.types.FreestyleLineSet.edge_type_negation:'INCLUSIVE'
msgid "Select feature edges satisfying the given edge type conditions"
msgstr ""
"கொடுக்கப்பட்ட விளிம்பு வகை நிபந்தனைகளை நிறைவு செய்யும் அம்ச விளிம்புகளைத் "
"தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.FreestyleLineSet.edge_type_negation:'EXCLUSIVE'
msgid "Select feature edges not satisfying the given edge type conditions"
msgstr ""
"கொடுக்கப்பட்ட விளிம்பு வகை நிபந்தனைகளை நிறைவு செய்யாத அம்ச விளிம்புகளைத் "
"தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.FreestyleLineSet.exclude_border
#. :src: bpy.types.FreestyleLineSet.select_border
msgid "Border"
msgstr "எல்லை"

#. :src: bpy.types.FreestyleLineSet.exclude_border
msgid "Exclude border edges"
msgstr "எல்லை விளிம்புகளை விலக்கு"

#. :src: bpy.types.FreestyleLineSet.exclude_contour
#. :src: bpy.types.FreestyleLineSet.select_contour
#. :src: bpy.types.GreasePencilLineartModifier.silhouette_filtering:'NONE'
msgid "Contour"
msgstr "விளிம்பு"

#. :src: bpy.types.FreestyleLineSet.exclude_contour
msgid "Exclude contours"
msgstr "வரையறைகளை விலக்கவும்"

