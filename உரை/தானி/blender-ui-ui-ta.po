#. :src: bpy.types.SpotLight
msgid "Directional cone Light"
msgstr "திசை கூம்பு ஒளி"

#. :src: bpy.types.SpotLight.energy
msgid ""
"The energy this light would emit over its entire area if it wasn't limited "
"by the spot angle, in units of radiant power (W)"
msgstr ""
"கதிரியக்க சக்தியின் அலகுகளில் (W) ச்பாட் கோணத்தால் "
"மட்டுப்படுத்தப்படாவிட்டால் இந்த ஒளி அதன் முழு பகுதியிலும் வெளிவரும் ஆற்றல் "
"வெளிப்படும்"

#. :src: bpy.types.SpotLight.show_cone
msgid "Show Cone"
msgstr "கோன் காட்டு"

#. :src: bpy.types.SpotLight.show_cone
msgid ""
"Display transparent cone in 3D view to visualize which objects are contained"
" in it"
msgstr ""
"3d பார்வையில் வெளிப்படையான கூம்பைக் காண்பி, அதில் எந்த பொருள்கள் உள்ளன "
"என்பதைக் காணலாம்"

#. :src: bpy.types.SpotLight.spot_blend
msgid "Spot Blend"
msgstr "ச்பாட் கலவை"

#. :src: bpy.types.SpotLight.spot_blend
msgid "The softness of the spotlight edge"
msgstr "ச்பாட்லைட் விளிம்பின் மென்மையாகும்"

#. :src: bpy.types.SpotLight.spot_size
#: scripts/addons_core/cycles/ui.py:1638
msgid "Spot Size"
msgstr "ச்பாட் அளவு"

#. :src: bpy.types.SpotLight.spot_size
msgid "Angle of the spotlight beam"
msgstr "ச்பாட்லைட் கற்றை கோணம்"

#. :src: bpy.types.SpotLight.use_square
msgid "Cast a square spot light shape"
msgstr "ஒரு சதுர ச்பாட் ஒளி வடிவத்தை செலுத்துங்கள்"

#. :src: bpy.types.SunLight
msgid "Sun Light"
msgstr "சூரிய ஒளி"

#. :src: bpy.types.SunLight
msgid "Constant direction parallel ray Light"
msgstr "நிலையான திசை இணை கதிர் ஒளி"

#. :src: bpy.types.SunLight.angle
#. :src: bpy.types.World.sun_angle
msgid "Angular diameter of the Sun as seen from the Earth"
msgstr "பூமியிலிருந்து பார்த்தபடி சூரியனின் கோண விட்டம்"

#. :src: bpy.types.SunLight.energy
msgctxt "Light"
msgid "Strength"
msgstr "வலிமை"

#. :src: bpy.types.SunLight.energy
msgid "Sunlight strength in watts per meter squared (W/m²)"
msgstr "ஒரு மீட்டர் சதுரத்திற்கு வாட்சில் சூரிய ஒளி வலிமை (w/m²)"

#. :src: bpy.types.SunLight.shadow_cascade_count
msgid "Cascade Count"
msgstr "அடுக்கை எண்ணிக்கை"

#. :src: bpy.types.SunLight.shadow_cascade_count
msgid "Number of texture used by the cascaded shadow map"
msgstr "அடுக்கு நிழல் வரைபடத்தால் பயன்படுத்தப்படும் அமைப்பின் எண்ணிக்கை"

#. :src: bpy.types.SunLight.shadow_cascade_exponent
msgid "Exponential Distribution"
msgstr "அதிவேக வழங்கல்"

#. :src: bpy.types.SunLight.shadow_cascade_exponent
msgid "Higher value increase resolution towards the viewpoint"
msgstr "அதிக மதிப்பு கண்ணோட்டத்தை நோக்கிய தீர்மானத்தை அதிகரிக்கும்"

#. :src: bpy.types.SunLight.shadow_cascade_fade
msgid "Cascade Fade"
msgstr "அடுக்கை மங்கிவிடும்"

#. :src: bpy.types.SunLight.shadow_cascade_fade
msgid "How smooth is the transition between each cascade"
msgstr "ஒவ்வொரு அடுக்குக்கும் இடையிலான மாற்றம் எவ்வளவு மென்மையானது"

#. :src: bpy.types.SunLight.shadow_cascade_max_distance
msgid "Cascade Max Distance"
msgstr "அடுக்கை அதிகபட்ச தூரம்"

#. :src: bpy.types.SunLight.shadow_cascade_max_distance
msgid "End distance of the cascaded shadow map (only in perspective view)"
msgstr "அடுக்கு நிழல் வரைபடத்தின் இறுதி தூரம் (முன்னோக்கு பார்வையில் மட்டுமே)"

#. :src: bpy.types.LightProbe
msgid "Light Probe data-block for lighting capture objects"
msgstr "லைட்டிங் பிடிப்பு பொருள்களுக்கான ஒளி ஆய்வு தரவு-தொகுதி"

#. :src: bpy.types.LightProbe.clip_start
msgid "Probe clip start, below which objects will not appear in reflections"
msgstr "ஆய்வு கிளிப் தொடக்க, கீழே எந்த பொருள்கள் பிரதிபலிப்புகளில் தோன்றாது"

#. :src: bpy.types.LightProbe.data_display_size
msgid "Display Data Size"
msgstr "தரவு அளவைக் காண்பி"

#. :src: bpy.types.LightProbe.data_display_size
msgid "Viewport display size of the sampled data"
msgstr "மாதிரி தரவின் காட்சிதுறைமுகம் காட்டும் அளவு"

#. :src: bpy.types.LightProbe.influence_distance
msgid "Influence Distance"
msgstr "செல்வாக்கு தூரம்"

#. :src: bpy.types.LightProbe.influence_distance
msgid "Influence distance of the probe"
msgstr "ஆய்வின் தூரம்"

#. :src: bpy.types.LightProbe.invert_visibility_collection
msgid "Invert Collection"
msgstr "தலைகீழ் சேகரிப்பு"

#. :src: bpy.types.LightProbe.invert_visibility_collection
msgid "Invert visibility collection (Deprecated)"
msgstr "தலைகீழ் தெரிவுநிலை சேகரிப்பு (நீக்கப்பட்டது)"

#. :src: bpy.types.LightProbe.show_clip
msgid "Show the clipping distances in the 3D view"
msgstr "3d பார்வையில் கிளிப்பிங் தூரங்களைக் காட்டுங்கள்"

#. :src: bpy.types.LightProbe.show_data
msgid "Display Data (Deprecated)"
msgstr "தரவைக் காண்பி (நீக்கப்பட்டது)"

#. :src: bpy.types.LightProbe.show_data
msgid "Deprecated, use use_data_display instead"
msgstr "நீக்கப்பட்டது, அதற்கு பதிலாக use_data_display ஐப் பயன்படுத்தவும்"

#. :src: bpy.types.LightProbe.show_influence
msgid "Show the influence volume in the 3D view"
msgstr "3d பார்வையில் செல்வாக்கு அளவைக் காட்டுங்கள்"

#. :src: bpy.types.LightProbe.type
msgid "Type of light probe"
msgstr "ஒளி ஆய்வு வகை"

#. :src: bpy.types.LightProbe.type:'SPHERE'
#. :src: bpy.types.LightProbeSphere
#. :src: bpy.types.OBJECT_OT_lightprobe_add.type:'SPHERE'
msgid ""
"Light probe that captures precise lighting from all directions at a single "
"point in space"
msgstr ""
"விண்வெளியில் ஒரே கட்டத்தில் எல்லா திசைகளிலிருந்தும் துல்லியமான விளக்குகளைப் "
"பிடிக்கும் ஒளி ஆய்வு"

#. :src: bpy.types.LightProbe.type:'PLANE'
#. :src: bpy.types.LightProbePlane
#. :src: bpy.types.OBJECT_OT_lightprobe_add.type:'PLANE'
msgid ""
"Light probe that captures incoming light from a single direction on a plane"
msgstr ""
"ஒரு விமானத்தில் ஒரு திசையிலிருந்து உள்வரும் ஒளியைப் பிடிக்கும் ஒளி ஆய்வு"

#. :src: bpy.types.LightProbe.type:'VOLUME'
#. :src: bpy.types.LightProbeVolume
#. :src: bpy.types.OBJECT_OT_lightprobe_add.type:'VOLUME'
msgid "Light probe that captures low frequency lighting inside a volume"
msgstr "ஒரு தொகுதிக்குள் குறைந்த அதிர்வெண் விளக்குகளைப் பிடிக்கும் ஒளி ஆய்வு"

#. :src: bpy.types.LightProbe.use_data_display
msgid "Display Data"
msgstr "தரவைக் காண்பி"

#. :src: bpy.types.LightProbe.use_data_display
msgid "Display sampled data in the viewport to debug captured light"
msgstr ""
"கைப்பற்றப்பட்ட ஒளியை பிழைத்திருத்தத்திற்கு காட்சிப் பகுதியில் மாதிரி தரவைக் "
"காண்பி"

#. :src: bpy.types.LightProbe.visibility_bleed_bias
msgid "Visibility Bleed Bias"
msgstr "தெரிவுநிலை இரத்தம் சார்பு"

#. :src: bpy.types.LightProbe.visibility_bleed_bias
msgid "Bias for reducing light-bleed on variance shadow maps (Deprecated)"
msgstr ""
"மாறுபாடு நிழல் வரைபடங்களில் ஒளியைக் குறைப்பதற்கான சார்பு (நீக்கப்பட்டது)"

#. :src: bpy.types.LightProbe.visibility_blur
msgid "Visibility Blur"
msgstr "தெரிவுநிலை மங்கலானது"

#. :src: bpy.types.LightProbe.visibility_blur
msgid "Filter size of the visibility blur (Deprecated)"
msgstr "தெரிவுநிலை மங்கலின் வடிகட்டி அளவு (நீக்கப்பட்டது)"

#. :src: bpy.types.LightProbe.visibility_buffer_bias
msgid "Visibility Bias"
msgstr "தெரிவுநிலை சார்பு"

#. :src: bpy.types.LightProbe.visibility_buffer_bias
msgid "Bias for reducing self shadowing (Deprecated)"
msgstr "தன்வய நிழலைக் குறைப்பதற்கான சார்பு (நீக்கப்பட்டது)"

#. :src: bpy.types.LightProbe.visibility_collection
msgid "Visibility Collection"
msgstr "தெரிவுநிலை சேகரிப்பு"

#. :src: bpy.types.LightProbe.visibility_collection
msgid "Restrict objects visible for this probe (Deprecated)"
msgstr ""
"இந்த ஆய்வுக்கு தெரியும் பொருள்களைக் கட்டுப்படுத்துங்கள் (நீக்கப்பட்டது)"

#. :src: bpy.types.LightProbePlane
msgid "Planar Probe"
msgstr "பிளானர் ஆய்வு"

#. :src: bpy.types.LightProbeSphere
msgid "Spherical Probe"
msgstr "கோள ஆய்வு"

#. :src: bpy.types.LightProbeSphere.clip_end
msgid "Probe clip end, beyond which objects will not appear in reflections"
msgstr "ஆய்வு கிளிப் முடிவு, எந்த பொருள்களை பிரதிபலிப்புகளில் தோன்றாது"

#. :src: bpy.types.LightProbeSphere.falloff
msgid "Control how fast the probe influence decreases"
msgstr "ஆய்வு செல்வாக்கு எவ்வளவு வேகமாக குறைகிறது என்பதைக் கட்டுப்படுத்தவும்"

#. :src: bpy.types.LightProbeSphere.influence_type
msgid "Type of influence volume"
msgstr "செல்வாக்கு தொகுதி வகை"

#. :src: bpy.types.LightProbeSphere.parallax_distance
msgid "Parallax Radius"
msgstr "இடமாறு ஆரம்"

#. :src: bpy.types.LightProbeSphere.parallax_distance
msgid "Lowest corner of the parallax bounding box"
msgstr "இடமாறு எல்லை பெட்டியின் மிகக் குறைந்த மூலையில்"

#. :src: bpy.types.LightProbeSphere.parallax_type
msgid "Type of parallax volume"
msgstr "இடமாறு தொகுதி வகை"

#. :src: bpy.types.LightProbeSphere.show_parallax
msgid "Parallax"
msgstr "இடமாறு"

#. :src: bpy.types.LightProbeSphere.show_parallax
msgid "Show the parallax correction volume in the 3D view"
msgstr "3d பார்வையில் இடமாறு திருத்தம் அளவைக் காட்டு"

#. :src: bpy.types.LightProbeSphere.use_custom_parallax
msgid "Use Custom Parallax"
msgstr "தனிப்பயன் இடமாறு பயன்படுத்தவும்"

#. :src: bpy.types.LightProbeSphere.use_custom_parallax
msgid "Enable custom settings for the parallax correction volume"
msgstr "இடமாறு திருத்தம் தொகுதிக்கு தனிப்பயன் அமைப்புகளை இயக்கவும்"

#. :src: bpy.types.LightProbeVolume
msgid "Volume Probe"
msgstr "தொகுதி ஆய்வு"

#. :src: bpy.types.LightProbeVolume.bake_samples
msgid "Bake Samples"
msgstr "சுட்டுக்கொள்ள மாதிரிகள்"

#. :src: bpy.types.LightProbeVolume.bake_samples
msgid "Number of ray directions to evaluate when baking"
msgstr "பேக்கிங் செய்யும் போது மதிப்பீடு செய்ய கதிர் திசைகளின் எண்ணிக்கை"

#. :src: bpy.types.LightProbeVolume.capture_distance
msgid "Capture Distance"
msgstr "படப்பிடிப்பு தூரம்"

#. :src: bpy.types.LightProbeVolume.capture_distance
msgid ""
"Distance around the probe volume that will be considered during the bake"
msgstr ""
"சுட்டுக்கொள்ளும் போது பரிசீலிக்கப்படும் ஆய்வு அளவைச் சுற்றியுள்ள தூரம்"

#. :src: bpy.types.LightProbeVolume.capture_emission
msgid "Capture Emission"
msgstr "உமிழ்வைப் பிடிக்கவும்"

#. :src: bpy.types.LightProbeVolume.capture_emission
msgid "Bake emissive surfaces for more accurate lighting"
msgstr ""
"மிகவும் துல்லியமான விளக்குகளுக்கு உமிழ்வு மேற்பரப்புகளை சுட்டுக்கொள்ளுங்கள்"

#. :src: bpy.types.LightProbeVolume.capture_indirect
msgid "Capture Indirect"
msgstr "மறைமுகமாக பிடிக்கவும்"

#. :src: bpy.types.LightProbeVolume.capture_indirect
msgid "Bake light bounces from light sources for more accurate lighting"
msgstr ""
"சுட்டுக்கொள்ள ஒளி மிகவும் துல்லியமான விளக்குகளுக்கு ஒளி மூலங்களிலிருந்து "
"துள்ளுகிறது"

#. :src: bpy.types.LightProbeVolume.capture_world
msgid "Capture World"
msgstr "உலகத்தைப் பிடிக்கவும்"

#. :src: bpy.types.LightProbeVolume.capture_world
msgid ""
"Bake incoming light from the world instead of just the visibility for more "
"accurate lighting, but lose correct blending to surrounding irradiance "
"volumes"
msgstr ""
"மிகவும் துல்லியமான விளக்குகளுக்கான தெரிவுநிலைக்கு பதிலாக உலகத்திலிருந்து "
"உள்வரும் ஒளியை சுட்டுக்கொள்ளுங்கள், ஆனால் சுற்றியுள்ள கதிர்வீச்சு "
"தொகுதிகளுக்கு சரியான கலவையை இழக்கவும்"

#. :src: bpy.types.LightProbeVolume.clamp_direct
#. :src: bpy.types.CyclesRenderSettings.sample_clamp_direct
msgid "Clamp Direct"
msgstr "கயிறு நேரடி"

#. :src: bpy.types.LightProbeVolume.clamp_direct
msgid "Clamp the direct lighting intensity to reduce noise (0 to disable)"
msgstr ""
"சத்தத்தைக் குறைக்க நேரடி விளக்கு தீவிரத்தை கட்டுப்படுத்தவும் (முடக்க 0)"

#. :src: bpy.types.LightProbeVolume.clamp_indirect
#. :src: bpy.types.CyclesRenderSettings.sample_clamp_indirect
msgid "Clamp Indirect"
msgstr "கெட் மறைமுக"

#. :src: bpy.types.LightProbeVolume.clamp_indirect
msgid "Clamp the indirect lighting intensity to reduce noise (0 to disable)"
msgstr ""
"சத்தத்தைக் குறைக்க மறைமுக விளக்கு தீவிரத்தை கட்டுப்படுத்தவும் (முடக்க 0)"

#. :src: bpy.types.LightProbeVolume.dilation_radius
msgid "Dilation Radius"
msgstr "டைலேசன் ஆரம்"

#. :src: bpy.types.LightProbeVolume.dilation_radius
msgid ""
"Radius in grid sample to search valid grid samples to copy into invalid grid"
" samples"
msgstr ""
"தவறான கட்டம் மாதிரிகளில் நகலெடுக்க செல்லுபடியாகும் கட்டம் மாதிரிகளைத் தேட "
"கட்டம் மாதிரியில் உள்ள ஆரம்"

#. :src: bpy.types.LightProbeVolume.dilation_threshold
msgid "Dilation Threshold"
msgstr "டைலேசன் த்ரெசோல்ட்"

#. :src: bpy.types.LightProbeVolume.dilation_threshold
msgid ""
"Ratio of front-facing surface hits under which a grid sample will reuse "
"neighbors grid sample lighting"
msgstr ""
"முன் எதிர்கொள்ளும் மேற்பரப்பு வெற்றிகளின் விகிதம், இதன் கீழ் ஒரு கட்டம் "
"மாதிரி அண்டை கட்டம் மாதிரி விளக்குகளை மீண்டும் பயன்படுத்தும்"

#. :src: bpy.types.LightProbeVolume.escape_bias
msgid "Search Distance"
msgstr "தேடல் தூரம்"

#. :src: bpy.types.LightProbeVolume.escape_bias
msgid ""
"Distance to search for valid capture positions to prevent lighting artifacts"
msgstr ""
"லைட்டிங் கலைப்பொருட்களைத் தடுக்க செல்லுபடியாகும் பிடிப்பு நிலைகளைத் "
"தேடுவதற்கான தூரம்"

#. :src: bpy.types.LightProbeVolume.facing_bias
msgid "Facing Bias"
msgstr "எதிர்கொள்ளும் சார்பு"

#. :src: bpy.types.LightProbeVolume.facing_bias
msgid "Smoother irradiance interpolation but introduce light bleeding"
msgstr ""
"மென்மையான கதிர்வீச்சு இடைக்கணிப்பு ஆனால் ஒளி இரத்தப்போக்கு "
"அறிமுகப்படுத்துகிறது"

