#. :src: bpy.types.SEQUENCER_OT_select_grouped.type:'EFFECT'
#: source/blender/sequencer/intern/utils.cc:176
msgid "Effect"
msgstr "விளைவு"

#. :src: bpy.types.SEQUENCER_OT_select_grouped.type:'EFFECT'
