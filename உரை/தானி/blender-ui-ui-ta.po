msgstr "ஆட்சிக்கு காசியன் மங்கலைப் பயன்படுத்துங்கள்"

#. :src: bpy.types.OBJECT_OT_shaderfx_add.type:'FX_COLORIZE'
#. :src: bpy.types.ShaderFx.type:'FX_COLORIZE'
msgctxt "ID"
msgid "Colorize"
msgstr "வண்ணமயமாக்கல்"

