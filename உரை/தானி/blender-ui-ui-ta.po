msgstr ".Vdb கோப்பிலிருந்து தொகுதி தரவை இறக்குமதி செய்யுங்கள்"

#. :src: bpy.types.GeometryNodeIndexOfNearest
#: source/blender/nodes/geometry/nodes/node_geo_index_of_nearest.cc:60
msgid "Index of Nearest"
msgstr "அருகிலுள்ள அட்டவணை"

#. :src: bpy.types.GeometryNodeIndexOfNearest
msgid ""
"Find the nearest element in a group. Similar to the \"Sample Nearest\" node"
msgstr ""
"ஒரு குழுவில் அருகிலுள்ள உறுப்பைக் கண்டறியவும். \"மாதிரி அருகிலுள்ள\" "
"முனைக்கு ஒத்ததாகும்"

#. :src: bpy.types.GeometryNodeIndexSwitch
msgid "Index Switch"
msgstr "குறியீட்டு சுவிட்ச்"

#. :src: bpy.types.GeometryNodeIndexSwitch
msgid "Choose between an arbitrary number of values with an index"
msgstr ""
"ஒரு குறியீட்டைக் கொண்டு தன்னிச்சையான மதிப்புகளின் எண்ணிக்கைக்கு இடையே தேர்வு"
" செய்யவும்"

#. :src: bpy.types.GeometryNodeInputActiveCamera
msgid "Retrieve the scene's active camera"
msgstr "காட்சியின் செயலில் உள்ள கேமராவை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeInputCollection
msgid "Output a single collection"
msgstr "ஒற்றை சேகரிப்பை வெளியிடுங்கள்"

#. :src: bpy.types.GeometryNodeInputCurveHandlePositions
msgid "Curve Handle Positions"
msgstr "வளைவு கைப்பிடி நிலைகள்"

#. :src: bpy.types.GeometryNodeInputCurveHandlePositions
msgid "Retrieve the position of each Bézier control point's handles"
msgstr ""
"ஒவ்வொரு பெசியர் கட்டுப்பாட்டு புள்ளியின் கைப்பிடிகளின் நிலையை "
"மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeInputCurveTilt
msgid "Curve Tilt"
msgstr "வளைவு சாய்வு"

#. :src: bpy.types.GeometryNodeInputCurveTilt
msgid ""
"Retrieve the angle at each control point used to twist the curve's normal "
"around its tangent"
msgstr ""
"வளைவின் இயல்பை அதன் தொடுகோடு திருப்பப் பயன்படுத்தப்படும் ஒவ்வொரு "
"கட்டுப்பாட்டு புள்ளியிலும் கோணத்தை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeInputEdgeSmooth
msgid "Is Edge Smooth"
msgstr "விளிம்பு மென்மையானது"

#. :src: bpy.types.GeometryNodeInputEdgeSmooth
msgid "Retrieve whether each edge is marked for smooth or split normals"
msgstr ""
"ஒவ்வொரு விளிம்பும் மென்மையான அல்லது பிளவுபட்ட இயல்புகளுக்காக "
"குறிக்கப்பட்டுள்ளதா என்பதை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeInputID
msgid ""
"Retrieve a stable random identifier value from the \"id\" attribute on the "
"point domain, or the index if the attribute does not exist"
msgstr ""
"புள்ளி டொமைனில் உள்ள \"ஐடி\" பண்புக்கூறில் இருந்து நிலையான சீரற்ற "
"அடையாளங்காட்டி மதிப்பை மீட்டெடுக்கவும் அல்லது பண்புக்கூறு இல்லாவிட்டால் "
"குறியீட்டை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeInputImage
msgid "Input an image data-block"
msgstr "பட தரவு-தொகுதியை உள்ளிடவும்"

#. :src: bpy.types.GeometryNodeInputIndex
msgid ""
"Retrieve an integer value indicating the position of each element in the "
"list, starting at zero"
msgstr ""
"பூச்சியத்தில் தொடங்கி, பட்டியலில் உள்ள ஒவ்வொரு உறுப்பின் நிலையையும் "
"குறிக்கும் ஒரு முழுஎண் மதிப்பை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeInputInstanceBounds
msgid "Instance Bounds"
msgstr "நிகழ்வு எல்லைகள்"

#. :src: bpy.types.GeometryNodeInputInstanceBounds
msgid "Calculate position bounds of each instance's geometry set"
msgstr "ஒவ்வொரு நிகழ்வின் வடிவியல் தொகுப்பின் நிலை வரம்புகளைக் கணக்கிடுங்கள்"

#. :src: bpy.types.GeometryNodeInputInstanceRotation
msgid "Instance Rotation"
msgstr "நிகழ்வு சுழற்சி"

#. :src: bpy.types.GeometryNodeInputInstanceRotation
msgid "Retrieve the rotation of each instance in the geometry"
msgstr "வடிவவியலில் ஒவ்வொரு நிகழ்வின் சுழற்சியை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeInputInstanceScale
msgid "Instance Scale"
msgstr "நிகழ்வு அளவு"

#. :src: bpy.types.GeometryNodeInputInstanceScale
msgid "Retrieve the scale of each instance in the geometry"
msgstr "வடிவவியலில் ஒவ்வொரு நிகழ்வின் அளவை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeInputMaterial
msgid "Output a single material"
msgstr "ஒற்றை மூலப்பொருளை வெளியிடுங்கள்"

#. :src: bpy.types.GeometryNodeInputMaterialIndex
msgid ""
"Retrieve the index of the material used for each element in the geometry's "
"list of materials"
msgstr ""
"வடிவவியலின் மூலப்பொருட்களின் பட்டியலில் உள்ள ஒவ்வொரு உறுப்புக்கும் "
"பயன்படுத்தப்படும் மூலப்பொருளின் குறியீட்டை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeInputMeshEdgeAngle
#. :src: bpy.types.View3DOverlay.show_extra_edge_angle
#: scripts/startup/bl_ui/space_view3d.py:7329
#: source/blender/modifiers/intern/MOD_edgesplit.cc:141
msgid "Edge Angle"
msgstr "விளிம்பு கோணம்"

#. :src: bpy.types.GeometryNodeInputMeshEdgeAngle
msgid "The angle between the normals of connected manifold faces"
msgstr "இணைக்கப்பட்ட பன்மடங்கு முகங்களின் இயல்புகளுக்கு இடையிலான கோணம்"

#. :src: bpy.types.GeometryNodeInputMeshEdgeNeighbors
msgid "Edge Neighbors"
msgstr "எட்ச் அயலவர்கள்"

#. :src: bpy.types.GeometryNodeInputMeshEdgeNeighbors
msgid "Retrieve the number of faces that use each edge as one of their sides"
msgstr ""
"ஒவ்வொரு விளிம்பையும் அவற்றின் பக்கங்களில் ஒன்றாகப் பயன்படுத்தும் முகங்களின் "
"எண்ணிக்கையை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeInputMeshEdgeVertices
msgid "Edge Vertices"
msgstr "விளிம்பு செங்குத்துகள்"

#. :src: bpy.types.GeometryNodeInputMeshEdgeVertices
msgid "Retrieve topology information relating to each edge of a mesh"
msgstr ""
"ஒரு கண்ணி ஒவ்வொரு விளிம்பிலும் தொடர்புடைய இடவியல் தகவல்களை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeInputMeshFaceArea
msgid "Calculate the surface area of a mesh's faces"
msgstr "ஒரு கண்ணி முகங்களின் மேற்பரப்பு பரப்பைக் கணக்கிடுங்கள்"

#. :src: bpy.types.GeometryNodeInputMeshFaceIsPlanar
msgid "Is Face Planar"
msgstr "முகம் பிளானர்"

#. :src: bpy.types.GeometryNodeInputMeshFaceIsPlanar
msgid ""
"Retrieve whether all triangles in a face are on the same plane, i.e. whether"
" they have the same normal"
msgstr ""
"ஒரு முகத்தில் உள்ள அனைத்து முக்கோணங்களும் ஒரே விமானத்தில் இருக்கிறதா என்பதை "
"மீட்டெடுக்கவும், அதாவது அவை இயல்பானதா என்பதை"

#. :src: bpy.types.GeometryNodeInputMeshFaceNeighbors
msgid "Face Neighbors"
msgstr "அண்டை வீட்டாரை எதிர்கொள்ளுங்கள்"

#. :src: bpy.types.GeometryNodeInputMeshFaceNeighbors
msgid "Retrieve topology information relating to each face of a mesh"
msgstr "ஒரு கண்ணி ஒவ்வொரு முகமும் தொடர்பான இடவியல் தகவல்களை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeInputMeshIsland
msgid "Mesh Island"
msgstr "மெச் தீவு"

#. :src: bpy.types.GeometryNodeInputMeshIsland
msgid "Retrieve information about separate connected regions in a mesh"
msgstr ""
"தனித்தனி இணைக்கப்பட்ட பகுதிகள் பற்றிய தகவல்களை ஒரு கண்ணி இல் மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeInputMeshVertexNeighbors
msgid "Vertex Neighbors"
msgstr "வெர்டெக்ச் அயலவர்கள்"

#. :src: bpy.types.GeometryNodeInputMeshVertexNeighbors
msgid "Retrieve topology information relating to each vertex of a mesh"
msgstr ""
"ஒரு கண்ணி ஒவ்வொரு வெர்டெக்ச் தொடர்பான இடவியல் தகவல்களை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeInputNamedAttribute
msgid "Named Attribute"
msgstr "பெயரிடப்பட்ட பண்புக்கூறு"

#. :src: bpy.types.GeometryNodeInputNamedAttribute
msgid "Retrieve the data of a specified attribute"
msgstr "ஒரு குறிப்பிட்ட பண்புக்கூறு தரவை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeInputNamedAttribute.data_type
msgid "The data type used to read the attribute values"
msgstr "பண்புக்கூறு மதிப்புகளைப் படிக்க பயன்படுத்தப்படும் தரவு வகை"

#. :src: bpy.types.GeometryNodeInputNamedLayerSelection
msgid "Named Layer Selection"
msgstr "லேயர் தேர்வு என்று பெயரிடப்பட்டது"

#. :src: bpy.types.GeometryNodeInputNamedLayerSelection
msgid "Output a selection of a Grease Pencil layer"
msgstr "கிரீச் பென்சில் அடுக்கின் தேர்வு"

#. :src: bpy.types.GeometryNodeInputNormal
msgid ""
"Retrieve a unit length vector indicating the direction pointing away from "
"the geometry at each element"
msgstr ""
"ஒவ்வொரு உறுப்பிலும் வடிவவியலில் இருந்து விலகிச் செல்லும் திசையைக் குறிக்கும்"
" ஒரு அலகு நீள திசையனை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeInputNormal.legacy_corner_normals
msgid "Flat Corner Normals"
msgstr "தட்டையான மூலையில் இயல்புகள்"

#. :src: bpy.types.GeometryNodeInputNormal.legacy_corner_normals
msgid ""
"Always use face normals for the face corner domain, matching old behavior of"
" the node"
msgstr ""
"முகம் மூலையில் உள்ள டொமைனுக்கு எப்போதும் முக இயல்புகளைப் பயன்படுத்துங்கள், "
"முனையின் பழைய நடத்தைக்கு பொருந்தும்"

#. :src: bpy.types.GeometryNodeInputObject
msgid "Output a single object"
msgstr "ஒரு பொருளை வெளியிடுங்கள்"

#. :src: bpy.types.GeometryNodeInputPosition
msgid "Retrieve a vector indicating the location of each element"
msgstr "ஒவ்வொரு உறுப்பின் இருப்பிடத்தைக் குறிக்கும் திசையனை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeInputRadius
msgid "Retrieve the radius at each point on curve or point cloud geometry"
msgstr ""
"வளைவு அல்லது புள்ளி முகில் வடிவவியலில் ஒவ்வொரு புள்ளியிலும் ஆரம் "
"மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeInputSceneTime
msgid ""
"Retrieve the current time in the scene's animation in units of seconds or "
"frames"
msgstr ""
"காட்சியின் அனிமேசனில் தற்போதைய நேரத்தை விநாடிகள் அல்லது பிரேம்களின் "
"அலகுகளில் மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeInputShadeSmooth
msgid "Is Face Smooth"
msgstr "முகம் மென்மையானது"

#. :src: bpy.types.GeometryNodeInputShadeSmooth
msgid "Retrieve whether each face is marked for smooth or sharp normals"
msgstr ""
"ஒவ்வொரு முகமும் மென்மையான அல்லது கூர்மையான இயல்புகளுக்காக "
"குறிக்கப்பட்டுள்ளதா என்பதை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeInputShortestEdgePaths
msgid "Shortest Edge Paths"
msgstr "குறுகிய விளிம்பு பாதைகள்"

#. :src: bpy.types.GeometryNodeInputShortestEdgePaths
msgid ""
"Find the shortest paths along mesh edges to selected end vertices, with "
"customizable cost per edge"
msgstr ""
"ஒரு விளிம்பிற்கு தனிப்பயனாக்கக்கூடிய செலவில், தேர்ந்தெடுக்கப்பட்ட இறுதி "
"செங்குத்துகளுக்கு கண்ணி விளிம்புகளுடன் குறுகிய பாதைகளைக் கண்டறியவும்"

#. :src: bpy.types.GeometryNodeInputSplineCyclic
msgid "Is Spline Cyclic"
msgstr "ச்ப்லைன் சுழற்சி"

#. :src: bpy.types.GeometryNodeInputSplineCyclic
msgid "Retrieve whether each spline endpoint connects to the beginning"
msgstr ""
"ஒவ்வொரு ச்ப்லைன் இறுதிப்புள்ளி தொடக்கத்துடன் இணைக்கிறதா என்பதை "
"மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeInputSplineResolution
msgid "Spline Resolution"
msgstr "ச்ப்லைன் தீர்மானம்"

#. :src: bpy.types.GeometryNodeInputSplineResolution
msgid ""
"Retrieve the number of evaluated points that will be generated for every "
"control point on curves"
msgstr ""
"வளைவுகளில் ஒவ்வொரு கட்டுப்பாட்டு புள்ளிக்கும் உருவாக்கப்படும் மதிப்பீடு "
"செய்யப்பட்ட புள்ளிகளின் எண்ணிக்கையை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeInputTangent
msgid "Curve Tangent"
msgstr "வளைவு தொடுகோடு"

#. :src: bpy.types.GeometryNodeInputTangent
msgid "Retrieve the direction of curves at each control point"
msgstr "ஒவ்வொரு கட்டுப்பாட்டு புள்ளியிலும் வளைவுகளின் திசையை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeInstanceOnPoints
msgid "Instance on Points"
msgstr "புள்ளிகளில் நிகழ்வு"

#. :src: bpy.types.GeometryNodeInstanceOnPoints
msgid ""
"Generate a reference to geometry at each of the input points, without "
"duplicating its underlying data"
msgstr ""
"அதன் அடிப்படை தரவை நகலெடுக்காமல், ஒவ்வொரு உள்ளீட்டு புள்ளிகளிலும் "
"வடிவவியலைப் பற்றிய குறிப்பை உருவாக்கவும்"

#. :src: bpy.types.GeometryNodeInstanceTransform
#. :src: bpy.types.NodeTreeInterfaceSocket.default_input:'INSTANCE_TRANSFORM'
msgid "Instance Transform"
msgstr "நிகழ்வு உருமாற்றம்"

#. :src: bpy.types.GeometryNodeInstanceTransform
msgid "Retrieve the full transformation of each instance in the geometry"
msgstr "வடிவவியலில் ஒவ்வொரு நிகழ்வின் முழு மாற்றத்தையும் மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeInstancesToPoints
msgid "Instances to Points"
msgstr "புள்ளிகளுக்கு நிகழ்வுகள்"

#. :src: bpy.types.GeometryNodeInstancesToPoints
msgid ""
"Generate points at the origins of instances.\n"
"Note: Nested instances are not affected by this node"
msgstr ""
"நிகழ்வுகளின் தோற்றத்தில் புள்ளிகளை உருவாக்குங்கள். \n"
" குறிப்பு: உள்ளமைக்கப்பட்ட நிகழ்வுகள் இந்த முனையால் பாதிக்கப்படவில்லை"

#. :src: bpy.types.GeometryNodeInterpolateCurves
msgid "Interpolate Curves"
msgstr "வளைவுகள் இடைக்கணிப்பு"

#. :src: bpy.types.GeometryNodeInterpolateCurves
msgid "Generate new curves on points by interpolating between existing curves"
msgstr ""
"இருக்கும் வளைவுகளுக்கு இடையில் இடைக்கணிப்பதன் மூலம் புள்ளிகளில் புதிய "
"வளைவுகளை உருவாக்குங்கள்"

#. :src: bpy.types.GeometryNodeIsViewport
#: source/blender/nodes/geometry/nodes/node_geo_is_viewport.cc:12
msgid "Is Viewport"
msgstr "காட்சியகம்"

#. :src: bpy.types.GeometryNodeIsViewport
msgid ""
"Retrieve whether the nodes are being evaluated for the viewport rather than "
"the final render"
msgstr ""
"இறுதி ரெண்டரைக் காட்டிலும் பார்வைக்கு முனைகள் மதிப்பீடு செய்யப்படுகிறதா "
"என்பதை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeJoinGeometry
msgid "Join Geometry"
msgstr "வடிவவியலில் சேரவும்"

#. :src: bpy.types.GeometryNodeJoinGeometry
msgid "Merge separately generated geometries into a single one"
msgstr "தனித்தனியாக உருவாக்கப்பட்ட வடிவவியல்களை ஒற்றை ஒன்றில் ஒன்றிணைக்கவும்"

#. :src: bpy.types.GeometryNodeList
msgid "Create a list of values"
msgstr "மதிப்புகளின் பட்டியலை உருவாக்கவும்"

#. :src: bpy.types.GeometryNodeListGetItem
msgid "Get List Item"
msgstr "பட்டியல் உருப்படியைப் பெறுங்கள்"

#. :src: bpy.types.GeometryNodeListGetItem
msgid "Retrieve a value from a list"
msgstr "ஒரு பட்டியலிலிருந்து ஒரு மதிப்பை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeListLength
msgid "List Length"
msgstr "பட்டியல் நீளம்"

#. :src: bpy.types.GeometryNodeListLength
msgid "Return the length of a list"
msgstr "ஒரு பட்டியலின் நீளத்தைத் தரவும்"

#. :src: bpy.types.GeometryNodeMaterialSelection
msgid "Material Selection"
msgstr "மூலப்பொருள் தேர்வு"

#. :src: bpy.types.GeometryNodeMaterialSelection
msgid "Provide a selection of faces that use the specified material"
msgstr "குறிப்பிட்ட மூலப்பொருளைப் பயன்படுத்தும் முகங்களின் தேர்வை வழங்கவும்"

#. :src: bpy.types.GeometryNodeMenuSwitch
msgid "Menu Switch"
msgstr "பட்டியல் சுவிட்ச்"

#. :src: bpy.types.GeometryNodeMenuSwitch
msgid "Select from multiple inputs by name"
msgstr "பெயரால் பல உள்ளீடுகளிலிருந்து தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.GeometryNodeMenuSwitch.active_item
msgid "Active Item"
msgstr "செயலில் உள்ள உருப்படி"

#. :src: bpy.types.GeometryNodeMenuSwitch.active_item
#. :src: bpy.types.NodeTreeInterface.active
msgid "Active item"
msgstr "செயலில் உள்ள உருப்படி"

#. :src: bpy.types.GeometryNodeMenuSwitch.enum_definition
msgid "Enum Definition (deprecated)"
msgstr "Enum வரையறை (நீக்கப்பட்டது)"

#. :src: bpy.types.GeometryNodeMenuSwitch.enum_definition
msgid ""
"The enum definition can now be accessed directly on the node. This exists "
"for backward compatibility."
msgstr ""
"ENUM வரையறையை இப்போது நேரடியாக முனையில் அணுகலாம். இது பின்தங்கிய "
"பொருந்தக்கூடிய தன்மைக்கு உள்ளது."

#. :src: bpy.types.GeometryNodeMergeByDistance
msgid "Merge by Distance"
msgstr "தூரத்தில் ஒன்றிணைக்கவும்"

#. :src: bpy.types.GeometryNodeMergeByDistance
msgid "Merge vertices or points within a given distance"
msgstr ""
"கொடுக்கப்பட்ட தூரத்திற்குள் செங்குத்துகள் அல்லது புள்ளிகளை ஒன்றிணைக்கவும்"

#. :src: bpy.types.GeometryNodeMergeLayers
msgid "Merge Layers"
msgstr "அடுக்குகளை ஒன்றிணைக்கவும்"

#. :src: bpy.types.GeometryNodeMergeLayers
msgid "Join groups of Grease Pencil layers into one"
msgstr "கிரீச் பென்சில் அடுக்குகளின் குழுக்களில் ஒன்றில் சேரவும்"

#. :src: bpy.types.GeometryNodeMergeLayers.mode
msgid "Determines how to choose which layers are merged"
msgstr ""
"எந்த அடுக்குகள் ஒன்றிணைக்கப்படுகின்றன என்பதை எவ்வாறு தேர்வு செய்வது என்பதை "
"தீர்மானிக்கிறது"

#. :src: bpy.types.GeometryNodeMergeLayers.mode:'MERGE_BY_NAME'
msgid "Combine all layers which have the same name"
msgstr "ஒரே பெயரைக் கொண்ட அனைத்து அடுக்குகளையும் இணைக்கவும்"

#. :src: bpy.types.GeometryNodeMergeLayers.mode:'MERGE_BY_ID'
msgid "By Group ID"
msgstr "குழு ஐடி மூலம்"

#. :src: bpy.types.GeometryNodeMergeLayers.mode:'MERGE_BY_ID'
msgid ""
"Provide a custom group ID for each layer and all layers with the same ID "
"will be merged into one"
msgstr ""
"ஒவ்வொரு அடுக்குக்கும் தனிப்பயன் குழு ஐடியை வழங்கவும், ஒரே ஐடியுடன் அனைத்து "
"அடுக்குகளுக்கும் ஒன்றில் இணைக்கப்படும்"

#. :src: bpy.types.GeometryNodeMeshBoolean
msgid "Mesh Boolean"
msgstr "மெச் பூலியன்"

#. :src: bpy.types.GeometryNodeMeshBoolean
msgid "Cut, subtract, or join multiple mesh inputs"
msgstr "பல கண்ணி உள்ளீடுகளை வெட்டவும், கழிக்கவும் அல்லது சேரவும்"

#. :src: bpy.types.GeometryNodeMeshCircle
msgid "Mesh Circle"
msgstr "மெச் வட்டம்"

#. :src: bpy.types.GeometryNodeMeshCircle
msgid "Generate a circular ring of edges"
msgstr "விளிம்புகளின் வட்ட வளையத்தை உருவாக்குங்கள்"

#. :src: bpy.types.GeometryNodeMeshCircle.fill_type
#. :src: bpy.types.GeometryNodeMeshCone.fill_type
#. :src: bpy.types.GeometryNodeMeshCylinder.fill_type
#. :src: bpy.types.MESH_OT_primitive_circle_add.fill_type
msgid "Fill Type"
msgstr "வகை நிரப்பு"

#. :src: bpy.types.GeometryNodeMeshCircle.fill_type:'NGON'
#. :src: bpy.types.GeometryNodeMeshCone.fill_type:'NGON'
#. :src: bpy.types.GeometryNodeMeshCylinder.fill_type:'NGON'
#. :src: bpy.types.MESH_OT_primitive_circle_add.fill_type:'NGON'
#. :src: bpy.types.MESH_OT_primitive_cone_add.end_fill_type:'NGON'
#. :src: bpy.types.MESH_OT_primitive_cylinder_add.end_fill_type:'NGON'
msgid "N-Gon"
msgstr "என்-கோன்"

#. :src: bpy.types.GeometryNodeMeshCircle.fill_type:'TRIANGLE_FAN'
#. :src: bpy.types.GeometryNodeMeshCone.fill_type:'TRIANGLE_FAN'
#. :src: bpy.types.GeometryNodeMeshCylinder.fill_type:'TRIANGLE_FAN'
#: source/blender/editors/space_info/info_stats.cc:836
msgid "Triangles"
msgstr "முக்கோணங்கள்"

#. :src: bpy.types.GeometryNodeMeshCone
msgid "Generate a cone mesh"
msgstr "ஒரு கூம்பு கண்ணி உருவாக்குங்கள்"

#. :src: bpy.types.GeometryNodeMeshCube
msgid "Generate a cuboid mesh with variable side lengths and subdivisions"
msgstr ""
"மாறி பக்க நீளம் மற்றும் துணைப்பிரிவுகளுடன் ஒரு க்யூபாய்டு கண்ணி உருவாக்கவும்"

#. :src: bpy.types.GeometryNodeMeshCylinder
msgid "Generate a cylinder mesh"
msgstr "ஒரு சிலிண்டர் மெச் உருவாக்கு"

#. :src: bpy.types.GeometryNodeMeshFaceSetBoundaries
#: source/blender/nodes/geometry/nodes/node_geo_mesh_face_group_boundaries.cc:32
msgid "Face Group Boundaries"
msgstr "குழு எல்லைகளை முகம்"

#. :src: bpy.types.GeometryNodeMeshFaceSetBoundaries
msgid ""
"Find edges on the boundaries between groups of faces with the same ID value"
msgstr ""
"ஒரே ஐடி மதிப்பைக் கொண்ட முகங்களின் குழுக்களுக்கு இடையிலான எல்லைகளில் "
"விளிம்புகளைக் கண்டறியவும்"

#. :src: bpy.types.GeometryNodeMeshGrid
msgid "Generate a planar mesh on the XY plane"
msgstr "xy விமானத்தில் ஒரு பிளானர் கண்ணி உருவாக்கவும்"

#. :src: bpy.types.GeometryNodeMeshIcoSphere
msgid "Ico Sphere"
msgstr "ஐ.சி.ஓ கோளம்"

#. :src: bpy.types.GeometryNodeMeshIcoSphere
msgid "Generate a spherical mesh that consists of equally sized triangles"
msgstr "சமமான அளவிலான முக்கோணங்களைக் கொண்ட ஒரு கோளக் கண்ணி உருவாக்குங்கள்"

#. :src: bpy.types.GeometryNodeMeshLine
msgid "Mesh Line"
msgstr "கண்ணி வரி"

#. :src: bpy.types.GeometryNodeMeshLine
msgid "Generate vertices in a line and connect them with edges"
msgstr "ஒரு வரியில் செங்குத்துகளை உருவாக்கி அவற்றை விளிம்புகளுடன் இணைக்கவும்"

#. :src: bpy.types.GeometryNodeMeshLine.count_mode
msgid "Count Mode"
msgstr "எண்ணிக்கை பயன்முறை"

#. :src: bpy.types.GeometryNodeMeshLine.count_mode:'TOTAL'
msgid "Specify the total number of vertices"
msgstr "மொத்த செங்குத்துகளின் எண்ணிக்கையைக் குறிப்பிடவும்"

#. :src: bpy.types.GeometryNodeMeshLine.count_mode:'RESOLUTION'
msgid "Specify the distance between vertices"
msgstr "செங்குத்துகளுக்கு இடையிலான தூரத்தைக் குறிப்பிடவும்"

#. :src: bpy.types.GeometryNodeMeshLine.mode:'OFFSET'
msgid "Specify the offset from one vertex to the next"
msgstr "ஆஃப்செட்டை ஒரு வெர்டெக்சிலிருந்து அடுத்த இடத்திற்கு குறிப்பிடவும்"

#. :src: bpy.types.GeometryNodeMeshLine.mode:'END_POINTS'
#. :src: bpy.types.ToolSettings.gpencil_stroke_snap_mode:'ENDS'
msgid "End Points"
msgstr "இறுதி புள்ளிகள்"

#. :src: bpy.types.GeometryNodeMeshLine.mode:'END_POINTS'
msgid "Specify the line's start and end points"
msgstr "வரியின் தொடக்க மற்றும் இறுதி புள்ளிகளைக் குறிப்பிடவும்"

#. :src: bpy.types.GeometryNodeMeshToCurve
msgid "Mesh to Curve"
msgstr "வளைவுக்கு கண்ணி"

#. :src: bpy.types.GeometryNodeMeshToCurve
msgid "Generate a curve from a mesh"
msgstr "ஒரு கண்ணி இருந்து ஒரு வளைவை உருவாக்குங்கள்"

#. :src: bpy.types.GeometryNodeMeshToCurve.mode:'EDGES'
msgid ""
"Convert mesh edges to curve segments. Attributes are propagated to curve "
"points."
msgstr ""
"கண்ணி விளிம்புகளை வளைவு பிரிவுகளாக மாற்றவும். பண்புக்கூறுகள் வளைவு "
"புள்ளிகளுக்கு பரப்பப்படுகின்றன."

#. :src: bpy.types.GeometryNodeMeshToCurve.mode:'FACES'
msgid ""
"Convert each mesh face to a cyclic curve. Face attributes are propagated to "
"curves."
msgstr ""
"ஒவ்வொரு கண்ணி முகத்தையும் ஒரு சுழற்சி வளைவுக்கு மாற்றவும். முக "
"பண்புக்கூறுகள் வளைவுகளுக்கு பிரச்சாரம் செய்யப்படுகின்றன."

#. :src: bpy.types.GeometryNodeMeshToDensityGrid
msgid "Mesh to Density Grid"
msgstr "மெச் முதல் அடர்த்தி கட்டம்"

#. :src: bpy.types.GeometryNodeMeshToDensityGrid
msgid "Create a filled volume grid from a mesh"
msgstr "ஒரு கண்ணி இருந்து நிரப்பப்பட்ட தொகுதி கட்டத்தை உருவாக்கவும்"

#. :src: bpy.types.GeometryNodeMeshToPoints
msgid "Mesh to Points"
msgstr "புள்ளிகளுக்கு மெச்"

#. :src: bpy.types.GeometryNodeMeshToPoints
msgid "Generate a point cloud from a mesh's vertices"
msgstr "ஒரு கண்ணி செங்குத்துகளிலிருந்து ஒரு புள்ளி மேகத்தை உருவாக்குங்கள்"

#. :src: bpy.types.GeometryNodeMeshToPoints.mode:'VERTICES'
msgid "Create a point in the point cloud for each selected vertex"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட ஒவ்வொரு வெர்டெக்சிற்கும் புள்ளி மேகத்தில் ஒரு புள்ளியை "
"உருவாக்கவும்"

#. :src: bpy.types.GeometryNodeMeshToPoints.mode:'EDGES'
msgid "Create a point in the point cloud for each selected edge"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட ஒவ்வொரு விளிம்பிற்கும் புள்ளி மேகத்தில் ஒரு புள்ளியை "
"உருவாக்கவும்"

#. :src: bpy.types.GeometryNodeMeshToPoints.mode:'FACES'
msgid "Create a point in the point cloud for each selected face"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட ஒவ்வொரு முகத்திற்கும் புள்ளி மேகத்தில் ஒரு புள்ளியை "
"உருவாக்கவும்"

#. :src: bpy.types.GeometryNodeMeshToPoints.mode:'CORNERS'
msgid "Create a point in the point cloud for each selected face corner"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட ஒவ்வொரு முகம் மூலையிலும் புள்ளி மேகத்தில் ஒரு புள்ளியை "
"உருவாக்கவும்"

#. :src: bpy.types.GeometryNodeMeshToSDFGrid
msgid "Mesh to SDF Grid"
msgstr "மெச் முதல் எச்.டி.எஃப் கட்டம்"

#. :src: bpy.types.GeometryNodeMeshToSDFGrid
msgid "Create a signed distance volume grid from a mesh"
msgstr "ஒரு கண்ணி இருந்து கையொப்பமிடப்பட்ட தூர தொகுதி கட்டத்தை உருவாக்கவும்"

#. :src: bpy.types.GeometryNodeMeshToVolume
msgid "Create a fog volume with the shape of the input mesh's surface"
msgstr ""
"உள்ளீட்டு கண்ணி மேற்பரப்பின் வடிவத்துடன் ஒரு மூடுபனி அளவை உருவாக்கவும்"

#. :src: bpy.types.GeometryNodeMeshUVSphere
#. :src: bpy.types.VIEW3D_OT_interactive_add.primitive_type:'SPHERE_UV'
msgid "UV Sphere"
msgstr "புறஊதா கோளம்"

#. :src: bpy.types.GeometryNodeMeshUVSphere
msgid ""
"Generate a spherical mesh with quads, except for triangles at the top and "
"bottom"
msgstr ""
"மேல் மற்றும் கீழ் முக்கோணங்களைத் தவிர, குவாட்சுடன் ஒரு கோளக் கண்ணி "
"உருவாக்குங்கள்"

#. :src: bpy.types.GeometryNodeObjectInfo
#. :src: bpy.types.ShaderNodeObjectInfo
#: scripts/startup/bl_ui/space_userpref.py:852
msgid "Object Info"
msgstr "பொருள் செய்தி"

#. :src: bpy.types.GeometryNodeObjectInfo
msgid "Retrieve information from an object"
msgstr "ஒரு பொருளிலிருந்து தகவல்களை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeObjectInfo.transform_space
msgid "The transformation of the vector and geometry outputs"
msgstr "திசையன் மற்றும் வடிவியல் வெளியீடுகளின் மாற்றம்"

#. :src: bpy.types.GeometryNodeObjectInfo.transform_space:'ORIGINAL'
msgid ""
"Output the geometry relative to the input object transform, and the "
"location, rotation and scale relative to the world origin"
msgstr ""
"உள்ளீட்டு பொருள் உருமாற்றத்துடன் தொடர்புடைய வடிவவியலையும், உலக தோற்றத்துடன் "
"தொடர்புடைய இருப்பிடம், சுழற்சி மற்றும் அளவு"

#. :src: bpy.types.GeometryNodeObjectInfo.transform_space:'RELATIVE'
msgid ""
"Bring the input object geometry, location, rotation and scale into the "
"modified object, maintaining the relative position between the two objects "
"in the scene"
msgstr ""
"உள்ளீட்டு பொருள் வடிவியல், இருப்பிடம், சுழற்சி மற்றும் அளவிலான "
"மாற்றியமைக்கப்பட்ட பொருளில் கொண்டு வாருங்கள், காட்சியில் உள்ள இரண்டு "
"பொருள்களுக்கு இடையில் தொடர்புடைய நிலையை பராமரித்தல்"

#. :src: bpy.types.GeometryNodeOffsetCornerInFace
#: source/blender/nodes/geometry/nodes/node_geo_mesh_topology_offset_corner_in_face.cc:29
msgid "Offset Corner in Face"
msgstr "முகத்தில் ஆஃப்செட் மூலையில்"

#. :src: bpy.types.GeometryNodeOffsetCornerInFace
msgid "Retrieve corners in the same face as another"
msgstr "மற்றொன்றின் அதே முகத்தில் மூலைகளை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeOffsetPointInCurve
#: source/blender/nodes/geometry/nodes/node_geo_offset_point_in_curve.cc:36
msgid "Offset Point in Curve"
msgstr "வளைவில் ஆஃப்செட் புள்ளி"

#. :src: bpy.types.GeometryNodeOffsetPointInCurve
msgid "Offset a control point index within its curve"
msgstr "அதன் வளைவுக்குள் ஒரு கட்டுப்பாட்டு புள்ளி குறியீட்டை ஈடுசெய்யவும்"

#. :src: bpy.types.GeometryNodePoints
msgid "Generate a point cloud with positions and radii defined by fields"
msgstr ""
"புலங்களால் வரையறுக்கப்பட்ட நிலைகள் மற்றும் கதிர்கள் கொண்ட ஒரு புள்ளி மேகத்தை"
" உருவாக்குங்கள்"

#. :src: bpy.types.GeometryNodePointsOfCurve
msgid "Points of Curve"
msgstr "வளைவின் புள்ளிகள்"

#. :src: bpy.types.GeometryNodePointsOfCurve
msgid "Retrieve a point index within a curve"
msgstr "ஒரு வளைவுக்குள் ஒரு புள்ளி குறியீட்டை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodePointsToCurves
msgid "Points to Curves"
msgstr "வளைவுகளுக்கு புள்ளிகள்"

#. :src: bpy.types.GeometryNodePointsToCurves
msgid "Split all points to curve by its group ID and reorder by weight"
msgstr ""
"அனைத்து புள்ளிகளையும் அதன் குழு ஐடியால் வளைக்கவும், எடையால் "
"மறுவரிசைப்படுத்தவும்"

#. :src: bpy.types.GeometryNodePointsToSDFGrid
msgid "Points to SDF Grid"
msgstr "SDF கட்டத்திற்கு புள்ளிகள்"

#. :src: bpy.types.GeometryNodePointsToSDFGrid
msgid "Create a signed distance volume grid from points"
msgstr "புள்ளிகளிலிருந்து கையொப்பமிடப்பட்ட தூர தொகுதி கட்டத்தை உருவாக்கவும்"

#. :src: bpy.types.GeometryNodePointsToVertices
msgid "Points to Vertices"
msgstr "செங்குத்துகளுக்கான புள்ளிகள்"

#. :src: bpy.types.GeometryNodePointsToVertices
msgid "Generate a mesh vertex for each point cloud point"
msgstr ""
"ஒவ்வொரு புள்ளி முகில் பாயிண்டிற்கும் ஒரு கண்ணி வெர்டெக்சை உருவாக்கவும்"

#. :src: bpy.types.GeometryNodePointsToVolume
msgid "Points to Volume"
msgstr "தொகுதிக்கான புள்ளிகள்"

#. :src: bpy.types.GeometryNodePointsToVolume
msgid "Generate a fog volume sphere around every point"
msgstr "ஒவ்வொரு புள்ளியையும் சுற்றி ஒரு மூடுபனி தொகுதி கோளத்தை உருவாக்குங்கள்"

#. :src: bpy.types.GeometryNodeProximity
msgid "Geometry Proximity"
msgstr "வடிவியல் அருகாமை"

#. :src: bpy.types.GeometryNodeProximity
msgid "Compute the closest location on the target geometry"
msgstr "இலக்கு வடிவவியலில் மிக நெருக்கமான இடத்தைக் கணக்கிடுங்கள்"

#. :src: bpy.types.GeometryNodeProximity.target_element
#: source/blender/nodes/geometry/nodes/node_geo_raycast.cc:45
msgid "Target Geometry"
msgstr "இலக்கு வடிவியல்"

#. :src: bpy.types.GeometryNodeProximity.target_element
msgid "Element of the target geometry to calculate the distance from"
msgstr "இலக்கு வடிவவியலின் உறுப்பு தூரத்தைக் கணக்கிட"

#. :src: bpy.types.GeometryNodeProximity.target_element:'POINTS'
msgid ""
"Calculate the proximity to the target's points (faster than the other modes)"
msgstr ""
"இலக்கின் புள்ளிகளுக்கு அருகாமையைக் கணக்கிடுங்கள் (மற்ற முறைகளை விட வேகமாக)"

#. :src: bpy.types.GeometryNodeProximity.target_element:'EDGES'
msgid "Calculate the proximity to the target's edges"
msgstr "இலக்கின் விளிம்புகளுக்கு அருகாமையில் கணக்கிடுங்கள்"

#. :src: bpy.types.GeometryNodeProximity.target_element:'FACES'
msgid "Calculate the proximity to the target's faces"
msgstr "இலக்கின் முகங்களுக்கு அருகாமையில் இருப்பதைக் கணக்கிடுங்கள்"

#. :src: bpy.types.GeometryNodeRaycast
msgid "Raycast"
msgstr "ரெய்காச்ட்"

#. :src: bpy.types.GeometryNodeRaycast
msgid ""
"Cast rays from the context geometry onto a target geometry, and retrieve "
"information from each hit point"
msgstr ""
"சூழல் வடிவவியலில் இருந்து கதிர்களை இலக்கு வடிவவியலுக்கு அனுப்பவும், ஒவ்வொரு "
"அடி புள்ளியிலிருந்தும் தகவல்களை மீட்டெடு"

#. :src: bpy.types.GeometryNodeRealizeInstances
msgid "Realize Instances"
msgstr "நிகழ்வுகளை உணருங்கள்"

#. :src: bpy.types.GeometryNodeRealizeInstances
msgid "Convert instances into real geometry data"
msgstr "நிகழ்வுகளை உண்மையான வடிவியல் தரவுகளாக மாற்றவும்"

#. :src: bpy.types.GeometryNodeRemoveAttribute
msgid "Remove Named Attribute"
msgstr "பெயரிடப்பட்ட பண்புக்கூறு அகற்று"

#. :src: bpy.types.GeometryNodeRemoveAttribute
msgid ""
"Delete an attribute with a specified name from a geometry. Typically used to"
" optimize performance"
msgstr ""
"ஒரு வடிவவியலிலிருந்து ஒரு குறிப்பிட்ட பெயருடன் ஒரு பண்புக்கூறு நீக்கவும். "
"செயல்திறனை மேம்படுத்த பொதுவாகப் பயன்படுகிறது"

#. :src: bpy.types.GeometryNodeRepeatInput
msgid "Repeat Input"
msgstr "உள்ளீட்டை மீண்டும் செய்யவும்"

#. :src: bpy.types.GeometryNodeRepeatOutput
msgid "Repeat Output"
msgstr "வெளியீட்டை மீண்டும் செய்யவும்"

#. :src: bpy.types.GeometryNodeReplaceMaterial
msgid "Replace Material"
msgstr "மூலப்பொருளை மாற்றவும்"

#. :src: bpy.types.GeometryNodeReplaceMaterial
msgid "Swap one material with another"
msgstr "ஒரு மூலப்பொருளை மற்றொன்றுடன் மாற்றவும்"

#. :src: bpy.types.GeometryNodeResampleCurve
msgid "Resample Curve"
msgstr "மறுசீரமைப்பு வளைவு"

#. :src: bpy.types.GeometryNodeResampleCurve
msgid "Generate a poly spline for each input spline"
msgstr "ஒவ்வொரு உள்ளீட்டு ச்ப்லைனுக்கும் பாலி ச்ப்லைனை உருவாக்கவும்"

#. :src: bpy.types.GeometryNodeResampleCurve.keep_last_segment
msgid "Keep Last Segment"
msgstr "கடைசி பகுதியை வைத்திருங்கள்"

#. :src: bpy.types.GeometryNodeResampleCurve.keep_last_segment
msgid ""
"Do not collapse curves to single points if they are shorter than the given "
"length. The collapsing behavior exists for compatibility reasons."
msgstr ""
"கொடுக்கப்பட்ட நீளத்தை விடக் குறைவாக இருந்தால் வளைவுகளை ஒற்றை புள்ளிகளுக்கு "
"உடைக்க வேண்டாம். இணைந்த நடத்தை பொருந்தக்கூடிய காரணங்களுக்காக உள்ளது."

#. :src: bpy.types.GeometryNodeReverseCurve
msgid "Reverse Curve"
msgstr "தலைகீழ் வளைவு"

#. :src: bpy.types.GeometryNodeReverseCurve
msgid "Change the direction of curves by swapping their start and end data"
msgstr ""
"வளைவுகளின் தொடக்க மற்றும் இறுதி தரவை மாற்றுவதன் மூலம் வளைவுகளின் திசையை "
"மாற்றவும்"

#. :src: bpy.types.GeometryNodeRotateInstances
msgid "Rotate Instances"
msgstr "நிகழ்வுகளை சுழற்றுங்கள்"

#. :src: bpy.types.GeometryNodeRotateInstances
msgid "Rotate geometry instances in local or global space"
msgstr "உள்ளக அல்லது உலகளாவிய இடத்தில் வடிவியல் நிகழ்வுகளை சுழற்றுங்கள்"

#. :src: bpy.types.GeometryNodeSDFGridBoolean
msgid "SDF Grid Boolean"
msgstr "எச்.டி.எஃப் கட்டம் பூலியன்"

#. :src: bpy.types.GeometryNodeSDFGridBoolean
msgid "Cut, subtract, or join multiple SDF volume grid inputs"
msgstr "பல SDF தொகுதி கட்டம் உள்ளீடுகளை வெட்டவும், கழிக்கவும் அல்லது சேரவும்"

#. :src: bpy.types.GeometryNodeSDFGridBoolean.operation:'INTERSECT'
msgid "Keep the part of the grids that is common between all operands"
msgstr ""
"அனைத்து செயல்பாடுகளுக்கும் இடையில் பொதுவான கட்டங்களின் பகுதியை வைத்திருங்கள்"

#. :src: bpy.types.GeometryNodeSDFGridBoolean.operation:'UNION'
msgid "Combine grids in an additive way"
msgstr "கட்டங்களை ஒரு சேர்க்கை வழியில் இணைக்கவும்"

#. :src: bpy.types.GeometryNodeSDFGridBoolean.operation:'DIFFERENCE'
msgid "Combine grids in a subtractive way"
msgstr "கட்டங்களை கழித்தல் வழியில் இணைக்கவும்"

#. :src: bpy.types.GeometryNodeSampleCurve
msgid "Sample Curve"
msgstr "மாதிரி வளைவு"

#. :src: bpy.types.GeometryNodeSampleCurve
msgid ""
"Retrieve data from a point on a curve at a certain distance from its start"
msgstr ""
"அதன் தொடக்கத்திலிருந்து ஒரு குறிப்பிட்ட தூரத்தில் ஒரு வளைவில் ஒரு "
"புள்ளியிலிருந்து தரவை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeSampleCurve.mode
msgid "Method for sampling input"
msgstr "மாதிரி உள்ளீட்டிற்கான முறை"

#. :src: bpy.types.GeometryNodeSampleCurve.mode:'FACTOR'
msgid "Find sample positions on the curve using a factor of its total length"
msgstr ""
"அதன் மொத்த நீளத்தின் காரணியைப் பயன்படுத்தி வளைவில் மாதிரி நிலைகளைக் "
"கண்டறியவும்"

#. :src: bpy.types.GeometryNodeSampleCurve.mode:'LENGTH'
msgid "Find sample positions on the curve using a distance from its beginning"
msgstr ""
"அதன் தொடக்கத்திலிருந்து தூரத்தைப் பயன்படுத்தி வளைவில் மாதிரி நிலைகளைக் "
"கண்டறியவும்"

#. :src: bpy.types.GeometryNodeSampleCurve.use_all_curves
msgid "All Curves"
msgstr "அனைத்து வளைவுகளும்"

#. :src: bpy.types.GeometryNodeSampleCurve.use_all_curves
msgid ""
"Sample lengths based on the total length of all curves, rather than using a "
"length inside each selected curve"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட ஒவ்வொரு வளைவினுள் நீளத்தைப் பயன்படுத்துவதை விட, அனைத்து "
"வளைவுகளின் மொத்த நீளத்தின் அடிப்படையில் மாதிரி நீளங்கள்"

#. :src: bpy.types.GeometryNodeSampleGrid
msgid "Sample Grid"
msgstr "மாதிரி கட்டம்"

#. :src: bpy.types.GeometryNodeSampleGrid.data_type
#. :src: bpy.types.GeometryNodeSampleGridIndex.data_type
msgid "Node socket data type"
msgstr "முனை சாக்கெட் தரவு வகை"

#. :src: bpy.types.GeometryNodeSampleGridIndex
msgid "Sample Grid Index"
msgstr "மாதிரி கட்டம் அட்டவணை"

#. :src: bpy.types.GeometryNodeSampleGridIndex
msgid "Retrieve volume grid values at specific voxels"
msgstr "குறிப்பிட்ட வோக்சல்களில் தொகுதி கட்டம் மதிப்புகளை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeSampleIndex
msgid "Sample Index"
msgstr "மாதிரி அட்டவணை"

#. :src: bpy.types.GeometryNodeSampleIndex
msgid "Retrieve values from specific geometry elements"
msgstr "குறிப்பிட்ட வடிவியல் கூறுகளிலிருந்து மதிப்புகளை மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeSampleIndex.clamp
msgid ""
"Clamp the indices to the size of the attribute domain instead of outputting "
"a default value for invalid indices"
msgstr ""
"தவறான குறியீடுகளுக்கான இயல்புநிலை மதிப்பை வெளியிடுவதற்கு பதிலாக பண்புக்கூறு "
"களத்தின் அளவிற்கு குறியீடுகளை இணைக்கவும்"

#. :src: bpy.types.GeometryNodeSampleNearest
msgid "Sample Nearest"
msgstr "மாதிரி அருகிலுள்ள"

#. :src: bpy.types.GeometryNodeSampleNearest
msgid ""
"Find the element of a geometry closest to a position. Similar to the \"Index"
" of Nearest\" node"
msgstr ""
"ஒரு நிலைக்கு மிக நெருக்கமான வடிவவியலின் உறுப்பைக் கண்டறியவும். "
"\"அருகிலுள்ள\" குறியீட்டைப் போன்றது"

#. :src: bpy.types.GeometryNodeSampleNearestSurface
msgid "Sample Nearest Surface"
msgstr "மாதிரி அருகிலுள்ள மேற்பரப்பு"

#. :src: bpy.types.GeometryNodeSampleNearestSurface
msgid ""
"Calculate the interpolated value of a mesh attribute on the closest point of"
" its surface"
msgstr ""
"அதன் மேற்பரப்பின் மிக நெருக்கமான புள்ளியில் ஒரு கண்ணி பண்புக்கூறின் "
"இடைக்கணிப்பு மதிப்பைக் கணக்கிடுங்கள்"

#. :src: bpy.types.GeometryNodeSampleUVSurface
msgid "Sample UV Surface"
msgstr "மாதிரி புறஊதா மேற்பரப்பு"

#. :src: bpy.types.GeometryNodeSampleUVSurface
msgid ""
"Calculate the interpolated values of a mesh attribute at a UV coordinate"
msgstr ""
"புறஊதா ஒருங்கிணைப்பில் ஒரு கண்ணி பண்புக்கூறின் இடைக்கணிப்பு மதிப்புகளைக் "
"கணக்கிடுங்கள்"

#. :src: bpy.types.GeometryNodeScaleElements
msgid "Scale Elements"
msgstr "அளவிலான கூறுகள்"

#. :src: bpy.types.GeometryNodeScaleElements
msgid "Scale groups of connected edges and faces"
msgstr "இணைக்கப்பட்ட விளிம்புகள் மற்றும் முகங்களின் அளவிலான குழுக்கள்"

#. :src: bpy.types.GeometryNodeScaleElements.domain
msgid "Element type to transform"
msgstr "மாற்றுவதற்கான உறுப்பு வகை"

#. :src: bpy.types.GeometryNodeScaleElements.domain:'FACE'
msgid "Scale individual faces or neighboring face islands"
msgstr "தனிப்பட்ட முகங்கள் அல்லது அண்டை முக தீவுகளை அளவிடவும்"

#. :src: bpy.types.GeometryNodeScaleElements.domain:'EDGE'
msgid "Scale individual edges or neighboring edge islands"
msgstr "தனிப்பட்ட விளிம்புகள் அல்லது அண்டை விளிம்பு தீவுகளை அளவிடவும்"

#. :src: bpy.types.GeometryNodeScaleInstances
msgid "Scale Instances"
msgstr "அளவிலான நிகழ்வுகள்"

#. :src: bpy.types.GeometryNodeScaleInstances
msgid "Scale geometry instances in local or global space"
msgstr "உள்ளக அல்லது உலகளாவிய இடத்தில் வடிவியல் நிகழ்வுகளை அளவிடவும்"

#. :src: bpy.types.GeometryNodeSelfObject
#: source/blender/nodes/geometry/nodes/node_geo_self_object.cc:10
msgid "Self Object"
msgstr "தன்வய பொருள்"

#. :src: bpy.types.GeometryNodeSelfObject
msgid ""
"Retrieve the object that contains the geometry nodes modifier currently "
"being executed"
msgstr ""
"தற்போது செயல்படுத்தப்படும் வடிவியல் முனைகள் மாற்றியமைப்பைக் கொண்ட பொருளை "
"மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeSeparateComponents
msgid "Separate Components"
msgstr "தனி கூறுகள்"

#. :src: bpy.types.GeometryNodeSeparateComponents
msgid ""
"Split a geometry into a separate output for each type of data in the "
"geometry"
msgstr ""
"வடிவவியலில் ஒவ்வொரு வகை தரவுகளுக்கும் ஒரு வடிவவியலை ஒரு தனி வெளியீடாக "
"பிரிக்கவும்"

#. :src: bpy.types.GeometryNodeSeparateGeometry
msgid "Separate Geometry"
msgstr "தனி வடிவியல்"

#. :src: bpy.types.GeometryNodeSeparateGeometry
msgid "Split a geometry into two geometry outputs based on a selection"
msgstr ""
"தேர்வின் அடிப்படையில் ஒரு வடிவவியலை இரண்டு வடிவியல் வெளியீடுகளாக பிரிக்கவும்"

#. :src: bpy.types.GeometryNodeSeparateGeometry.domain
msgid "Which domain to separate on"
msgstr "எந்த டொமைன் பிரிக்க வேண்டும்"

#. :src: bpy.types.GeometryNodeSetCurveHandlePositions
msgid "Set Handle Positions"
msgstr "கைப்பிடி நிலைகளை அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetCurveHandlePositions
msgid "Set the positions for the handles of Bézier curves"
msgstr "பெசியர் வளைவுகளின் கைப்பிடிகளுக்கான நிலைகளை அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetCurveNormal
msgid "Set Curve Normal"
msgstr "வளைவை இயல்பாக அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetCurveNormal
msgid "Set the evaluation mode for curve normals"
msgstr "வளைவு இயல்பான மதிப்பீட்டு பயன்முறையை அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetCurveRadius
msgid "Set Curve Radius"
msgstr "வளைவு ஆரம் அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetCurveRadius
msgid "Set the radius of the curve at each control point"
msgstr "ஒவ்வொரு கட்டுப்பாட்டு புள்ளியிலும் வளைவின் ஆரம் அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetCurveTilt
msgid "Set Curve Tilt"
msgstr "வளைவு சாய்வை அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetCurveTilt
msgid "Set the tilt angle at each curve control point"
msgstr "ஒவ்வொரு வளைவு கட்டுப்பாட்டு புள்ளியிலும் சாய்வு கோணத்தை அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetGeometryName
msgid "Set Geometry Name"
msgstr "வடிவியல் பெயரை அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetGeometryName
msgid "Set the name of a geometry for easier debugging"
msgstr "எளிதாக பிழைத்திருத்தத்திற்கு வடிவவியலின் பெயரை அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetGreasePencilColor
msgid "Set Grease Pencil Color"
msgstr "கிரீச் பென்சில் நிறத்தை அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetGreasePencilColor
msgid "Set color and opacity attributes on Grease Pencil geometry"
msgstr ""
"கிரீச் பென்சில் வடிவவியலில் வண்ணம் மற்றும் ஒளிபுகா பண்புகளை அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetGreasePencilColor.mode:'STROKE'
msgid "Set the color and opacity for the points of the stroke"
msgstr "பக்கவாதத்தின் புள்ளிகளுக்கான நிறம் மற்றும் ஒளிபுகாநிலையை அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetGreasePencilColor.mode:'FILL'
msgid "Set the color and opacity for the stroke fills"
msgstr "பக்கவாதம் நிரப்புதலுக்கான வண்ணம் மற்றும் ஒளிபுகாநிலையை அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetGreasePencilDepth
msgid "Set Grease Pencil Depth"
msgstr "கிரீச் பென்சில் ஆழத்தை அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetGreasePencilDepth
msgid "Set the Grease Pencil depth order to use"
msgstr "பயன்படுத்த கிரீச் பென்சில் ஆழத்தை அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetGreasePencilDepth.depth_order
msgid "Depth Order"
msgstr "ஆழ வரிசை"

#. :src: bpy.types.GeometryNodeSetGreasePencilSoftness
msgid "Set Grease Pencil Softness"
msgstr "கிரீச் பென்சில் மென்மையை அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetGreasePencilSoftness
msgid "Set softness attribute on Grease Pencil geometry"
msgstr "கிரீச் பென்சில் வடிவவியலில் மென்மையான பண்புகளை அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetID
msgid "Set ID"
msgstr "ஐடி அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetID
msgid ""
"Set the id attribute on the input geometry, mainly used internally for "
"randomizing"
msgstr ""
"உள்ளீட்டு வடிவவியலில் ஐடி பண்புக்கூறு அமைக்கவும், முக்கியமாக "
"சீரற்றமயமாக்கலுக்கு உள்நாட்டில் பயன்படுத்தப்படுகிறது"

#. :src: bpy.types.GeometryNodeSetInstanceTransform
msgid "Set Instance Transform"
msgstr "நிகழ்வு மாற்றத்தை அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetInstanceTransform
msgid "Set the transformation matrix of every instance"
msgstr "ஒவ்வொரு நிகழ்வின் உருமாற்ற மேட்ரிக்சையும் அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetMaterial
msgid "Set Material"
msgstr "மூலப்பொருள் அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetMaterial
msgid "Assign a material to geometry elements"
msgstr "வடிவியல் கூறுகளுக்கு ஒரு மூலப்பொருளை ஒதுக்குங்கள்"

#. :src: bpy.types.GeometryNodeSetMaterialIndex
msgid "Set Material Index"
msgstr "மூலப்பொருள் குறியீட்டை அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetMaterialIndex
msgid "Set the material index for each selected geometry element"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட ஒவ்வொரு வடிவியல் உறுப்புக்கும் மூலப்பொருள் குறியீட்டை "
"அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetMeshNormal
msgid "Set Mesh Normal"
msgstr "கண்ணி இயல்பாக அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetMeshNormal
msgid "Store a normal vector for each mesh element"
msgstr "ஒவ்வொரு கண்ணி உறுப்புக்கும் ஒரு சாதாரண திசையனை சேமிக்கவும்"

#. :src: bpy.types.GeometryNodeSetMeshNormal.domain
msgid "Attribute domain to store free custom normals"
msgstr "இலவச தனிப்பயன் இயல்புகளைச் சேமிக்க டொமைன் டொமைன்"

#. :src: bpy.types.GeometryNodeSetMeshNormal.mode
msgid "Storage mode for custom normal data"
msgstr "தனிப்பயன் சாதாரண தரவுகளுக்கான சேமிப்பக முறை"

#. :src: bpy.types.GeometryNodeSetMeshNormal.mode:'SHARPNESS'
msgid ""
"Store the sharpness of each face or edge. Similar to the \"Shade Smooth\" "
"and \"Shade Flat\" operators."
msgstr ""
"ஒவ்வொரு முகம் அல்லது விளிம்பின் கூர்மையை சேமிக்கவும். \"நிழல் மென்மையான\" "
"மற்றும் \"நிழல் பிளாட்\" ஆபரேட்டர்களைப் போன்றது."

#. :src: bpy.types.GeometryNodeSetMeshNormal.mode:'FREE'
msgid ""
"Store custom normals as simple vectors in the local space of the mesh. "
"Values are not necessarily updated automatically later on as the mesh is "
"deformed."
msgstr ""
"தனிப்பயன் இயல்புகளை கண்ணி உள்ளக இடத்தில் எளிய திசையன்களாக சேமிக்கவும். கண்ணி"
" சிதைக்கப்படுவதால் மதிப்புகள் தானாகவே பின்னர் புதுப்பிக்கப்படுவதில்லை."

#. :src: bpy.types.GeometryNodeSetMeshNormal.mode:'TANGENT_SPACE'
#. :src: bpy.types.ShaderNodeNormalMap.space:'TANGENT'
#. :src: bpy.types.ShaderNodeVectorDisplacement.space:'TANGENT'
#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_tspace
msgid "Tangent Space"
msgstr "தொடுகோடு இடம்"

#. :src: bpy.types.GeometryNodeSetMeshNormal.mode:'TANGENT_SPACE'
msgid ""
"Store normals in a deformation dependent custom transformation space. This "
"method is slower, but can be better when subsequent operations change the "
"mesh without handling normals specifically."
msgstr ""
"சிதைவு சார்ந்த தனிப்பயன் உருமாற்ற இடத்தில் இயல்புகளை சேமிக்கவும். இந்த முறை "
"மெதுவாக உள்ளது, ஆனால் அடுத்தடுத்த செயல்பாடுகள் குறிப்பாக இயல்புகளை கையாளாமல்"
" கண்ணி மாற்றும்போது சிறப்பாக இருக்கும்."

#. :src: bpy.types.GeometryNodeSetPointRadius
msgid "Set Point Radius"
msgstr "புள்ளி ஆரம் அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetPointRadius
msgid "Set the display size of point cloud points"
msgstr "புள்ளி முகில் புள்ளிகளின் காட்சி அளவை அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetPosition
msgid "Set Position"
msgstr "நிலை அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetPosition
msgid "Set the location of each point"
msgstr "ஒவ்வொரு புள்ளியின் இருப்பிடத்தையும் அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetShadeSmooth
msgid "Set Shade Smooth"
msgstr "நிழலை மென்மையாக அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetShadeSmooth
msgid ""
"Control the smoothness of mesh normals around each face by changing the "
"\"shade smooth\" attribute"
msgstr ""
"\"நிழல் மென்மையான\" பண்புகளை மாற்றுவதன் மூலம் ஒவ்வொரு முகத்தைச் சுற்றியுள்ள "
"கண்ணி இயல்புகளின் மென்மையை கட்டுப்படுத்தவும்"

#. :src: bpy.types.GeometryNodeSetSplineCyclic
msgid "Set Spline Cyclic"
msgstr "ச்ப்லைன் சுழற்சி அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetSplineCyclic
msgid ""
"Control whether each spline loops back on itself by changing the \"cyclic\" "
"attribute"
msgstr ""
"\"சுழற்சி\" பண்பை மாற்றுவதன் மூலம் ஒவ்வொரு ச்ப்லைன் தன்னைத் தானே "
"சுழற்றுகிறதா என்பதைக் கட்டுப்படுத்தவும்"

#. :src: bpy.types.GeometryNodeSetSplineResolution
msgid "Set Spline Resolution"
msgstr "ச்ப்லைன் தீர்மானத்தை அமைக்கவும்"

#. :src: bpy.types.GeometryNodeSetSplineResolution
msgid ""
"Control how many evaluated points should be generated on every curve segment"
msgstr ""
"ஒவ்வொரு வளைவு பிரிவிலும் எத்தனை மதிப்பிடப்பட்ட புள்ளிகள் உருவாக்கப்பட "
"வேண்டும் என்பதைக் கட்டுப்படுத்தவும்"

#. :src: bpy.types.GeometryNodeSimulationInput
msgid "Simulation Input"
msgstr "உருவகப்படுத்துதல் உள்ளீடு"

#. :src: bpy.types.GeometryNodeSimulationInput
msgid "Input data for the simulation zone"
msgstr "உருவகப்படுத்துதல் மண்டலத்திற்கான உள்ளீட்டு தரவு"

#. :src: bpy.types.GeometryNodeSimulationOutput
msgid "Simulation Output"
msgstr "உருவகப்படுத்துதல் வெளியீடு"

#. :src: bpy.types.GeometryNodeSimulationOutput
msgid "Output data from the simulation zone"
msgstr "உருவகப்படுத்துதல் மண்டலத்திலிருந்து வெளியீட்டு தரவு"

#. :src: bpy.types.GeometryNodeSortElements
msgid "Sort Elements"
msgstr "கூறுகளை வரிசைப்படுத்துங்கள்"

#. :src: bpy.types.GeometryNodeSortElements
msgid "Rearrange geometry elements, changing their indices"
msgstr "வடிவியல் கூறுகளை மறுசீரமைத்து, அவற்றின் குறியீடுகளை மாற்றவும்"

#. :src: bpy.types.GeometryNodeSplineLength
msgid "Spline Length"
msgstr "ச்ப்லைன் நீளம்"

#. :src: bpy.types.GeometryNodeSplineLength
msgid ""
"Retrieve the total length of each spline, as a distance or as a number of "
"points"
msgstr ""
"ஒவ்வொரு ச்ப்லைனின் மொத்த நீளத்தையும், தூரமாக அல்லது பல புள்ளிகளாக "
"மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeSplineParameter
msgid "Spline Parameter"
msgstr "ச்ப்லைன் அளவுரு"

#. :src: bpy.types.GeometryNodeSplineParameter
msgid "Retrieve how far along each spline a control point is"
msgstr ""
"ஒவ்வொரு ச்ப்லைனிலும் ஒரு கட்டுப்பாட்டு புள்ளி எவ்வளவு தூரம் என்பதை "
"மீட்டெடுக்கவும்"

#. :src: bpy.types.GeometryNodeSplitEdges
msgid "Split Edges"
msgstr "பிளவு விளிம்புகள்"

#. :src: bpy.types.GeometryNodeSplitEdges
msgid "Duplicate mesh edges and break connections with the surrounding faces"
msgstr ""
"கண்ணி விளிம்புகளை நகல் மற்றும் சுற்றியுள்ள முகங்களுடன் இணைப்புகளை உடைக்கவும்"

#. :src: bpy.types.GeometryNodeSplitToInstances
msgid "Split to Instances"
msgstr "நிகழ்வுகளுக்குப் பிரிக்கவும்"

#. :src: bpy.types.GeometryNodeSplitToInstances
msgid "Create separate geometries containing the elements from the same group"
msgstr "ஒரே குழுவிலிருந்து உறுப்புகளைக் கொண்ட தனி வடிவவியல்களை உருவாக்கவும்"

#. :src: bpy.types.GeometryNodeSplitToInstances.domain
msgid "Attribute domain for the Selection and Group ID inputs"
msgstr "தேர்வு மற்றும் குழு ஐடி உள்ளீடுகளுக்கான பண்புக்கூறு டொமைன்"

#. :src: bpy.types.GeometryNodeStoreNamedAttribute
msgid "Store Named Attribute"
msgstr "பெயரிடப்பட்ட பண்புக்கூறு"

#. :src: bpy.types.GeometryNodeStoreNamedAttribute
msgid ""
"Store the result of a field on a geometry as an attribute with the specified"
" name"
msgstr ""
"ஒரு புலத்தின் முடிவை குறிப்பிட்ட பெயருடன் ஒரு பண்புக்கூறாக ஒரு வடிவவியலில் "
"சேமிக்கவும்"

#. :src: bpy.types.GeometryNodeStoreNamedGrid
msgid "Store Named Grid"
msgstr "கட்டம் என்று பெயரிடப்பட்ட கடை"

#. :src: bpy.types.GeometryNodeStoreNamedGrid
msgid "Store grid data in a volume geometry with the specified name"
msgstr "கட்டம் தரவை குறிப்பிட்ட பெயருடன் தொகுதி வடிவவியலில் சேமிக்கவும்"

#. :src: bpy.types.GeometryNodeStoreNamedGrid.data_type:'FLOAT'
#. :src: bpy.types.VolumeGrid.data_type:'FLOAT'
msgid "Single precision float"
msgstr "ஒற்றை துல்லியமான மிதவை"

#. :src: bpy.types.GeometryNodeStoreNamedGrid.data_type:'DOUBLE'
#. :src: bpy.types.VolumeGrid.data_type:'DOUBLE'
msgid "Double precision"
msgstr "இரட்டை மதிப்புகளருகில்"

#. :src: bpy.types.GeometryNodeStoreNamedGrid.data_type:'INT64'
msgid "Integer 64-bit"
msgstr "முழு எண் 64-பிட்"

#. :src: bpy.types.GeometryNodeStoreNamedGrid.data_type:'INT64'
#. :src: bpy.types.VolumeGrid.data_type:'INT64'
msgid "64-bit integer"
msgstr "64-பிட் முழுஎண்"

#. :src: bpy.types.GeometryNodeStoreNamedGrid.data_type:'MASK'
#. :src: bpy.types.VolumeGrid.data_type:'MASK'
msgid "No data, boolean mask of active voxels"
msgstr "தரவு இல்லை, செயலில் உள்ள வோக்சல்களின் பூலியன் முகமூடி"

#. :src: bpy.types.GeometryNodeStoreNamedGrid.data_type:'VECTOR_FLOAT'
msgid "Float Vector"
msgstr "மிதவை திசையன்"

#. :src: bpy.types.GeometryNodeStoreNamedGrid.data_type:'VECTOR_FLOAT'
#. :src: bpy.types.VolumeGrid.data_type:'VECTOR_FLOAT'
msgid "3D float vector"
msgstr "3 டி மிதவை திசையன்"

#. :src: bpy.types.GeometryNodeStoreNamedGrid.data_type:'VECTOR_DOUBLE'
msgid "Double Vector"
msgstr "இரட்டை திசையன்"

#. :src: bpy.types.GeometryNodeStoreNamedGrid.data_type:'VECTOR_DOUBLE'
#. :src: bpy.types.VolumeGrid.data_type:'VECTOR_DOUBLE'
msgid "3D double vector"
msgstr "3 டி இரட்டை திசையன்"

#. :src: bpy.types.GeometryNodeStoreNamedGrid.data_type:'VECTOR_INT'
msgid "Integer Vector"
msgstr "முழு எண் திசையன்"

#. :src: bpy.types.GeometryNodeStoreNamedGrid.data_type:'VECTOR_INT'
#. :src: bpy.types.VolumeGrid.data_type:'VECTOR_INT'
msgid "3D integer vector"
msgstr "3d முழுஎண் திசையன்"

#. :src: bpy.types.GeometryNodeStoreNamedGrid.data_type:'POINTS'
msgid "Points (Unsupported)"
msgstr "புள்ளிகள் (ஆதரிக்கப்படாத)"

#. :src: bpy.types.GeometryNodeStoreNamedGrid.data_type:'POINTS'
#. :src: bpy.types.VolumeGrid.data_type:'POINTS'
msgid "Points grid, currently unsupported by volume objects"
msgstr "புள்ளிகள் கட்டம், தற்போது தொகுதி பொருள்களால் ஆதரிக்கப்படவில்லை"

#. :src: bpy.types.GeometryNodeStoreNamedGrid.data_type:'UNKNOWN'
#: scripts/startup/bl_ui/node_add_menu.py:18
#: scripts/startup/bl_ui/space_sequencer.py:1990
