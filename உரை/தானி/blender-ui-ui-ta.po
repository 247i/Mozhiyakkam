#. :src: bpy.types.OBJECT_OT_shaderfx_add.type:'FX_FLIP'
#. :src: bpy.types.ShaderFx.type:'FX_FLIP'
msgctxt "ID"
msgid "Flip"
msgstr "புரட்டுதல்"

#. :src: bpy.types.OBJECT_OT_shaderfx_add.type:'FX_FLIP'
#. :src: bpy.types.ShaderFx.type:'FX_FLIP'
msgid "Flip image"
msgstr "படத்தை புரட்டவும்"

#. :src: bpy.types.OBJECT_OT_shaderfx_add.type:'FX_GLOW'
#. :src: bpy.types.ShaderFx.type:'FX_GLOW'
msgctxt "ID"
msgid "Glow"
msgstr "பளபளப்பு"

#. :src: bpy.types.OBJECT_OT_shaderfx_add.type:'FX_GLOW'
#. :src: bpy.types.ShaderFx.type:'FX_GLOW'
msgid "Create a glow effect"
msgstr "ஒரு பளபளப்பான விளைவை உருவாக்கவும்"

#. :src: bpy.types.OBJECT_OT_shaderfx_add.type:'FX_PIXEL'
#. :src: bpy.types.ShaderFx.type:'FX_PIXEL'
msgctxt "ID"
msgid "Pixelate"
msgstr "பிக்சலேட்"

#. :src: bpy.types.OBJECT_OT_shaderfx_add.type:'FX_PIXEL'
#. :src: bpy.types.ShaderFx.type:'FX_PIXEL'
