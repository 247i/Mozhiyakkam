#: source/blender/editors/object/object_edit.cc:2271
msgid "Objects moved to %s"
msgstr "பொருள்கள் %s க்கு நகர்ந்தன"

#: source/blender/editors/object/object_hook.cc:528
#: source/blender/editors/object/object_hook.cc:909
msgid "Requires selected vertices or active vertex group"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட செங்குத்துகள் அல்லது செயலில் உள்ள வெர்டெக்ச் குழு தேவை"

#: source/blender/editors/object/object_hook.cc:585
msgid "Armature has no active object bone"
msgstr "ஆர்மேச்சருக்கு செயலில் பொருள் எலும்பு இல்லை"

#: source/blender/editors/object/object_hook.cc:632
msgid "Cannot add hook with no other selected objects"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட வேறு எந்த பொருளும் இல்லாமல் கொக்கி சேர்க்க முடியாது"

#: source/blender/editors/object/object_hook.cc:637
msgid "Cannot add hook bone for a non armature object"
msgstr "ஆர்மேச்சர் அல்லாத பொருளுக்கு கொக்கி எலும்பைச் சேர்க்க முடியாது"

#: source/blender/editors/object/object_hook.cc:711
#: source/blender/editors/object/object_hook.cc:794
#: source/blender/editors/object/object_hook.cc:844
#: source/blender/editors/object/object_hook.cc:902
#: source/blender/editors/object/object_hook.cc:964
msgid "Could not find hook modifier"
msgstr "கொக்கி மாற்றியமைப்பைக் கண்டுபிடிக்க முடியவில்லை"

#: source/blender/editors/object/object_modes.cc:160
#: source/blender/editors/object/object_modes.cc:213
msgid "Unable to execute '%s', error changing modes"
msgstr "'%s' ஐ இயக்க முடியவில்லை, மாற்றும் முறைகள்"

#: source/blender/editors/object/object_modes.cc:509
msgid "No target object to transfer the mode to"
msgstr "பயன்முறையை மாற்ற இலக்கு பொருள் இல்லை"

#: source/blender/editors/object/object_modes.cc:521
msgid ""
"Unable to transfer mode, the source and/or target objects are not editable"
msgstr ""
"பயன்முறையை மாற்ற முடியவில்லை, மூல மற்றும்/அல்லது இலக்கு பொருள்கள் "
"திருத்தக்கூடியவை அல்ல"

#: source/blender/editors/object/object_modes.cc:527
msgid ""
"Current mode of source object '%s' is not compatible with target liboverride"
" object '%s'"
msgstr ""
"மூல பொருளின் தற்போதைய முறை 'இலக்கு லிப் மேலெழுத பொருள்களுடன் பொருந்தாது'"

#: source/blender/editors/object/object_modes.cc:536
msgid ""
"Current mode of source object '%s' is not compatible with target object '%s'"
msgstr "மூல பொருளின் தற்போதைய முறை '%s' இலக்கு பொருள் '%s' உடன் பொருந்தாது"

#: source/blender/editors/object/object_modifier.cc:2091
msgid "Apply Modifier"
msgstr "மாற்றியமைப்பாளரைப் பயன்படுத்துங்கள்"

#: source/blender/editors/object/object_modifier.cc:2092
msgid "Make data single-user, apply modifier, and remove it from the list."
msgstr ""
"தரவை ஒற்றை பயனரை உருவாக்கி, மாற்றியமைப்பைப் பயன்படுத்துங்கள், "
"பட்டியலிலிருந்து அகற்றவும்."

#: source/blender/editors/object/object_modifier.cc:2177
msgid "Apply modifier as a new shapekey and keep it in the stack"
msgstr ""
"மாற்றியமைப்பை ஒரு புதிய சேப்ச்கேயாகப் பயன்படுத்துங்கள் மற்றும் அதை அடுக்கில்"
" வைக்கவும்"

#: source/blender/editors/object/object_modifier.cc:170
msgid "Only one modifier of this type is allowed"
msgstr "இந்த வகையின் ஒரு மாற்றியமைப்பாளர் மட்டுமே அனுமதிக்கப்படுகிறது"

#: source/blender/editors/object/object_modifier.cc:450
msgid "Cannot move above a modifier requiring original data"
msgstr "அசல் தரவு தேவைப்படும் மாற்றியமைப்பிற்கு மேலே நகர்த்த முடியாது"

#: source/blender/editors/object/object_modifier.cc:456
msgid "Cannot move modifier beyond the start of the list"
msgstr "பட்டியலின் தொடக்கத்திற்கு அப்பால் மாற்றியமைப்பை நகர்த்த முடியாது"

#: source/blender/editors/object/object_modifier.cc:488
msgid "Cannot move beyond a non-deforming modifier"
msgstr "சிதைக்காத மாற்றியமைப்பைத் தாண்டி நகர முடியாது"

#: source/blender/editors/object/object_modifier.cc:494
msgid "Cannot move modifier beyond the end of the list"
msgstr "பட்டியலின் முடிவிற்கு அப்பால் மாற்றியமைப்பை நகர்த்த முடியாது"

#: source/blender/editors/object/object_modifier.cc:521
msgid "Cannot move modifier beyond the end of the stack"
msgstr "ச்டேக்கின் முடிவைத் தாண்டி மாற்றியமைப்பை நகர்த்த முடியாது"

#: source/blender/editors/object/object_modifier.cc:862
msgid "Evaluated geometry from modifier does not contain a mesh"
msgstr "மாற்றியமைப்பிலிருந்து மதிப்பிடப்பட்ட வடிவவியலில் ஒரு கண்ணி இல்லை"

#: source/blender/editors/object/object_modifier.cc:888
#: source/blender/editors/object/object_modifier.cc:1076
msgid "Modifier is disabled, skipping apply"
msgstr "மாற்றியமைப்பாளர் முடக்கப்பட்டுள்ளது, ச்கிப்பிங் பொருந்தும்"

#: source/blender/editors/object/object_modifier.cc:907
msgid "Only deforming modifiers can be applied to shapes"
msgstr "மாற்றியமைக்கும் மாற்றிகளை மட்டுமே வடிவங்களுக்குப் பயன்படுத்த முடியும்"

#: source/blender/editors/object/object_modifier.cc:919
msgid "Modifier is disabled or returned error, skipping apply"
msgstr ""
"மாற்றியமைப்பாளர் முடக்கப்பட்டுள்ளது அல்லது திரும்பிய பிழை, ச்கிப்பிங் "
"பொருந்தும்"

#: source/blender/editors/object/object_modifier.cc:938
#: source/blender/editors/object/object_modifier.cc:1252
msgid "Cannot apply modifier for this object type"
msgstr "இந்த பொருள் வகைக்கு மாற்றியமைப்பைப் பயன்படுத்த முடியாது"

#: source/blender/editors/object/object_modifier.cc:1085
msgid "Modifier cannot be applied to a mesh with shape keys"
msgstr "வடிவ விசைகள் கொண்ட கண்ணிக்கு மாற்றியமைப்பாளரைப் பயன்படுத்த முடியாது"

#: source/blender/editors/object/object_modifier.cc:1098
msgid "Multires modifier returned error, skipping apply"
msgstr "பன்முக மாற்றியமைக்கும் பிழை, ச்கிப்பிங் பொருந்தும்"

#: source/blender/editors/object/object_modifier.cc:1139
msgid ""
"Cannot apply constructive modifiers on curve. Convert curve to mesh in order"
" to apply"
msgstr ""
"வளைவில் ஆக்கபூர்வமான மாற்றிகளைப் பயன்படுத்த முடியாது. விண்ணப்பிக்க வளைவை "
"மெச் ஆக மாற்றவும்"

#: source/blender/editors/object/object_modifier.cc:1146
msgid ""
"Applied modifier only changed CV points, not tessellated/bevel vertices"
msgstr ""
"பயன்படுத்தப்பட்ட மாற்றியமைப்பாளர் சி.வி புள்ளிகளை மட்டுமே மாற்றினார், "
"டெசெலேட்டட்/பெவல் செங்குத்துகள் அல்ல"

#: source/blender/editors/object/object_modifier.cc:1162
msgid "Constructive modifiers cannot be applied"
msgstr "ஆக்கபூர்வமான மாற்றிகளைப் பயன்படுத்த முடியாது"

#: source/blender/editors/object/object_modifier.cc:1185
msgid "Evaluated geometry from modifier does not contain curves"
msgstr "மாற்றியமைப்பிலிருந்து மதிப்பிடப்பட்ட வடிவவியலில் வளைவுகள் இல்லை"

#: source/blender/editors/object/object_modifier.cc:1210
msgid "Evaluated geometry from modifier does not contain a point cloud"
msgstr ""
"மாற்றியமைப்பிலிருந்து மதிப்பிடப்பட்ட வடிவவியலில் ஒரு புள்ளி முகில் இல்லை"

#: source/blender/editors/object/object_modifier.cc:1226
msgid "Cannot apply this modifier to Grease Pencil geometry"
msgstr ""
"கிரீச் பென்சில் வடிவவியலுக்கு இந்த மாற்றியமைப்பைப் பயன்படுத்த முடியாது"

#: source/blender/editors/object/object_modifier.cc:1244
msgid ""
"Evaluated geometry from modifier does not contain Grease Pencil geometry"
msgstr ""
"மாற்றியமைப்பிலிருந்து மதிப்பிடப்பட்ட வடிவவியலில் கிரீச் பென்சில் வடிவியல் "
"இல்லை"

#: source/blender/editors/object/object_modifier.cc:1281
msgid "Modifiers cannot be applied in edit mode"
msgstr "திருத்து பயன்முறையில் மாற்றியமைப்பாளர்களைப் பயன்படுத்த முடியாது"

#: source/blender/editors/object/object_modifier.cc:1285
msgid "Modifiers cannot be applied to multi-user data"
msgstr "பல பயனர் தரவுகளுக்கு மாற்றியமைப்பாளர்களைப் பயன்படுத்த முடியாது"

#: source/blender/editors/object/object_modifier.cc:1291
#: source/blender/editors/object/object_modifier.cc:1979
msgid ""
"Constructive modifier cannot be applied to multi-res data in sculpt mode"
msgstr ""
"சிற்பம் பயன்முறையில் மல்டி-ரெச் தரவுகளுக்கு ஆக்கபூர்வமான மாற்றியமைப்பைப் "
"பயன்படுத்த முடியாது"

#: source/blender/editors/object/object_modifier.cc:1298
msgid "Applied modifier was not first, result may not be as expected"
msgstr ""
"பயன்பாட்டு மாற்றியமைப்பாளர் முதலில் இல்லை, முடிவு எதிர்பார்த்தபடி இருக்காது"

#: source/blender/editors/object/object_modifier.cc:2937
msgid "Modifier is disabled"
msgstr "மாற்றியமைப்பாளர் முடக்கப்பட்டுள்ளது"

#: source/blender/editors/object/object_modifier.cc:164
msgid "Modifiers cannot be added to object '%s'"
msgstr "மாற்றியமைப்பாளர்களை பொருள் '%s' இல் சேர்க்க முடியாது"

#: source/blender/editors/object/object_modifier.cc:404
msgid "Modifier '%s' not in object '%s'"
msgstr "மாற்றியமைப்பாளர் '%s' பொருள் '%s'"

#: source/blender/editors/object/object_modifier.cc:602
msgid "Object '%s' does not support %s modifiers"
msgstr "பொருள் ' %s' %s மாற்றிகளை ஆதரிக்காது"

#: source/blender/editors/object/object_modifier.cc:612
msgid "Modifier can only be added once to object '%s'"
msgstr "மாற்றியமைப்பை ஒரு முறை மட்டுமே '%s' சேர்க்க முடியும்"

#: source/blender/editors/object/object_modifier.cc:621
msgid "Copying modifier '%s' to object '%s' failed"
msgstr "மாற்றியமைப்பாளரை நகலெடுப்பது '%s' '%s' தோல்வியுற்றது"

#: source/blender/editors/object/object_modifier.cc:1728
msgid "Removed modifier: %s"
msgstr "அகற்றப்பட்ட மாற்றியமைப்பாளர்: %s"

#: source/blender/editors/object/object_modifier.cc:2063
msgid "Applied modifier: %s"
msgstr "பயன்பாட்டு மாற்றியமைப்பாளர்: %s"

#: source/blender/editors/object/object_modifier.cc:2398
msgid "Modifier '%s' was not copied to any objects"
msgstr "மாற்றியமைக்கும் '%s' எந்த பொருளுக்கும் நகலெடுக்கப்படவில்லை"

#: source/blender/editors/object/object_modifier.cc:2863
msgid "Mesh '%s' has no skin vertex data"
msgstr "மெச் '%s' தோல் வெர்டெக்ச் தரவு இல்லை"

#: source/blender/editors/object/object_modifier.cc:1556
msgid "Cannot edit modifiers coming from linked data in a library override"
msgstr ""
"ஒரு நூலகத்தில் இணைக்கப்பட்ட தரவுகளிலிருந்து வரும் மாற்றிகளைத் திருத்த "
"முடியாது"

#: source/blender/editors/object/object_modifier.cc:1562
msgid "This modifier operation is not allowed from Edit mode"
msgstr "திருத்து பயன்முறையிலிருந்து இந்த மாற்றி செயல்பாடு அனுமதிக்கப்படவில்லை"

#: source/blender/editors/object/object_modifier.cc:1972
msgid "Modifiers cannot be applied on override data"
msgstr "மேலெழுதும் தரவுகளில் மாற்றியமைப்பாளர்களைப் பயன்படுத்த முடியாது"

#: source/blender/editors/object/object_modifier.cc:2430
msgid "No selected object is active"
msgstr "தேர்ந்தெடுக்கப்பட்ட பொருள் எதுவும் செயலில் இல்லை"

#: source/blender/editors/object/object_modifier.cc:2435
msgid "Object type of source object is not supported"
msgstr "மூல பொருளின் பொருள் வகை ஆதரிக்கப்படவில்லை"

#: source/blender/editors/object/object_modifier.cc:2463
msgid "No supported objects were selected"
msgstr "ஆதரிக்கப்பட்ட பொருள்கள் எதுவும் தேர்ந்தெடுக்கப்படவில்லை"

#: source/blender/editors/object/object_modifier.cc:2523
msgid "Active object has no modifiers"
msgstr "செயலில் உள்ள பொருளுக்கு மாற்றிகள் இல்லை"

#. :src: source/blender/editors/object/object_modifier.cc:3282
msgid "Simulating ocean..."
msgstr "கடல் உருவகப்படுத்துதல் ..."

#: source/blender/editors/object/object_multires_modifier.cc:192
msgid "Reshape can work only with higher levels of subdivisions"
msgstr "மறுசீரமைப்பு அதிக அளவு உட்பிரிவுகளுடன் மட்டுமே வேலை செய்ய முடியும்"

#: source/blender/editors/object/object_multires_modifier.cc:205
msgid "Second selected mesh object required to copy shape from"
msgstr "வடிவத்தை நகலெடுக்க தேவையான இரண்டாவது தேர்ந்தெடுக்கப்பட்ட கண்ணி பொருள்"

#: source/blender/editors/object/object_multires_modifier.cc:210
msgid "Objects do not have the same number of vertices"
msgstr "பொருள்களுக்கு ஒரே எண்ணிக்கையிலான செங்குத்துகள் இல்லை"

#: source/blender/editors/object/object_multires_modifier.cc:449
msgid "No valid subdivisions found to rebuild a lower level"
msgstr ""
"செல்லுபடியாகும் துணைப்பிரிவுகள் எதுவும் கீழ் மட்டத்தை மீண்டும் "
"உருவாக்கவில்லை"

#: source/blender/editors/object/object_multires_modifier.cc:503
msgid "No valid subdivisions found to rebuild lower levels"
msgstr ""
"குறைந்த மட்டங்களை மீண்டும் கட்டியெழுப்ப செல்லுபடியாகும் துணைப்பிரிவுகள் "
"எதுவும் கிடைக்கவில்லை"

#: source/blender/editors/object/object_multires_modifier.cc:507
msgid "%d new levels rebuilt"
msgstr "%d புதிய நிலைகள் மீண்டும் கட்டப்பட்டன"

#: source/blender/editors/object/object_relations.cc:949
msgid "Set Parent To"
