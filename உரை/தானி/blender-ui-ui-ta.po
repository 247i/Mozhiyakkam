#. :src: bpy.types.GREASE_PENCIL_OT_frame_duplicate.all
msgid "Duplicate all"
msgstr "அனைத்தையும் நகல்"

#. :src: bpy.types.GREASE_PENCIL_OT_frame_duplicate.all
msgid "Duplicate active keyframes of all layer"
msgstr "அனைத்து அடுக்குகளின் செயலில் உள்ள கீஃப்ரேம்களை நகலெடுக்கவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_insert_blank_frame
msgctxt "Operator"
msgid "Insert Blank Frame"
msgstr "வெற்று சட்டத்தை செருகவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_insert_blank_frame
msgid "Insert a blank frame on the current scene frame"
msgstr "தற்போதைய காட்சி சட்டத்தில் ஒரு வெற்று சட்டத்தை செருகவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_insert_blank_frame.all_layers
