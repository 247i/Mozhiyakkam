msgid "Unknown"
msgstr "தெரியவில்லை"

#. :src: bpy.types.GeometryNodeStoreNamedGrid.data_type:'UNKNOWN'
#. :src: bpy.types.VolumeGrid.data_type:'UNKNOWN'
msgid "Unsupported data type"
msgstr "ஆதரிக்கப்படாத தரவு வகை"

#. :src: bpy.types.GeometryNodeStringJoin
msgid "Join Strings"
msgstr "சரங்களில் சேரவும்"

#. :src: bpy.types.GeometryNodeStringJoin
msgid "Combine any number of input strings"
msgstr "எந்தவொரு உள்ளீட்டு சரங்களையும் இணைக்கவும்"

#. :src: bpy.types.GeometryNodeStringToCurves
msgid "String to Curves"
msgstr "வளைவுகளுக்கு சரம்"

#. :src: bpy.types.GeometryNodeStringToCurves
msgid ""
"Generate a paragraph of text with a specific font, using a curve instance to"
" store each character"
msgstr ""
"ஒவ்வொரு எழுத்தையும் சேமிக்க ஒரு வளைவு நிகழ்வைப் பயன்படுத்தி, ஒரு குறிப்பிட்ட"
" எழுத்துருவுடன் உரையின் பத்தியை உருவாக்குங்கள்"

#. :src: bpy.types.GeometryNodeStringToCurves.align_x:'CENTER'
msgid "Align text to the center"
msgstr "உரையை மையத்திற்கு சீரமைக்கவும்"

#. :src: bpy.types.GeometryNodeStringToCurves.align_x:'JUSTIFY'
msgid "Align text to the left and the right"
msgstr "இடது மற்றும் வலதுபுறத்தில் உரையை சீரமைக்கவும்"

#. :src: bpy.types.GeometryNodeStringToCurves.align_x:'FLUSH'
msgid "Align text to the left and the right, with equal character spacing"
msgstr ""
"சமமான எழுத்து இடைவெளியுடன் இடது மற்றும் வலதுபுறத்தில் உரையை சீரமைக்கவும்"

#. :src: bpy.types.GeometryNodeStringToCurves.font
#. :src: bpy.types.TextStrip.font
msgid "Font of the text. Falls back to the UI font by default."
msgstr ""
"உரையின் எழுத்துரு. இயல்பாகவே இடைமுகம் எழுத்துருவுக்கு மீண்டும் விழுகிறது."

#. :src: bpy.types.GeometryNodeStringToCurves.overflow:'OVERFLOW'
msgid "Let the text use more space than the specified height"
msgstr "உரை குறிப்பிட்ட உயரத்தை விட அதிக இடத்தைப் பயன்படுத்தட்டும்"

#. :src: bpy.types.GeometryNodeStringToCurves.overflow:'SCALE_TO_FIT'
msgid "Scale To Fit"
msgstr "பொருத்தமான அளவு"

#. :src: bpy.types.GeometryNodeStringToCurves.overflow:'SCALE_TO_FIT'
msgid "Scale the text size to fit inside the width and height"
msgstr "அகலம் மற்றும் உயரத்திற்குள் பொருந்தும் வகையில் உரை அளவை அளவிடவும்"

#. :src: bpy.types.GeometryNodeStringToCurves.overflow:'TRUNCATE'
msgid ""
"Only output curves that fit within the width and height. Output the "
"remainder to the \"Remainder\" output."
msgstr ""
"அகலம் மற்றும் உயரத்திற்குள் பொருந்தக்கூடிய வெளியீட்டு வளைவுகள் மட்டுமே. "
"மீதமுள்ளவற்றை \"மீதமுள்ள\" வெளியீட்டிற்கு வெளியிடுங்கள்."

#. :src: bpy.types.GeometryNodeStringToCurves.pivot_mode
msgid "Pivot point position relative to character"
msgstr "பாத்திரத்துடன் தொடர்புடைய பிவோட் புள்ளி நிலை"

#. :src: bpy.types.GeometryNodeStringToCurves.pivot_mode:'TOP_LEFT'
msgid "Top Left"
msgstr "மேல் இடது"

#. :src: bpy.types.GeometryNodeStringToCurves.pivot_mode:'TOP_CENTER'
msgid "Top Center"
msgstr "மேல் நடுவண்"

#. :src: bpy.types.GeometryNodeStringToCurves.pivot_mode:'TOP_RIGHT'
msgid "Top Right"
msgstr "மேல் வலது"

#. :src: bpy.types.GeometryNodeStringToCurves.pivot_mode:'BOTTOM_LEFT'
msgid "Bottom Left"
msgstr "கீழே இடது"

#. :src: bpy.types.GeometryNodeStringToCurves.pivot_mode:'BOTTOM_CENTER'
msgid "Bottom Center"
msgstr "கீழே நடுவண்"

#. :src: bpy.types.GeometryNodeStringToCurves.pivot_mode:'BOTTOM_RIGHT'
msgid "Bottom Right"
msgstr "கீழே வலது"

#. :src: bpy.types.GeometryNodeSubdivideCurve
msgid "Subdivide Curve"
msgstr "உட்பிரிவு வளைவு"

#. :src: bpy.types.GeometryNodeSubdivideCurve
msgid "Dividing each curve segment into a specified number of pieces"
msgstr ""
"ஒவ்வொரு வளைவு பிரிவையும் ஒரு குறிப்பிட்ட எண்ணிக்கையிலான துண்டுகளாக "
"பிரிக்கிறது"

#. :src: bpy.types.GeometryNodeSubdivideMesh
msgid "Subdivide Mesh"
msgstr "துணைப்பிரிவு மெச்"

#. :src: bpy.types.GeometryNodeSubdivideMesh
msgid ""
"Divide mesh faces into smaller ones without changing the shape or volume, "
"using linear interpolation to place the new vertices"
msgstr ""
