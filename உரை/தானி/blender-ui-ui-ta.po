#. :src: bpy.types.TRANSFORM_OT_transform.orient_type:'GIMBAL'
#. :src: bpy.types.TRANSFORM_OT_translate.orient_matrix_type:'GIMBAL'
#. :src: bpy.types.TRANSFORM_OT_translate.orient_type:'GIMBAL'
