#. :src: bpy.types.GPENCIL_OT_layer_annotation_move
msgid "Move the active Annotation layer up/down in the list"
msgstr "செயலில் உள்ள சிறுகுறிப்பு அடுக்கை பட்டியலில் மேலே/கீழ் நகர்த்தவும்"

#. :src: bpy.types.GPENCIL_OT_layer_annotation_remove
msgctxt "Operator"
msgid "Remove Annotation Layer"
msgstr "சிறுகுறிப்பு அடுக்கை அகற்று"

#. :src: bpy.types.GPENCIL_OT_layer_annotation_remove
msgid "Remove active Annotation layer"
msgstr "செயலில் சிறுகுறிப்பு அடுக்கை அகற்று"

#. :src: bpy.types.GRAPH_OT_blend_offset
msgctxt "Operator"
msgid "Blend Offset Keyframes"
msgstr "ஆஃப்செட் கீஃப்ரேம்களைக் கலக்கவும்"

#. :src: bpy.types.GRAPH_OT_blend_offset
msgid "Shift selected keys to the value of the neighboring keys as a block"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட விசைகளை அண்டை விசைகளின் மதிப்புக்கு ஒரு தொகுதியாக "
"மாற்றவும்"

#. :src: bpy.types.GRAPH_OT_blend_offset.factor
msgid "Control which key to offset towards and how far"
msgstr "எந்த விசையை நோக்கி ஈடுசெய்ய வேண்டும், எவ்வளவு தூரம்"

#. :src: bpy.types.GRAPH_OT_blend_to_default
#: scripts/startup/bl_ui/space_graph.py:410
msgctxt "Operator"
msgid "Blend to Default Value"
msgstr "இயல்புநிலை மதிப்புடன் கலக்கவும்"

#. :src: bpy.types.GRAPH_OT_blend_to_default
msgid "Blend selected keys to their default value from their current position"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட விசைகளை அவற்றின் தற்போதைய நிலையிலிருந்து இயல்புநிலை "
"மதிப்புக்கு கலக்கவும்"

#. :src: bpy.types.GRAPH_OT_blend_to_default.factor
#. :src: bpy.types.GRAPH_OT_gaussian_smooth.factor
msgid "How much to blend to the default value"
msgstr "இயல்புநிலை மதிப்புடன் எவ்வளவு கலக்க வேண்டும்"

#. :src: bpy.types.GRAPH_OT_blend_to_ease
msgctxt "Operator"
msgid "Blend to Ease Keyframes"
msgstr "கீஃப்ரேம்களை எளிதாக்க கலக்கவும்"

#. :src: bpy.types.GRAPH_OT_blend_to_ease
msgid "Blends keyframes from current state to an ease-in or ease-out curve"
msgstr ""
"கீஃப்ரேம்களை தற்போதைய நிலையிலிருந்து எளிதான அல்லது எளிதாக வளைவுக்கு "
"கலக்கிறது"

#. :src: bpy.types.GRAPH_OT_blend_to_ease.factor
msgid "Favor either original data or ease curve"
msgstr "அசல் தரவு அல்லது எளிதான வளைவை ஆதரிக்கவும்"

#. :src: bpy.types.GRAPH_OT_blend_to_neighbor
#. :src: bpy.types.POSE_OT_blend_to_neighbor
#: scripts/startup/bl_ui/space_graph.py:409
msgctxt "Operator"
msgid "Blend to Neighbor"
msgstr "அண்டை வீட்டாருடன் கலக்கவும்"

#. :src: bpy.types.GRAPH_OT_blend_to_neighbor
msgid "Blend selected keyframes to their left or right neighbor"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட கீஃப்ரேம்களை அவர்களின் இடது அல்லது வலது அண்டை நாடுகளில் "
"கலக்கவும்"

#. :src: bpy.types.GRAPH_OT_blend_to_neighbor.factor
msgid "The blend factor with 0 being the current frame"
msgstr "0 உடன் கலப்பு காரணி தற்போதைய சட்டகமாக உள்ளது"

#. :src: bpy.types.GRAPH_OT_breakdown
#: scripts/startup/bl_ui/space_graph.py:408
msgctxt "Operator"
msgid "Breakdown"
msgstr "முறிவு"

#. :src: bpy.types.GRAPH_OT_breakdown
msgid ""
"Move selected keyframes to an inbetween position relative to adjacent keys"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட கீஃப்ரேம்களை அருகிலுள்ள விசைகளுடன் ஒப்பிடும்போது ஒரு "
"நிலைக்கு நகர்த்தவும்"

#. :src: bpy.types.GRAPH_OT_breakdown.factor
msgid "Favor either the left or the right key"
msgstr "இடது அல்லது வலது விசையை ஆதரிக்கவும்"

#. :src: bpy.types.GRAPH_OT_butterworth_smooth
msgctxt "Operator"
msgid "Butterworth Smooth"
msgstr "பட்டர்வொர்த் மென்மையானது"

#. :src: bpy.types.GRAPH_OT_butterworth_smooth
msgid "Smooth an F-Curve while maintaining the general shape of the curve"
msgstr ""
"வளைவின் பொதுவான வடிவத்தை பராமரிக்கும் போது ஒரு எஃப்-வளைவை மென்மையாக்குங்கள்"

#. :src: bpy.types.GRAPH_OT_butterworth_smooth.blend
msgid "How much to blend to the smoothed curve"
msgstr "மென்மையான வளைவுடன் எவ்வளவு கலக்க வேண்டும்"

#. :src: bpy.types.GRAPH_OT_butterworth_smooth.blend_in_out
msgid "Blend In/Out"
msgstr "/வெளியே கலக்கவும்"

#. :src: bpy.types.GRAPH_OT_butterworth_smooth.blend_in_out
msgid "Linearly blend the smooth data to the border frames of the selection"
msgstr "மென்மையான தரவை தேர்வின் எல்லை பிரேம்களில் நேர்கோட்டுடன் கலக்கவும்"

#. :src: bpy.types.GRAPH_OT_butterworth_smooth.cutoff_frequency
msgid "Frequency Cutoff (Hz)"
msgstr "அதிர்வெண் வெட்டு"

#. :src: bpy.types.GRAPH_OT_butterworth_smooth.cutoff_frequency
msgid "Lower values give a smoother curve"
msgstr "குறைந்த மதிப்புகள் மென்மையான வளைவைக் கொடுக்கும்"

#. :src: bpy.types.GRAPH_OT_butterworth_smooth.filter_order
msgid "Filter Order"
msgstr "வடிகட்டி வரிசை"

#. :src: bpy.types.GRAPH_OT_butterworth_smooth.filter_order
msgid "Higher values produce a harder frequency cutoff"
msgstr "அதிக மதிப்புகள் கடினமான அதிர்வெண் வெட்டுக்களை உருவாக்குகின்றன"

#. :src: bpy.types.GRAPH_OT_butterworth_smooth.samples_per_frame
msgid "Samples per Frame"
msgstr "ஒரு சட்டகத்திற்கு மாதிரிகள்"

#. :src: bpy.types.GRAPH_OT_butterworth_smooth.samples_per_frame
msgid "How many samples to calculate per frame, helps with subframe data"
msgstr ""
"ஒரு சட்டகத்திற்கு எத்தனை மாதிரிகள் கணக்கிட, சப்ஃப்ரேம் தரவுக்கு உதவுகிறது"

#. :src: bpy.types.GRAPH_OT_click_insert
msgctxt "Operator"
msgid "Click-Insert Keyframes"
msgstr "கிளிக்-ஐசெர்ட் கீஃப்ரேம்கள்"

#. :src: bpy.types.GRAPH_OT_click_insert
msgid "Insert new keyframe at the cursor position for the active F-Curve"
msgstr ""
"செயலில் உள்ள எஃப்-வளைவுக்கான கர்சர் நிலையில் புதிய கீஃப்ரேமை செருகவும்"

#. :src: bpy.types.GRAPH_OT_click_insert.frame
msgid "Frame to insert keyframe on"
msgstr "கீஃப்ரேமை செருக சட்டகம்"

#. :src: bpy.types.GRAPH_OT_click_insert.value
msgid "Value for keyframe on"
msgstr "கீஃப்ரேமுக்கான மதிப்பு"

#. :src: bpy.types.GRAPH_OT_clickselect.curves
msgid "Only Curves"
msgstr "வளைவுகள் மட்டுமே"

#. :src: bpy.types.GRAPH_OT_clickselect.curves
msgid "Select all the keyframes in the curve"
msgstr "வளைவில் உள்ள அனைத்து கீஃப்ரேம்களையும் தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.GRAPH_OT_cursor_set
#. :src: bpy.types.SEQUENCER_OT_text_cursor_set
#. :src: bpy.types.TEXT_OT_cursor_set
msgctxt "Operator"
msgid "Set Cursor"
msgstr "கர்சரை அமைக்கவும்"

#. :src: bpy.types.GRAPH_OT_cursor_set
msgid "Interactively set the current frame and value cursor"
msgstr "தற்போதைய சட்டகம் மற்றும் மதிப்பு கர்சரை ஊடாடும் வகையில் அமைக்கவும்"

#. :src: bpy.types.GRAPH_OT_decimate
msgctxt "Operator"
msgid "Decimate Keyframes"
msgstr "கீஃப்ரேம்களை அழிக்கவும்"

#. :src: bpy.types.GRAPH_OT_decimate
msgid ""
"Decimate F-Curves by removing keyframes that influence the curve shape the "
"least"
msgstr ""
"வளைவு வடிவத்தை பாதிக்கும் கீஃப்ரேம்களை அகற்றுவதன் மூலம் எஃப்-வளைவுகளை "
"அழிக்கவும்"

#. :src: bpy.types.GRAPH_OT_decimate.factor
msgid "The ratio of keyframes to remove"
msgstr "அகற்ற கீஃப்ரேம்களின் விகிதம்"

#. :src: bpy.types.GRAPH_OT_decimate.mode
msgid "Which mode to use for decimation"
msgstr "அழிவுக்கு எந்த பயன்முறையைப் பயன்படுத்த வேண்டும்"

#. :src: bpy.types.GRAPH_OT_decimate.mode:'RATIO'
msgid "Use a percentage to specify how many keyframes you want to remove"
msgstr ""
"நீங்கள் எத்தனை கீஃப்ரேம்களை அகற்ற விரும்புகிறீர்கள் என்பதைக் குறிப்பிட ஒரு "
"சதவீதத்தைப் பயன்படுத்தவும்"

#. :src: bpy.types.GRAPH_OT_decimate.mode:'ERROR'
msgid "Error Margin"
msgstr "பிழை விளிம்பு"

#. :src: bpy.types.GRAPH_OT_decimate.mode:'ERROR'
msgid ""
"Use an error margin to specify how much the curve is allowed to deviate from"
" the original path"
msgstr ""
"அசல் பாதையிலிருந்து வளைவு எவ்வளவு விலகுவதற்கு அனுமதிக்கப்படுகிறது என்பதைக் "
"குறிப்பிட பிழை விளிம்பைப் பயன்படுத்தவும்"

#. :src: bpy.types.GRAPH_OT_decimate.remove_error_margin
msgid "Max Error Margin"
msgstr "அதிகபட்ச பிழை விளிம்பு"

#. :src: bpy.types.GRAPH_OT_decimate.remove_error_margin
msgid ""
"How much the new decimated curve is allowed to deviate from the original"
msgstr ""
"புதிய அழிக்கப்பட்ட வளைவு அசலில் இருந்து விலக எவ்வளவு அனுமதிக்கப்படுகிறது"

#. :src: bpy.types.GRAPH_OT_driver_delete_invalid
msgctxt "Operator"
msgid "Delete Invalid Drivers"
msgstr "தவறான இயக்கிகளை நீக்கு"

#. :src: bpy.types.GRAPH_OT_driver_delete_invalid
msgid "Delete all visible drivers considered invalid"
msgstr "தவறானதாகக் கருதப்படும் அனைத்து காணக்கூடிய இயக்கிகளையும் நீக்கு"

#. :src: bpy.types.GRAPH_OT_driver_variables_copy
msgctxt "Operator"
msgid "Copy Driver Variables"
msgstr "இயக்கி மாறிகள் நகலெடுக்கவும்"

#. :src: bpy.types.GRAPH_OT_driver_variables_copy
msgid "Copy the driver variables of the active driver"
msgstr "செயலில் இயக்கி இயக்கி மாறிகள் நகலெடுக்கவும்"

#. :src: bpy.types.GRAPH_OT_driver_variables_paste
msgctxt "Operator"
msgid "Paste Driver Variables"
msgstr "இயக்கி மாறிகள் ஒட்டவும்"

#. :src: bpy.types.GRAPH_OT_driver_variables_paste
msgid "Add copied driver variables to the active driver"
msgstr "செயலில் இயக்கி நகலெடுக்கப்பட்ட இயக்கி மாறிகள் சேர்க்கவும்"

#. :src: bpy.types.GRAPH_OT_driver_variables_paste.replace
#. :src: bpy.types.GRAPH_OT_fmodifier_paste.replace
#. :src: bpy.types.NLA_OT_fmodifier_paste.replace
msgid "Replace Existing"
msgstr "இருக்கும்"

#. :src: bpy.types.GRAPH_OT_driver_variables_paste.replace
msgid ""
"Replace existing driver variables, instead of just appending to the end of "
"the existing list"
msgstr ""
"இருக்கும் பட்டியலின் முடிவில் சேர்க்கப்படுவதற்குப் பதிலாக, இருக்கும் இயக்கி "
"மாறிகளை மாற்றவும்"

#. :src: bpy.types.GRAPH_OT_ease
msgctxt "Operator"
msgid "Ease Keyframes"
msgstr "கீஃப்ரேம்களை எளிதாக்குங்கள்"

#. :src: bpy.types.GRAPH_OT_ease
msgid "Align keyframes on a ease-in or ease-out curve"
msgstr "கீஃப்ரேம்களை எளிதாக அல்லது எளிதாக-அவுட் வளைவில் சீரமைக்கவும்"

#. :src: bpy.types.GRAPH_OT_ease.factor
msgid "Curve Bend"
msgstr "வளைவு வளைவு"

#. :src: bpy.types.GRAPH_OT_ease.factor
msgid "Defines if the keys should be aligned on an ease-in or ease-out curve"
msgstr ""
"விசைகள் ஒரு எளிமை அல்லது எளிதான வளைவில் சீரமைக்கப்பட வேண்டுமா என்பதை "
"வரையறுக்கிறது"

#. :src: bpy.types.GRAPH_OT_ease.sharpness
msgid "Higher values make the change more abrupt"
msgstr "அதிக மதிப்புகள் மாற்றத்தை மிகவும் திடீரென ஆக்குகின்றன"

#. :src: bpy.types.GRAPH_OT_equalize_handles
#: scripts/startup/bl_ui/space_graph.py:491
msgctxt "Operator"
msgid "Equalize Handles"
msgstr "கைப்பிடிகளை சமப்படுத்தவும்"

#. :src: bpy.types.GRAPH_OT_equalize_handles
msgid ""
"Ensure selected keyframes' handles have equal length, optionally making them"
" horizontal. Automatic, Automatic Clamped, or Vector handle types will be "
"converted to Aligned"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட கீஃப்ரேம்களின் கைப்பிடிகள் சம நீளத்தைக் கொண்டிருக்கின்றன"
" என்பதை உறுதிப்படுத்தவும், விருப்பமாக அவற்றை கிடைமட்டமாக்குகிறது. தானியங்கி,"
" தானியங்கி பிணைப்பு அல்லது திசையன் கைப்பிடி வகைகள் சீரமைக்கப்பட்டதாக "
"மாற்றப்படும்"

#. :src: bpy.types.GRAPH_OT_equalize_handles.flatten
msgid "Flatten"
msgstr "தட்டையானது"

#. :src: bpy.types.GRAPH_OT_equalize_handles.flatten
msgid ""
"Make the values of the selected keyframes' handles the same as their "
"respective keyframes"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட கீஃப்ரேம்களின் மதிப்புகளை அந்தந்த கீஃப்ரேம்களைப் போலவே "
"கையாளுகிறது"

#. :src: bpy.types.GRAPH_OT_equalize_handles.handle_length
msgid "Handle Length"
msgstr "நீளத்தை கையாளவும்"

#. :src: bpy.types.GRAPH_OT_equalize_handles.handle_length
msgid "Length to make selected keyframes' Bézier handles"
msgstr "தேர்ந்தெடுக்கப்பட்ட கீஃப்ரேம்களின் பெசியர் கைப்பிடிகளை உருவாக்க நீளம்"

#. :src: bpy.types.GRAPH_OT_equalize_handles.side
#. :src:
#. bpy.types.GREASE_PENCIL_OT_bake_grease_pencil_animation.project_type:'SIDE'
#. :src: bpy.types.GREASE_PENCIL_OT_outline.type:'SIDE'
#. :src: bpy.types.GREASE_PENCIL_OT_reproject.type:'SIDE'
#. :src: bpy.types.SEQUENCER_OT_select_handles.side
#. :src: bpy.types.SEQUENCER_OT_select_side.side
#. :src: bpy.types.SEQUENCER_OT_select_side_of_frame.side
#. :src: bpy.types.SEQUENCER_OT_split.side
#. :src: bpy.types.SEQUENCER_OT_swap.side
#: scripts/startup/bl_ui/properties_data_empty.py:42
#: source/blender/nodes/geometry/nodes/node_geo_extrude_mesh.cc:52
#: source/blender/nodes/geometry/nodes/node_geo_mesh_primitive_cone.cc:57
#: source/blender/nodes/geometry/nodes/node_geo_mesh_primitive_cylinder.cc:50
msgid "Side"
msgstr "பக்க"

#. :src: bpy.types.GRAPH_OT_equalize_handles.side
msgid "Side of the keyframes' Bézier handles to affect"
msgstr "கீஃப்ரேம்களின் பெசியர் கையாளுதலின் பக்கம் பாதிக்க"

#. :src: bpy.types.GRAPH_OT_equalize_handles.side:'LEFT'
msgid "Equalize selected keyframes' left handles"
msgstr "தேர்ந்தெடுக்கப்பட்ட கீஃப்ரேம்களின் இடது கைப்பிடிகளை சமப்படுத்தவும்"

#. :src: bpy.types.GRAPH_OT_equalize_handles.side:'RIGHT'
msgid "Equalize selected keyframes' right handles"
msgstr "தேர்ந்தெடுக்கப்பட்ட கீஃப்ரேம்களின் வலது கைப்பிடிகளை சமப்படுத்தவும்"

#. :src: bpy.types.GRAPH_OT_equalize_handles.side:'BOTH'
#. :src: bpy.types.MESH_OT_knife_tool.visible_measurements:'BOTH'
#. :src: bpy.types.SEQUENCER_OT_select_handles.side:'BOTH'
#. :src: bpy.types.SEQUENCER_OT_select_side.side:'BOTH'
#. :src: bpy.types.SEQUENCER_OT_split.side:'BOTH'
#. :src: bpy.types.UI_OT_eyedropper_grease_pencil_color.material_mode:'BOTH'
#: source/blender/editors/interface/eyedroppers/eyedropper_grease_pencil_color.cc:108
#: source/blender/editors/interface/templates/interface_template_preview.cc:248
msgid "Both"
msgstr "இரண்டும்"

#. :src: bpy.types.GRAPH_OT_equalize_handles.side:'BOTH'
msgid "Equalize both of a keyframe's handles"
msgstr "கீஃப்ரேம் கைப்பிடிகள் இரண்டையும் சமப்படுத்தவும்"

#. :src: bpy.types.GRAPH_OT_euler_filter
msgctxt "Operator"
msgid "Euler Discontinuity Filter"
msgstr "யூலர் இடைநிறுத்தம் வடிகட்டி"

#. :src: bpy.types.GRAPH_OT_euler_filter
msgid ""
"Fix large jumps and flips in the selected Euler Rotation F-Curves arising "
"from rotation values being clipped when baking physics"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட யூலர் சுழற்சியில் பெரிய தாவல்கள் மற்றும் புரட்டுகளை "
"சரிசெய்யவும் எஃப்-வளைவுகள் சுழற்சி மதிப்புகளிலிருந்து எழும் இயற்பியல் போது "
"கிளிப் செய்யப்படுகின்றன"

#. :src: bpy.types.GRAPH_OT_fmodifier_add
#: scripts/startup/bl_ui/space_dopesheet.py:883
msgctxt "Operator"
msgid "Add F-Curve Modifier"
msgstr "எஃப்-கர்வ் மாற்றியமைப்பைச் சேர்க்கவும்"

#. :src: bpy.types.GRAPH_OT_fmodifier_add
msgid "Add F-Modifier to the active/selected F-Curves"
msgstr ""
"செயலில்/தேர்ந்தெடுக்கப்பட்ட எஃப்-வளைவுகளுக்கு எஃப்-மோடிஃபையரைச் சேர்க்கவும்"

#. :src: bpy.types.GRAPH_OT_fmodifier_add.only_active
#. :src: bpy.types.GRAPH_OT_fmodifier_paste.only_active
#. :src: bpy.types.GREASE_PENCIL_OT_layer_duplicate_object.only_active
#. :src: bpy.types.GREASE_PENCIL_OT_material_copy_to_object.only_active
msgid "Only Active"
msgstr "செயலில் மட்டுமே"

#. :src: bpy.types.GRAPH_OT_fmodifier_add.only_active
msgid "Only add F-Modifier to active F-Curve"
msgstr "செயலில் எஃப்-வளைவுக்கு மட்டுமே எஃப்-மோடிஃபையரைச் சேர்க்கவும்"

#. :src: bpy.types.GRAPH_OT_fmodifier_copy
#. :src: bpy.types.NLA_OT_fmodifier_copy
msgctxt "Operator"
msgid "Copy F-Modifiers"
msgstr "எஃப்-மாடிஃபையர்களை நகலெடுக்கவும்"

#. :src: bpy.types.GRAPH_OT_fmodifier_copy
msgid "Copy the F-Modifier(s) of the active F-Curve"
msgstr "செயலில் உள்ள எஃப்-வளைவின் எஃப்-மாடிஃபைஃபையரை (களை) நகலெடுக்கவும்"

#. :src: bpy.types.GRAPH_OT_fmodifier_paste
#. :src: bpy.types.NLA_OT_fmodifier_paste
msgctxt "Operator"
msgid "Paste F-Modifiers"
msgstr "எஃப்-மாடிஃபையர்களை ஒட்டவும்"

#. :src: bpy.types.GRAPH_OT_fmodifier_paste
msgid "Add copied F-Modifiers to the selected F-Curves"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட எஃப்-வளைவுகளுக்கு நகலெடுக்கப்பட்ட எஃப்-மாடிஃபையர்களைச் "
"சேர்க்கவும்"

#. :src: bpy.types.GRAPH_OT_fmodifier_paste.only_active
msgid "Only paste F-Modifiers on active F-Curve"
msgstr "செயலில் எஃப்-வளைவில் எஃப்-மாடிஃபையர்களை மட்டுமே ஒட்டவும்"

#. :src: bpy.types.GRAPH_OT_fmodifier_paste.replace
#. :src: bpy.types.NLA_OT_fmodifier_paste.replace
msgid ""
"Replace existing F-Modifiers, instead of just appending to the end of the "
"existing list"
msgstr ""
"இருக்கும் பட்டியலின் முடிவில் சேர்க்கப்படுவதற்குப் பதிலாக, இருக்கும் "
"எஃப்-மாடிஃபையர்களை மாற்றவும்"

#. :src: bpy.types.GRAPH_OT_frame_jump
msgid "Place the cursor on the midpoint of selected keyframes"
msgstr "தேர்ந்தெடுக்கப்பட்ட கீஃப்ரேம்களின் நடுப்பகுதியில் கர்சரை வைக்கவும்"

#. :src: bpy.types.GRAPH_OT_gaussian_smooth
msgctxt "Operator"
msgid "Gaussian Smooth"
msgstr "காசியன் மென்மையான"

#. :src: bpy.types.GRAPH_OT_gaussian_smooth
msgid "Smooth the curve using a Gaussian filter"
msgstr "காசியன் வடிப்பானைப் பயன்படுத்தி வளைவை மென்மையாக்கவும்"

#. :src: bpy.types.GRAPH_OT_gaussian_smooth.filter_width
#. :src: bpy.types.CyclesRenderSettings.filter_width
#: source/blender/nodes/shader/nodes/node_shader_bump.cc:37
msgid "Filter Width"
msgstr "வடிகட்டி அகலம்"

#. :src: bpy.types.GRAPH_OT_gaussian_smooth.filter_width
msgid "How far to each side the operator will average the key values"
msgstr ""
"ஒவ்வொரு பக்கத்திற்கும் ஆபரேட்டர் எவ்வளவு தூரம் முக்கிய மதிப்புகளை சராசரியாக "
"மாற்றுவார்"

#. :src: bpy.types.GRAPH_OT_gaussian_smooth.sigma
msgid "Sigma"
msgstr "சிக்மா"

#. :src: bpy.types.GRAPH_OT_gaussian_smooth.sigma
msgid "The shape of the gaussian distribution, lower values make it sharper"
msgstr ""
"காசியன் விநியோகத்தின் வடிவம், குறைந்த மதிப்புகள் அதை கூர்மையாக ஆக்குகின்றன"

#. :src: bpy.types.GRAPH_OT_ghost_curves_clear
msgctxt "Operator"
msgid "Clear Ghost Curves"
msgstr "பேய் வளைவுகளை அழிக்கவும்"

#. :src: bpy.types.GRAPH_OT_ghost_curves_clear
msgid "Clear F-Curve snapshots (Ghosts) for active Graph Editor"
msgstr ""
"செயலில் உள்ள வரைபட திருத்திக்கு எஃப்-வளைவு ச்னாப்சாட்களை (பேய்கள்) "
"அழிக்கவும்"

#. :src: bpy.types.GRAPH_OT_ghost_curves_create
msgctxt "Operator"
msgid "Create Ghost Curves"
msgstr "பேய் வளைவுகளை உருவாக்கவும்"

#. :src: bpy.types.GRAPH_OT_ghost_curves_create
msgid ""
"Create snapshot (Ghosts) of selected F-Curves as background aid for active "
"Graph Editor"
msgstr ""
"செயலில் உள்ள வரைபட திருத்திக்கான பின்னணி உதவியாக தேர்ந்தெடுக்கப்பட்ட "
"எஃப்-வளைவுகளின் ச்னாப்சாட்டை (பேய்கள்) உருவாக்கவும்"

#. :src: bpy.types.GRAPH_OT_hide
msgctxt "Operator"
msgid "Hide Curves"
msgstr "வளைவுகளை மறைக்கவும்"

#. :src: bpy.types.GRAPH_OT_hide
msgid "Hide selected curves from Graph Editor view"
msgstr "வரைபட திருத்தி பார்வையில் தேர்ந்தெடுக்கப்பட்ட வளைவுகளை மறைக்கவும்"

#. :src: bpy.types.GRAPH_OT_hide.unselected
msgid "Hide unselected rather than selected curves"
msgstr "தேர்ந்தெடுக்கப்பட்ட வளைவுகளை விட தேர்வு செய்யப்படாததை மறைக்கவும்"

#. :src: bpy.types.GRAPH_OT_keyframe_insert.type:'ALL'
msgid ""
"Insert a keyframe on all visible and editable F-Curves using each curve's "
"current value"
msgstr ""
"ஒவ்வொரு வளைவின் தற்போதைய மதிப்பைப் பயன்படுத்தி அனைத்து புலப்படும் மற்றும் "
"திருத்தக்கூடிய எஃப்-வளைவுகளிலும் ஒரு கீஃப்ரேமைச் செருகவும்"

#. :src: bpy.types.GRAPH_OT_keyframe_insert.type:'SEL'
msgid ""
"Insert a keyframe on selected F-Curves using each curve's current value"
msgstr ""
"ஒவ்வொரு வளைவின் தற்போதைய மதிப்பைப் பயன்படுத்தி தேர்ந்தெடுக்கப்பட்ட "
"எஃப்-வளைவுகளில் ஒரு கீஃப்ரேமைச் செருகவும்"

#. :src: bpy.types.GRAPH_OT_keyframe_insert.type:'ACTIVE'
msgid "Only Active F-Curve"
msgstr "செயலில் எஃப்-வளைவு மட்டுமே"

#. :src: bpy.types.GRAPH_OT_keyframe_insert.type:'ACTIVE'
msgid ""
"Insert a keyframe on the active F-Curve using the curve's current value"
msgstr ""
"வளைவின் தற்போதைய மதிப்பைப் பயன்படுத்தி செயலில் உள்ள எஃப்-வளைவில் ஒரு "
"கீஃப்ரேமை செருகவும்"

#. :src: bpy.types.GRAPH_OT_keyframe_insert.type:'CURSOR_ACTIVE'
msgid "Active Channels at Cursor"
msgstr "கர்சரில் செயலில் உள்ள சேனல்கள்"

#. :src: bpy.types.GRAPH_OT_keyframe_insert.type:'CURSOR_ACTIVE'
msgid "Insert a keyframe for the active F-Curve at the cursor point"
msgstr "கர்சர் புள்ளியில் செயலில் உள்ள எஃப்-வளைவுக்கு ஒரு கீஃப்ரேமை செருகவும்"

#. :src: bpy.types.GRAPH_OT_keyframe_insert.type:'CURSOR_SEL'
msgid "Selected Channels at Cursor"
msgstr "கர்சரில் தேர்ந்தெடுக்கப்பட்ட சேனல்கள்"

#. :src: bpy.types.GRAPH_OT_keyframe_insert.type:'CURSOR_SEL'
msgid "Insert a keyframe for selected F-Curves at the cursor point"
msgstr ""
"கர்சர் புள்ளியில் தேர்ந்தெடுக்கப்பட்ட எஃப்-வளைவுகளுக்கு ஒரு கீஃப்ரேமை "
"செருகவும்"

#. :src: bpy.types.GRAPH_OT_keyframe_jump
#. :src: bpy.types.SCREEN_OT_keyframe_jump
msgctxt "Operator"
msgid "Jump to Keyframe"
msgstr "கீஃப்ரேமுக்கு செல்லவும்"

#. :src: bpy.types.GRAPH_OT_keyframe_jump
#. :src: bpy.types.SCREEN_OT_keyframe_jump
msgid "Jump to previous/next keyframe"
msgstr "முந்தைய/அடுத்த கீஃப்ரேமுக்கு செல்லவும்"

#. :src: bpy.types.GRAPH_OT_keyframe_jump.next
#. :src: bpy.types.POSE_OT_blend_to_neighbor.next_frame
#. :src: bpy.types.POSE_OT_blend_with_rest.next_frame
#. :src: bpy.types.POSE_OT_breakdown.next_frame
#. :src: bpy.types.POSE_OT_push.next_frame
#. :src: bpy.types.POSE_OT_relax.next_frame
#. :src: bpy.types.SCREEN_OT_keyframe_jump.next
msgid "Next Keyframe"
msgstr "அடுத்த கீஃப்ரேம்"

#. :src: bpy.types.GRAPH_OT_keys_to_samples
msgctxt "Operator"
msgid "Keys to Samples"
msgstr "மாதிரிகளின் விசைகள்"

#. :src: bpy.types.GRAPH_OT_keys_to_samples
msgid ""
"Convert selected channels to an uneditable set of samples to save storage "
"space"
msgstr ""
"சேமிப்பக இடத்தை சேமிக்க தேர்ந்தெடுக்கப்பட்ட சேனல்களை ஒரு படிக்காத மாதிரிகளாக"
" மாற்றவும்"

#. :src: bpy.types.GRAPH_OT_match_slope
#: scripts/startup/bl_ui/space_graph.py:414
msgctxt "Operator"
msgid "Match Slope"
msgstr "சாய்வு பொருத்தவும்"

#. :src: bpy.types.GRAPH_OT_match_slope
msgid "Blend selected keys to the slope of neighboring ones"
msgstr "தேர்ந்தெடுக்கப்பட்ட விசைகளை அண்டை நாடுகளின் சாய்வுக்கு கலக்கவும்"

#. :src: bpy.types.GRAPH_OT_match_slope.factor
msgid "Defines which keys to use as slope and how much to blend towards them"
msgstr ""
"எந்த விசைகளை சாய்வாக பயன்படுத்த வேண்டும், அவற்றை எவ்வளவு கலக்க வேண்டும் "
"என்பதை வரையறுக்கிறது"

#. :src: bpy.types.GRAPH_OT_mirror.type:'VALUE'
msgid "By Values Over Cursor Value"
msgstr "கர்சர் மதிப்புக்கு மேல் மதிப்புகள் மூலம்"

#. :src: bpy.types.GRAPH_OT_mirror.type:'VALUE'
msgid ""
"Flip values of selected keyframes using the cursor value (Y/Horizontal "
"component) as the mirror line"
msgstr ""
"கர்சர் மதிப்பை (y/கிடைமட்ட கூறு) கண்ணாடிக் கோட்டாகப் பயன்படுத்தி "
"தேர்ந்தெடுக்கப்பட்ட கீஃப்ரேம்களின் மதிப்புகள்"

#. :src: bpy.types.GRAPH_OT_mirror.type:'YAXIS'
msgid "By Times Over Zero Time"
msgstr "சுழிய நேரத்திற்கு மேல்"

#. :src: bpy.types.GRAPH_OT_mirror.type:'YAXIS'
msgid ""
"Flip times of selected keyframes, effectively reversing the order they "
"appear in"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட கீஃப்ரேம்களின் புரட்டு நேரங்கள், அவை தோன்றும் வரிசையை "
"திறம்பட மாற்றியமைக்கின்றன"

#. :src: bpy.types.GRAPH_OT_paste.value_offset
msgid "Paste keys with a value offset"
msgstr "மதிப்பு ஆஃப்செட் கொண்ட விசைகளை ஒட்டவும்"

#. :src: bpy.types.GRAPH_OT_paste.value_offset:'LEFT_KEY'
msgid "Left Key"
msgstr "இடது விசை"

#. :src: bpy.types.GRAPH_OT_paste.value_offset:'LEFT_KEY'
msgid "Paste keys with the first key matching the key left of the cursor"
msgstr ""
"கர்சரின் இடதுபுறத்தில் பொருந்தக்கூடிய முதல் விசையுடன் விசைகளை ஒட்டவும்"

#. :src: bpy.types.GRAPH_OT_paste.value_offset:'RIGHT_KEY'
msgid "Right Key"
msgstr "வலது விசை"

#. :src: bpy.types.GRAPH_OT_paste.value_offset:'RIGHT_KEY'
msgid "Paste keys with the last key matching the key right of the cursor"
msgstr ""
"கர்சரின் முக்கிய உரிமையுடன் பொருந்தக்கூடிய கடைசி விசையுடன் விசைகளை ஒட்டவும்"

#. :src: bpy.types.GRAPH_OT_paste.value_offset:'CURRENT_FRAME'
msgid "Current Frame Value"
msgstr "தற்போதைய சட்ட மதிப்பு"

#. :src: bpy.types.GRAPH_OT_paste.value_offset:'CURRENT_FRAME'
msgid "Paste keys relative to the value of the curve under the cursor"
msgstr "கர்சரின் கீழ் வளைவின் மதிப்புடன் தொடர்புடைய விசைகளை ஒட்டவும்"

#. :src: bpy.types.GRAPH_OT_paste.value_offset:'CURSOR_VALUE'
msgid "Cursor Value"
msgstr "கர்சர் மதிப்பு"

#. :src: bpy.types.GRAPH_OT_paste.value_offset:'CURSOR_VALUE'
msgid "Paste keys relative to the Y-Position of the cursor"
msgstr "கர்சரின் ஒய்-நிலைக்கு தொடர்புடைய விசைகளை ஒட்டவும்"

#. :src: bpy.types.GRAPH_OT_paste.value_offset:'NONE'
msgid "Paste keys with the same value as they were copied"
msgstr "அவை நகலெடுக்கப்பட்ட அதே மதிப்புடன் விசைகளை ஒட்டவும்"

#. :src: bpy.types.GRAPH_OT_previewrange_set
msgid "Set Preview Range based on range of selected keyframes"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட கீஃப்ரேம்களின் வரம்பின் அடிப்படையில் முன்னோட்ட வரம்பை "
"அமைக்கவும்"

#. :src: bpy.types.GRAPH_OT_push_pull
msgctxt "Operator"
msgid "Push Pull Keyframes"
msgstr "புச் புல் கீஃப்ரேம்கள்"

#. :src: bpy.types.GRAPH_OT_push_pull
msgid "Exaggerate or minimize the value of the selected keys"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட விசைகளின் மதிப்பை மிகைப்படுத்தவும் அல்லது குறைக்கவும்"

#. :src: bpy.types.GRAPH_OT_push_pull.factor
msgid "Control how far to push or pull the keys"
msgstr ""
"விசைகளை எவ்வளவு தூரம் தள்ளுவது அல்லது இழுக்க வேண்டும் என்பதைக் "
"கட்டுப்படுத்தவும்"

#. :src: bpy.types.GRAPH_OT_reveal
msgctxt "Operator"
msgid "Reveal Curves"
msgstr "வளைவுகளை வெளிப்படுத்துங்கள்"

#. :src: bpy.types.GRAPH_OT_reveal
msgid "Make previously hidden curves visible again in Graph Editor view"
msgstr ""
"வரைபட திருத்தி பார்வையில் முன்னர் மறைக்கப்பட்ட வளைவுகளை மீண்டும் காணச் "
"செய்யுங்கள்"

#. :src: bpy.types.GRAPH_OT_samples_to_keys
msgctxt "Operator"
msgid "Samples to Keys"
msgstr "விசைகளுக்கு மாதிரிகள்"

#. :src: bpy.types.GRAPH_OT_samples_to_keys
msgid "Convert selected channels from samples to keyframes"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட சேனல்களை மாதிரிகளிலிருந்து கீஃப்ரேம்களாக மாற்றவும்"

#. :src: bpy.types.GRAPH_OT_scale_average
msgctxt "Operator"
msgid "Scale Average Keyframes"
msgstr "அளவிலான சராசரி கீஃப்ரேம்கள்"

#. :src: bpy.types.GRAPH_OT_scale_average
msgid "Scale selected key values by their combined average"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட முக்கிய மதிப்புகளை அவற்றின் ஒருங்கிணைந்த சராசரியால் "
"அளவிடவும்"

#. :src: bpy.types.GRAPH_OT_scale_average.factor
msgid "Scale Factor"
msgstr "அளவிலான காரணி"

#. :src: bpy.types.GRAPH_OT_scale_average.factor
msgid "The scale factor applied to the curve segments"
msgstr "வளைவு பிரிவுகளுக்கு பயன்படுத்தப்படும் அளவிலான காரணி"

#. :src: bpy.types.GRAPH_OT_scale_from_neighbor
#: scripts/startup/bl_ui/space_graph.py:418
msgctxt "Operator"
msgid "Scale from Neighbor"
msgstr "அண்டை வீட்டிலிருந்து அளவு"

#. :src: bpy.types.GRAPH_OT_scale_from_neighbor
msgid ""
"Increase or decrease the value of selected keys in relationship to the "
"neighboring one"
msgstr ""
"அண்டை ஒருவருடனான உறவில் தேர்ந்தெடுக்கப்பட்ட விசைகளின் மதிப்பை அதிகரிக்கவும் "
"அல்லது குறைக்கவும்"

#. :src: bpy.types.GRAPH_OT_scale_from_neighbor.anchor
msgid "Which end of the segment to use as a reference to scale from"
msgstr "பிரிவின் எந்த முடிவு அளவுகோலுக்கான குறிப்பாக பயன்படுத்த வேண்டும்"

#. :src: bpy.types.GRAPH_OT_scale_from_neighbor.anchor:'LEFT'
#. :src: bpy.types.GRAPH_OT_shear.direction:'FROM_LEFT'
#: source/blender/editors/space_graph/graph_slider_ops.cc:1568
#: source/blender/editors/space_graph/graph_slider_ops.cc:2459
msgid "From Left"
msgstr "இடமிருந்து"

#. :src: bpy.types.GRAPH_OT_scale_from_neighbor.anchor:'RIGHT'
#. :src: bpy.types.GRAPH_OT_shear.direction:'FROM_RIGHT'
#: source/blender/editors/space_graph/graph_slider_ops.cc:1568
#: source/blender/editors/space_graph/graph_slider_ops.cc:2460
msgid "From Right"
msgstr "வலதுபுறத்திலிருந்து"

#. :src: bpy.types.GRAPH_OT_scale_from_neighbor.factor
msgid "The factor to scale keys with"
msgstr "விசைகளை அளவிடுவதற்கான காரணி"

#. :src: bpy.types.GRAPH_OT_select_box.include_handles
#. :src: bpy.types.GRAPH_OT_select_circle.include_handles
#. :src: bpy.types.GRAPH_OT_select_lasso.include_handles
msgid ""
"Are handles tested individually against the selection criteria, "
"independently from their keys. When unchecked, handles are (de)selected in "
"unison with their keys"
msgstr ""
"தேர்வு அளவுகோல்களுக்கு எதிராக தனித்தனியாக சோதனை செய்யப்படுகின்றன, அவற்றின் "
"விசைகளிலிருந்து சுயாதீனமாக. தேர்வு செய்யப்படும்போது, கைப்பிடிகள் (டி) "
"அவற்றின் சாவியுடன் ஒற்றுமையாக தேர்ந்தெடுக்கப்படுகின்றன"

#. :src: bpy.types.GRAPH_OT_select_box.use_curve_selection
#. :src: bpy.types.GRAPH_OT_select_circle.use_curve_selection
#. :src: bpy.types.GRAPH_OT_select_lasso.use_curve_selection
msgid "Select Curves"
msgstr "வளைவுகளைத் தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.GRAPH_OT_select_box.use_curve_selection
msgid ""
"Allow selecting all the keyframes of a curve by selecting the calculated "
"F-curve"
msgstr ""
"கணக்கிடப்பட்ட எஃப்-வளைவைத் தேர்ந்தெடுப்பதன் மூலம் வளைவின் அனைத்து "
"கீஃப்ரேம்களையும் தேர்ந்தெடுக்க அனுமதிக்கவும்"

#. :src: bpy.types.GRAPH_OT_select_circle.use_curve_selection
#. :src: bpy.types.GRAPH_OT_select_lasso.use_curve_selection
msgid ""
"Allow selecting all the keyframes of a curve by selecting the curve itself"
msgstr ""
"வளைவைத் தேர்ந்தெடுப்பதன் மூலம் வளைவின் அனைத்து கீஃப்ரேம்களையும் "
"தேர்ந்தெடுக்க அனுமதிக்கவும்"

#. :src: bpy.types.GRAPH_OT_select_key_handles
msgctxt "Operator"
msgid "Select Key / Handles"
msgstr "விசை / கைப்பிடிகளைத் தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.GRAPH_OT_select_key_handles
msgid ""
"For selected keyframes, select/deselect any combination of the key itself "
"and its handles"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட கீஃப்ரேம்களுக்கு, விசையின் எந்தவொரு கலவையையும் அதன் "
"கைப்பிடிகளையும் தேர்ந்தெடுக்கவும்/தேர்வு செய்யவும்"

#. :src: bpy.types.GRAPH_OT_select_key_handles.key_action
msgid "Effect on the key itself"
msgstr "விசையில் விளைவு"

#. :src: bpy.types.GRAPH_OT_select_key_handles.key_action:'KEEP'
#. :src: bpy.types.GRAPH_OT_select_key_handles.left_handle_action:'KEEP'
#. :src: bpy.types.GRAPH_OT_select_key_handles.right_handle_action:'KEEP'
#. :src: bpy.types.WM_OT_usd_export.export_textures_mode:'KEEP'
#. :src: bpy.types.WM_OT_usd_export.usdz_downscale_size:'KEEP'
msgid "Keep"
msgstr "வை"

#. :src: bpy.types.GRAPH_OT_select_key_handles.key_action:'KEEP'
#. :src: bpy.types.GRAPH_OT_select_key_handles.left_handle_action:'KEEP'
#. :src: bpy.types.GRAPH_OT_select_key_handles.right_handle_action:'KEEP'
msgid "Leave as is"
msgstr "விடுங்கள்"

#. :src: bpy.types.GRAPH_OT_select_key_handles.left_handle_action
msgid "Effect on the left handle"
msgstr "இடது கைப்பிடியில் விளைவு"

#. :src: bpy.types.GRAPH_OT_select_key_handles.right_handle_action
msgid "Effect on the right handle"
msgstr "வலது கைப்பிடியில் விளைவு"

#. :src: bpy.types.GRAPH_OT_shear
msgctxt "Operator"
msgid "Shear Keyframes"
msgstr "வெட்டு கீஃப்ரேம்கள்"

#. :src: bpy.types.GRAPH_OT_shear
msgid ""
"Affect the value of the keys linearly, keeping the same relationship between"
" them using either the left or the right key as reference"
msgstr ""
"விசைகளின் மதிப்பை நேர்கோட்டுடன் பாதிக்கும், இடது அல்லது வலது விசையை "
"குறிப்பாகப் பயன்படுத்தி அவற்றுக்கிடையே அதே உறவை வைத்திருங்கள்"

#. :src: bpy.types.GRAPH_OT_shear.direction
msgid "Which end of the segment to use as a reference to shear from"
msgstr "பிரிவின் எந்த முடிவு வெட்டுக்கான குறிப்பாக பயன்படுத்த வேண்டும்"

#. :src: bpy.types.GRAPH_OT_shear.direction:'FROM_LEFT'
msgid "Shear the keys using the left key as reference"
msgstr "இடது விசையை குறிப்பாகப் பயன்படுத்தி விசைகளை வெட்டுங்கள்"

#. :src: bpy.types.GRAPH_OT_shear.direction:'FROM_RIGHT'
msgid "Shear the keys using the right key as reference"
msgstr "சரியான விசையை குறிப்பாகப் பயன்படுத்தி விசைகளை வெட்டுங்கள்"

#. :src: bpy.types.GRAPH_OT_shear.factor
msgid "Shear Factor"
msgstr "வெட்டு காரணி"

#. :src: bpy.types.GRAPH_OT_shear.factor
msgid "The amount of shear to apply"
msgstr "விண்ணப்பிக்க வெட்டு அளவு"

#. :src: bpy.types.GRAPH_OT_smooth
msgctxt "Operator"
msgid "Smooth Keys"
msgstr "மென்மையான விசைகள்"

#. :src: bpy.types.GRAPH_OT_smooth
msgid "Apply weighted moving means to make selected F-Curves less bumpy"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட எஃப்-வளைவுகளை குறைந்த சமதளமாக்க எடையுள்ள நகரும் வழிகளைப்"
" பயன்படுத்துங்கள்"

#. :src: bpy.types.GRAPH_OT_snap
msgid "Snap selected keyframes to the chosen times/values"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட நேரங்கள்/மதிப்புகளுக்கு தேர்ந்தெடுக்கப்பட்ட கீஃப்ரேம்களை"
" ச்னாப்"

#. :src: bpy.types.GRAPH_OT_snap.type:'VALUE'
msgid "Selection to Cursor Value"
msgstr "கர்சர் மதிப்புக்கு தேர்வு"

#. :src: bpy.types.GRAPH_OT_snap.type:'VALUE'
msgid ""
"Set values of selected keyframes to the cursor value (Y/Horizontal "
"component)"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட கீஃப்ரேம்களின் மதிப்புகளை கர்சர் மதிப்புக்கு அமைக்கவும் "
"(y/கிடைமட்ட கூறு)"

#. :src: bpy.types.GRAPH_OT_snap.type:'HORIZONTAL'
msgid "Flatten Handles"
msgstr "தட்டையான கைப்பிடிகள்"

#. :src: bpy.types.GRAPH_OT_snap.type:'HORIZONTAL'
msgid "Flatten handles for a smoother transition"
msgstr "மென்மையான மாற்றத்திற்காக தட்டையான கையாளுதல்கள்"

#. :src: bpy.types.GRAPH_OT_snap_cursor_value
msgctxt "Operator"
msgid "Snap Cursor Value to Selected"
msgstr "தேர்ந்தெடுக்கப்பட்டதற்கு கர்சர் மதிப்பு"

#. :src: bpy.types.GRAPH_OT_snap_cursor_value
msgid "Place the cursor value on the average value of selected keyframes"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட கீஃப்ரேம்களின் சராசரி மதிப்பில் கர்சர் மதிப்பை வைக்கவும்"

#. :src: bpy.types.GRAPH_OT_sound_to_samples
msgctxt "Operator"
msgid "Sound to Samples"
msgstr "மாதிரிகளுக்கு ஒலி"

#. :src: bpy.types.GRAPH_OT_sound_to_samples
msgid "Bakes a sound wave to samples on selected channels"
msgstr "தேர்ந்தெடுக்கப்பட்ட சேனல்களில் மாதிரிகளுக்கு ஒலி அலைகளை சுடுகிறது"

#. :src: bpy.types.GRAPH_OT_sound_to_samples.attack
msgid "Attack Time"
msgstr "தாக்குதல் நேரம்"

#. :src: bpy.types.GRAPH_OT_sound_to_samples.attack
msgid ""
"Value for the envelope calculation that tells how fast the envelope can rise"
" (the lower the value the steeper it can rise)"
msgstr ""
"உறை எவ்வளவு வேகமாக உயரக்கூடும் என்பதைக் கூறும் உறை கணக்கீட்டிற்கான மதிப்பு "
"(செங்குத்தான மதிப்பைக் குறைக்கும்)"

#. :src: bpy.types.GRAPH_OT_sound_to_samples.high
msgid "Highest Frequency"
msgstr "அதிக அதிர்வெண்"

#. :src: bpy.types.GRAPH_OT_sound_to_samples.high
msgid ""
"Cutoff frequency of a low-pass filter that is applied to the audio data"
msgstr ""
"ஆடியோ தரவுக்கு பயன்படுத்தப்படும் குறைந்த பாச் வடிப்பானின் வெட்டு அதிர்வெண்"

#. :src: bpy.types.GRAPH_OT_sound_to_samples.low
msgid "Lowest Frequency"
msgstr "குறைந்த அதிர்வெண்"

#. :src: bpy.types.GRAPH_OT_sound_to_samples.low
msgid ""
"Cutoff frequency of a high-pass filter that is applied to the audio data"
msgstr ""
"ஆடியோ தரவுக்கு பயன்படுத்தப்படும் உயர்-பாச் வடிப்பானின் வெட்டு அதிர்வெண்"

#. :src: bpy.types.GRAPH_OT_sound_to_samples.release
msgid "Release Time"
msgstr "வெளியீட்டு நேரம்"

#. :src: bpy.types.GRAPH_OT_sound_to_samples.release
msgid ""
"Value for the envelope calculation that tells how fast the envelope can fall"
" (the lower the value the steeper it can fall)"
msgstr ""
"உறை எவ்வளவு வேகமாக வீழ்ச்சியடையக்கூடும் என்பதைக் கூறும் உறை கணக்கீட்டிற்கான "
"மதிப்பு (செங்குத்தான மதிப்பைக் குறைக்கும்)"

#. :src: bpy.types.GRAPH_OT_sound_to_samples.sthreshold
msgid "Square Threshold"
msgstr "சதுர வாசல்"

#. :src: bpy.types.GRAPH_OT_sound_to_samples.sthreshold
msgid ""
"Square only: all values with an absolute amplitude lower than that result in"
" 0"
msgstr ""
"நாற்கை மட்டும்: ஒரு முழுமையான வீச்சு கொண்ட அனைத்து மதிப்புகளும் அந்த முடிவை "
"விட குறைவாக இருக்கும்"

#. :src: bpy.types.GRAPH_OT_sound_to_samples.threshold
msgid "Minimum amplitude value needed to influence the envelope"
msgstr "உறை பாதிக்க குறைந்தபட்ச வீச்சு மதிப்பு"

#. :src: bpy.types.GRAPH_OT_sound_to_samples.use_accumulate
msgid ""
"Only the positive differences of the envelope amplitudes are summarized to "
"produce the output"
msgstr ""
"உறை பெருக்கங்களின் நேர்மறையான வேறுபாடுகள் மட்டுமே வெளியீட்டை உருவாக்க "
"சுருக்கமாகக் கூறப்படுகின்றன"

#. :src: bpy.types.GRAPH_OT_sound_to_samples.use_additive
msgid ""
"The amplitudes of the envelope are summarized (or, when Accumulate is "
"enabled, both positive and negative differences are accumulated)"
msgstr ""
"உறைகளின் பெருக்கங்கள் சுருக்கப்பட்டுள்ளன (அல்லது, குவிந்து இயக்கப்பட்டால், "
"நேர்மறை மற்றும் எதிர்மறை வேறுபாடுகள் இரண்டுமே குவிக்கப்படுகின்றன)"

#. :src: bpy.types.GRAPH_OT_sound_to_samples.use_square
msgid ""
"The output is a square curve (negative values always result in -1, and "
"positive ones in 1)"
msgstr ""
"வெளியீடு ஒரு சதுர வளைவு (எதிர்மறை மதிப்புகள் எப்போதும் -1 இல் விளைகின்றன, "
"மேலும் 1 இல் நேர்மறை))"

#. :src: bpy.types.GRAPH_OT_time_offset
msgctxt "Operator"
msgid "Time Offset Keyframes"
msgstr "டைம் ஆஃப்செட் கீஃப்ரேம்கள்"

#. :src: bpy.types.GRAPH_OT_time_offset
msgid "Shifts the value of selected keys in time"
msgstr "தேர்ந்தெடுக்கப்பட்ட விசைகளின் மதிப்பை சரியான நேரத்தில் மாற்றுகிறது"

#. :src: bpy.types.GRAPH_OT_time_offset.frame_offset
msgid "How far in frames to offset the animation"
msgstr "அனிமேசனை ஈடுசெய்ய பிரேம்களில் எவ்வளவு தூரம்"

#. :src: bpy.types.GRAPH_OT_view_selected
msgid "Reset viewable area to show selected keyframe range"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட கீஃப்ரேம் வரம்பைக் காட்ட பார்க்கக்கூடிய பரப்பை "
"மீட்டமைக்கவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_active_frame_delete
msgctxt "Operator"
msgid "Delete Active Frame(s)"
msgstr "செயலில் உள்ள சட்டகம் (களை) நீக்கு"

#. :src: bpy.types.GREASE_PENCIL_OT_active_frame_delete
msgid "Delete the active Grease Pencil frame(s)"
msgstr "செயலில் உள்ள கிரீச் பென்சில் சட்டகத்தை (கள்) நீக்கவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_active_frame_delete.all
msgid "Delete all"
msgstr "அனைத்தையும் நீக்கு"

#. :src: bpy.types.GREASE_PENCIL_OT_active_frame_delete.all
msgid "Delete active keyframes of all layers"
msgstr "அனைத்து அடுக்குகளின் செயலில் உள்ள கீஃப்ரேம்களை நீக்கவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_bake_grease_pencil_animation
msgctxt "Operator"
msgid "Bake Object Transform to Grease Pencil"
msgstr "பசை எழுதுகோலுக்கு பொருள் மாற்றத்தை சுட்டுக்கொள்ளுங்கள்"

#. :src: bpy.types.GREASE_PENCIL_OT_bake_grease_pencil_animation
msgid "Bake Grease Pencil object transform to Grease Pencil keyframes"
msgstr ""
"கிரீச் பென்சில் பொருள் மாற்றத்தை கிரீச் பென்சில் கீஃப்ரேம்களுக்கு "
"சுட்டுக்கொள்ளுங்கள்"

#. :src: bpy.types.GREASE_PENCIL_OT_bake_grease_pencil_animation.frame_end
msgid "The end frame of animation"
msgstr "அனிமேசனின் இறுதி சட்டகம்"

#. :src: bpy.types.GREASE_PENCIL_OT_bake_grease_pencil_animation.frame_start
msgid "The start frame"
msgstr "தொடக்க சட்டகம்"

#. :src: bpy.types.GREASE_PENCIL_OT_bake_grease_pencil_animation.frame_target
msgid "Target Frame"
msgstr "இலக்கு சட்டகம்"

#. :src: bpy.types.GREASE_PENCIL_OT_bake_grease_pencil_animation.frame_target
msgid "Destination frame"
msgstr "இலக்கு சட்டகம்"

#. :src: bpy.types.GREASE_PENCIL_OT_bake_grease_pencil_animation.only_selected
msgid "Only Selected Keyframes"
msgstr "தேர்ந்தெடுக்கப்பட்ட கீஃப்ரேம்கள் மட்டுமே"

#. :src: bpy.types.GREASE_PENCIL_OT_bake_grease_pencil_animation.only_selected
msgid "Convert only selected keyframes"
msgstr "தேர்ந்தெடுக்கப்பட்ட கீஃப்ரேம்களை மட்டுமே மாற்றவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_bake_grease_pencil_animation.project_type
#. :src: bpy.types.GREASE_PENCIL_OT_reproject.type
msgid "Projection Type"
msgstr "திட்ட வகை"

#. :src:
#. bpy.types.GREASE_PENCIL_OT_bake_grease_pencil_animation.project_type:'KEEP'
msgid "No Reproject"
msgstr "இனிப்பான் இல்லை"

#. :src:
#. bpy.types.GREASE_PENCIL_OT_bake_grease_pencil_animation.project_type:'FRONT'
#. :src: bpy.types.GREASE_PENCIL_OT_reproject.type:'FRONT'
msgid "Reproject the strokes using the X-Z plane"
msgstr "எக்ச்-இசட் விமானத்தைப் பயன்படுத்தி வீச்சுகள்"

#. :src:
#. bpy.types.GREASE_PENCIL_OT_bake_grease_pencil_animation.project_type:'SIDE'
#. :src: bpy.types.GREASE_PENCIL_OT_reproject.type:'SIDE'
msgid "Reproject the strokes using the Y-Z plane"
msgstr "y-z விமானத்தைப் பயன்படுத்தி வீச்சுகள்"

#. :src:
#. bpy.types.GREASE_PENCIL_OT_bake_grease_pencil_animation.project_type:'TOP'
#. :src: bpy.types.GREASE_PENCIL_OT_reproject.type:'TOP'
msgid "Reproject the strokes using the X-Y plane"
msgstr "எக்ச்-ஒய் விமானத்தைப் பயன்படுத்தி வீச்சுகள்"

#. :src:
