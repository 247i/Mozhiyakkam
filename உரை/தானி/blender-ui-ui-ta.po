#. :src: bpy.types.UV_OT_sphere_project.pole:'PINCH'
#: scripts/startup/bl_ui/properties_paint_common.py:787
msgid "Pinch"
msgstr "கிள்ளுதல்"

#. :src: bpy.types.UV_OT_cylinder_project.pole:'PINCH'
#. :src: bpy.types.UV_OT_sphere_project.pole:'PINCH'
msgid "UVs are pinched at the poles"
msgstr "புறஊதாக்கள் துருவங்களில் கிள்ளுகின்றன"

#. :src: bpy.types.UV_OT_cylinder_project.pole:'FAN'
#. :src: bpy.types.UV_OT_sphere_project.pole:'FAN'
msgid "UVs are fanned at the poles"
msgstr "புறஊதாக்கள் துருவங்களில் ஒலிக்கின்றன"

#. :src: bpy.types.UV_OT_cylinder_project.radius
msgid "Radius of the sphere or cylinder"
msgstr "கோளத்தின் ஆரம் அல்லது சிலிண்டர்"

#. :src: bpy.types.UV_OT_cylinder_project.seam
#. :src: bpy.types.UV_OT_sphere_project.seam
msgid "Preserve Seams"
msgstr "சீம்களைப் பாதுகாக்கவும்"

#. :src: bpy.types.UV_OT_cylinder_project.seam
#. :src: bpy.types.UV_OT_sphere_project.seam
msgid "Separate projections by islands isolated by seams"
msgstr "சீம்களால் தனிமைப்படுத்தப்பட்ட தீவுகளின் தனி கணிப்புகள்"

#. :src: bpy.types.UV_OT_export_layout.export_all
msgid "All UVs"
msgstr "அனைத்து uv களும்"

#. :src: bpy.types.UV_OT_export_layout.export_all
msgid "Export all UVs in this mesh (not just visible ones)"
msgstr ""
"இந்த கண்ணி அனைத்து புறஊதாக்களையும் ஏற்றுமதி செய்யுங்கள் (புலப்படும்வை "
"மட்டுமல்ல)"

#. :src: bpy.types.UV_OT_export_layout.export_tiles
msgid "Export Tiles"
msgstr "ஓடுகளை ஏற்றுமதி செய்யுங்கள்"

#. :src: bpy.types.UV_OT_export_layout.export_tiles
msgid "Choose whether to export only the [0, 1] range, or all UV tiles"
msgstr ""
"[0, 1] வரம்பு அல்லது அனைத்து புறஊதா ஓடுகளையும் மட்டுமே ஏற்றுமதி செய்ய "
"வேண்டுமா என்பதைத் தேர்வுசெய்க"

#. :src: bpy.types.UV_OT_export_layout.export_tiles:'NONE'
msgid "Export only UVs in the [0, 1] range"
msgstr "[0, 1] வரம்பில் uv களை மட்டுமே ஏற்றுமதி செய்யுங்கள்"

#. :src: bpy.types.UV_OT_export_layout.export_tiles:'UDIM'
msgid "Export tiles in the UDIM numbering scheme: 1001 + u_tile + 10*v_tile"
msgstr ""
"யுடிம் எண் திட்டத்தில் ஓடுகளை ஏற்றுமதி செய்யுங்கள்: 1001 + u_tile + "
"10*v_tile"

#. :src: bpy.types.UV_OT_export_layout.export_tiles:'UV'
msgid "UVTILE"
msgstr "uvtile"

#. :src: bpy.types.UV_OT_export_layout.export_tiles:'UV'
msgid ""
"Export tiles in the UVTILE numbering scheme: u(u_tile + 1)_v(v_tile + 1)"
msgstr ""
"uvtile எண் திட்டத்தில் ஓடுகளை ஏற்றுமதி செய்யுங்கள்: u (u_tile + 1) _v "
"(v_tile + 1)"

#. :src: bpy.types.UV_OT_export_layout.mode
msgid "File format to export the UV layout to"
msgstr "புறஊதா தளவமைப்பை ஏற்றுமதி செய்ய கோப்பு வடிவம்"

#. :src: bpy.types.UV_OT_export_layout.mode:'SVG'
msgid "Scalable Vector Graphic (.svg)"
msgstr "அளவிடக்கூடிய திசையன் கிராஃபிக் (.svg)"

#. :src: bpy.types.UV_OT_export_layout.mode:'SVG'
msgid "Export the UV layout to a vector SVG file"
msgstr "uv தளவமைப்பை ஒரு திசையன் svg கோப்பில் ஏற்றுமதி செய்யுங்கள்"

#. :src: bpy.types.UV_OT_export_layout.mode:'EPS'
msgid "Encapsulated PostScript (.eps)"
msgstr "இணைக்கப்பட்ட போச்ட்கைஉரை (.eps)"

#. :src: bpy.types.UV_OT_export_layout.mode:'EPS'
msgid "Export the UV layout to a vector EPS file"
msgstr "uv தளவமைப்பை ஒரு திசையன் eps கோப்பில் ஏற்றுமதி செய்யுங்கள்"

#. :src: bpy.types.UV_OT_export_layout.mode:'PNG'
msgid "PNG Image (.png)"
msgstr "png படம் (.png)"

#. :src: bpy.types.UV_OT_export_layout.mode:'PNG'
msgid "Export the UV layout to a bitmap image"
msgstr "uv தளவமைப்பை பிட்மேப் படத்திற்கு ஏற்றுமதி செய்யுங்கள்"

#. :src: bpy.types.UV_OT_export_layout.modified
msgctxt "Mesh"
msgid "Modified"
msgstr "மாற்றியமைக்கப்பட்ட"

#. :src: bpy.types.UV_OT_export_layout.modified
msgid "Exports UVs from the modified mesh"
msgstr "மாற்றியமைக்கப்பட்ட கண்ணி இருந்து uv களை ஏற்றுமதி செய்கிறது"

#. :src: bpy.types.UV_OT_export_layout.opacity
msgid "Set amount of opacity for exported UV layout"
msgstr "ஏற்றுமதி செய்யப்பட்ட புறஊதா தளவமைப்புக்கான ஒளிபுகாநிலையை அமைக்கவும்"

#. :src: bpy.types.UV_OT_export_layout.size
msgid "Dimensions of the exported file"
msgstr "ஏற்றுமதி செய்யப்பட்ட கோப்பின் பரிமாணங்கள்"

#. :src: bpy.types.UV_OT_follow_active_quads.mode
msgid "Edge Length Mode"
msgstr "விளிம்பு நீள பயன்முறை"

#. :src: bpy.types.UV_OT_follow_active_quads.mode
msgid "Method to space UV edge loops"
msgstr "விண்வெளி புறஊதா விளிம்பு சுழல்கள்"

#. :src: bpy.types.UV_OT_follow_active_quads.mode:'EVEN'
#. :src: bpy.types.UV_OT_lightmap_pack.PREF_CONTEXT:'SEL_FACES'
msgid "Space all UVs evenly"
msgstr "விண்வெளி அனைத்து புறஊதாக்களும் சமமாக"

#. :src: bpy.types.UV_OT_follow_active_quads.mode:'LENGTH'
#. :src: bpy.types.UV_OT_follow_active_quads.mode:'LENGTH_AVERAGE'
#. :src: bpy.types.UV_OT_lightmap_pack.PREF_CONTEXT:'ALL_FACES'
msgid "Average space UVs edge length of each loop"
msgstr "ஒவ்வொரு வளையத்தின் சராசரி விண்வெளி uvs விளிம்பு நீளம்"

#. :src: bpy.types.UV_OT_follow_active_quads.mode:'LENGTH_AVERAGE'
msgid "Length Average"
msgstr "நீள சராசரி"

#. :src: bpy.types.UV_OT_hide
msgid "Hide (un)selected UV vertices"
msgstr "மறைக்க (ஐ.நா) தேர்ந்தெடுக்கப்பட்ட புறஊதா செங்குத்துகள்"

#. :src: bpy.types.UV_OT_lightmap_pack.PREF_BOX_DIV
msgid "Pack Quality"
msgstr "பேக் தகுதி"

#. :src: bpy.types.UV_OT_lightmap_pack.PREF_BOX_DIV
msgid ""
"Quality of the packing. Higher values will be slower but waste less space"
msgstr ""
"பேக்கிங்கின் தகுதி. அதிக மதிப்புகள் மெதுவாக இருக்கும், ஆனால் குறைந்த இடத்தை "
"வீணாக்குகின்றன"

#. :src: bpy.types.UV_OT_lightmap_pack.PREF_CONTEXT:'SEL_FACES'
msgid "Selected Faces"
msgstr "தேர்ந்தெடுக்கப்பட்ட முகங்கள்"

#. :src: bpy.types.UV_OT_lightmap_pack.PREF_CONTEXT:'ALL_FACES'
msgid "All Faces"
msgstr "அனைத்து முகங்களும்"

#. :src: bpy.types.UV_OT_lightmap_pack.PREF_MARGIN_DIV
msgid "Size of the margin as a division of the UV"
msgstr "புறஊதா பிரிவாக விளிம்பின் அளவு"

#. :src: bpy.types.UV_OT_lightmap_pack.PREF_NEW_UVLAYER
msgid "New UV Map"
msgstr "புதிய புறஊதா வரைபடம்"

#. :src: bpy.types.UV_OT_lightmap_pack.PREF_NEW_UVLAYER
msgid "Create a new UV map for every mesh packed"
msgstr ""
"நிரம்பிய ஒவ்வொரு கண்ணி வரைபடத்திற்கும் புதிய புறஊதா வரைபடத்தை உருவாக்கவும்"

#. :src: bpy.types.UV_OT_lightmap_pack.PREF_PACK_IN_ONE
msgid "Share Texture Space"
msgstr "அமைப்பு இடத்தைப் பகிரவும்"

#. :src: bpy.types.UV_OT_lightmap_pack.PREF_PACK_IN_ONE
msgid "Objects share texture space, map all objects into a single UV map"
msgstr ""
"பொருள்கள் அமைப்பு இடத்தைப் பகிர்கின்றன, எல்லா பொருட்களையும் ஒற்றை புறஊதா "
"வரைபடத்தில் வரைபடமாக்குகின்றன"

#. :src: bpy.types.UV_OT_mark_seam
msgid "Mark selected UV edges as seams"
msgstr "மார்க் தேர்ந்தெடுக்கப்பட்ட புறஊதா விளிம்புகளை சீம்களாக"

#. :src: bpy.types.UV_OT_mark_seam.clear
#. :src: bpy.types.UV_OT_stitch.clear_seams
msgid "Clear Seams"
msgstr "தெளிவான சீம்கள்"

#. :src: bpy.types.UV_OT_mark_seam.clear
msgid "Clear instead of marking seams"
msgstr "சீம்களைக் குறிப்பதற்கு பதிலாக அழிக்கவும்"

#. :src: bpy.types.UV_OT_minimize_stretch
msgctxt "Operator"
msgid "Minimize Stretch"
msgstr "நீட்டிப்பைக் குறைக்கவும்"

#. :src: bpy.types.UV_OT_minimize_stretch
msgid "Reduce UV stretching by relaxing angles"
msgstr "கோணங்களை தளர்த்துவதன் மூலம் புறஊதா நீட்டிப்பைக் குறைக்கவும்"

#. :src: bpy.types.UV_OT_minimize_stretch.blend
msgid "Blend factor between stretch minimized and original"
msgstr "நீட்டிக்கப்பட்ட மற்றும் அசல் இடையே கலப்பு காரணி"

#. :src: bpy.types.UV_OT_minimize_stretch.fill_holes
#. :src: bpy.types.UV_OT_unwrap.fill_holes
#: source/blender/nodes/geometry/nodes/node_geo_uv_unwrap.cc:43
msgid ""
"Virtually fill holes in mesh before unwrapping, to better avoid overlaps and"
" preserve symmetry"
msgstr ""
"ஒன்றுடன் ஒன்று ஒன்றுடன் ஒன்று தவிர்ப்பதற்கும், சமச்சீரைப் பாதுகாப்பதற்கும், "
"அவிழ்ப்பதற்கு முன் கிட்டத்தட்ட துளைகளை மெசில் நிரப்பவும்"

#. :src: bpy.types.UV_OT_minimize_stretch.iterations
msgid "Number of iterations to run, 0 is unlimited when run interactively"
msgstr ""
"இயக்க மறு செய்கைகளின் எண்ணிக்கை, ஊடாடும் வகையில் இயக்கும்போது 0 வரம்பற்றது"

#. :src: bpy.types.UV_OT_pack_islands
msgctxt "Operator"
msgid "Pack Islands"
msgstr "பொதி தீவுகள்"

#. :src: bpy.types.UV_OT_pack_islands
msgid ""
"Transform all islands so that they fill up the UV/UDIM space as much as "
"possible"
msgstr ""
"அனைத்து தீவுகளையும் மாற்றி, அவை புறஊதா/யுடிம் இடத்தை முடிந்தவரை "
"நிரப்புகின்றன"

#. :src: bpy.types.UV_OT_pack_islands.margin
#. :src: bpy.types.UV_OT_unwrap.margin
#: source/blender/nodes/geometry/nodes/node_geo_uv_pack_islands.cc:64
#: source/blender/nodes/geometry/nodes/node_geo_uv_unwrap.cc:39
msgid "Space between islands"
msgstr "தீவுகளுக்கு இடையில் இடைவெளி"

#. :src: bpy.types.UV_OT_pack_islands.margin_method
#. :src: bpy.types.UV_OT_smart_project.margin_method
#. :src: bpy.types.UV_OT_unwrap.margin_method
msgid "Margin Method"
msgstr "விளிம்பு முறை"

#. :src: bpy.types.UV_OT_pack_islands.margin_method:'SCALED'
#. :src: bpy.types.UV_OT_smart_project.margin_method:'SCALED'
#. :src: bpy.types.UV_OT_unwrap.margin_method:'SCALED'
msgid "Scaled"
msgstr "அளவிடப்பட்டது"

#. :src: bpy.types.UV_OT_pack_islands.margin_method:'SCALED'
#. :src: bpy.types.UV_OT_smart_project.margin_method:'SCALED'
#. :src: bpy.types.UV_OT_unwrap.margin_method:'SCALED'
msgid "Use scale of existing UVs to multiply margin"
msgstr "விளிம்பைப் பெருக்க இருக்கும் uv களின் அளவைப் பயன்படுத்தவும்"

#. :src: bpy.types.UV_OT_pack_islands.margin_method:'ADD'
#. :src: bpy.types.UV_OT_smart_project.margin_method:'ADD'
#. :src: bpy.types.UV_OT_unwrap.margin_method:'ADD'
msgid "Just add the margin, ignoring any UV scale"
msgstr "எந்த புறஊதா அளவையும் புறக்கணித்து விளிம்பைச் சேர்க்கவும்"

#. :src: bpy.types.UV_OT_pack_islands.margin_method:'FRACTION'
#. :src: bpy.types.UV_OT_smart_project.margin_method:'FRACTION'
#. :src: bpy.types.UV_OT_unwrap.margin_method:'FRACTION'
msgid "Fraction"
msgstr "பின்னம்"

#. :src: bpy.types.UV_OT_pack_islands.margin_method:'FRACTION'
#. :src: bpy.types.UV_OT_smart_project.margin_method:'FRACTION'
#. :src: bpy.types.UV_OT_unwrap.margin_method:'FRACTION'
msgid "Specify a precise fraction of final UV output"
msgstr "இறுதி புறஊதா வெளியீட்டின் துல்லியமான பகுதியைக் குறிப்பிடவும்"

#. :src: bpy.types.UV_OT_pack_islands.merge_overlap
msgid "Merge Overlapping"
msgstr "ஒன்றுடன் ஒன்று ஒன்றிணைக்கவும்"

#. :src: bpy.types.UV_OT_pack_islands.merge_overlap
msgid "Overlapping islands stick together"
msgstr "ஒன்றுடன் ஒன்று தீவுகள் ஒன்றாக ஒட்டிக்கொள்கின்றன"

#. :src: bpy.types.UV_OT_pack_islands.pin
msgid "Lock Pinned Islands"
msgstr "பூட்டு பின் செய்யப்பட்ட தீவுகள்"

#. :src: bpy.types.UV_OT_pack_islands.pin
msgid "Constrain islands containing any pinned UV's"
msgstr "எந்தவொரு பொருத்தப்பட்ட புறஊதா கொண்ட தீவுகளை கட்டுப்படுத்துகிறது"

#. :src: bpy.types.UV_OT_pack_islands.pin_method
msgid "Pin Method"
msgstr "முள் முறை"

#. :src: bpy.types.UV_OT_pack_islands.pin_method:'SCALE'
msgid "Pinned islands won't rescale"
msgstr "பின் செய்யப்பட்ட தீவுகள் மீளாது"

#. :src: bpy.types.UV_OT_pack_islands.pin_method:'ROTATION'
msgid "Pinned islands won't rotate"
msgstr "பின் செய்யப்பட்ட தீவுகள் சுழலாது"

#. :src: bpy.types.UV_OT_pack_islands.pin_method:'ROTATION_SCALE'
msgid "Rotation and Scale"
msgstr "சுழற்சி மற்றும் அளவு"

#. :src: bpy.types.UV_OT_pack_islands.pin_method:'ROTATION_SCALE'
msgid "Pinned islands will translate only"
msgstr "பின் செய்யப்பட்ட தீவுகள் மட்டுமே மொழிபெயர்க்கப்படும்"

#. :src: bpy.types.UV_OT_pack_islands.pin_method:'LOCKED'
msgid "Pinned islands are locked in place"
msgstr "பின் செய்யப்பட்ட தீவுகள் இடத்தில் பூட்டப்பட்டுள்ளன"

#. :src: bpy.types.UV_OT_pack_islands.rotate
msgid "Rotate islands to improve layout"
msgstr "தளவமைப்பை மேம்படுத்த தீவுகளை சுழற்றுங்கள்"

#. :src: bpy.types.UV_OT_pack_islands.rotate_method
#. :src: bpy.types.UV_OT_smart_project.rotate_method
msgid "Rotation Method"
msgstr "சுழற்சி முறை"

#. :src: bpy.types.UV_OT_pack_islands.rotate_method:'ANY'
msgid "Any angle is allowed for rotation"
msgstr "எந்த கோணமும் சுழற்சிக்கு அனுமதிக்கப்படுகிறது"

#. :src: bpy.types.UV_OT_pack_islands.rotate_method:'CARDINAL'
msgid "Only 90 degree rotations are allowed"
msgstr "90 டிகிரி சுழற்சிகள் மட்டுமே அனுமதிக்கப்படுகின்றன"

#. :src: bpy.types.UV_OT_pack_islands.rotate_method:'AXIS_ALIGNED'
#. :src: bpy.types.UV_OT_smart_project.rotate_method:'AXIS_ALIGNED'
msgid "Axis-aligned"
msgstr "அச்சு-சீரமை"

#. :src: bpy.types.UV_OT_pack_islands.rotate_method:'AXIS_ALIGNED'
#. :src: bpy.types.UV_OT_smart_project.rotate_method:'AXIS_ALIGNED'
msgid "Rotated to a minimal rectangle, either vertical or horizontal"
msgstr ""
"செங்குத்து அல்லது கிடைமட்டமாக குறைந்தபட்ச செவ்வகத்திற்கு சுழற்றப்படுகிறது"

#. :src: bpy.types.UV_OT_pack_islands.rotate_method:'AXIS_ALIGNED_X'
