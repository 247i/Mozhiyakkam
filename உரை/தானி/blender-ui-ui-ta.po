msgstr "அனைத்து அடுக்குகளும்"

#. :src: bpy.types.DataTransferModifier.layers_uv_select_src:'ALL'
#. :src: bpy.types.DataTransferModifier.layers_vcol_loop_select_src:'ALL'
#. :src: bpy.types.DataTransferModifier.layers_vcol_vert_select_src:'ALL'
#. :src: bpy.types.DataTransferModifier.layers_vgroup_select_src:'ALL'
#. :src: bpy.types.OBJECT_OT_data_transfer.layers_select_src:'ALL'
#. :src: bpy.types.OBJECT_OT_datalayout_transfer.layers_select_src:'ALL'
msgid "Transfer all data layers"
msgstr "எல்லா தரவு அடுக்குகளையும் மாற்றவும்"

#. :src: bpy.types.DataTransferModifier.layers_uv_select_src:'BONE_SELECT'
