msgstr "சட் சாதாரண"

#. :src: bpy.types.WaveModifier.use_normal_z
msgid "Enable displacement along the Z normal"
msgstr "சட் இயல்புடன் இடப்பெயர்ச்சியை இயக்கவும்"

#. :src: bpy.types.WaveModifier.use_x
msgid "X axis motion"
msgstr "ஃச் அச்சு இயக்கம்"

