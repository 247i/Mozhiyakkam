msgstr "செயலில் உள்ள தரவு அடுக்கை மட்டுமே மாற்றவும்"

#. :src: bpy.types.DataTransferModifier.layers_uv_select_src:'ALL'
#. :src: bpy.types.DataTransferModifier.layers_vcol_loop_select_src:'ALL'
#. :src: bpy.types.DataTransferModifier.layers_vcol_vert_select_src:'ALL'
#. :src: bpy.types.DataTransferModifier.layers_vgroup_select_src:'ALL'
