#. :src:
#. bpy.types.OBJECT_OT_datalayout_transfer.layers_select_src:'BONE_DEFORM'
msgid "Deform Pose Bones"
msgstr "போச் எலும்புகளை சிதைக்கவும்"

#. :src: bpy.types.DataTransferModifier.layers_uv_select_src:'BONE_DEFORM'
#. :src:
#. bpy.types.DataTransferModifier.layers_vcol_loop_select_src:'BONE_DEFORM'
#. :src:
#. bpy.types.DataTransferModifier.layers_vcol_vert_select_src:'BONE_DEFORM'
