msgstr "நேரியல்"

#. :src: bpy.types.GREASE_PENCIL_OT_interpolate_sequence.type:'CUSTOM'
msgctxt "GPencil"
msgid "Custom"
msgstr "தனிப்பயன்"

#. :src: bpy.types.GREASE_PENCIL_OT_interpolate_sequence.type:'CUSTOM'
msgid "Custom interpolation defined using a curve map"
msgstr ""
"வளைவு வரைபடத்தைப் பயன்படுத்தி தனிப்பயன் இடைக்கணிப்பு வரையறுக்கப்பட்டுள்ளது"

#. :src: bpy.types.GREASE_PENCIL_OT_interpolate_sequence.type:'SINE'
msgctxt "GPencil"
msgid "Sinusoidal"
msgstr "சைனூசாய்டல்"

#. :src: bpy.types.GREASE_PENCIL_OT_interpolate_sequence.type:'QUAD'
msgctxt "GPencil"
msgid "Quadratic"
msgstr "இருபடி"

#. :src: bpy.types.GREASE_PENCIL_OT_interpolate_sequence.type:'CUBIC'
msgctxt "GPencil"
msgid "Cubic"
msgstr "கன"

#. :src: bpy.types.GREASE_PENCIL_OT_interpolate_sequence.type:'QUART'
msgctxt "GPencil"
msgid "Quartic"
msgstr "நான்கார்டிக்"

#. :src: bpy.types.GREASE_PENCIL_OT_interpolate_sequence.type:'QUINT'
msgctxt "GPencil"
msgid "Quintic"
msgstr "குயின்டிக்"

#. :src: bpy.types.GREASE_PENCIL_OT_interpolate_sequence.type:'EXPO'
msgctxt "GPencil"
msgid "Exponential"
msgstr "அதிவேக"

#. :src: bpy.types.GREASE_PENCIL_OT_interpolate_sequence.type:'CIRC'
msgctxt "GPencil"
msgid "Circular"
msgstr "வட்ட"

#. :src: bpy.types.GREASE_PENCIL_OT_interpolate_sequence.type:'BOUNCE'
msgctxt "GPencil"
msgid "Bounce"
msgstr "பவுன்ச்"

#. :src: bpy.types.GREASE_PENCIL_OT_interpolate_sequence.type:'ELASTIC'
msgctxt "GPencil"
msgid "Elastic"
msgstr "மீள்"

#. :src: bpy.types.GREASE_PENCIL_OT_join_selection
msgctxt "Operator"
msgid "Join Selection"
msgstr "தேர்வில் சேரவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_join_selection
msgid "New stroke from selected points/strokes"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட புள்ளிகள்/பக்கவாதம் ஆகியவற்றிலிருந்து புதிய பக்கவாதம்"

