#: scripts/addons_core/cycles/ui.py:1420
#: scripts/startup/bl_ui/properties_object.py:416
msgid "Volume Scatter"
msgstr "தொகுதி சிதறல்"

#. :src: bpy.types.ShaderNodeVolumeScatter
msgid ""
"Scatter light as it passes through the volume, often used to add fog to a "
"scene"
msgstr ""
"ஒரு காட்சியில் மூடுபனியைச் சேர்க்க பெரும்பாலும் பயன்படுத்தப்படும் அளவைக் "
"கடந்து செல்லும்போது சிதறல் ஒளி"

