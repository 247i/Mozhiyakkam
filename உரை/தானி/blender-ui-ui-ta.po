#. :src: bpy.types.GREASE_PENCIL_OT_duplicate
#. :src: bpy.types.GREASE_PENCIL_OT_duplicate_move.GREASE_PENCIL_OT_duplicate
msgid "Duplicate the selected points"
msgstr "தேர்ந்தெடுக்கப்பட்ட புள்ளிகளை நகலெடுக்கவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_duplicate_move
msgctxt "Operator"
