msgid "Interpolate Grease Pencil strokes between frames"
msgstr "பிரேம்களுக்கு இடையில் கிரீச் பென்சில் பக்கவாதம் இடைக்கணிப்பு"

#. :src: bpy.types.GREASE_PENCIL_OT_interpolate.exclude_breakdowns
#. :src: bpy.types.GREASE_PENCIL_OT_interpolate_sequence.exclude_breakdowns
msgid "Exclude Breakdowns"
msgstr "முறிவுகளை விலக்கவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_interpolate.exclude_breakdowns
