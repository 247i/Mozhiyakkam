#. :src: bpy.types.PAINT_OT_mask_lasso_gesture.smooth_stroke_radius
#. :src: bpy.types.SCULPT_OT_face_set_lasso_gesture.smooth_stroke_radius
#. :src: bpy.types.SCULPT_OT_trim_lasso_gesture.smooth_stroke_radius
#. :src: bpy.types.UV_OT_select_lasso.smooth_stroke_radius
#. :src: bpy.types.VIEW3D_OT_select_lasso.smooth_stroke_radius
msgid "Smooth Stroke Radius"
msgstr "மென்மையான வீச்சு ஆரம்"

#. :src: bpy.types.Brush.smooth_stroke_radius
#. :src: bpy.types.GPENCIL_OT_annotate.stabilizer_radius
msgid "Minimum distance from last point before stroke continues"
msgstr "வீச்சு தொடரும் முன் கடைசி புள்ளியிலிருந்து குறைந்தபட்ச தூரம்"

#. :src: bpy.types.Brush.snake_hook_deform_type:'FALLOFF'
msgid "Radius Falloff"
msgstr "ஆரம் வீழ்ச்சி"

#. :src: bpy.types.Brush.snake_hook_deform_type:'FALLOFF'
msgid "Applies the brush falloff in the tip of the brush"
msgstr "தூரிகையின் நுனியில் தூரிகை வீழ்ச்சியைப் பயன்படுத்துகிறது"

#. :src: bpy.types.Brush.snake_hook_deform_type:'ELASTIC'
#. :src: bpy.types.Sculpt.transform_mode:'RADIUS_ELASTIC'
msgid "Elastic"
msgstr "மீள்"

#. :src: bpy.types.Brush.snake_hook_deform_type:'ELASTIC'
msgid "Modifies the entire mesh using elastic deform"
msgstr "மீள் சிதைவைப் பயன்படுத்தி முழு கண்ணியத்தையும் மாற்றியமைக்கிறது"

#. :src: bpy.types.Brush.spacing
msgid "Spacing between brush daubs as a percentage of brush diameter"
msgstr "தூரிகை விட்டம் ஒரு சதவீதமாக தூரிகை டப்களுக்கு இடையில் இடைவெளி"

#. :src: bpy.types.Brush.stabilize_normal
msgid "Stabilize Normal"
msgstr "இயல்பை உறுதிப்படுத்தவும்"

#. :src: bpy.types.Brush.stabilize_normal
msgid "Stabilize the orientation of the brush plane."
msgstr "தூரிகை விமானத்தின் நோக்குநிலையை உறுதிப்படுத்தவும்."

#. :src: bpy.types.Brush.stabilize_plane
msgid "Stabilize Plane"
msgstr "விமானத்தை உறுதிப்படுத்தவும்"

#. :src: bpy.types.Brush.stabilize_plane
msgid "Stabilize the center of the brush plane."
msgstr "தூரிகை விமானத்தின் மையத்தை உறுதிப்படுத்தவும்."

#. :src: bpy.types.Brush.stencil_dimension
msgid "Stencil Dimensions"
msgstr "ச்டென்சில் பரிமாணங்கள்"

#. :src: bpy.types.Brush.stencil_dimension
msgid "Dimensions of stencil in viewport"
msgstr "வியாபோர்ட்டில் ச்டென்சிலின் பரிமாணங்கள்"

#. :src: bpy.types.Brush.stencil_pos
msgid "Stencil Position"
msgstr "ச்டென்சில் நிலை"

#. :src: bpy.types.Brush.stencil_pos
msgid "Position of stencil in viewport"
msgstr "வியூபோர்ட்டில் ச்டென்சிலின் நிலை"

#. :src: bpy.types.Brush.strength
#. :src: bpy.types.UnifiedPaintSettings.strength
msgid "How powerful the effect of the brush is when applied"
msgstr "பயன்படுத்தும்போது தூரிகையின் விளைவு எவ்வளவு ஆற்றல் வாய்ந்தது"

#. :src: bpy.types.Brush.stroke_method
msgctxt "GPencil"
msgid "Stroke Method"
msgstr "பக்கவாதம் முறை"

#. :src: bpy.types.Brush.stroke_method:'DOTS'
msgctxt "GPencil"
msgid "Dots"
msgstr "புள்ளிகள்"

#. :src: bpy.types.Brush.stroke_method:'DOTS'
msgid "Apply paint on each mouse move step"
msgstr "ஒவ்வொரு சுட்டி நகரும் படியிலும் வண்ணப்பூச்சு தடவவும்"

#. :src: bpy.types.Brush.stroke_method:'DRAG_DOT'
msgctxt "GPencil"
msgid "Drag Dot"
msgstr "இழுவை புள்ளி"

#. :src: bpy.types.Brush.stroke_method:'DRAG_DOT'
msgid "Allows a single dot to be carefully positioned"
msgstr "ஒரு புள்ளியை கவனமாக நிலைநிறுத்த அனுமதிக்கிறது"

#. :src: bpy.types.Brush.stroke_method:'SPACE'
#. :src: bpy.types.Brush.use_space
msgctxt "GPencil"
msgid "Space"
msgstr "இடைவெளி"

#. :src: bpy.types.Brush.stroke_method:'SPACE'
#. :src: bpy.types.Brush.use_space
msgid "Limit brush application to the distance specified by spacing"
msgstr ""
"இடைவெளி மூலம் குறிப்பிடப்பட்ட தூரத்திற்கு தூரிகை பயன்பாட்டை "
"மட்டுப்படுத்தவும்"

#. :src: bpy.types.Brush.stroke_method:'AIRBRUSH'
msgctxt "GPencil"
msgid "Airbrush"
msgstr "ஏர்பிரச்"

#. :src: bpy.types.Brush.stroke_method:'AIRBRUSH'
#. :src: bpy.types.Brush.use_airbrush
msgid "Keep applying paint effect while holding mouse (spray)"
msgstr ""
"சுட்டியை (ச்ப்ரே) வைத்திருக்கும் போது வண்ணப்பூச்சு விளைவைப் பயன்படுத்துங்கள்"

#. :src: bpy.types.Brush.stroke_method:'ANCHORED'
msgctxt "GPencil"
msgid "Anchored"
msgstr "தொகுக்கப்பட்டது"

#. :src: bpy.types.Brush.stroke_method:'ANCHORED'
#. :src: bpy.types.Brush.use_anchor
msgid "Keep the brush anchored to the initial location"
msgstr "ஆரம்ப இடத்திற்கு தூரிகையை நங்கூரமிடுங்கள்"

#. :src: bpy.types.Brush.stroke_method:'LINE'
msgctxt "GPencil"
msgid "Line"
msgstr "வரி"

#. :src: bpy.types.Brush.stroke_method:'LINE'
#. :src: bpy.types.Brush.use_line
msgid "Draw a line with dabs separated according to spacing"
msgstr "இடைவெளியின் படி பிரிக்கப்பட்ட dab களுடன் ஒரு கோட்டை வரையவும்"

#. :src: bpy.types.Brush.stroke_method:'CURVE'
msgctxt "GPencil"
msgid "Curve"
msgstr "வளைவு"

#. :src: bpy.types.Brush.stroke_method:'CURVE'
msgid ""
"Define the stroke curve with a Bézier curve (dabs are separated according to"
" spacing)"
msgstr ""
"பக்கவாதம் வளைவை ஒரு பெசியர் வளைவுடன் வரையறுக்கவும் (இடைவெளியின் படி dab கள் "
"பிரிக்கப்படுகின்றன)"

#. :src: bpy.types.Brush.surface_smooth_current_vertex
#. :src: bpy.types.SCULPT_OT_mesh_filter.surface_smooth_current_vertex
msgid "Per Vertex Displacement"
msgstr "ஒரு வெர்டெக்ச் இடப்பெயர்ச்சிக்கு"

#. :src: bpy.types.Brush.surface_smooth_current_vertex
#. :src: bpy.types.SCULPT_OT_mesh_filter.surface_smooth_current_vertex
msgid ""
"How much the position of each individual vertex influences the final result"
msgstr ""
"ஒவ்வொரு தனிப்பட்ட வெர்டெக்சின் நிலையும் இறுதி முடிவை எவ்வளவு பாதிக்கிறது"

#. :src: bpy.types.Brush.surface_smooth_iterations
msgid "Number of smoothing iterations per brush step"
msgstr "தூரிகை படிக்கு மென்மையான மறு செய்கைகளின் எண்ணிக்கை"

#. :src: bpy.types.Brush.surface_smooth_shape_preservation
#. :src: bpy.types.SCULPT_OT_mesh_filter.surface_smooth_shape_preservation
msgid "Shape Preservation"
msgstr "வடிவ பாதுகாப்பு"

#. :src: bpy.types.Brush.surface_smooth_shape_preservation
#. :src: bpy.types.SCULPT_OT_mesh_filter.surface_smooth_shape_preservation
msgid "How much of the original shape is preserved when smoothing"
msgstr "மென்மையாக்கும் போது அசல் வடிவம் எவ்வளவு பாதுகாக்கப்படுகிறது"

#. :src: bpy.types.Brush.texture_overlay_alpha
msgid "Texture Overlay Alpha"
msgstr "அமைப்பு மேலடுக்கு ஆல்பா"

#. :src: bpy.types.Brush.texture_sample_bias
msgid "Texture Sample Bias"
msgstr "அமைப்பு மாதிரி சார்பு"

#. :src: bpy.types.Brush.texture_sample_bias
msgid "Value added to texture samples"
msgstr "அமைப்பு மாதிரிகளில் மதிப்பு சேர்க்கப்பட்டது"

#. :src: bpy.types.Brush.texture_slot
#. :src: bpy.types.TextureSlot
msgid "Texture Slot"
msgstr "அமைப்பு ச்லாட்"

#. :src: bpy.types.Brush.tilt_strength_factor
msgid "Tilt Strength"
msgstr "சாய்ந்த வலிமை"

#. :src: bpy.types.Brush.tilt_strength_factor
msgid ""
"How much the tilt of the pen will affect the brush. Negative values indicate"
" inverting the tilt directions."
msgstr ""
"பேனாவின் சாய்வு தூரிகையை எவ்வளவு பாதிக்கும். எதிர்மறை மதிப்புகள் சாய்வு "
"திசைகளை தலைகீழாகக் குறிக்கின்றன."

#. :src: bpy.types.Brush.tip_roundness
#. :src: Socket name from node group Duplicate Hair Curves, file
#. procedural_hair_node_assets.blend
msgid "Tip Roundness"
msgstr "முனை சுற்று"

#. :src: bpy.types.Brush.tip_roundness
msgid "Roundness of the brush tip"
msgstr "தூரிகை நுனியின் சுற்று"

#. :src: bpy.types.Brush.tip_scale_x
msgid "Tip Scale X"
msgstr "உதவிக்குறிப்பு அளவுகோல் ஃச்"

#. :src: bpy.types.Brush.tip_scale_x
msgid "Scale of the brush tip in the X axis"
msgstr "ஃச் அச்சில் தூரிகை நுனியின் அளவு"

#. :src: bpy.types.Brush.topology_rake_factor
msgid "Topology Rake"
msgstr "இடவியல் ரேக்"

#. :src: bpy.types.Brush.topology_rake_factor
msgid ""
"Automatically align edges to the brush direction to generate cleaner "
"topology and define sharp features. Best used on low-poly meshes as it has a"
" performance impact."
msgstr ""
"தூய்மையான இடவியல் உருவாக்க மற்றும் கூர்மையான அம்சங்களை வரையறுக்க தூரங்களை "
"தூரிகை திசையில் தானாக சீரமைக்கவும். செயல்திறன் தாக்கத்தை ஏற்படுத்துவதால் "
"குறைந்த பாலி மெச்களில் சிறந்தது."

#. :src: bpy.types.Brush.unprojected_radius
#. :src: bpy.types.UnifiedPaintSettings.unprojected_radius
msgid "Unprojected Radius"
msgstr "அறிவிக்கப்படாத ஆரம்"

#. :src: bpy.types.Brush.unprojected_radius
#. :src: bpy.types.UnifiedPaintSettings.unprojected_radius
msgid "Radius of brush in Blender units"
msgstr "கலப்பான் அலகுகளில் தூரிகை ஆரம்"

#. :src: bpy.types.Brush.use_accumulate
#. :src: bpy.types.GRAPH_OT_sound_to_samples.use_accumulate
msgid "Accumulate"
msgstr "குவிந்து"

#. :src: bpy.types.Brush.use_accumulate
msgid "Accumulate stroke daubs on top of each other"
msgstr "ஒருவருக்கொருவர் மேல் வீச்சு டவப்களைக் குவிக்கவும்"

#. :src: bpy.types.Brush.use_adaptive_space
msgid "Adaptive Spacing"
msgstr "தகவமைப்பு இடைவெளி"

#. :src: bpy.types.Brush.use_adaptive_space
msgid "Space daubs according to surface orientation instead of screen space"
msgstr "திரை இடத்திற்கு பதிலாக மேற்பரப்பு நோக்குநிலைக்கு ஏற்ப விண்வெளி டப்கள்"

#. :src: bpy.types.Brush.use_airbrush
msgid "Airbrush"
msgstr "ஏர்பிரச்"

#. :src: bpy.types.Brush.use_alpha
#. :src: bpy.types.PAINT_OT_vertex_color_set.use_alpha
msgid "Affect Alpha"
msgstr "ஆல்பாவை பாதிக்கும்"

#. :src: bpy.types.Brush.use_alpha
msgid "When this is disabled, lock alpha while painting"
msgstr "இது முடக்கப்பட்டால், ஓவியம் வரைவின் போது ஆல்பாவைப் பூட்டவும்"

#. :src: bpy.types.Brush.use_anchor
msgid "Anchored"
msgstr "தொகுக்கப்பட்டது"

#. :src: bpy.types.Brush.use_automasking_boundary_edges
#. :src: bpy.types.Sculpt.use_automasking_boundary_edges
msgid "Mesh Boundary Auto-Masking"
msgstr "மெச் எல்லை ஆட்டோ-மாசிங்"

#. :src: bpy.types.Brush.use_automasking_boundary_edges
#. :src: bpy.types.Sculpt.use_automasking_boundary_edges
msgid "Do not affect non manifold boundary edges"
msgstr "அல்லாத பன்மடங்கு எல்லை விளிம்புகளை பாதிக்காதீர்கள்"

#. :src: bpy.types.Brush.use_automasking_boundary_face_sets
#. :src: bpy.types.Sculpt.use_automasking_boundary_face_sets
msgid "Face Sets Boundary Automasking"
msgstr "முகம் எல்லை ஆட்டோமேச்கிங்கை அமைக்கிறது"

#. :src: bpy.types.Brush.use_automasking_boundary_face_sets
#. :src: bpy.types.Sculpt.use_automasking_boundary_face_sets
msgid "Do not affect vertices that belong to a Face Set boundary"
msgstr "முகம் அமைக்கப்பட்ட எல்லைக்கு சொந்தமான செங்குத்துகளை பாதிக்காதீர்கள்"

#. :src: bpy.types.Brush.use_automasking_cavity
#. :src: bpy.types.Paint.use_cavity
#. :src: bpy.types.Sculpt.use_automasking_cavity
#. :src: bpy.types.VIEW3D_PT_tools_imagepaint_options_cavity
msgid "Cavity Mask"
msgstr "குழி முகமூடி"

#. :src: bpy.types.Brush.use_automasking_cavity
#. :src: bpy.types.Sculpt.use_automasking_cavity
msgid "Do not affect vertices on peaks, based on the surface curvature"
msgstr ""
"மேற்பரப்பு வளைவின் அடிப்படையில் சிகரங்களில் செங்குத்துகளை பாதிக்காதீர்கள்"

#. :src: bpy.types.Brush.use_automasking_cavity_inverted
#. :src: bpy.types.Sculpt.use_automasking_cavity_inverted
msgid "Inverted Cavity Mask"
msgstr "தலைகீழ் குழி முகமூடி"

#. :src: bpy.types.Brush.use_automasking_cavity_inverted
#. :src: bpy.types.Sculpt.use_automasking_cavity_inverted
msgid "Do not affect vertices within crevices, based on the surface curvature"
msgstr ""
"மேற்பரப்பு வளைவின் அடிப்படையில் பிளவுகளுக்குள் செங்குத்துகளை பாதிக்காதீர்கள்"

#. :src: bpy.types.Brush.use_automasking_custom_cavity_curve
#. :src: bpy.types.Sculpt.use_automasking_custom_cavity_curve
msgid "Custom Cavity Curve"
msgstr "தனிப்பயன் குழி வளைவு"

#. :src: bpy.types.Brush.use_automasking_custom_cavity_curve
#. :src: bpy.types.Sculpt.use_automasking_custom_cavity_curve
msgid "Use custom curve"
msgstr "தனிப்பயன் வளைவைப் பயன்படுத்தவும்"

#. :src: bpy.types.Brush.use_automasking_face_sets
#. :src: bpy.types.Sculpt.use_automasking_face_sets
msgid "Affect only vertices that share Face Sets with the active vertex"
msgstr ""
"செயலில் உள்ள வெர்டெக்சுடன் முகத் தொகுப்புகளைப் பகிர்ந்து கொள்ளும் "
"செங்குத்துகளை மட்டுமே பாதிக்கிறது"

#. :src: bpy.types.Brush.use_automasking_start_normal
#. :src: bpy.types.Sculpt.use_automasking_start_normal
#: scripts/startup/bl_ui/properties_paint_common.py:1309
#: scripts/startup/bl_ui/space_view3d.py:6191
#: scripts/startup/bl_ui/space_view3d.py:8813
msgid "Area Normal"
msgstr "இயல்பான பரப்பு"

#. :src: bpy.types.Brush.use_automasking_start_normal
#. :src: bpy.types.Sculpt.use_automasking_start_normal
msgid "Affect only vertices with a similar normal to where the stroke starts"
msgstr ""
"வீச்சு தொடங்கும் இடத்திற்கு ஒத்த இயல்புடன் கூடிய செங்குத்துகளை மட்டுமே "
"பாதிக்கிறது"

#. :src: bpy.types.Brush.use_automasking_topology
#. :src: bpy.types.Sculpt.use_automasking_topology
msgid "Affect only vertices connected to the active vertex under the brush"
msgstr ""
"தூரிகையின் கீழ் செயலில் உள்ள வெர்டெக்சுடன் இணைக்கப்பட்ட செங்குத்துகளை "
"மட்டுமே பாதிக்கும்"

#. :src: bpy.types.Brush.use_automasking_view_normal
#. :src: bpy.types.Sculpt.use_automasking_view_normal
#: scripts/startup/bl_ui/properties_paint_common.py:1299
#: scripts/startup/bl_ui/space_view3d.py:6192
#: scripts/startup/bl_ui/space_view3d.py:8803
msgid "View Normal"
msgstr "சாதாரணமாகக் காண்க"

#. :src: bpy.types.Brush.use_automasking_view_normal
#. :src: bpy.types.Sculpt.use_automasking_view_normal
msgid "Affect only vertices with a normal that faces the viewer"
msgstr "பார்வையாளரை எதிர்கொள்ளும் இயல்புடன் செங்குத்துகளை மட்டுமே பாதிக்கும்"

#. :src: bpy.types.Brush.use_automasking_view_occlusion
#. :src: bpy.types.Sculpt.use_automasking_view_occlusion
#: scripts/startup/bl_ui/properties_paint_common.py:1302
#: scripts/startup/bl_ui/space_view3d.py:8806
#: source/blender/modifiers/intern/MOD_lineart.cc:719
msgid "Occlusion"
msgstr "மறைவு"

#. :src: bpy.types.Brush.use_automasking_view_occlusion
#. :src: bpy.types.Sculpt.use_automasking_view_occlusion
msgid ""
"Only affect vertices that are not occluded by other faces (slower "
"performance)"
msgstr ""
"மற்ற முகங்களால் மறைக்கப்படாத செங்குத்துகளை மட்டுமே பாதிக்கிறது (மெதுவான "
"செயல்திறன்)"

#. :src: bpy.types.Brush.use_cloth_collision
msgid "Collide with objects during the simulation"
msgstr "உருவகப்படுத்துதலின் போது பொருட்களுடன் மோதுக"

#. :src: bpy.types.Brush.use_cloth_pin_simulation_boundary
msgid "Pin Simulation Boundary"
msgstr "முள் உருவகப்படுத்துதல் எல்லை"

#. :src: bpy.types.Brush.use_cloth_pin_simulation_boundary
msgid ""
"Lock the position of the vertices in the simulation falloff area to avoid "
"artifacts and create a softer transition with unaffected areas"
msgstr ""
"கலைப்பொருட்களைத் தவிர்ப்பதற்காக உருவகப்படுத்துதல் வீழ்ச்சி பரப்பில் "
"செங்குத்துகளின் நிலையை பூட்டவும், பாதிக்கப்படாத பரப்புகளுடன் மென்மையான "
"மாற்றத்தை உருவாக்கவும்"

#. :src: bpy.types.Brush.use_color_as_displacement
#. :src: bpy.types.ShaderNodeVectorDisplacement
#: scripts/startup/bl_ui/properties_paint_common.py:1507
msgid "Vector Displacement"
msgstr "திசையன் இடப்பெயர்ச்சி"

#. :src: bpy.types.Brush.use_color_as_displacement
msgid ""
"Handle each pixel color as individual vector for displacement (area plane "
"mapping only)"
msgstr ""
"இடப்பெயர்ச்சிக்கான ஒவ்வொரு படப்புள்ளி வண்ணத்தையும் தனிப்பட்ட திசையனாக "
"கையாளவும் (பகுதி விமான மேப்பிங் மட்டும்)"

#. :src: bpy.types.Brush.use_color_jitter
#. :src: bpy.types.UnifiedPaintSettings.use_color_jitter
msgid "Use Color Jitter"
msgstr "வண்ண நடுக்கத்தைப் பயன்படுத்துங்கள்"

#. :src: bpy.types.Brush.use_color_jitter
#. :src: bpy.types.UnifiedPaintSettings.use_color_jitter
msgid "Jitter brush color"
msgstr "நடுக்கம் தூரிகை நிறம்"

#. :src: bpy.types.Brush.use_connected_only
#. :src: bpy.types.ToolSettings.use_proportional_connected
msgid "Connected Only"
msgstr "மட்டுமே இணைக்கப்பட்டுள்ளது"

#. :src: bpy.types.Brush.use_connected_only
msgid "Affect only topologically connected elements"
msgstr "இடவியல் ரீதியாக இணைக்கப்பட்ட கூறுகளை மட்டுமே பாதிக்கும்"

#. :src: bpy.types.Brush.use_cursor_overlay
msgid "Use Cursor Overlay"
msgstr "கர்சர் மேலடுக்கு பயன்படுத்தவும்"

#. :src: bpy.types.Brush.use_cursor_overlay
msgid "Show cursor in viewport"
msgstr "வியூபோர்ட்டில் கர்சரைக் காட்டு"

#. :src: bpy.types.Brush.use_cursor_overlay_override
#. :src: bpy.types.Brush.use_primary_overlay_override
#. :src: bpy.types.Brush.use_secondary_overlay_override
msgid "Override Overlay"
msgstr "மேலெழுதும் மேலெழுதவும்"

#. :src: bpy.types.Brush.use_cursor_overlay_override
#. :src: bpy.types.Brush.use_primary_overlay_override
#. :src: bpy.types.Brush.use_secondary_overlay_override
msgid "Don't show overlay during a stroke"
msgstr "பக்கவாதத்தின் போது மேலடுக்கு காட்ட வேண்டாம்"

#. :src: bpy.types.Brush.use_curve
msgid ""
"Define the stroke curve with a Bézier curve. Dabs are separated according to"
" spacing."
msgstr ""
"பக்கவாதம் வளைவை பெசியர் வளைவுடன் வரையறுக்கவும். DAB கள் இடைவெளியின் படி "
"பிரிக்கப்படுகின்றன."

#. :src: bpy.types.Brush.use_density_pressure
msgid "Use Pressure for Density"
msgstr "அடர்த்திக்கு அழுத்தத்தைப் பயன்படுத்துங்கள்"

#. :src: bpy.types.Brush.use_density_pressure
msgid "Use pressure to modulate density"
msgstr "அடர்த்தியை மாற்றியமைக்க அழுத்தத்தைப் பயன்படுத்தவும்"

#. :src: bpy.types.Brush.use_edge_to_edge
msgid "Edge-to-Edge"
msgstr "விளிம்பு-க்கு-விளிம்பு"

#. :src: bpy.types.Brush.use_edge_to_edge
msgid "Drag anchor brush from edge-to-edge"
msgstr "நங்கூர தூரிகையை விளிம்பில் இருந்து விளிம்பில் இருந்து இழுக்கவும்"

#. :src: bpy.types.Brush.use_flow_pressure
msgid "Use Pressure for Flow"
msgstr "ஓட்டத்திற்கு அழுத்தம் பயன்படுத்தவும்"

#. :src: bpy.types.Brush.use_flow_pressure
msgid "Use pressure to modulate flow"
msgstr "ஓட்டத்தை மாற்றியமைக்க அழுத்தம் பயன்படுத்தவும்"

#. :src: bpy.types.Brush.use_frontface
msgid "Use Front-Face"
msgstr "முன் முகத்தைப் பயன்படுத்துங்கள்"

#. :src: bpy.types.Brush.use_frontface
msgid "Brush only affects vertices that face the viewer"
msgstr "தூரிகை பார்வையாளரை எதிர்கொள்ளும் செங்குத்துகளை மட்டுமே பாதிக்கிறது"

#. :src: bpy.types.Brush.use_frontface_falloff
msgid "Use Front-Face Falloff"
msgstr "முன் முகம் வீழ்ச்சி பயன்படுத்தவும்"

#. :src: bpy.types.Brush.use_frontface_falloff
msgid "Blend brush influence by how much they face the front"
msgstr ""
"தூரிகை செல்வாக்கை அவர்கள் எவ்வளவு எதிர்கொள்கிறார்கள் என்பதன் மூலம் கலக்கவும்"

#. :src: bpy.types.Brush.use_grab_active_vertex
msgid "Grab Active Vertex"
msgstr "செயலில் உள்ள வெர்டெக்சைப் பிடிக்கவும்"

#. :src: bpy.types.Brush.use_grab_active_vertex
msgid ""
"Apply the maximum grab strength to the active vertex instead of the cursor "
"location"
msgstr ""
"கர்சர் இருப்பிடத்திற்கு பதிலாக செயலில் உள்ள வெர்டெக்சுக்கு அதிகபட்ச கிராப் "
"வலிமையைப் பயன்படுத்துங்கள்"

#. :src: bpy.types.Brush.use_grab_silhouette
msgid "Grab Silhouette"
msgstr "சில்அவுட்டைப் பற்றிக் கொள்ளுங்கள்"

#. :src: bpy.types.Brush.use_grab_silhouette
msgid "Grabs trying to automask the silhouette of the object"
msgstr "பொருளின் நிழற்படத்தை தானியக்கமாக்க முயற்சிக்கிறது"

#. :src: bpy.types.Brush.use_hardness_pressure
msgid "Use Pressure for Hardness"
msgstr "கடினத்தன்மைக்கு அழுத்தத்தைப் பயன்படுத்துங்கள்"

#. :src: bpy.types.Brush.use_hardness_pressure
msgid "Use pressure to modulate hardness"
msgstr "கடினத்தன்மையை மாற்றியமைக்க அழுத்தத்தைப் பயன்படுத்துங்கள்"

#. :src: bpy.types.Brush.use_inverse_smooth_pressure
msgid "Inverse Smooth Pressure"
msgstr "தலைகீழ் மென்மையான அழுத்தம்"

#. :src: bpy.types.Brush.use_inverse_smooth_pressure
msgid "Lighter pressure causes more smoothing to be applied"
msgstr "இலகுவான அழுத்தம் அதிக மென்மையாக்குகிறது"

#. :src: bpy.types.Brush.use_locked_size
#. :src: bpy.types.UnifiedPaintSettings.use_locked_size
msgid "Radius Unit"
msgstr "ஆரம் அலகு"

#. :src: bpy.types.Brush.use_locked_size
#. :src: bpy.types.UnifiedPaintSettings.use_locked_size
msgid "Measure brush size relative to the view or the scene"
msgstr "பார்வை அல்லது காட்சியுடன் தொடர்புடைய தூரிகை அளவை அளவிடவும்"

#. :src: bpy.types.Brush.use_locked_size:'VIEW'
#. :src: bpy.types.UnifiedPaintSettings.use_locked_size:'VIEW'
msgid "Measure brush size relative to the view"
msgstr "பார்வையுடன் தொடர்புடைய தூரிகை அளவை அளவிடவும்"

#. :src: bpy.types.Brush.use_locked_size:'SCENE'
#. :src: bpy.types.UnifiedPaintSettings.use_locked_size:'SCENE'
msgid "Measure brush size relative to the scene"
msgstr "காட்சியுடன் தொடர்புடைய தூரிகை அளவை அளவிடவும்"

#. :src: bpy.types.Brush.use_multiplane_scrape_dynamic
msgid "Dynamic Mode"
msgstr "மாறும் பயன்முறை"

#. :src: bpy.types.Brush.use_multiplane_scrape_dynamic
msgid ""
"The angle between the planes changes during the stroke to fit the surface "
"under the cursor"
msgstr ""
"கர்சரின் கீழ் மேற்பரப்புக்கு பொருந்தும் வகையில் பக்கவாதத்தின் போது "
"விமானங்களுக்கு இடையிலான கோணம் மாறுகிறது"

#. :src: bpy.types.Brush.use_offset_pressure
msgid "Plane Offset Pressure"
msgstr "வானூர்தி ஆஃப்செட் அழுத்தம்"

#. :src: bpy.types.Brush.use_offset_pressure
msgid "Enable tablet pressure sensitivity for offset"
msgstr "ஆஃப்செட்டுக்கு டேப்லெட் அழுத்தம் உணர்திறனை இயக்கவும்"

#. :src: bpy.types.Brush.use_original_normal
msgid "Original Normal"
msgstr "அசல் இயல்பானது"

#. :src: bpy.types.Brush.use_original_normal
msgid "When locked keep using normal of surface where stroke was initiated"
msgstr ""
"பூட்டப்பட்டால் வீச்சு தொடங்கப்பட்ட மேற்பரப்பின் இயல்பைப் பயன்படுத்துங்கள்"

#. :src: bpy.types.Brush.use_original_plane
msgid "Original Plane"
msgstr "அசல் வானூர்தி"

#. :src: bpy.types.Brush.use_original_plane
msgid ""
"When locked keep using the plane origin of surface where stroke was "
"initiated"
msgstr ""
"பூட்டப்பட்டபோது, வீச்சு தொடங்கப்பட்ட மேற்பரப்பின் விமான தோற்றத்தைப் "
"பயன்படுத்தி தொடர்ந்து"

#. :src: bpy.types.Brush.use_paint_antialiasing
msgid "Smooths the edges of the strokes"
msgstr "வீச்சுகள் விளிம்புகளை மென்மையாக்குகிறது"

#. :src: bpy.types.Brush.use_paint_grease_pencil
msgid "Use Paint"
msgstr "வண்ணப்பூச்சு பயன்படுத்தவும்"

#. :src: bpy.types.Brush.use_paint_grease_pencil
msgid "Use this brush in Grease Pencil drawing mode"
msgstr "இந்த தூரிகையை கிரீச் பென்சில் வரைதல் பயன்முறையில் பயன்படுத்தவும்"

#. :src: bpy.types.Brush.use_paint_image
msgid "Use this brush in texture paint mode"
msgstr "இந்த தூரிகையை அமைப்பு வண்ணப்பூச்சு பயன்முறையில் பயன்படுத்தவும்"

#. :src: bpy.types.Brush.use_paint_sculpt
#. :src: bpy.types.Brush.use_paint_sculpt_curves
msgid "Use Sculpt"
msgstr "சிற்பத்தைப் பயன்படுத்தவும்"

#. :src: bpy.types.Brush.use_paint_sculpt
msgid "Use this brush in sculpt mode"
msgstr "இந்த தூரிகையை சிற்பம் பயன்முறையில் பயன்படுத்தவும்"

#. :src: bpy.types.Brush.use_paint_sculpt_curves
msgid "Use this brush in sculpt curves mode"
msgstr "இந்த தூரிகையை சிற்பம் வளைவுகள் பயன்முறையில் பயன்படுத்தவும்"

#. :src: bpy.types.Brush.use_paint_uv_sculpt
msgid "Use UV Sculpt"
msgstr "புறஊதா சிற்பத்தைப் பயன்படுத்தவும்"

#. :src: bpy.types.Brush.use_paint_uv_sculpt
msgid "Use this brush in UV sculpt mode"
msgstr "இந்த தூரிகையை புறஊதா சிற்பம் பயன்முறையில் பயன்படுத்தவும்"

#. :src: bpy.types.Brush.use_paint_vertex
#. :src: bpy.types.Brush.use_vertex_grease_pencil
msgid "Use Vertex"
msgstr "வெர்டெக்ச் பயன்படுத்தவும்"

#. :src: bpy.types.Brush.use_paint_vertex
msgid "Use this brush in vertex paint mode"
msgstr "இந்த தூரிகையை வெர்டெக்ச் பெயிண்ட் பயன்முறையில் பயன்படுத்தவும்"

#. :src: bpy.types.Brush.use_paint_weight
msgid "Use Weight"
msgstr "எடை பயன்படுத்தவும்"

#. :src: bpy.types.Brush.use_paint_weight
msgid "Use this brush in weight paint mode"
msgstr "இந்த தூரிகையை எடை வண்ணப்பூச்சு பயன்முறையில் பயன்படுத்தவும்"

#. :src: bpy.types.Brush.use_persistent
msgid "Sculpt on a persistent layer of the mesh"
msgstr "கண்ணி ஒரு தொடர்ச்சியான அடுக்கில் சிற்பம்"

#. :src: bpy.types.Brush.use_plane_trim
msgid "Use Plane Trim"
msgstr "விமான டிரிம் பயன்படுத்தவும்"

#. :src: bpy.types.Brush.use_plane_trim
msgid "Limit the distance from the offset plane that a vertex can be affected"
msgstr ""
"ஒரு வெர்டெக்ச் பாதிக்கக்கூடிய ஆஃப்செட் விமானத்திலிருந்து தூரத்தை "
"கட்டுப்படுத்துங்கள்"

#. :src: bpy.types.Brush.use_pose_ik_anchored
msgid "Keep Anchor Point"
msgstr "நங்கூர புள்ளியை வைத்திருங்கள்"

#. :src: bpy.types.Brush.use_pose_ik_anchored
msgid "Keep the position of the last segment in the IK chain fixed"
msgstr "ஐகே சங்கிலியில் கடைசி பிரிவின் நிலையை சரி செய்யுங்கள்"

#. :src: bpy.types.Brush.use_pose_lock_rotation
msgid "Lock Rotation When Scaling"
msgstr "அளவிடும்போது பூட்டு சுழற்சி"

#. :src: bpy.types.Brush.use_pose_lock_rotation
msgid "Do not rotate the segment when using the scale deform mode"
msgstr ""
"அளவிலான சிதைவு பயன்முறையைப் பயன்படுத்தும் போது பகுதியை சுழற்ற வேண்டாம்"

#. :src: bpy.types.Brush.use_pressure_area_radius
msgid "Area Radius Pressure"
msgstr "பரப்பு ஆரம் அழுத்தம்"

#. :src: bpy.types.Brush.use_pressure_area_radius
msgid "Enable tablet pressure sensitivity for area radius"
msgstr "பரப்பு ஆரம் மாத்திரை அழுத்தம் உணர்திறனை இயக்கவும்"

#. :src: bpy.types.Brush.use_pressure_jitter
msgid "Jitter Pressure"
msgstr "நடுக்கம் அழுத்தம்"

#. :src: bpy.types.Brush.use_pressure_jitter
msgid "Enable tablet pressure sensitivity for jitter"
msgstr "நடுக்கத்திற்கு டேப்லெட் அழுத்தம் உணர்திறனை இயக்கவும்"

#. :src: bpy.types.Brush.use_pressure_masking
msgid "Mask Pressure Mode"
msgstr "முகமூடி அழுத்தம் பயன்முறை"

#. :src: bpy.types.Brush.use_pressure_masking
msgid "Pen pressure makes texture influence smaller"
msgstr "பேனா அழுத்தம் அமைப்பு செல்வாக்கை சிறியதாக ஆக்குகிறது"

#. :src: bpy.types.Brush.use_pressure_masking:'RAMP'
#. :src: bpy.types.LineStyleColorModifier_Material.use_ramp
#. :src: bpy.types.PHYSICS_PT_dp_brush_velocity_color_ramp
msgid "Ramp"
msgstr "வளைவு"

#. :src: bpy.types.Brush.use_pressure_masking:'CUTOFF'
#. :src: bpy.types.BevelModifier.vmesh_method:'CUTOFF'
#. :src: bpy.types.MESH_OT_bevel.vmesh_method:'CUTOFF'
msgid "Cutoff"
msgstr "வெட்டு"

#. :src: bpy.types.Brush.use_pressure_size
msgid "Size Pressure"
msgstr "அளவு அழுத்தம்"

#. :src: bpy.types.Brush.use_pressure_size
msgid "Enable tablet pressure sensitivity for size"
msgstr "அளவிற்கு டேப்லெட் அழுத்தம் உணர்திறனை இயக்கவும்"

#. :src: bpy.types.Brush.use_pressure_spacing
msgid "Spacing Pressure"
msgstr "இடைவெளி அழுத்தம்"

#. :src: bpy.types.Brush.use_pressure_spacing
msgid "Enable tablet pressure sensitivity for spacing"
msgstr "இடைவெளிக்கு டேப்லெட் அழுத்தம் உணர்திறனை இயக்கவும்"

#. :src: bpy.types.Brush.use_pressure_strength
msgid "Strength Pressure"
msgstr "வலிமை அழுத்தம்"

#. :src: bpy.types.Brush.use_pressure_strength
msgid "Enable tablet pressure sensitivity for strength"
msgstr "வலிமைக்கு டேப்லெட் அழுத்தம் உணர்திறனை இயக்கவும்"

#. :src: bpy.types.Brush.use_primary_overlay
#. :src: bpy.types.Brush.use_secondary_overlay
msgid "Use Texture Overlay"
msgstr "அமைப்பு மேலடுக்கைப் பயன்படுத்தவும்"

#. :src: bpy.types.Brush.use_primary_overlay
#. :src: bpy.types.Brush.use_secondary_overlay
msgid "Show texture in viewport"
msgstr "வியாபோர்ட்டில் அமைப்பைக் காட்டு"

#. :src: bpy.types.Brush.use_restore_mesh
msgid "Restore Mesh"
msgstr "மெச் மீட்டமை"

#. :src: bpy.types.Brush.use_restore_mesh
msgid "Allow a single dot to be carefully positioned"
msgstr "ஒரு புள்ளியை கவனமாக நிலைநிறுத்த அனுமதிக்கவும்"

#. :src: bpy.types.Brush.use_scene_spacing
#: scripts/startup/bl_ui/properties_paint_common.py:524
msgid "Spacing Distance"
msgstr "இடைவெளி தூரம்"

#. :src: bpy.types.Brush.use_scene_spacing
msgid "Calculate the brush spacing using view or scene distance"
msgstr ""
"பார்வை அல்லது காட்சி தூரத்தைப் பயன்படுத்தி தூரிகை இடைவெளியைக் கணக்கிடுங்கள்"

#. :src: bpy.types.Brush.use_scene_spacing:'VIEW'
msgid "Calculate brush spacing relative to the view"
msgstr "பார்வையுடன் தொடர்புடைய தூரிகை இடைவெளியைக் கணக்கிடுங்கள்"

#. :src: bpy.types.Brush.use_scene_spacing:'SCENE'
msgid ""
"Calculate brush spacing relative to the scene using the stroke location"
msgstr ""
"வீச்சு இருப்பிடத்தைப் பயன்படுத்தி காட்சியுடன் தொடர்புடைய தூரிகை இடைவெளியைக் "
"கணக்கிடுங்கள்"

#. :src: bpy.types.Brush.use_smooth_stroke
#. :src:
#. bpy.types.GREASE_PENCIL_OT_stroke_subdivide_smooth.GREASE_PENCIL_OT_stroke_smooth
msgid "Smooth Stroke"
msgstr "மென்மையான வீச்சு"

#. :src: bpy.types.Brush.use_smooth_stroke
msgid "Brush lags behind mouse and follows a smoother path"
msgstr ""
"தூரிகை சுட்டிக்கு பின்னால் பின்தங்கியிருக்கிறது மற்றும் மென்மையான பாதையைப் "
"பின்பற்றுகிறது"

#. :src: bpy.types.Brush.use_space_attenuation
msgid "Adjust Strength for Spacing"
msgstr "இடைவெளிக்கு வலிமையை சரிசெய்யவும்"

#. :src: bpy.types.Brush.use_space_attenuation
msgid ""
"Automatically adjust strength to give consistent results for different "
"spacings"
msgstr ""
"வெவ்வேறு இடைவெளிகளுக்கு நிலையான முடிவுகளை வழங்க வலிமையை தானாக சரிசெய்யவும்"

#. :src: bpy.types.Brush.use_vertex_grease_pencil
msgid "Use this brush in Grease Pencil vertex color mode"
msgstr ""
"இந்த தூரிகையை கிரீச் பென்சில் வெர்டெக்ச் வண்ண பயன்முறையில் பயன்படுத்தவும்"

#. :src: bpy.types.Brush.use_wet_mix_pressure
msgid "Use Pressure for Wet Mix"
msgstr "ஈரமான கலவைக்கு அழுத்தம் பயன்படுத்தவும்"

#. :src: bpy.types.Brush.use_wet_mix_pressure
msgid "Use pressure to modulate wet mix"
msgstr "ஈரமான கலவையை மாற்றியமைக்க அழுத்தத்தைப் பயன்படுத்தவும்"

#. :src: bpy.types.Brush.use_wet_persistence_pressure
msgid "Use Pressure for Wet Persistence"
msgstr "ஈரமான நிலைத்தன்மைக்கு அழுத்தம் பயன்படுத்தவும்"

#. :src: bpy.types.Brush.use_wet_persistence_pressure
msgid "Use pressure to modulate wet persistence"
msgstr "ஈரமான நிலைத்தன்மையை மாற்றியமைக்க அழுத்தத்தைப் பயன்படுத்தவும்"

#. :src: bpy.types.Brush.value_jitter
#. :src: bpy.types.UnifiedPaintSettings.value_jitter
msgid "Value Jitter"
msgstr "மதிப்பு நடுக்கம்"

#. :src: bpy.types.Brush.value_jitter
#. :src: bpy.types.UnifiedPaintSettings.value_jitter
msgid "Color jitter effect on value"
msgstr "மதிப்பில் வண்ண நடுக்கம் விளைவு"

#. :src: bpy.types.Brush.weight
msgid "Vertex weight when brush is applied"
msgstr "தூரிகை பயன்படுத்தப்படும்போது வெர்டெக்ச் எடை"

#. :src: bpy.types.Brush.wet_mix
msgid "Wet Mix"
msgstr "ஈரமான கலவை"

#. :src: bpy.types.Brush.wet_mix
msgid "Amount of paint that is picked from the surface into the brush color"
msgstr ""
"மேற்பரப்பில் இருந்து தூரிகை நிறத்தில் எடுக்கப்படும் வண்ணப்பூச்சின் அளவு"

#. :src: bpy.types.Brush.wet_paint_radius_factor
msgid "Wet Paint Radius"
msgstr "ஈரமான வண்ணப்பூச்சு ஆரம்"

#. :src: bpy.types.Brush.wet_paint_radius_factor
msgid ""
"Ratio between the brush radius and the radius that is going to be used to "
"sample the color to blend in wet paint"
msgstr ""
"ஈரமான வண்ணப்பூச்சில் கலக்க வண்ணத்தை மாதிரியாகப் பயன்படுத்தப் போகும் தூரிகை "
"ஆரம் மற்றும் ஆரம் இடையே விகிதம்"

#. :src: bpy.types.Brush.wet_persistence
msgid "Wet Persistence"
msgstr "ஈரமான விடாமுயற்சி"

#. :src: bpy.types.Brush.wet_persistence
msgid ""
"Amount of wet paint that stays in the brush after applying paint to the "
"surface"
msgstr ""
"மேற்பரப்பில் வண்ணப்பூச்சு பயன்படுத்திய பின் தூரிகையில் இருக்கும் ஈரமான "
"வண்ணப்பூச்சின் அளவு"

#. :src: bpy.types.CacheFile.filepath
#. :src: bpy.types.MeshCacheModifier.filepath
#. :src: bpy.types.MultiresModifier.filepath
msgid "Path to external displacements file"
msgstr "வெளிப்புற இடப்பெயர்வுகள் கோப்பிற்கான பாதை"

#. :src: bpy.types.CacheFile.forward_axis
#. :src: bpy.types.MeshCacheModifier.forward_axis
#. :src: bpy.types.EXPORT_SCENE_OT_fbx.axis_forward
#. :src: bpy.types.IMPORT_ANIM_OT_bvh.axis_forward
#. :src: bpy.types.IMPORT_SCENE_OT_fbx.axis_forward
#: source/blender/editors/io/io_stl_ops.cc:103
msgid "Forward"
msgstr "முன்னோக்கி"

#. :src: bpy.types.CacheFile.frame
msgid ""
"The time to use for looking up the data in the cache file, or to determine "
"which file to use in a file sequence"
msgstr ""
"கேச் கோப்பில் தரவைப் பார்ப்பதற்கு பயன்படுத்த வேண்டிய நேரம் அல்லது கோப்பு "
"வரிசையில் எந்தக் கோப்பைப் பயன்படுத்த வேண்டும் என்பதைத் தீர்மானிக்க வேண்டும்"

#. :src: bpy.types.CacheFile.frame_offset
#. :src: bpy.types.MovieClip.frame_offset
#. :src: bpy.types.GreasePencilTimeModifier.offset
#. :src: bpy.types.GRAPH_OT_paste.offset
#. :src: bpy.types.GRAPH_OT_time_offset.frame_offset
#: scripts/startup/bl_ui/space_sequencer.py:2859
#: source/blender/modifiers/intern/MOD_grease_pencil_time.cc:536
msgid "Frame Offset"
msgstr "பிரேம் ஆஃப்செட்"

#. :src: bpy.types.CacheFile.frame_offset
msgid ""
"Subtracted from the current frame to use for looking up the data in the "
"cache file, or to determine which file to use in a file sequence"
msgstr ""
"தற்காலிக சேமிப்பில் தரவைப் பார்க்க அல்லது ஒரு கோப்பு வரிசையில் எந்தக் "
"கோப்பைப் பயன்படுத்த வேண்டும் என்பதைத் தீர்மானிக்க தற்போதைய சட்டத்திலிருந்து "
"கழிக்கப்பட்டது"

#. :src: bpy.types.CacheFile.is_sequence
#. :src: bpy.types.Volume.is_sequence
#. :src: bpy.types.GREASE_PENCIL_OT_trace_image.mode:'SEQUENCE'
#: source/blender/editors/space_image/image_buttons.cc:153
msgid "Sequence"
msgstr "வரிசை"

#. :src: bpy.types.CacheFile.is_sequence
#. :src: bpy.types.Volume.is_sequence
msgid "Whether the cache is separated in a series of files"
msgstr "தொடர்ச்சியான கோப்புகளில் கேச் பிரிக்கப்பட்டதா என்பதை"

#. :src: bpy.types.CacheFile.layers
msgid "Layers of the cache"
msgstr "தற்காலிக சேமிப்பின் அடுக்குகள்"

#. :src: bpy.types.CacheFile.object_paths
msgid "Paths of the objects inside the Alembic archive"
msgstr "அலெம்பிக் காப்பகத்திற்குள் உள்ள பொருட்களின் பாதைகள்"

#. :src: bpy.types.CacheFile.override_frame
#: source/blender/editors/interface/templates/interface_template_cache_file.cc:114
msgid "Override Frame"
msgstr "சட்டத்தை மீறவும்"

#. :src: bpy.types.CacheFile.override_frame
msgid ""
"Whether to use a custom frame for looking up data in the cache file, instead"
" of using the current scene frame"
msgstr ""
"தற்போதைய காட்சி சட்டத்தைப் பயன்படுத்துவதற்குப் பதிலாக, கேச் கோப்பில் தரவைப் "
"பார்ப்பதற்கு தனிப்பயன் சட்டத்தைப் பயன்படுத்தலாமா"

#. :src: bpy.types.CacheFile.prefetch_cache_size
msgid "Prefetch Cache Size"
msgstr "கேச் அளவை முன்னெடுங்கள்"

#. :src: bpy.types.CacheFile.prefetch_cache_size
msgid ""
"Memory usage limit in megabytes for the Cycles Procedural cache, if the data"
" does not fit within the limit, rendering is aborted"
msgstr ""
"மெகாபைட்டுகளில் நினைவக பயன்பாட்டு வரம்பு சுழற்சிகளின் நடைமுறை தற்காலிக "
"சேமிப்பிற்கு, தரவு வரம்பிற்குள் பொருந்தவில்லை என்றால், வழங்குதல் "
"கைவிடப்படுகிறது"

#. :src: bpy.types.CacheFile.scale
msgid ""
"Value by which to enlarge or shrink the object with respect to the world's "
"origin (only applicable through a Transform Cache constraint)"
msgstr ""
"உலகின் தோற்றத்தைப் பொறுத்து பொருளை பெரிதாக்க அல்லது சுருக்க வேண்டிய மதிப்பு "
"(உருமாற்ற கேச் கட்டுப்பாடு மூலம் மட்டுமே பொருந்தும்)"

