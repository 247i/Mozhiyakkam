#. :src: bpy.types.WM_OT_obj_export.path_mode:'AUTO'
msgctxt "File browser"
msgid "Auto"
msgstr "தானி"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.path_mode:'AUTO'
#. :src: bpy.types.WM_OT_obj_export.path_mode:'AUTO'
msgid "Use relative paths with subdirectories only"
msgstr "துணை அடைவுகளுடன் மட்டுமே தொடர்புடைய பாதைகளைப் பயன்படுத்துங்கள்"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.path_mode:'ABSOLUTE'
#. :src: bpy.types.WM_OT_obj_export.path_mode:'ABSOLUTE'
msgctxt "File browser"
msgid "Absolute"
msgstr "தனி, சார்பிலா"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.path_mode:'ABSOLUTE'
#. :src: bpy.types.WM_OT_obj_export.path_mode:'ABSOLUTE'
msgid "Always write absolute paths"
msgstr "எப்போதும் முழுமையான பாதைகளை எழுதுங்கள்"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.path_mode:'RELATIVE'
#. :src: bpy.types.WM_OT_obj_export.path_mode:'RELATIVE'
msgctxt "File browser"
msgid "Relative"
msgstr "உறவினர்"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.path_mode:'RELATIVE'
#. :src: bpy.types.WM_OT_obj_export.path_mode:'RELATIVE'
msgid "Write relative paths where possible"
msgstr "முடிந்தவரை உறவினர் பாதைகளை எழுதுங்கள்"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.path_mode:'MATCH'
#. :src: bpy.types.WM_OT_obj_export.path_mode:'MATCH'
msgctxt "File browser"
msgid "Match"
msgstr "போட்டி"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.path_mode:'MATCH'
#. :src: bpy.types.WM_OT_obj_export.path_mode:'MATCH'
msgid "Match absolute/relative setting with input path"
msgstr "உள்ளீட்டு பாதையுடன் முழுமையான/உறவினர் அமைப்பை பொருத்துங்கள்"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.path_mode:'STRIP'
#. :src: bpy.types.WM_OT_obj_export.path_mode:'STRIP'
msgctxt "File browser"
msgid "Strip"
msgstr "துண்டு"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.path_mode:'STRIP'
msgid "Filename only"
msgstr "கோப்பு பெயர் மட்டுமே"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.path_mode:'COPY'
#. :src: bpy.types.WM_OT_obj_export.path_mode:'COPY'
msgctxt "File browser"
msgid "Copy"
msgstr "நகலெடு"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.path_mode:'COPY'
msgid "Copy the file to the destination path (or subdirectory)"
msgstr "கோப்பை இலக்கு பாதையில் நகலெடுக்கவும் (அல்லது துணை அடைவு)"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.primary_bone_axis
#. :src: bpy.types.IMPORT_SCENE_OT_fbx.primary_bone_axis
msgid "Primary Bone Axis"
msgstr "முதன்மை எலும்பு அச்சு"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.primary_bone_axis:'-X'
#. :src: bpy.types.EXPORT_SCENE_OT_fbx.secondary_bone_axis:'-X'
#. :src: bpy.types.IMPORT_SCENE_OT_fbx.primary_bone_axis:'-X'
#. :src: bpy.types.IMPORT_SCENE_OT_fbx.secondary_bone_axis:'-X'
msgid "-X Axis"
msgstr "-x அச்சு"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.primary_bone_axis:'-Y'
#. :src: bpy.types.EXPORT_SCENE_OT_fbx.secondary_bone_axis:'-Y'
#. :src: bpy.types.IMPORT_SCENE_OT_fbx.primary_bone_axis:'-Y'
#. :src: bpy.types.IMPORT_SCENE_OT_fbx.secondary_bone_axis:'-Y'
msgid "-Y Axis"
msgstr "-y அச்சு"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.primary_bone_axis:'-Z'
#. :src: bpy.types.EXPORT_SCENE_OT_fbx.secondary_bone_axis:'-Z'
#. :src: bpy.types.IMPORT_SCENE_OT_fbx.primary_bone_axis:'-Z'
#. :src: bpy.types.IMPORT_SCENE_OT_fbx.secondary_bone_axis:'-Z'
msgid "-Z Axis"
msgstr "-z அச்சு"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.prioritize_active_color
msgid "Prioritize Active Color"
msgstr "செயலில் உள்ள வண்ணத்திற்கு முன்னுரிமை கொடுங்கள்"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.prioritize_active_color
msgid ""
"Make sure active color will be exported first. Could be important since some"
" other software can discard other color attributes besides the first one"
msgstr ""
"செயலில் வண்ணம் முதலில் ஏற்றுமதி செய்யப்படும் என்பதை உறுதிப்படுத்தவும். சில "
"மென்பொருள்கள் முதல் ஒன்றைத் தவிர மற்ற வண்ண பண்புகளை நிராகரிக்க முடியும் "
"என்பதால் முக்கியமானதாக இருக்கும்"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.secondary_bone_axis
#. :src: bpy.types.IMPORT_SCENE_OT_fbx.secondary_bone_axis
msgid "Secondary Bone Axis"
msgstr "இரண்டாம் நிலை எலும்பு அச்சு"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_active_collection
msgid "Export only objects from the active collection (and its children)"
msgstr ""
"செயலில் உள்ள சேகரிப்பிலிருந்து (மற்றும் அதன் குழந்தைகள்) பொருட்களை மட்டுமே "
"ஏற்றுமதி செய்யுங்கள்"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_armature_deform_only
#. :src: bpy.types.WM_OT_usd_export.only_deform_bones
msgid "Only Deform Bones"
msgstr "எலும்புகளை மட்டுமே சிதைக்கிறது"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_armature_deform_only
msgid ""
"Only write deforming bones (and non-deforming ones when they have deforming "
"children)"
msgstr ""
"சிதைக்கும் எலும்புகளை மட்டும் எழுதுங்கள் (மற்றும் குழந்தைகளை சிதைக்கும் போது"
" சிதறடிக்காதவை)"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_batch_own_dir
msgid "Batch Own Dir"
msgstr "தொகுதி சொந்த டிர்"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.use_batch_own_dir
msgid "Create a dir for each exported file"
msgstr "ஏற்றுமதி செய்யப்பட்ட ஒவ்வொரு கோப்பிற்கும் ஒரு dir ஐ உருவாக்கவும்"

