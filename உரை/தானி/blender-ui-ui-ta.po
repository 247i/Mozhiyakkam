#. :src: bpy.types.MESH_OT_select_axis.orientation:'LOCAL'
#. :src: bpy.types.TRANSFORM_OT_transform.orient_matrix_type:'LOCAL'
#. :src: bpy.types.TRANSFORM_OT_transform.orient_type:'LOCAL'
#. :src: bpy.types.TRANSFORM_OT_translate.orient_matrix_type:'LOCAL'
