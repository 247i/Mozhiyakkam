#. :src: bpy.types.FluidFlowSettings.flow_behavior
msgid "Flow Behavior"
msgstr "ஓட்ட நடத்தை"

#. :src: bpy.types.FluidFlowSettings.flow_behavior
msgid "Change flow behavior in the simulation"
msgstr "உருவகப்படுத்துதலில் ஓட்ட நடத்தை மாற்றவும்"

#. :src: bpy.types.FluidFlowSettings.flow_behavior:'INFLOW'
msgid "Add fluid to simulation"
msgstr "உருவகப்படுத்துதலில் திரவத்தைச் சேர்க்கவும்"

#. :src: bpy.types.FluidFlowSettings.flow_behavior:'OUTFLOW'
msgid "Delete fluid from simulation"
msgstr "உருவகப்படுத்துதலில் இருந்து திரவத்தை நீக்கவும்"

#. :src: bpy.types.FluidFlowSettings.flow_behavior:'GEOMETRY'
msgid "Only use given geometry for fluid"
msgstr "திரவத்திற்கு கொடுக்கப்பட்ட வடிவவியலை மட்டுமே பயன்படுத்தவும்"

#. :src: bpy.types.FluidFlowSettings.flow_source
msgid "Change how fluid is emitted"
msgstr "திரவம் எவ்வாறு வெளியேற்றப்படுகிறது என்பதை மாற்றவும்"

#. :src: bpy.types.FluidFlowSettings.flow_type
msgid "Flow Type"
msgstr "ஓட்ட வகை"

#. :src: bpy.types.FluidFlowSettings.flow_type
msgid "Change type of fluid in the simulation"
msgstr "உருவகப்படுத்துதலில் திரவ வகையை மாற்றவும்"

#. :src: bpy.types.FluidFlowSettings.flow_type:'SMOKE'
msgid "Add smoke"
msgstr "புகை சேர்க்கவும்"

#. :src: bpy.types.FluidFlowSettings.flow_type:'BOTH'
msgid "Fire + Smoke"
msgstr "தீ + புகை"

#. :src: bpy.types.FluidFlowSettings.flow_type:'BOTH'
msgid "Add fire and smoke"
msgstr "தீ மற்றும் புகை சேர்க்கவும்"

#. :src: bpy.types.FluidFlowSettings.flow_type:'FIRE'
#. :src: bpy.types.OBJECT_OT_quick_smoke.style:'FIRE'
#. :src: bpy.types.PHYSICS_PT_fire
msgid "Fire"
msgstr "தீ"

#. :src: bpy.types.FluidFlowSettings.flow_type:'FIRE'
msgid "Add fire"
msgstr "தீ சேர்க்கவும்"

#. :src: bpy.types.FluidFlowSettings.flow_type:'LIQUID'
msgid "Add liquid"
msgstr "திரவத்தைச் சேர்க்கவும்"

