#. :src: bpy.types.PreferencesView.show_developer_ui
msgid "Display advanced settings and tools for developers"
msgstr "டெவலப்பர்களுக்கான மேம்பட்ட அமைப்புகள் மற்றும் கருவிகளைக் காண்பி"

#. :src: bpy.types.PreferencesView.show_extensions_updates
msgid "Show Extensions Update Count"
msgstr "நீட்டிப்புகள் புதுப்பிப்பு எண்ணிக்கையைக் காட்டு"

#. :src: bpy.types.PreferencesView.show_gizmo
msgid "Use transform gizmos by default"
msgstr "இயல்புநிலையாக உருமாற்ற கிச்மோசைப் பயன்படுத்தவும்"

#. :src: bpy.types.PreferencesView.show_navigate_ui
msgid "Navigation Controls"
msgstr "வழிசெலுத்தல் கட்டுப்பாடுகள்"

#. :src: bpy.types.PreferencesView.show_navigate_ui
msgid ""
"Show navigation controls in 2D and 3D views which do not have scroll bars"
msgstr ""
"சுருள் பார்கள் இல்லாத 2 டி மற்றும் 3 டி காட்சிகளில் வழிசெலுத்தல் "
"கட்டுப்பாடுகளைக் காட்டுங்கள்"

#. :src: bpy.types.PreferencesView.show_object_info
msgid "Display Object Info"
msgstr "பொருள் தகவலைக் காண்பி"

#. :src: bpy.types.PreferencesView.show_object_info
msgid ""
"Include the name of the active object and the current frame number in the "
"text info overlay"
msgstr ""
"செயலில் உள்ள பொருளின் பெயர் மற்றும் உரை செய்தி மேலடுக்கில் தற்போதைய பிரேம் "
"எண்ணைச் சேர்க்கவும்"

#. :src: bpy.types.PreferencesView.show_playback_fps
msgid "Display Playback Frame Rate (FPS)"
msgstr "பிளேபேக் பிரேம் வீதத்தைக் காண்பி (fps)"

#. :src: bpy.types.PreferencesView.show_playback_fps
msgid ""
"Include the number of frames displayed per second in the text info overlay "
"while animation is played back"
msgstr ""
"அனிமேசன் மீண்டும் இயக்கப்படும் போது உரை செய்தி மேலடுக்கில் நொடிக்கு "
"காட்டப்படும் பிரேம்களின் எண்ணிக்கையைச் சேர்க்கவும்"

#. :src: bpy.types.PreferencesView.show_splash
msgid "Show Splash"
msgstr "ச்பிளாச் காட்டு"

#. :src: bpy.types.PreferencesView.show_splash
msgid "Display splash screen on startup"
msgstr "தொடக்கத்தில் ச்பிளாச் திரையை காண்பி"

#. :src: bpy.types.PreferencesView.show_statusbar_memory
msgid "Show Memory"
msgstr "நினைவகத்தைக் காட்டு"

#. :src: bpy.types.PreferencesView.show_statusbar_memory
msgid "Show Blender memory usage"
msgstr "கலப்பான் நினைவக பயன்பாட்டைக் காட்டு"

#. :src: bpy.types.PreferencesView.show_statusbar_scene_duration
msgid "Show Scene Duration"
msgstr "காட்சி காலத்தைக் காட்டு"

#. :src: bpy.types.PreferencesView.show_statusbar_scene_duration
msgid "Show scene duration"
msgstr "காட்சி காலத்தைக் காட்டு"

#. :src: bpy.types.PreferencesView.show_statusbar_stats
#. :src: bpy.types.View3DOverlay.show_stats
msgid "Show Statistics"
msgstr "புள்ளிவிவரங்களைக் காட்டு"

#. :src: bpy.types.PreferencesView.show_statusbar_stats
msgid "Show scene statistics"
msgstr "காட்சி புள்ளிவிவரங்களைக் காட்டு"

#. :src: bpy.types.PreferencesView.show_statusbar_version
msgid "Show Version"
msgstr "பதிப்பைக் காட்டு"

#. :src: bpy.types.PreferencesView.show_statusbar_version
msgid "Show Blender version string"
msgstr "கலப்பான் பதிப்பு சரம் காட்டு"

#. :src: bpy.types.PreferencesView.show_statusbar_vram
msgid "Show VRAM"
msgstr "vram ஐக் காட்டு"

#. :src: bpy.types.PreferencesView.show_statusbar_vram
msgid "Show GPU video memory usage"
msgstr "gpu வீடியோ நினைவக பயன்பாட்டைக் காட்டு"

#. :src: bpy.types.PreferencesView.show_tooltips
#: scripts/startup/bl_ui/space_userpref.py:219
#: scripts/startup/bl_ui/space_userpref.py:267
msgid "Tooltips"
msgstr "உதவிக்குறிப்புகள்"

#. :src: bpy.types.PreferencesView.show_tooltips
msgid "Display tooltips (when disabled, hold Alt to force display)"
msgstr ""
"கருவி உதவிக்குறிப்புகளைக் காண்பி (முடக்கப்பட்டால், காட்சிக்கு கட்டாயப்படுத்த"
" மாற்று ஐ வைத்திருங்கள்)"

#. :src: bpy.types.PreferencesView.show_tooltips_python
msgid "Python Tooltips"
msgstr "பைதான் உதவிக்குறிப்புகள்"

#. :src: bpy.types.PreferencesView.show_tooltips_python
msgid "Show Python references in tooltips"
msgstr "உதவிக்குறிப்புகளில் பைதான் குறிப்புகளைக் காட்டு"

#. :src: bpy.types.PreferencesView.show_view_name
msgid "Display View Name"
msgstr "காட்சி பார்வை பெயர்"

#. :src: bpy.types.PreferencesView.show_view_name
msgid "Include the name of the view orientation in the text info overlay"
msgstr "உரை செய்தி மேலடுக்கில் பார்வை நோக்குநிலையின் பெயரைச் சேர்க்கவும்"

#. :src: bpy.types.PreferencesView.smooth_view
msgid "Smooth View"
msgstr "மென்மையான பார்வை"

#. :src: bpy.types.PreferencesView.smooth_view
msgid "Time to animate the view in milliseconds, zero to disable"
msgstr "மில்லி விநாடிகளில் பார்வையை உயிரூட்டுவதற்கான நேரம், முடக்க பூச்சியம்"

#. :src: bpy.types.PreferencesView.text_hinting
msgid "Text Hinting"
msgstr "உரை குறிப்பு"

#. :src: bpy.types.PreferencesView.text_hinting
msgid "Method for making user interface text render sharp"
msgstr "பயனர் இடைமுக உரை வழங்குவதற்கான முறை கூர்மையானது"

#. :src: bpy.types.PreferencesView.text_hinting:'SLIGHT'
msgid "Slight"
msgstr "லேசான"

#. :src: bpy.types.PreferencesView.timecode_style
msgid "Timecode Style"
msgstr "டைம்கோட் பாணி"

#. :src: bpy.types.PreferencesView.timecode_style
msgid ""
"Format of timecode displayed when not displaying timing in terms of frames"
msgstr ""
"பிரேம்களின் அடிப்படையில் நேரத்தைக் காட்டாதபோது நேரக் குறியீடு காட்சியின் "
"வடிவம்"

#. :src: bpy.types.PreferencesView.timecode_style:'MINIMAL'
msgid "Minimal Info"
msgstr "குறைந்தபட்ச செய்தி"

#. :src: bpy.types.PreferencesView.timecode_style:'MINIMAL'
msgid ""
"Most compact representation, uses '+' as separator for sub-second frame "
"numbers, with left and right truncation of the timecode as necessary"
msgstr ""
"பெரும்பாலான கச்சிதமான பிரதிநிதித்துவம், துணை-வினாடி பிரேம் எண்களுக்கு "
"பிரிப்பானாக '+' ஐப் பயன்படுத்துகிறது, நேரக் குறியீட்டின் இடது மற்றும் வலது "
"துண்டுடன் தேவையானது"

#. :src: bpy.types.PreferencesView.timecode_style:'SMPTE'
msgid "SMPTE (Full)"
msgstr "smpte (முழு)"

#. :src: bpy.types.PreferencesView.timecode_style:'SMPTE'
msgid "Full SMPTE timecode (format is HH:MM:SS:FF)"
msgstr "முழு smpte timecode (வடிவம் hh: mm: ss: ff)"

#. :src: bpy.types.PreferencesView.timecode_style:'SMPTE_COMPACT'
msgid "SMPTE (Compact)"
msgstr "smpte (காம்பாக்ட்)"

#. :src: bpy.types.PreferencesView.timecode_style:'SMPTE_COMPACT'
msgid ""
"SMPTE timecode showing minutes, seconds, and frames only - hours are also "
"shown if necessary, but not by default"
msgstr ""
"நிமிடங்கள், விநாடிகள் மற்றும் பிரேம்கள் மட்டுமே காட்டும் smpte நேரக் "
"குறியீடு - தேவைப்பட்டால் மணிநேரங்களும் காண்பிக்கப்படுகின்றன, ஆனால் இயல்பாகவே"
" அல்ல"

#. :src: bpy.types.PreferencesView.timecode_style:'MILLISECONDS'
msgid "Compact with Decimals"
msgstr "தசமங்களுடன் கச்சிதமான"

#. :src: bpy.types.PreferencesView.timecode_style:'MILLISECONDS'
msgid ""
"Similar to SMPTE (Compact), except that the decimal part of the second is "
"shown instead of frames"
msgstr ""
"SMPTE (காம்பாக்ட்) போன்றது, பிரேம்களுக்கு பதிலாக இரண்டாவது தசம பகுதி "
"காட்டப்படுகிறது என்பதைத் தவிர"

#. :src: bpy.types.PreferencesView.timecode_style:'SECONDS_ONLY'
msgid "Only Seconds"
msgstr "வினாடிகள் மட்டுமே"

#. :src: bpy.types.PreferencesView.timecode_style:'SECONDS_ONLY'
msgid "Direct conversion of frame numbers to seconds"
msgstr "பிரேம் எண்களை வினாடிகளுக்கு நேரடி மாற்ற"

#. :src: bpy.types.PreferencesView.ui_line_width
msgid ""
"Changes the thickness of widget outlines, lines and dots in the interface"
msgstr ""
"இடைமுகத்தில் உள்ள விட்செட் வெளிப்புறங்கள், கோடுகள் மற்றும் புள்ளிகளின் "
"தடிமன் மாற்றுகிறது"

#. :src: bpy.types.PreferencesView.ui_line_width:'THIN'
msgid "Thin"
msgstr "மெல்லிய"

#. :src: bpy.types.PreferencesView.ui_line_width:'THIN'
msgid "Thinner lines than the default"
msgstr "இயல்புநிலையை விட மெல்லிய கோடுகள்"

#. :src: bpy.types.PreferencesView.ui_line_width:'AUTO'
msgid "Automatic line width based on UI scale"
msgstr "இடைமுகம் அளவின் அடிப்படையில் தானியங்கி வரி அகலம்"

#. :src: bpy.types.PreferencesView.ui_line_width:'THICK'
msgid "Thick"
msgstr "அடர்த்தியான"

#. :src: bpy.types.PreferencesView.ui_line_width:'THICK'
msgid "Thicker lines than the default"
msgstr "இயல்புநிலையை விட தடிமனான கோடுகள்"

#. :src: bpy.types.PreferencesView.ui_scale
msgid "Changes the size of the fonts and widgets in the interface"
msgstr "இடைமுகத்தில் எழுத்துருக்கள் மற்றும் விட்செட்களின் அளவை மாற்றுகிறது"

#. :src: bpy.types.PreferencesView.use_filter_brushes_by_tool
msgid "Filter Brushes by Tool"
msgstr "கருவி மூலம் தூரிகைகளை வடிகட்டவும்"

#. :src: bpy.types.PreferencesView.use_filter_brushes_by_tool
msgid ""
"Only show brushes applicable for the currently active tool in the asset "
"shelf. Stored in the Preferences, which may have to be saved manually if "
"Auto-Save Preferences is disabled"
msgstr ""
"சொத்து அலமாரியில் தற்போது செயலில் உள்ள கருவிக்கு பொருந்தக்கூடிய தூரிகைகளை "
"மட்டுமே காண்பி. தானாக சேமிக்கும் விருப்பத்தேர்வுகள் முடக்கப்பட்டிருந்தால், "
"விருப்பத்தேர்வுகளில் சேமிக்கப்பட வேண்டும், இது கைமுறையாக சேமிக்கப்பட "
"வேண்டியிருக்கும்"

#. :src: bpy.types.PreferencesView.use_fresnel_edit
msgid ""
"Enable a fresnel effect on edit mesh overlays.\n"
"It improves shape readability of very dense meshes, but increases eye fatigue when modeling lower poly"
msgstr ""
"திருத்து கண்ணி மேலடுக்குகளில் ஃப்ரெச்னல் விளைவை இயக்கவும். \n"
" இது மிகவும் அடர்த்தியான மெச்களின் வடிவ வாசிப்புத்திறனை மேம்படுத்துகிறது, ஆனால் குறைந்த பாலி மாதிரியை மாடலிங் செய்யும் போது கண் சோர்வு அதிகரிக்கிறது"

#. :src: bpy.types.PreferencesView.use_mouse_over_open
msgid ""
"Open menu buttons and pull-downs automatically when the mouse is hovering"
msgstr "சுட்டி வட்டமிடும்போது தானாக பட்டியல் பொத்தான்கள் மற்றும் இழுக்கல்"

#. :src: bpy.types.PreferencesView.use_save_prompt
msgid "Save Prompt"
msgstr "வரியில் சேமிக்கவும்"

#. :src: bpy.types.PreferencesView.use_save_prompt
msgid "Ask for confirmation when quitting with unsaved changes"
msgstr ""
"சேமிக்கப்படாத மாற்றங்களுடன் வெளியேறும்போது உறுதிப்படுத்தலைக் கேளுங்கள்"

#. :src: bpy.types.PreferencesView.use_text_antialiasing
msgid "Text Anti-Aliasing"
msgstr "உரை எதிர்ப்பு மாற்று"

#. :src: bpy.types.PreferencesView.use_text_antialiasing
msgid "Smooth jagged edges of user interface text"
msgstr "பயனர் இடைமுக உரையின் மென்மையான துண்டிக்கப்பட்ட விளிம்புகள்"

#. :src: bpy.types.PreferencesView.use_text_render_subpixelaa
msgid "Text Subpixel Anti-Aliasing"
msgstr "உரை துணை படப்புள்ளி எதிர்ப்பு மாற்றுப்பெயர்"

#. :src: bpy.types.PreferencesView.use_text_render_subpixelaa
msgid "Render text for optimal horizontal placement"
msgstr "உகந்த கிடைமட்ட வேலைவாய்ப்புக்கு உரையை வழங்கவும்"

#. :src: bpy.types.PreferencesView.use_translate_interface
msgid "Translate Interface"
msgstr "இடைமுகத்தை மொழிபெயர்க்கவும்"

#. :src: bpy.types.PreferencesView.use_translate_interface
msgid ""
"Translate all labels in menus, buttons and panels (note that this might make"
" it hard to follow tutorials or the manual)"
msgstr ""
"மெனுக்கள், பொத்தான்கள் மற்றும் பேனல்களில் அனைத்து சிட்டைகளையும் "
"மொழிபெயர்க்கவும் (இது பயிற்சிகள் அல்லது கையேட்டைப் பின்பற்றுவது கடினமாக்கும்"
" என்பதை நினைவில் கொள்க)"

#. :src: bpy.types.PreferencesView.use_translate_new_dataname
msgid "Translate New Names"
msgstr "புதிய பெயர்களை மொழிபெயர்க்கவும்"

#. :src: bpy.types.PreferencesView.use_translate_new_dataname
msgid "Translate the names of new data-blocks (objects, materials...)"
msgstr ""
"புதிய தரவு-தொகுதிகளின் பெயர்களை மொழிபெயர்க்கவும் (பொருள்கள், மூலப்பொருட்கள் "
"...)"

#. :src: bpy.types.PreferencesView.use_translate_reports
msgid "Translate Reports"
msgstr "அறிக்கைகளை மொழிபெயர்க்கவும்"

#. :src: bpy.types.PreferencesView.use_translate_reports
msgid "Translate additional information, such as error messages"
msgstr "பிழை செய்திகள் போன்ற கூடுதல் தகவல்களை மொழிபெயர்க்கவும்"

#. :src: bpy.types.PreferencesView.use_translate_tooltips
msgid "Translate Tooltips"
msgstr "உதவிக்குறிப்புகளை மொழிபெயர்க்கவும்"

#. :src: bpy.types.PreferencesView.use_translate_tooltips
msgid "Translate the descriptions when hovering UI elements (recommended)"
msgstr ""
"இடைமுகம் கூறுகளை வட்டமிடும்போது விளக்கங்களை மொழிபெயர்க்கவும் "
"(பரிந்துரைக்கப்படுகிறது)"

#. :src: bpy.types.PreferencesView.use_weight_color_range
msgid "Use Weight Color Range"
msgstr "எடை வண்ண வரம்பைப் பயன்படுத்தவும்"

#. :src: bpy.types.PreferencesView.use_weight_color_range
msgid ""
"Enable color range used for weight visualization in weight painting mode"
msgstr ""
"எடை ஓவியம் பயன்முறையில் எடை காட்சிப்படுத்தலுக்குப் பயன்படுத்தப்படும் வண்ண "
"வரம்பை இயக்கவும்"

