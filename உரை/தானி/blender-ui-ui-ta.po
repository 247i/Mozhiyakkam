msgstr "வெளியீட்டிற்கு பயன்படுத்த எந்த மார்க்கர் நிலை"

#. :src: bpy.types.CompositorNodeTrackPos.position:'ABSOLUTE'
msgid "Output absolute position of a marker"
msgstr "ஒரு மார்க்கரின் வெளியீடு முழுமையான நிலை"

#. :src: bpy.types.CompositorNodeTrackPos.position:'RELATIVE_START'
msgid "Relative Start"
msgstr "உறவினர் தொடக்க"

#. :src: bpy.types.CompositorNodeTrackPos.position:'RELATIVE_START'
msgid "Output position of a marker relative to first marker of a track"
msgstr ""
"ஒரு பாதையின் முதல் குறிப்பானுடன் தொடர்புடைய மார்க்கரின் வெளியீட்டு நிலை"

#. :src: bpy.types.CompositorNodeTrackPos.position:'RELATIVE_FRAME'
msgid "Relative Frame"
msgstr "உறவினர் சட்டகம்"

#. :src: bpy.types.CompositorNodeTrackPos.position:'RELATIVE_FRAME'
msgid "Output position of a marker relative to marker at given frame number"
msgstr ""
"கொடுக்கப்பட்ட பிரேம் எண்ணில் மார்க்கருடன் தொடர்புடைய மார்க்கரின் வெளியீட்டு "
"நிலை"

#. :src: bpy.types.CompositorNodeTrackPos.position:'ABSOLUTE_FRAME'
msgid "Absolute Frame"
msgstr "முழுமையான சட்டகம்"

#. :src: bpy.types.CompositorNodeTrackPos.position:'ABSOLUTE_FRAME'
msgid "Output absolute position of a marker at given frame number"
msgstr "கொடுக்கப்பட்ட பிரேம் எண்ணில் ஒரு மார்க்கரின் வெளியீடு முழுமையான நிலை"

#. :src: bpy.types.CompositorNodeTransform
msgid "Scale, translate and rotate an image"
msgstr "ஒரு படத்தை அளவிடவும், மொழிபெயர்க்கவும் மற்றும் சுழற்றவும்"

#. :src: bpy.types.CompositorNodeTranslate
#. :src: bpy.types.TextureNodeTranslate
msgid "Translate"
msgstr "மொழிபெயர்"

#. :src: bpy.types.CompositorNodeTranslate
msgid "Offset an image"
msgstr "ஒரு படத்தை ஈடுசெய்யவும்"

#. :src: bpy.types.CompositorNodeVecBlur
msgid "Vector Blur"
msgstr "திசையன் மங்கலானது"

#. :src: bpy.types.CompositorNodeVecBlur
msgid "Uses the vector speed render pass to blur the image pixels in 2D"
msgstr ""
"2d இல் பட பிக்சல்களை மங்கச் செய்ய திசையன் வேக வழங்குதல் பாசைப் "
"பயன்படுத்துகிறது"

#. :src: bpy.types.CompositorNodeViewer
#. :src: bpy.types.GeometryNodeViewer
#. :src: bpy.types.TextureNodeViewer
#: source/blender/editors/interface/regions/interface_region_tooltip.cc:1743
msgid "Viewer"
msgstr "பார்வையாளர்"

#. :src: bpy.types.CompositorNodeViewer
msgid ""
"Visualize data from inside a node graph, in the image editor or as a "
"backdrop"
msgstr ""
"ஒரு முனை வரைபடத்தின் உள்ளே, பட எடிட்டரில் அல்லது பின்னணியாக தரவைக் "
"காட்சிப்படுத்துங்கள்"

#. :src: bpy.types.CompositorNodeZcombine
msgid "Depth Combine"
msgstr "ஆழம் இணைத்தல்"

#. :src: bpy.types.CompositorNodeZcombine
msgid "Combine two images using depth maps"
msgstr "ஆழமான வரைபடங்களைப் பயன்படுத்தி இரண்டு படங்களை இணைக்கவும்"

#. :src: bpy.types.FunctionNode
msgid "Function Node"
msgstr "செயல்பாட்டு முனை"

#. :src: bpy.types.FunctionNodeAlignEulerToVector
msgid "Align Euler to Vector"
msgstr "யூலரை திசையனுடன் சீரமைக்கவும்"

#. :src: bpy.types.FunctionNodeAlignEulerToVector.axis
#. :src: bpy.types.FunctionNodeAlignRotationToVector.axis
msgid "Axis to align to the vector"
msgstr "திசையனுடன் சீரமைக்க அச்சு"

#. :src: bpy.types.FunctionNodeAlignEulerToVector.axis:'X'
#. :src: bpy.types.FunctionNodeAlignRotationToVector.axis:'X'
msgid "Align the X axis with the vector"
msgstr "ஃச் அச்சை திசையனுடன் சீரமைக்கவும்"

#. :src: bpy.types.FunctionNodeAlignEulerToVector.axis:'Y'
#. :src: bpy.types.FunctionNodeAlignRotationToVector.axis:'Y'
msgid "Align the Y axis with the vector"
msgstr "ஒய் அச்சை திசையனுடன் சீரமைக்கவும்"

#. :src: bpy.types.FunctionNodeAlignEulerToVector.axis:'Z'
#. :src: bpy.types.FunctionNodeAlignRotationToVector.axis:'Z'
msgid "Align the Z axis with the vector"
msgstr "சட் அச்சை திசையனுடன் சீரமைக்கவும்"

#. :src: bpy.types.FunctionNodeAlignEulerToVector.pivot_axis
#. :src: bpy.types.FunctionNodeAlignRotationToVector.pivot_axis
msgid "Pivot Axis"
msgstr "பிவோட் அச்சு"

#. :src: bpy.types.FunctionNodeAlignEulerToVector.pivot_axis
#. :src: bpy.types.FunctionNodeAlignRotationToVector.pivot_axis
#: source/blender/nodes/shader/nodes/node_shader_vector_rotate.cc:38
msgid "Axis to rotate around"
msgstr "சுற்றி சுழற்ற அச்சு"

#. :src: bpy.types.FunctionNodeAlignEulerToVector.pivot_axis:'AUTO'
#. :src: bpy.types.FunctionNodeAlignRotationToVector.pivot_axis:'AUTO'
msgid ""
"Automatically detect the best rotation axis to rotate towards the vector"
msgstr "திசையன் நோக்கி சுழல சிறந்த சுழற்சி அச்சை தானாகவே கண்டறியவும்"

#. :src: bpy.types.FunctionNodeAlignEulerToVector.pivot_axis:'X'
#. :src: bpy.types.FunctionNodeAlignRotationToVector.pivot_axis:'X'
msgid "Rotate around the local X axis"
msgstr "உள்ளக ஃச் அச்சில் சுழற்றுங்கள்"

#. :src: bpy.types.FunctionNodeAlignEulerToVector.pivot_axis:'Y'
#. :src: bpy.types.FunctionNodeAlignRotationToVector.pivot_axis:'Y'
msgid "Rotate around the local Y axis"
msgstr "உள்ளக ஒய் அச்சில் சுழற்றுங்கள்"

#. :src: bpy.types.FunctionNodeAlignEulerToVector.pivot_axis:'Z'
#. :src: bpy.types.FunctionNodeAlignRotationToVector.pivot_axis:'Z'
msgid "Rotate around the local Z axis"
msgstr "உள்ளக சட் அச்சில் சுழற்றுங்கள்"

#. :src: bpy.types.FunctionNodeAlignRotationToVector
msgid "Align Rotation to Vector"
msgstr "சுழற்சியை திசையனுடன் சீரமைக்கவும்"

#. :src: bpy.types.FunctionNodeAxesToRotation
msgid "Axes to Rotation"
msgstr "சுழற்சிக்கு அச்சுகள்"

#. :src: bpy.types.FunctionNodeAxesToRotation
msgid ""
"Create a rotation from a primary and (ideally orthogonal) secondary axis"
msgstr ""
"ஒரு முதன்மை மற்றும் (வெறுமனே ஆர்த்தோகனல்) இரண்டாம் நிலை அச்சிலிருந்து ஒரு "
"சுழற்சியை உருவாக்கவும்"

#. :src: bpy.types.FunctionNodeAxesToRotation.primary_axis
#: source/blender/nodes/function/nodes/node_fn_axes_to_rotation.cc:19
msgid "Primary Axis"
msgstr "முதன்மை அச்சு"

#. :src: bpy.types.FunctionNodeAxesToRotation.primary_axis
msgid "Axis that is aligned exactly to the provided primary direction"
msgstr "வழங்கப்பட்ட முதன்மை திசையுடன் சரியாக சீரமைக்கப்பட்ட அச்சு"

#. :src: bpy.types.FunctionNodeAxesToRotation.secondary_axis
#: source/blender/nodes/function/nodes/node_fn_axes_to_rotation.cc:20
msgid "Secondary Axis"
msgstr "இரண்டாம் நிலை அச்சு"

#. :src: bpy.types.FunctionNodeAxesToRotation.secondary_axis
msgid ""
"Axis that is aligned as well as possible given the alignment of the primary "
"axis"
msgstr "முதன்மை அச்சின் சீரமைப்பு கொடுக்கப்பட்டுள்ள அச்சு மற்றும் முடிந்தவரை"

#. :src: bpy.types.FunctionNodeAxisAngleToRotation
msgid "Axis Angle to Rotation"
msgstr "சுழற்சிக்கு அச்சு கோணம்"

#. :src: bpy.types.FunctionNodeBitMath
msgid "Bit Math"
msgstr "பிட் கணிதம்"

#. :src: bpy.types.FunctionNodeBitMath
msgid "Perform bitwise operations on 32-bit integers"
msgstr "32-பிட் முழு எண்களில் பிட்வைச் செயல்பாடுகளைச் செய்யுங்கள்"

#. :src: bpy.types.FunctionNodeBitMath.operation:'AND'
#. :src: bpy.types.FunctionNodeBooleanMath.operation:'AND'
msgid "And"
msgstr "மற்றும்"

#. :src: bpy.types.FunctionNodeBitMath.operation:'AND'
msgid "Returns a value where the bits of A and B are both set"
msgstr ""
"A மற்றும் B இன் பிட்கள் இரண்டும் அமைக்கப்பட்டிருக்கும் மதிப்பை வழங்குகிறது"

#. :src: bpy.types.FunctionNodeBitMath.operation:'OR'
#. :src: bpy.types.FunctionNodeBooleanMath.operation:'OR'
msgid "Or"
msgstr "அல்லது"

#. :src: bpy.types.FunctionNodeBitMath.operation:'OR'
msgid "Returns a value where the bits of either A or B are set"
msgstr "A அல்லது B இன் பிட்கள் அமைக்கப்பட்டிருக்கும் மதிப்பை வழங்குகிறது"

#. :src: bpy.types.FunctionNodeBitMath.operation:'XOR'
msgid "Exclusive Or"
msgstr "பிரத்தியேக அல்லது"

#. :src: bpy.types.FunctionNodeBitMath.operation:'XOR'
msgid "Returns a value where only one bit from A and B is set"
msgstr ""
"A மற்றும் B இலிருந்து ஒரு பிட் மட்டுமே அமைக்கப்பட்டிருக்கும் ஒரு மதிப்பை "
"வழங்குகிறது"

#. :src: bpy.types.FunctionNodeBitMath.operation:'NOT'
msgid ""
"Returns the opposite bit value of A, in decimal it is equivalent of A = -A -"
" 1"
msgstr ""
"A இன் எதிர் பிட் மதிப்பை வழங்குகிறது, தசமத்தில் இது a = -a - 1 க்கு சமம்"

#. :src: bpy.types.FunctionNodeBitMath.operation:'SHIFT'
msgid ""
"Shifts the bit values of A by the specified Shift amount. Positive values "
"shift left, negative values shift right."
msgstr ""
"குறிப்பிட்ட மாற்றத் தொகையால் A இன் பிட் மதிப்புகளை மாற்றுகிறது. நேர்மறை "
"மதிப்புகள் இடதுபுறமாக மாறுகின்றன, எதிர்மறை மதிப்புகள் வலதுபுறமாக மாறுகின்றன."

#. :src: bpy.types.FunctionNodeBitMath.operation:'ROTATE'
msgid ""
"Rotates the bit values of A by the specified Shift amount. Positive values "
"rotate left, negative values rotate right."
msgstr ""
"குறிப்பிட்ட மாற்றத் தொகையால் A இன் பிட் மதிப்புகளை சுழற்றுகிறது. நேர்மறை "
"மதிப்புகள் இடதுபுறமாக சுழல்கின்றன, எதிர்மறை மதிப்புகள் வலதுபுறமாக "
"சுழல்கின்றன."

#. :src: bpy.types.FunctionNodeBooleanMath
msgid "Boolean Math"
msgstr "பூலியன் கணிதம்"

#. :src: bpy.types.FunctionNodeBooleanMath.operation:'AND'
msgid "True when both inputs are true"
msgstr "இரண்டு உள்ளீடுகளும் உண்மையாக இருக்கும்போது உண்மை"

#. :src: bpy.types.FunctionNodeBooleanMath.operation:'OR'
msgid "True when at least one input is true"
msgstr "குறைந்தது ஒரு உள்ளீடு உண்மையாக இருக்கும்போது உண்மை"

#. :src: bpy.types.FunctionNodeBooleanMath.operation:'NOT'
msgid "Opposite of the input"
msgstr "உள்ளீட்டிற்கு எதிரானது"

#. :src: bpy.types.FunctionNodeBooleanMath.operation:'NAND'
msgid "Not And"
msgstr "இல்லை"

#. :src: bpy.types.FunctionNodeBooleanMath.operation:'NAND'
msgid "True when at least one input is false"
msgstr "குறைந்தது ஒரு உள்ளீடு தவறானது போது உண்மை"

#. :src: bpy.types.FunctionNodeBooleanMath.operation:'NOR'
msgid "Nor"
msgstr "அல்லது"

#. :src: bpy.types.FunctionNodeBooleanMath.operation:'NOR'
msgid "True when both inputs are false"
msgstr "இரண்டு உள்ளீடுகளும் பொய்யாக இருக்கும்போது உண்மை"

#. :src: bpy.types.FunctionNodeBooleanMath.operation:'XNOR'
#. :src: bpy.types.FunctionNodeCompare.operation:'EQUAL'
#. :src: bpy.types.CURVE_OT_select_similar.compare:'EQUAL'
#. :src: bpy.types.MESH_OT_select_similar.compare:'EQUAL'
#. :src: bpy.types.UV_OT_select_similar.compare:'EQUAL'
msgid "Equal"
msgstr "சமமான"

#. :src: bpy.types.FunctionNodeBooleanMath.operation:'XNOR'
msgid "True when both inputs are equal (exclusive nor)"
msgstr "இரண்டு உள்ளீடுகளும் சமமாக இருக்கும்போது உண்மை (பிரத்தியேக nor)"

#. :src: bpy.types.FunctionNodeBooleanMath.operation:'XOR'
#. :src: bpy.types.FunctionNodeCompare.operation:'NOT_EQUAL'
msgid "Not Equal"
msgstr "சமமாக இல்லை"

#. :src: bpy.types.FunctionNodeBooleanMath.operation:'XOR'
msgid "True when both inputs are different (exclusive or)"
msgstr ""
"இரண்டு உள்ளீடுகளும் வித்தியாசமாக இருக்கும்போது உண்மை (பிரத்தியேக அல்லது)"

#. :src: bpy.types.FunctionNodeBooleanMath.operation:'IMPLY'
msgid "Imply"
msgstr "குறிக்கவும்"

#. :src: bpy.types.FunctionNodeBooleanMath.operation:'IMPLY'
msgid "True unless the first input is true and the second is false"
msgstr "முதல் உள்ளீடு உண்மை மற்றும் இரண்டாவது தவறானது என்றால் உண்மை"

#. :src: bpy.types.FunctionNodeBooleanMath.operation:'NIMPLY'
msgid "True when the first input is true and the second is false (not imply)"
msgstr ""
"முதல் உள்ளீடு உண்மையாகவும், இரண்டாவது தவறாகவும் இருக்கும்போது உண்மை "
"(குறிக்கவில்லை)"

#. :src: bpy.types.FunctionNodeCombineMatrix
msgid "Combine Matrix"
msgstr "மேட்ரிக்சை இணைக்கவும்"

#. :src: bpy.types.FunctionNodeCombineMatrix
msgid "Construct a 4x4 matrix from its individual values"
msgstr "அதன் தனிப்பட்ட மதிப்புகளிலிருந்து 4x4 மேட்ரிக்சை உருவாக்குங்கள்"

#. :src: bpy.types.FunctionNodeCombineTransform
msgid "Combine Transform"
msgstr "உருமாற்றத்தை இணைக்கவும்"

#. :src: bpy.types.FunctionNodeCompare
#. :src: bpy.types.CURVE_OT_select_similar.compare
#. :src: bpy.types.MESH_OT_select_similar.compare
#. :src: bpy.types.UV_OT_select_similar.compare
msgid "Compare"
msgstr "ஒப்பிடுக"

#. :src: bpy.types.FunctionNodeCompare.data_type
#. :src: bpy.types.GeometryNodeSwitch.input_type
msgid "Input Type"
msgstr "உள்ளீட்டு வகை"

#. :src: bpy.types.FunctionNodeCompare.mode:'ELEMENT'
msgid "Element-Wise"
msgstr "உறுப்பு வாரியாக"

#. :src: bpy.types.FunctionNodeCompare.mode:'ELEMENT'
msgid "Compare each element of the input vectors"
msgstr "உள்ளீட்டு திசையன்களின் ஒவ்வொரு உறுப்புகளையும் ஒப்பிடுக"

#. :src: bpy.types.FunctionNodeCompare.mode:'LENGTH'
msgid "Compare the length of the input vectors"
msgstr "உள்ளீட்டு திசையன்களின் நீளத்தை ஒப்பிடுக"

#. :src: bpy.types.FunctionNodeCompare.mode:'AVERAGE'
msgid "Compare the average of the input vectors elements"
msgstr "உள்ளீட்டு திசையன்கள் உறுப்புகளின் சராசரியை ஒப்பிடுக"

#. :src: bpy.types.FunctionNodeCompare.mode:'DOT_PRODUCT'
msgid "Dot Product"
msgstr "டாட் தயாரிப்பு"

#. :src: bpy.types.FunctionNodeCompare.mode:'DOT_PRODUCT'
msgid "Compare the dot products of the input vectors"
msgstr "உள்ளீட்டு திசையன்களின் புள்ளி தயாரிப்புகளை ஒப்பிடுக"

#. :src: bpy.types.FunctionNodeCompare.mode:'DIRECTION'
msgid "Compare the direction of the input vectors"
msgstr "உள்ளீட்டு திசையன்களின் திசையை ஒப்பிடுக"

#. :src: bpy.types.FunctionNodeCompare.operation:'LESS_THAN'
#. :src: bpy.types.MESH_OT_select_by_pole_count.type:'LESS'
#. :src: bpy.types.MESH_OT_select_face_by_sides.type:'LESS'
#. :src: bpy.types.SpreadsheetRowFilter.operation:'LESS'
msgid "Less Than"
msgstr "குறைவாக"

#. :src: bpy.types.FunctionNodeCompare.operation:'LESS_THAN'
msgid "True when the first input is smaller than second input"
msgstr "முதல் உள்ளீடு இரண்டாவது உள்ளீட்டை விட சிறியதாக இருக்கும்போது உண்மை"

#. :src: bpy.types.FunctionNodeCompare.operation:'LESS_EQUAL'
msgid "Less Than or Equal"
msgstr "குறைவான அல்லது சமமான"

#. :src: bpy.types.FunctionNodeCompare.operation:'LESS_EQUAL'
msgid "True when the first input is smaller than the second input or equal"
msgstr ""
"முதல் உள்ளீடு இரண்டாவது உள்ளீட்டை விட சிறியதாக இருக்கும்போது அல்லது சமமாக "
"இருக்கும்போது உண்மை"

#. :src: bpy.types.FunctionNodeCompare.operation:'GREATER_THAN'
#. :src: bpy.types.MESH_OT_select_by_pole_count.type:'GREATER'
#. :src: bpy.types.MESH_OT_select_face_by_sides.type:'GREATER'
#. :src: bpy.types.SpreadsheetRowFilter.operation:'GREATER'
msgid "Greater Than"
msgstr "விட பெரியது"

#. :src: bpy.types.FunctionNodeCompare.operation:'GREATER_THAN'
msgid "True when the first input is greater than the second input"
msgstr "முதல் உள்ளீடு இரண்டாவது உள்ளீட்டை விட அதிகமாக இருக்கும்போது உண்மை"

#. :src: bpy.types.FunctionNodeCompare.operation:'GREATER_EQUAL'
msgid "Greater Than or Equal"
msgstr "பெரிய அல்லது சமமான"

#. :src: bpy.types.FunctionNodeCompare.operation:'GREATER_EQUAL'
msgid "True when the first input is greater than the second input or equal"
msgstr ""
"முதல் உள்ளீடு இரண்டாவது உள்ளீட்டை விட அதிகமாக இருக்கும்போது அல்லது சமமாக "
"இருக்கும்போது உண்மை"

#. :src: bpy.types.FunctionNodeCompare.operation:'EQUAL'
msgid "True when both inputs are approximately equal"
msgstr "இரண்டு உள்ளீடுகளும் தோராயமாக சமமாக இருக்கும்போது உண்மை"

#. :src: bpy.types.FunctionNodeCompare.operation:'NOT_EQUAL'
msgid "True when both inputs are not approximately equal"
msgstr "இரண்டு உள்ளீடுகளும் தோராயமாக சமமாக இல்லாதபோது உண்மை"

#. :src: bpy.types.FunctionNodeCompare.operation:'BRIGHTER'
msgid "Brighter"
msgstr "பிரகாசமான"

#. :src: bpy.types.FunctionNodeCompare.operation:'BRIGHTER'
msgid "True when the first input is brighter"
msgstr "முதல் உள்ளீடு பிரகாசமாக இருக்கும்போது உண்மை"

#. :src: bpy.types.FunctionNodeCompare.operation:'DARKER'
msgid "Darker"
msgstr "இருண்ட"

#. :src: bpy.types.FunctionNodeCompare.operation:'DARKER'
msgid "True when the first input is darker"
msgstr "முதல் உள்ளீடு இருட்டாக இருக்கும்போது உண்மை"

#. :src: bpy.types.FunctionNodeEulerToRotation
msgid "Euler to Rotation"
msgstr "சுழற்சிக்கு யூலர்"

#. :src: bpy.types.FunctionNodeFindInString
msgid "Find in String"
msgstr "சரத்தில் காணலாம்"

#. :src: bpy.types.FunctionNodeFloatToInt
msgid "Float to Integer"
msgstr "முழுஎண்ணுக்கு மிதக்கவும்"

#. :src: bpy.types.FunctionNodeFloatToInt.rounding_mode
msgctxt "NodeTree"
msgid "Rounding Mode"
msgstr "ரவுண்டிங் பயன்முறை"

#. :src: bpy.types.FunctionNodeFloatToInt.rounding_mode
msgid "Method used to convert the float to an integer"
msgstr "மிதவை ஒரு முழுஎண்ணாக மாற்ற பயன்படுத்தப்படும் முறை"

#. :src: bpy.types.FunctionNodeFloatToInt.rounding_mode:'ROUND'
#. :src: bpy.types.ShaderNodeMath.operation:'ROUND'
#. :src: bpy.types.TextureNodeMath.operation:'ROUND'
#. :src: bpy.types.NODE_OT_nw_batch_change.operation:'ROUND'
#. :src: bpy.types.NODE_OT_nw_merge_nodes.mode:'ROUND'
msgctxt "NodeTree"
msgid "Round"
msgstr "சுற்று"

#. :src: bpy.types.FunctionNodeFloatToInt.rounding_mode:'ROUND'
msgid "Round the float up or down to the nearest integer"
msgstr "மிதவை மேலே அல்லது கீழே அருகிலுள்ள முழுஎண்ணுக்குச் சுற்றி"

#. :src: bpy.types.FunctionNodeFloatToInt.rounding_mode:'FLOOR'
#. :src: bpy.types.ShaderNodeMath.operation:'FLOOR'
#. :src: bpy.types.ShaderNodeVectorMath.operation:'FLOOR'
#. :src: bpy.types.TextureNodeMath.operation:'FLOOR'
#. :src: bpy.types.NODE_OT_nw_batch_change.operation:'FLOOR'
#. :src: bpy.types.NODE_OT_nw_merge_nodes.mode:'FLOOR'
msgctxt "NodeTree"
msgid "Floor"
msgstr "தரை"

#. :src: bpy.types.FunctionNodeFloatToInt.rounding_mode:'FLOOR'
msgid "Round the float down to the next smallest integer"
msgstr "அடுத்த சிறிய முழுஎண்ணுக்கு மிதவைச் சுற்றி"

#. :src: bpy.types.FunctionNodeFloatToInt.rounding_mode:'CEILING'
msgctxt "NodeTree"
msgid "Ceiling"
msgstr "உச்சவரம்பு"

#. :src: bpy.types.FunctionNodeFloatToInt.rounding_mode:'CEILING'
msgid "Round the float up to the next largest integer"
msgstr "மிதவை அடுத்த பெரிய முழுஎண்ணாகச் சுற்றி"

#. :src: bpy.types.FunctionNodeFloatToInt.rounding_mode:'TRUNCATE'
