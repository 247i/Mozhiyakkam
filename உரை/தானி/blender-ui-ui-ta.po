#. :src: bpy.types.RenderSettings.line_thickness_mode
#: scripts/startup/bl_ui/properties_freestyle.py:44
msgid "Line Thickness Mode"
msgstr "வரி தடிமன் பயன்முறை"

#. :src: bpy.types.RenderSettings.line_thickness_mode
msgid "Line thickness mode for Freestyle line drawing"
msgstr "ஃப்ரீபாணி லைன் வரைபடத்திற்கான வரி தடிமன் பயன்முறை"

#. :src: bpy.types.RenderSettings.line_thickness_mode:'ABSOLUTE'
msgid "Specify unit line thickness in pixels"
msgstr "பிக்சல்களில் அலகு வரி தடிமன் குறிப்பிடவும்"

#. :src: bpy.types.RenderSettings.line_thickness_mode:'RELATIVE'
msgid ""
"Unit line thickness is scaled by the proportion of the present vertical "
"image resolution to 480 pixels"
msgstr ""
"அலகு வரி தடிமன் தற்போதைய செங்குத்து படத் தெளிவுத்திறனின் விகிதத்தால் 480 "
"பிக்சல்களுக்கு அளவிடப்படுகிறது"

#. :src: bpy.types.RenderSettings.metadata_input
msgid "Metadata Input"
msgstr "மேனிலை தரவு உள்ளீடு"

#. :src: bpy.types.RenderSettings.metadata_input
msgid "Where to take the metadata from"
msgstr "மேவுடேட்டாவை எங்கிருந்து எடுக்க வேண்டும்"

#. :src: bpy.types.RenderSettings.metadata_input:'SCENE'
msgid "Use metadata from the current scene"
msgstr "தற்போதைய காட்சியில் இருந்து மேவுடேட்டாவைப் பயன்படுத்தவும்"

#. :src: bpy.types.RenderSettings.metadata_input:'STRIPS'
msgid "Sequencer Strips"
msgstr "சீக்வென்சர் கீற்றுகள்"

#. :src: bpy.types.RenderSettings.metadata_input:'STRIPS'
msgid "Use metadata from the strips in the sequencer"
msgstr "சீக்வென்சரில் உள்ள கீற்றுகளிலிருந்து மேவுடேட்டாவைப் பயன்படுத்தவும்"

#. :src: bpy.types.RenderSettings.motion_blur_position
msgid "Motion Blur Position"
msgstr "இயக்க மங்கலான நிலை"

#. :src: bpy.types.RenderSettings.motion_blur_position
msgid ""
"Offset for the shutter's time interval, allows to change the motion blur "
"trails"
msgstr ""
"சட்டரின் நேர இடைவெளியில் ஆஃப்செட், மோசன் மங்கலான பாதைகளை மாற்ற அனுமதிக்கிறது"

#. :src: bpy.types.RenderSettings.motion_blur_position:'START'
msgid "Start on Frame"
msgstr "சட்டகத்தில் தொடங்கவும்"

#. :src: bpy.types.RenderSettings.motion_blur_position:'START'
msgid "The shutter opens at the current frame"
msgstr "சட்டர் தற்போதைய சட்டகத்தில் திறக்கிறது"

#. :src: bpy.types.RenderSettings.motion_blur_position:'CENTER'
msgid "Center on Frame"
msgstr "சட்டகத்தின் நடுவண்"

#. :src: bpy.types.RenderSettings.motion_blur_position:'CENTER'
msgid "The shutter is open during the current frame"
msgstr "தற்போதைய சட்டகத்தின் போது சட்டர் திறந்திருக்கும்"

#. :src: bpy.types.RenderSettings.motion_blur_position:'END'
msgid "End on Frame"
msgstr "சட்டகத்தில் முடிவு"

#. :src: bpy.types.RenderSettings.motion_blur_position:'END'
msgid "The shutter closes at the current frame"
msgstr "சட்டர் தற்போதைய சட்டகத்தில் மூடுகிறது"

#. :src: bpy.types.RenderSettings.motion_blur_shutter
#: source/blender/nodes/composite/nodes/node_composite_mask.cc:55
#: source/blender/nodes/composite/nodes/node_composite_planetrackdeform.cc:92
#: source/blender/nodes/composite/nodes/node_composite_vec_blur.cc:54
msgid "Shutter"
msgstr "சட்டர்"

#. :src: bpy.types.RenderSettings.motion_blur_shutter
msgid "Time taken in frames between shutter open and close"
msgstr ""
"சட்டருக்கு இடையில் பிரேம்களில் எடுக்கப்பட்ட நேரம் திறந்த மற்றும் நெருக்கமான"

#. :src: bpy.types.RenderSettings.motion_blur_shutter_curve
msgid "Curve defining the shutter's openness over time"
msgstr "காலப்போக்கில் சட்டரின் திறந்த தன்மையை வரையறுக்கும் வளைவு"

#. :src: bpy.types.RenderSettings.pixel_aspect_x
msgid "Pixel Aspect X"
msgstr "படப்புள்ளி நற்பொருத்தம் ஃச்"

#. :src: bpy.types.RenderSettings.pixel_aspect_x
msgid "Horizontal aspect ratio - for anamorphic or non-square pixel output"
msgstr ""
"கிடைமட்ட விகித விகிதம் - அனமார்பிக் அல்லது சதுரமற்ற படப்புள்ளி "
"வெளியீட்டிற்கு"

#. :src: bpy.types.RenderSettings.pixel_aspect_y
msgid "Pixel Aspect Y"
msgstr "படப்புள்ளி நற்பொருத்தம் ஒய்"

#. :src: bpy.types.RenderSettings.pixel_aspect_y
msgid "Vertical aspect ratio - for anamorphic or non-square pixel output"
msgstr ""
"செங்குத்து விகித விகிதம் - அனமார்பிக் அல்லது சதுரமற்ற படப்புள்ளி "
"வெளியீட்டிற்கு"

#. :src: bpy.types.RenderSettings.ppm_base
msgid "PPM Base"
msgstr "பிபிஎம் அடிப்படை"

#. :src: bpy.types.RenderSettings.ppm_base
msgid "The base unit for pixels per meter."
msgstr "ஒரு மீட்டருக்கு பிக்சல்களுக்கான அடிப்படை அலகு."

#. :src: bpy.types.RenderSettings.ppm_factor
msgid "PPM Factor"
msgstr "பிபிஎம் காரணி"

#. :src: bpy.types.RenderSettings.ppm_factor
msgid ""
"The pixel density meta-data written to supported image formats. This value "
"is multiplied by the PPM-base which defines the unit (typically inches or "
"meters)"
msgstr ""
"படப்புள்ளி அடர்த்தி மெட்டா-தரவு உதவி பட வடிவங்களுக்கு எழுதப்பட்டது. இந்த "
"மதிப்பு பிபிஎம்-பேசால் பெருக்கப்படுகிறது, இது அலகு வரையறுக்கிறது (பொதுவாக "
"அங்குலங்கள் அல்லது மீட்டர்)"

#. :src: bpy.types.RenderSettings.preview_pixel_size
#: scripts/addons_core/cycles/ui.py:948
#: scripts/startup/bl_ui/properties_render.py:847
msgid "Pixel Size"
msgstr "படப்புள்ளி அளவு"

#. :src: bpy.types.RenderSettings.preview_pixel_size
msgid "Pixel size for viewport rendering"
msgstr "வியூபோர்ட் ரெண்டரிங்கிற்கான படப்புள்ளி அளவு"

#. :src: bpy.types.RenderSettings.preview_pixel_size:'AUTO'
msgid "Automatic pixel size, depends on the user interface scale"
msgstr "தானியங்கி படப்புள்ளி அளவு, பயனர் இடைமுக அளவைப் பொறுத்தது"

#. :src: bpy.types.RenderSettings.preview_pixel_size:'1'
msgid "1×"
msgstr "1 ×"

#. :src: bpy.types.RenderSettings.preview_pixel_size:'1'
msgid "Render at full resolution"
msgstr "முழு தெளிவுத்திறனில் வழங்கவும்"

#. :src: bpy.types.RenderSettings.preview_pixel_size:'2'
msgid "Render at 50% resolution"
msgstr "50% தெளிவுத்திறனில் வழங்கவும்"

#. :src: bpy.types.RenderSettings.preview_pixel_size:'4'
msgid "Render at 25% resolution"
msgstr "25% தெளிவுத்திறனில் வழங்கவும்"

#. :src: bpy.types.RenderSettings.preview_pixel_size:'8'
msgid "Render at 12.5% resolution"
msgstr "12.5% தீர்மானத்தில் வழங்கவும்"

#. :src: bpy.types.RenderSettings.resolution_percentage
#: scripts/startup/bl_ui/space_userpref.py:212
msgid "Resolution Scale"
msgstr "தெளிவுத்திறன் அளவு"

#. :src: bpy.types.RenderSettings.resolution_percentage
msgid "Percentage scale for render resolution"
msgstr "வழங்கல் தெளிவுத்திறனுக்கான சதவீத அளவு"

#. :src: bpy.types.RenderSettings.resolution_x
msgid "Number of horizontal pixels in the rendered image"
msgstr "வழங்கப்பட்ட படத்தில் கிடைமட்ட பிக்சல்களின் எண்ணிக்கை"

#. :src: bpy.types.RenderSettings.resolution_y
msgid "Number of vertical pixels in the rendered image"
msgstr "வழங்கப்பட்ட படத்தில் செங்குத்து பிக்சல்களின் எண்ணிக்கை"

#. :src: bpy.types.RenderSettings.sequencer_gl_preview
msgid "Sequencer Preview Shading"
msgstr "சீக்வென்சர் முன்னோட்டம் நிழல்"

#. :src: bpy.types.RenderSettings.sequencer_gl_preview
msgid "Display method used in the sequencer view"
msgstr "சீக்வென்சர் பார்வையில் பயன்படுத்தப்படும் காட்சி முறை"

#. :src: bpy.types.RenderSettings.sequencer_gl_preview:'WIREFRAME'
#. :src: bpy.types.View3DShading.type:'WIREFRAME'
msgid "Display only edges of geometry without surface shading"
msgstr "மேற்பரப்பு நிழல் இல்லாமல் வடிவவியலின் விளிம்புகளை மட்டுமே காண்பி"

#. :src: bpy.types.RenderSettings.sequencer_gl_preview:'SOLID'
#. :src: bpy.types.View3DShading.type:'SOLID'
msgid "Display objects with flat lighting and basic surface shading"
msgstr ""
"தட்டையான விளக்குகள் மற்றும் அடிப்படை மேற்பரப்பு நிழல் கொண்ட பொருள்களைக் "
"காண்பி"

#. :src: bpy.types.RenderSettings.sequencer_gl_preview:'MATERIAL'
#. :src: bpy.types.View3DShading.type:'MATERIAL'
msgid "Preview materials using predefined environment lights"
msgstr ""
"முன் வரையறுக்கப்பட்ட சூழல் விளக்குகளைப் பயன்படுத்தி பொருட்களை "
"முன்னோட்டமிடுங்கள்"

#. :src: bpy.types.RenderSettings.sequencer_gl_preview:'RENDERED'
#. :src: bpy.types.View3DShading.type:'RENDERED'
msgid "Preview the final scene using the active render engine"
msgstr ""
"ஆக்டிவ் வழங்குதல் எஞ்சினைப் பயன்படுத்தி இறுதிக் காட்சியை முன்னோட்டமிடுங்கள்"

#. :src: bpy.types.RenderSettings.simplify_child_particles
#. :src: bpy.types.RenderSettings.simplify_child_particles_render
msgid "Simplify Child Particles"
msgstr "குழந்தை துகள்களை எளிதாக்குங்கள்"

#. :src: bpy.types.RenderSettings.simplify_child_particles
msgid "Global child particles percentage"
msgstr "உலகளாவிய குழந்தை துகள்கள் விழுக்காடு"

#. :src: bpy.types.RenderSettings.simplify_child_particles_render
msgid "Global child particles percentage during rendering"
msgstr "வழங்குதல் போது உலகளாவிய குழந்தை துகள்கள் விழுக்காடு"

#. :src: bpy.types.RenderSettings.simplify_gpencil
msgid "Simplify Grease Pencil drawing"
msgstr "பசை எழுதுகோல் வரைபடத்தை எளிதாக்குங்கள்"

#. :src: bpy.types.RenderSettings.simplify_gpencil_antialiasing
#. :src: bpy.types.ShaderFxPixel.use_antialiasing
msgid "Antialiasing"
msgstr "ஆன்டிலிசிங்"

#. :src: bpy.types.RenderSettings.simplify_gpencil_antialiasing
msgid "Use Antialiasing to smooth stroke edges"
msgstr "மென்மையான வீச்சு விளிம்புகளுக்கு ஆன்டியாலியாசிங்கைப் பயன்படுத்தவும்"

#. :src: bpy.types.RenderSettings.simplify_gpencil_modifier
msgid "Display modifiers"
msgstr "மாற்றியமைப்பாளர்களைக் காண்பி"

#. :src: bpy.types.RenderSettings.simplify_gpencil_onplay
msgid "Playback Only"
msgstr "பின்னணி மட்டுமே"

#. :src: bpy.types.RenderSettings.simplify_gpencil_onplay
msgid "Simplify Grease Pencil only during animation playback"
msgstr "அனிமேசன் பிளேபேக்கின் போது மட்டுமே பசை எழுதுகோலை எளிதாக்குங்கள்"

#. :src: bpy.types.RenderSettings.simplify_gpencil_shader_fx
msgid "Display Shader Effects"
msgstr "சேடர் விளைவுகளைக் காண்பி"

#. :src: bpy.types.RenderSettings.simplify_gpencil_tint
msgid "Layers Tinting"
msgstr "அடுக்குகள் சாயல்"

#. :src: bpy.types.RenderSettings.simplify_gpencil_tint
msgid "Display layer tint"
msgstr "அடுக்கு அடுக்கு காட்சி"

#. :src: bpy.types.RenderSettings.simplify_gpencil_view_fill
msgid "Display fill strokes in the viewport"
msgstr "வியூபோர்ட்டில் நிரப்பு வீச்சுகள்"

#. :src: bpy.types.RenderSettings.simplify_subdivision
#. :src: bpy.types.RenderSettings.simplify_subdivision_render
msgid "Simplify Subdivision"
msgstr "துணைப்பிரிவை எளிதாக்குங்கள்"

#. :src: bpy.types.RenderSettings.simplify_subdivision
msgid "Global maximum subdivision level"
msgstr "உலகளாவிய அதிகபட்ச துணைப்பிரிவு நிலை"

#. :src: bpy.types.RenderSettings.simplify_subdivision_render
msgid "Global maximum subdivision level during rendering"
msgstr "வழங்குதல் போது உலகளாவிய அதிகபட்ச துணைப்பிரிவு நிலை"

#. :src: bpy.types.RenderSettings.simplify_volumes
msgid "Simplify Volumes"
msgstr "தொகுதிகளை எளிதாக்குங்கள்"

#. :src: bpy.types.RenderSettings.simplify_volumes
msgid "Resolution percentage of volume objects in viewport"
msgstr "வியாபோர்ட்டில் தொகுதி பொருள்களின் தீர்மானம் விழுக்காடு"

#. :src: bpy.types.RenderSettings.stamp_background
msgid "Color to use behind stamp text"
msgstr "முத்திரை உரையின் பின்னால் பயன்படுத்த வண்ணம்"

#. :src: bpy.types.RenderSettings.stamp_font_size
msgid "Size of the font used when rendering stamp text"
msgstr ""
"முத்திரை உரையை வழங்குதல் செய்யும் போது பயன்படுத்தப்படும் எழுத்துருவின் அளவு"

#. :src: bpy.types.RenderSettings.stamp_foreground
msgid "Text Color"
msgstr "உரை நிறம்"

#. :src: bpy.types.RenderSettings.stamp_foreground
msgid "Color to use for stamp text"
msgstr "முத்திரை உரைக்கு பயன்படுத்த வண்ணம்"

#. :src: bpy.types.RenderSettings.stamp_note_text
msgid "Stamp Note Text"
msgstr "முத்திரை குறிப்பு உரை"

#. :src: bpy.types.RenderSettings.stamp_note_text
msgid "Custom text to appear in the stamp note"
msgstr "முத்திரைக் குறிப்பில் தோன்றும் தனிப்பயன் உரை"

#. :src: bpy.types.RenderSettings.stereo_views
#. :src: bpy.types.RenderSettings.views
#. :src: bpy.types.RenderViews
msgid "Render Views"
msgstr "காட்சிகளை வழங்கவும்"

#. :src: bpy.types.RenderSettings.threads
msgid ""
"Maximum number of CPU cores to use simultaneously while rendering (for "
"multi-core/CPU systems)"
msgstr ""
"வழங்குதல் போது ஒரே நேரத்தில் பயன்படுத்த அதிகபட்ச சிபியு கோர்களின் எண்ணிக்கை "
"(மல்டி கோர்/சிபியு அமைப்புகளுக்கு)"

#. :src: bpy.types.RenderSettings.threads_mode
msgid "Threads Mode"
msgstr "நூல்கள் பயன்முறை"

#. :src: bpy.types.RenderSettings.threads_mode
msgid "Determine the amount of render threads used"
msgstr "பயன்படுத்தப்படும் வழங்குதல் நூல்களின் அளவை தீர்மானிக்கவும்"

#. :src: bpy.types.RenderSettings.threads_mode:'AUTO'
msgid "Auto-Detect"
msgstr "தானாக கண்டறியவும்"

#. :src: bpy.types.RenderSettings.threads_mode:'AUTO'
msgid "Automatically determine the number of threads, based on CPUs"
msgstr "சிபியு களின் அடிப்படையில் நூல்களின் எண்ணிக்கையை தானாக தீர்மானிக்கவும்"

#. :src: bpy.types.RenderSettings.threads_mode:'FIXED'
msgid "Manually determine the number of threads"
msgstr "நூல்களின் எண்ணிக்கையை கைமுறையாக தீர்மானிக்கவும்"

#. :src: bpy.types.RenderSettings.use_bake_clear
msgid "Clear Images before baking"
msgstr "பேக்கிங் முன் படங்களை அழிக்கவும்"

#. :src: bpy.types.RenderSettings.use_bake_lores_mesh
msgid "Low Resolution Mesh"
msgstr "குறைந்த தெளிவுத்திறன் கண்ணி"

#. :src: bpy.types.RenderSettings.use_bake_lores_mesh
msgid "Calculate heights against unsubdivided low resolution mesh"
msgstr ""
"கட்டுப்பாடற்ற குறைந்த தெளிவுத்திறன் கண்ணுக்கு எதிராக உயரங்களைக் "
"கணக்கிடுங்கள்"

#. :src: bpy.types.RenderSettings.use_bake_multires
msgid "Bake from Multires"
msgstr "மல்டீசிலிருந்து சுட்டுக்கொள்ளுங்கள்"

#. :src: bpy.types.RenderSettings.use_bake_multires
msgid "Bake directly from multires object"
msgstr "மல்டைர் பொருளிலிருந்து நேரடியாக சுட்டுக்கொள்ளுங்கள்"

#. :src: bpy.types.RenderSettings.use_bake_user_scale
msgid "User Scale"
msgstr "பயனர் அளவு"

#. :src: bpy.types.RenderSettings.use_bake_user_scale
msgid "Use a user scale for the derivative map"
msgstr "வழித்தோன்றல் வரைபடத்திற்கு பயனர் அளவைப் பயன்படுத்தவும்"

#. :src: bpy.types.RenderSettings.use_border
#. :src: bpy.types.SpaceView3D.use_render_border
#. :src: bpy.types.SpaceImageOverlay.show_render_size
msgid "Render Region"
msgstr "மண்டலம் வழங்கவும்"

#. :src: bpy.types.RenderSettings.use_border
msgid "Render a user-defined render region, within the frame size"
msgstr "பிரேம் அளவிற்குள் பயனர் வரையறுக்கப்பட்ட வழங்குதல் மண்டலத்தை வழங்கவும்"

#. :src: bpy.types.RenderSettings.use_compositing
msgid ""
"Process the render result through the compositing pipeline, if a compositing"
" node group is assigned to the scene"
msgstr ""
"காட்சிக்கு ஒரு கலவையான முனை குழு நியமிக்கப்பட்டால், இசையமைக்கும் குழாய் "
"மூலம் வழங்குதல் முடிவை செயலாக்கவும்"

#. :src: bpy.types.RenderSettings.use_crop_to_border
msgid "Crop to Render Region"
msgstr "மண்டலத்தை வழங்க பயிர்"

#. :src: bpy.types.RenderSettings.use_crop_to_border
msgid "Crop the rendered frame to the defined render region size"
msgstr "வரையறுக்கப்பட்ட வழங்குதல் மண்டல அளவிற்கு வழங்கப்பட்ட சட்டகத்தை பயிர்"

#. :src: bpy.types.RenderSettings.use_file_extension
msgid ""
"Add the file format extensions to the rendered file name (eg: filename + "
".jpg)"
msgstr ""
"வழங்கப்பட்ட கோப்பு பெயரில் கோப்பு வடிவமைப்பு நீட்டிப்புகளைச் சேர்க்கவும் "
"(எ.கா.: கோப்பு பெயர் + .jpg)"

#. :src: bpy.types.RenderSettings.use_freestyle
msgid "Use Freestyle"
msgstr "ஃப்ரீபாணி பயன்படுத்தவும்"

#. :src: bpy.types.RenderSettings.use_freestyle
msgid "Draw stylized strokes using Freestyle"
msgstr "ஃப்ரீச்டைலைப் பயன்படுத்தி பகட்டான வீச்சுகள் வரையவும்"

#. :src: bpy.types.RenderSettings.use_high_quality_normals
msgid "Use high quality tangent space at the cost of lower performance"
msgstr ""
"குறைந்த செயல்திறன் செலவில் உயர் தரமான தொடுகோடு இடத்தைப் பயன்படுத்தவும்"

#. :src: bpy.types.RenderSettings.use_lock_interface
#: scripts/startup/bl_ui/space_topbar.py:478
msgid "Lock Interface"
msgstr "பூட்டு இடைமுகம்"

#. :src: bpy.types.RenderSettings.use_lock_interface
msgid ""
"Lock interface during rendering in favor of giving more memory to the "
"renderer"
msgstr ""
"ரெண்டரருக்கு அதிக நினைவகத்தை வழங்குவதற்கு ஆதரவாக வழங்குதல் செய்யும் போது "
"பூட்டு இடைமுகம்"

#. :src: bpy.types.RenderSettings.use_motion_blur
msgid "Use multi-sampled 3D scene motion blur"
msgstr "பல மாதிரி 3 டி காட்சி மோசன் மங்கலைப் பயன்படுத்தவும்"

#. :src: bpy.types.RenderSettings.use_multiview
msgid "Use multiple views in the scene"
msgstr "காட்சியில் பல காட்சிகளைப் பயன்படுத்துங்கள்"

#. :src: bpy.types.RenderSettings.use_overwrite
msgid "Overwrite existing files while rendering"
msgstr "வழங்குதல் செய்யும் போது இருக்கும் கோப்புகளை மேலெழுதவும்"

#. :src: bpy.types.RenderSettings.use_persistent_data
#: scripts/addons_core/cycles/ui.py:931
msgid "Persistent Data"
msgstr "தொடர்ச்சியான தரவு"

#. :src: bpy.types.RenderSettings.use_persistent_data
msgid ""
"Keep render data around for faster re-renders and animation renders, at the "
"cost of increased memory usage"
msgstr ""
"அதிகரித்த நினைவக பயன்பாட்டின் செலவில், வேகமான மறு ரெண்டர்கள் மற்றும் "
"அனிமேசன் ரெண்டர்களுக்கான தரவை வழங்கவும்"

#. :src: bpy.types.RenderSettings.use_placeholder
msgid "Placeholders"
msgstr "இடம் வைத்திருப்பவர்கள்"

#. :src: bpy.types.RenderSettings.use_placeholder
msgid ""
"Create empty placeholder files while rendering frames (similar to Unix "
"'touch')"
msgstr ""
"பிரேம்களை வழங்குதல் செய்யும் போது வெற்று ஒதுக்கிடக் கோப்புகளை உருவாக்கவும் "
"(யூனிக்ச் 'டச்' போன்றது)"

#. :src: bpy.types.RenderSettings.use_render_cache
msgid "Cache Result"
msgstr "கேச் முடிவு"

#. :src: bpy.types.RenderSettings.use_render_cache
msgid ""
"Save render cache to EXR files (useful for heavy compositing, Note: affects "
"indirectly rendered scenes)"
msgstr ""
"எக்ச்ஆர் கோப்புகளுக்கு வழங்குதல் கேச் சேமிக்கவும் (கனமான தொகுப்புக்கு "
"பயனுள்ளதாக இருக்கும், குறிப்பு: மறைமுகமாக வழங்கப்பட்ட காட்சிகளை பாதிக்கிறது)"

#. :src: bpy.types.RenderSettings.use_sequencer
msgid ""
"Process the render (and composited) result through the video sequence editor"
" pipeline, if sequencer strips exist"
msgstr ""
