#. :src: bpy.types.GREASE_PENCIL_OT_erase_lasso
msgctxt "Operator"
msgid "Grease Pencil Erase Lasso"
msgstr "கிரீச் பென்சில் லாசோவை அழிக்கிறது"

#. :src: bpy.types.GREASE_PENCIL_OT_erase_lasso
msgid "Erase points in the lasso region"
