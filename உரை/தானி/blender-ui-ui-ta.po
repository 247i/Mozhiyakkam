#. :src: bpy.types.Modifier.persistent_uid
msgid ""
"Uniquely identifies the modifier within the modifier stack that it is part "
"of"
msgstr "மாற்றியமைப்பாளரை மாற்றியமைக்கும் அடுக்குக்குள் அது ஒரு பகுதியாகும்"

#. :src: bpy.types.Modifier.show_expanded
msgid "Set modifier expanded in the user interface"
msgstr "பயனர் இடைமுகத்தில் மாற்றப்பட்ட மாற்றி"

#. :src: bpy.types.Modifier.show_in_editmode
msgid "Display modifier in Edit mode"
msgstr "திருத்து பயன்முறையில் மாற்றியமைப்பைக் காண்பி"

#. :src: bpy.types.Modifier.show_on_cage
msgid "On Cage"
msgstr "கூண்டில்"

#. :src: bpy.types.Modifier.show_on_cage
msgid "Adjust edit cage to modifier result"
msgstr "மாற்றியமைக்கும் முடிவுக்கு கூண்டைத் திருத்து சரிசெய்யவும்"

#. :src: bpy.types.Modifier.show_render
msgid "Use modifier during render"
msgstr "ரெண்டரின் போது மாற்றியமைப்பைப் பயன்படுத்தவும்"

#. :src: bpy.types.Modifier.show_viewport
msgid "Display modifier in viewport"
msgstr "வியூபோர்ட்டில் மாற்றியமைப்பைக் காண்பி"

#. :src: bpy.types.Modifier.type:'GREASE_PENCIL_VERTEX_WEIGHT_PROXIMITY'
#. :src: bpy.types.Modifier.type:'VERTEX_WEIGHT_PROXIMITY'
#. :src:
#. bpy.types.OBJECT_OT_modifier_add.type:'GREASE_PENCIL_VERTEX_WEIGHT_PROXIMITY'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'VERTEX_WEIGHT_PROXIMITY'
msgid "Vertex Weight Proximity"
msgstr "வெர்டெக்ச் எடை அருகாமை"

#. :src: bpy.types.Modifier.type:'GREASE_PENCIL_VERTEX_WEIGHT_PROXIMITY'
#. :src:
#. bpy.types.OBJECT_OT_modifier_add.type:'GREASE_PENCIL_VERTEX_WEIGHT_PROXIMITY'
msgid "Generate vertex weights based on distance to object"
msgstr "பொருளின் தூரத்தின் அடிப்படையில் வெர்டெக்ச் எடைகளை உருவாக்குங்கள்"

#. :src: bpy.types.Modifier.type:'DATA_TRANSFER'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'DATA_TRANSFER'
msgid "Data Transfer"
msgstr "தரவு பரிமாற்ற"

#. :src: bpy.types.Modifier.type:'DATA_TRANSFER'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'DATA_TRANSFER'
msgid ""
"Transfer several types of data (vertex groups, UV maps, vertex colors, "
"custom normals) from one mesh to another"
msgstr ""
"பல வகையான தரவுகளை (வெர்டெக்ச் குழுக்கள், புறஊதா வரைபடங்கள், வெர்டெக்ச் "
"வண்ணங்கள், தனிப்பயன் இயல்புகள்) ஒரு கண்ணி இருந்து இன்னொரு இடத்திற்கு "
"மாற்றவும்"

#. :src: bpy.types.Modifier.type:'MESH_CACHE'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'MESH_CACHE'
msgid "Mesh Cache"
msgstr "கண்ணி கேச்"

#. :src: bpy.types.Modifier.type:'MESH_CACHE'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'MESH_CACHE'
msgid ""
"Deform the mesh using an external frame-by-frame vertex transform cache"
msgstr ""
"வெளிப்புற பிரேம்-பை-பிரேம் வெர்டெக்ச் டிரான்ச்ஃபார்ம் கேச் பயன்படுத்தி கண்ணி"
" சிதைக்கவும்"

#. :src: bpy.types.Modifier.type:'MESH_SEQUENCE_CACHE'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'MESH_SEQUENCE_CACHE'
msgid "Mesh Sequence Cache"
msgstr "கண்ணி வரிசை தற்காலிக சேமிப்பு"

#. :src: bpy.types.Modifier.type:'MESH_SEQUENCE_CACHE'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'MESH_SEQUENCE_CACHE'
msgid ""
"Deform the mesh or curve using an external mesh cache in Alembic format"
msgstr ""
"அலெம்பிக் வடிவத்தில் வெளிப்புற கண்ணி தற்காலிக சேமிப்பைப் பயன்படுத்தி கண்ணி "
"அல்லது வளைவை சிதைக்கவும்"

#. :src: bpy.types.Modifier.type:'NORMAL_EDIT'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'NORMAL_EDIT'
msgid "Normal Edit"
msgstr "சாதாரண திருத்து"

#. :src: bpy.types.Modifier.type:'NORMAL_EDIT'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'NORMAL_EDIT'
msgid "Modify the direction of the surface normals"
msgstr "மேற்பரப்பு இயல்புகளின் திசையை மாற்றவும்"

#. :src: bpy.types.Modifier.type:'WEIGHTED_NORMAL'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'WEIGHTED_NORMAL'
msgid "Weighted Normal"
msgstr "சாதாரணமானது"

#. :src: bpy.types.Modifier.type:'WEIGHTED_NORMAL'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'WEIGHTED_NORMAL'
msgid "Modify the direction of the surface normals using a weighting method"
msgstr ""
"ஒரு எடையுள்ள முறையைப் பயன்படுத்தி மேற்பரப்பு இயல்புகளின் திசையை மாற்றவும்"

#. :src: bpy.types.Modifier.type:'UV_PROJECT'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'UV_PROJECT'
msgid "UV Project"
msgstr "புறஊதா திட்டம்"

#. :src: bpy.types.Modifier.type:'UV_PROJECT'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'UV_PROJECT'
msgid ""
"Project the UV map coordinates from the negative Z axis of another object"
msgstr ""
"மற்றொரு பொருளின் எதிர்மறை சட் அச்சிலிருந்து புறஊதா வரைபடம் ஒருங்கிணைக்கிறது"

#. :src: bpy.types.Modifier.type:'UV_WARP'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'UV_WARP'
msgid "UV Warp"
msgstr "புறஊதா வார்ப்"

#. :src: bpy.types.Modifier.type:'UV_WARP'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'UV_WARP'
msgid "Transform the UV map using the difference between two objects"
msgstr ""
"இரண்டு பொருள்களுக்கு இடையிலான வேறுபாட்டைப் பயன்படுத்தி புறஊதா வரைபடத்தை "
"மாற்றவும்"

#. :src: bpy.types.Modifier.type:'VERTEX_WEIGHT_EDIT'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'VERTEX_WEIGHT_EDIT'
msgid "Vertex Weight Edit"
msgstr "வெர்டெக்ச் எடை திருத்து"

#. :src: bpy.types.Modifier.type:'VERTEX_WEIGHT_EDIT'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'VERTEX_WEIGHT_EDIT'
msgid "Modify of the weights of a vertex group"
msgstr "ஒரு வெர்டெக்ச் குழுவின் எடைகளை மாற்றியமைத்தல்"

#. :src: bpy.types.Modifier.type:'VERTEX_WEIGHT_MIX'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'VERTEX_WEIGHT_MIX'
msgid "Vertex Weight Mix"
msgstr "வெர்டெக்ச் எடை கலவை"

#. :src: bpy.types.Modifier.type:'VERTEX_WEIGHT_MIX'
#. :src: bpy.types.VertexWeightMixModifier
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'VERTEX_WEIGHT_MIX'
msgid "Mix the weights of two vertex groups"
msgstr "இரண்டு வெர்டெக்ச் குழுக்களின் எடையை கலக்கவும்"

#. :src: bpy.types.Modifier.type:'VERTEX_WEIGHT_PROXIMITY'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'VERTEX_WEIGHT_PROXIMITY'
msgid ""
"Set the vertex group weights based on the distance to another target object"
msgstr ""
"மற்றொரு இலக்கு பொருளின் தூரத்தின் அடிப்படையில் வெர்டெக்ச் குழு எடைகளை "
"அமைக்கவும்"

#. :src: bpy.types.Modifier.type:'GREASE_PENCIL_COLOR'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'GREASE_PENCIL_COLOR'
msgid "Hue/Saturation"
msgstr "சாயல்/செறிவு"

#. :src: bpy.types.Modifier.type:'GREASE_PENCIL_COLOR'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'GREASE_PENCIL_COLOR'
msgid "Change hue/saturation/value of the strokes"
msgstr "பக்கவாதங்களின் சாயல்/செறிவு/மதிப்பை மாற்றவும்"

#. :src: bpy.types.Modifier.type:'GREASE_PENCIL_TINT'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'GREASE_PENCIL_TINT'
msgid "Tint the color of the strokes"
msgstr "பக்கவாதம் வண்ணம்"

#. :src: bpy.types.Modifier.type:'GREASE_PENCIL_OPACITY'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'GREASE_PENCIL_OPACITY'
msgid "Change the opacity of the strokes"
msgstr "பக்கவாதங்களின் ஒளிபுகாநிலையை மாற்றவும்"

#. :src: bpy.types.Modifier.type:'GREASE_PENCIL_VERTEX_WEIGHT_ANGLE'
#. :src:
#. bpy.types.OBJECT_OT_modifier_add.type:'GREASE_PENCIL_VERTEX_WEIGHT_ANGLE'
msgid "Vertex Weight Angle"
msgstr "வெர்டெக்ச் எடை கோணம்"

#. :src: bpy.types.Modifier.type:'GREASE_PENCIL_VERTEX_WEIGHT_ANGLE'
#. :src:
#. bpy.types.OBJECT_OT_modifier_add.type:'GREASE_PENCIL_VERTEX_WEIGHT_ANGLE'
msgid "Generate vertex weights based on stroke angle"
msgstr "பக்கவாதம் கோணத்தின் அடிப்படையில் வெர்டெக்ச் எடைகளை உருவாக்குங்கள்"

#. :src: bpy.types.Modifier.type:'GREASE_PENCIL_TIME'
#. :src: bpy.types.WaveModifier.time_offset
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'GREASE_PENCIL_TIME'
msgid "Time Offset"
msgstr "நேரம் ஈடுசெய்யும்"

#. :src: bpy.types.Modifier.type:'GREASE_PENCIL_TIME'
#. :src: bpy.types.GreasePencilTimeModifier
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'GREASE_PENCIL_TIME'
msgid "Offset keyframes"
msgstr "கீக்ஃப்ரேம்களை ஆஃப்செட்"

#. :src: bpy.types.Modifier.type:'GREASE_PENCIL_TEXTURE'
#. :src: bpy.types.ShaderNodeTexBrick.texture_mapping
#. :src: bpy.types.ShaderNodeTexChecker.texture_mapping
#. :src: bpy.types.ShaderNodeTexEnvironment.texture_mapping
#. :src: bpy.types.ShaderNodeTexGabor.texture_mapping
#. :src: bpy.types.ShaderNodeTexGradient.texture_mapping
#. :src: bpy.types.ShaderNodeTexImage.texture_mapping
#. :src: bpy.types.ShaderNodeTexMagic.texture_mapping
#. :src: bpy.types.ShaderNodeTexNoise.texture_mapping
#. :src: bpy.types.ShaderNodeTexSky.texture_mapping
#. :src: bpy.types.ShaderNodeTexVoronoi.texture_mapping
#. :src: bpy.types.ShaderNodeTexWave.texture_mapping
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'GREASE_PENCIL_TEXTURE'
#. :src: bpy.types.NODE_PT_texture_mapping
#. :src: bpy.types.TexMapping
#: source/blender/modifiers/intern/MOD_volume_displace.cc:103
msgid "Texture Mapping"
msgstr "அமைப்பு மேப்பிங்"

#. :src: bpy.types.Modifier.type:'GREASE_PENCIL_TEXTURE'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'GREASE_PENCIL_TEXTURE'
msgid "Change stroke UV texture values"
msgstr "வீச்சு புறஊதா அமைப்பு மதிப்புகளை மாற்றவும்"

#. :src: bpy.types.Modifier.type:'ARRAY'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'ARRAY'
msgid "Create copies of the shape with offsets"
msgstr "ஆஃப்செட்களுடன் வடிவத்தின் நகல்களை உருவாக்கவும்"

#. :src: bpy.types.Modifier.type:'BEVEL'
#. :src: bpy.types.ShaderNodeBevel
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'BEVEL'
#. :src: bpy.types.DATA_PT_geometry_curve_bevel
#: scripts/startup/bl_ui/space_view3d.py:7221
#: source/blender/modifiers/intern/MOD_bevel.cc:455
msgid "Bevel"
msgstr "பெவல்"

#. :src: bpy.types.Modifier.type:'BEVEL'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'BEVEL'
msgid ""
"Generate sloped corners by adding geometry to the mesh's edges or vertices"
msgstr ""
"மெசின் விளிம்புகள் அல்லது செங்குத்துகளுக்கு வடிவவியலைச் சேர்ப்பதன் மூலம் "
"சாய்வான மூலைகளை உருவாக்குங்கள்"

#. :src: bpy.types.Modifier.type:'BOOLEAN'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'BOOLEAN'
msgid "Use another shape to cut, combine or perform a difference operation"
msgstr ""
"வித்தியாச செயல்பாட்டை வெட்ட, இணைக்க அல்லது செய்ய மற்றொரு வடிவத்தைப் "
"பயன்படுத்தவும்"

#. :src: bpy.types.Modifier.type:'BUILD'
#. :src: bpy.types.Modifier.type:'GREASE_PENCIL_BUILD'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'BUILD'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'GREASE_PENCIL_BUILD'
#: source/blender/modifiers/intern/MOD_build.cc:295
#: source/blender/modifiers/intern/MOD_grease_pencil_build.cc:843
msgid "Build"
msgstr "உருவாக்கு"

#. :src: bpy.types.Modifier.type:'BUILD'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'BUILD'
msgid ""
"Cause the faces of the mesh object to appear or disappear one after the "
"other over time"
msgstr ""
"கண்ணி பொருளின் முகங்கள் காலப்போக்கில் ஒன்றன் பின் ஒன்றாக தோன்றும் அல்லது "
"மறைந்துவிடும்"

#. :src: bpy.types.Modifier.type:'DECIMATE'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'DECIMATE'
#: source/blender/modifiers/intern/MOD_decimate.cc:275
msgid "Decimate"
msgstr "அழிவு"

#. :src: bpy.types.Modifier.type:'DECIMATE'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'DECIMATE'
msgid "Reduce the geometry density"
msgstr "வடிவியல் அடர்த்தியைக் குறைக்கவும்"

#. :src: bpy.types.Modifier.type:'EDGE_SPLIT'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'EDGE_SPLIT'
msgid "Edge Split"
msgstr "விளிம்பு பிளவு"

#. :src: bpy.types.Modifier.type:'EDGE_SPLIT'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'EDGE_SPLIT'
msgid "Split away joined faces at the edges"
msgstr "பிளவு விளிம்புகளில் இணைந்த முகங்கள்"

#. :src: bpy.types.Modifier.type:'NODES'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'NODES'
#: scripts/startup/bl_operators/geometry_nodes.py:36
#: scripts/startup/bl_operators/geometry_nodes.py:320
#: scripts/startup/bl_operators/geometry_nodes.py:341
#: source/blender/editors/space_buttons/buttons_texture.cc:211
msgid "Geometry Nodes"
msgstr "வடிவியல் முனைகள்"

#. :src: bpy.types.Modifier.type:'MASK'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'MASK'
msgid "Dynamically hide vertices based on a vertex group or armature"
msgstr ""
"ஒரு வெர்டெக்ச் குழு அல்லது ஆர்மேச்சரின் அடிப்படையில் செங்குத்துகளை மாறும்"

#. :src: bpy.types.Modifier.type:'MIRROR'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'MIRROR'
msgid "Mirror along the local X, Y and/or Z axes, over the object origin"
msgstr ""
"உள்ளக ஃச், ஒய் மற்றும்/அல்லது சட் அச்சுகளுடன், பொருள் தோற்றத்திற்கு மேல் "
"கண்ணாடி"

#. :src: bpy.types.Modifier.type:'MESH_TO_VOLUME'
#. :src: bpy.types.GeometryNodeMeshToVolume
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'MESH_TO_VOLUME'
#: source/blender/modifiers/intern/MOD_mesh_to_volume.cc:188
msgid "Mesh to Volume"
msgstr "மெச் டு தொகுதி"

#. :src: bpy.types.Modifier.type:'MULTIRES'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'MULTIRES'
msgid "Multiresolution"
msgstr "பன்முகத்தன்மை"

#. :src: bpy.types.Modifier.type:'MULTIRES'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'MULTIRES'
msgid ""
"Subdivide the mesh in a way that allows editing the higher subdivision "
"levels"
msgstr ""
"உயர் உட்பிரிவு நிலைகளைத் திருத்த அனுமதிக்கும் வகையில் கண்ணி பிரிக்கவும்"

#. :src: bpy.types.Modifier.type:'REMESH'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'REMESH'
#. :src: bpy.types.DATA_PT_remesh
#. :src: bpy.types.VIEW3D_PT_sculpt_voxel_remesh
#: source/blender/editors/object/object_remesh.cc:1122
#: source/blender/modifiers/intern/MOD_remesh.cc:268
msgid "Remesh"
msgstr "ரமேச்"

#. :src: bpy.types.Modifier.type:'REMESH'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'REMESH'
msgid "Generate new mesh topology based on the current shape"
msgstr "தற்போதைய வடிவத்தின் அடிப்படையில் புதிய கண்ணி இடவியல் உருவாக்கவும்"

#. :src: bpy.types.Modifier.type:'SCREW'
#. :src: bpy.types.ScrewModifier.screw_offset
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'SCREW'
#: source/blender/modifiers/intern/MOD_screw.cc:1134
msgid "Screw"
msgstr "திருகு"

#. :src: bpy.types.Modifier.type:'SCREW'
#. :src: bpy.types.OBJECT_OT_modifier_add.type:'SCREW'
msgid "Lathe around an axis, treating the input mesh as a profile"
msgstr ""
