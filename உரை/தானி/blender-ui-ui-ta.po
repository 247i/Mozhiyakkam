msgstr "பிக்யூபிக்"

#. :src: bpy.types.MovieTrackingStabilization.filter_type:'BICUBIC'
msgid "High quality pixel interpolation"
msgstr "உயர் தரமான படப்புள்ளி இடைக்கணிப்பு"

#. :src: bpy.types.MovieTrackingStabilization.influence_location
msgid "Location Influence"
msgstr "இருப்பிட செல்வாக்கு"

#. :src: bpy.types.MovieTrackingStabilization.influence_location
msgid "Influence of stabilization algorithm on footage location"
msgstr "காட்சிகள் இருப்பிடத்தில் உறுதிப்படுத்தல் வழிமுறையின் தாக்கம்"

#. :src: bpy.types.MovieTrackingStabilization.influence_rotation
msgid "Rotation Influence"
msgstr "சுழற்சி செல்வாக்கு"

#. :src: bpy.types.MovieTrackingStabilization.influence_rotation
msgid "Influence of stabilization algorithm on footage rotation"
msgstr "காட்சிகள் சுழற்சியில் உறுதிப்படுத்தல் வழிமுறையின் தாக்கம்"

#. :src: bpy.types.MovieTrackingStabilization.influence_scale
msgid "Scale Influence"
msgstr "அளவிலான செல்வாக்கு"

#. :src: bpy.types.MovieTrackingStabilization.influence_scale
msgid "Influence of stabilization algorithm on footage scale"
msgstr "காட்சிகள் அளவில் உறுதிப்படுத்தல் வழிமுறையின் தாக்கம்"

#. :src: bpy.types.MovieTrackingStabilization.rotation_tracks
msgid "Rotation Tracks"
msgstr "சுழற்சி தடங்கள்"

#. :src: bpy.types.MovieTrackingStabilization.rotation_tracks
#. :src: bpy.types.MovieTrackingStabilization.tracks
msgid "Collection of tracks used for 2D stabilization (translation)"
msgstr ""
"2 டி உறுதிப்படுத்தலுக்கு பயன்படுத்தப்படும் தடங்களின் சேகரிப்பு "
"(மொழிபெயர்ப்பு)"

#. :src: bpy.types.MovieTrackingStabilization.scale_max
msgid "Maximal Scale"
msgstr "அதிகபட்ச அளவு"

#. :src: bpy.types.MovieTrackingStabilization.scale_max
msgid "Limit the amount of automatic scaling"
msgstr "தானியங்கி அளவிடுதலின் அளவைக் கட்டுப்படுத்துங்கள்"

#. :src: bpy.types.MovieTrackingStabilization.show_tracks_expanded
msgid "Show Tracks"
msgstr "தடங்களைக் காட்டு"

#. :src: bpy.types.MovieTrackingStabilization.show_tracks_expanded
msgid "Show UI list of tracks participating in stabilization"
msgstr "உறுதிப்படுத்தலில் பங்கேற்கும் தடங்களின் இடைமுகம் பட்டியலைக் காட்டு"

#. :src: bpy.types.MovieTrackingStabilization.target_position
msgid "Expected Position"
msgstr "எதிர்பார்க்கப்படும் நிலை"

#. :src: bpy.types.MovieTrackingStabilization.target_position
msgid ""
"Known relative offset of original shot, will be subtracted (e.g. for panning"
" shot, can be animated)"
msgstr ""
"அசல் சாட்டின் அறியப்பட்ட உறவினர் ஆஃப்செட் கழிக்கப்படும் (எ.கா. பானிங் "
"சாட்டுக்கு, அனிமேசன் செய்யப்படலாம்)"

#. :src: bpy.types.MovieTrackingStabilization.target_rotation
msgid "Expected Rotation"
msgstr "எதிர்பார்க்கப்படும் சுழற்சி"

#. :src: bpy.types.MovieTrackingStabilization.target_rotation
msgid ""
"Rotation present on original shot, will be compensated (e.g. for deliberate "
"tilting)"
msgstr "அசல் சாட்டில் சுழற்சி, ஈடுசெய்யப்படும் (எ.கா. வேண்டுமென்றே சாய்க்க)"

#. :src: bpy.types.MovieTrackingStabilization.target_scale
msgid "Expected Scale"
msgstr "எதிர்பார்க்கப்படும் அளவு"

#. :src: bpy.types.MovieTrackingStabilization.target_scale
msgid "Explicitly scale resulting frame to compensate zoom of original shot"
msgstr ""
"அசல் சாட்டின் பெரிதாக்கத்தை ஈடுசெய்ய வெளிப்படையாக அளவிடப்படும் சட்டகம்"

#. :src: bpy.types.MovieTrackingStabilization.tracks
msgid "Translation Tracks"
msgstr "மொழிபெயர்ப்பு தடங்கள்"

#. :src: bpy.types.MovieTrackingStabilization.use_2d_stabilization
msgid "Use 2D Stabilization"
msgstr "2 டி உறுதிப்படுத்தல் பயன்படுத்தவும்"

#. :src: bpy.types.MovieTrackingStabilization.use_2d_stabilization
msgid "Use 2D stabilization for footage"
msgstr "காட்சிகளுக்கு 2 டி உறுதிப்படுத்தல் பயன்படுத்தவும்"

#. :src: bpy.types.MovieTrackingStabilization.use_autoscale
msgid "Autoscale"
msgstr "ஆட்டோச்கேல்"

#. :src: bpy.types.MovieTrackingStabilization.use_autoscale
msgid "Automatically scale footage to cover unfilled areas when stabilizing"
msgstr ""
"உறுதிப்படுத்தும் போது நிரப்பப்படாத பகுதிகளை மறைக்க தானாக அளவிலான காட்சிகள்"

#. :src: bpy.types.MovieTrackingStabilization.use_stabilize_rotation
msgid "Stabilize Rotation"
msgstr "சுழற்சியை உறுதிப்படுத்தவும்"

#. :src: bpy.types.MovieTrackingStabilization.use_stabilize_rotation
msgid "Stabilize detected rotation around center of frame"
msgstr "சட்டத்தின் மையத்தை சுற்றி கண்டறியப்பட்ட சுழற்சியை உறுதிப்படுத்தவும்"

#. :src: bpy.types.MovieTrackingStabilization.use_stabilize_scale
msgid "Stabilize Scale"
msgstr "அளவை உறுதிப்படுத்தவும்"

#. :src: bpy.types.MovieTrackingStabilization.use_stabilize_scale
msgid "Compensate any scale changes relative to center of rotation"
msgstr ""
"சுழற்சியின் மையத்துடன் தொடர்புடைய எந்த அளவிலான மாற்றங்களையும் ஈடுசெய்க"

#. :src: bpy.types.MovieTrackingTrack
msgid "Movie tracking track data"
msgstr "மூவி டிராக் டிராக் தரவு"

#. :src: bpy.types.MovieTrackingTrack
msgid "Match-moving track data for tracking"
msgstr "கண்காணிப்புக்கான மேட்ச்-நகரும் தட தரவு"

#. :src: bpy.types.MovieTrackingTrack.annotation
msgid "Annotation data for this track"
msgstr "இந்த பாதைக்கான சிறுகுறிப்பு தரவு"

#. :src: bpy.types.MovieTrackingTrack.average_error
msgid "Average error of re-projection"
msgstr "மறு திட்டத்தின் சராசரி பிழை"

#. :src: bpy.types.MovieTrackingTrack.bundle
msgid "Position of bundle reconstructed from this track"
msgstr "இந்த பாதையில் இருந்து புனரமைக்கப்பட்ட மூட்டை நிலை"

#. :src: bpy.types.MovieTrackingTrack.color
msgid ""
"Color of the track in the Movie Clip Editor and the 3D viewport after a "
"solve"
msgstr ""
"மூவி கிளிப் திருத்தியில் பாதையின் நிறம் மற்றும் ஒரு தீர்க்கப்பட்ட பிறகு 3 டி"
" வியூபோர்ட்"

#. :src: bpy.types.MovieTrackingTrack.correlation_min
msgid ""
"Minimal value of correlation between matched pattern and reference that is "
"still treated as successful tracking"
msgstr ""
"பொருந்திய வடிவத்திற்கும் குறிப்புக்கும் இடையிலான தொடர்புகளின் குறைந்தபட்ச "
"மதிப்பு இன்னும் வெற்றிகரமான கண்காணிப்பாக கருதப்படுகிறது"

#. :src: bpy.types.MovieTrackingTrack.has_bundle
msgid "Has Bundle"
msgstr "மூட்டை உள்ளது"

#. :src: bpy.types.MovieTrackingTrack.has_bundle
msgid "True if track has a valid bundle"
msgstr "டிராக்கில் செல்லுபடியாகும் மூட்டை இருந்தால் உண்மை"

#. :src: bpy.types.MovieTrackingTrack.hide
msgid "Track is hidden"
msgstr "டிராக் மறைக்கப்பட்டுள்ளது"

#. :src: bpy.types.MovieTrackingTrack.lock
msgid "Track is locked and all changes to it are disabled"
msgstr ""
"ட்ராக் பூட்டப்பட்டுள்ளது மற்றும் அதன் அனைத்து மாற்றங்களும் முடக்கப்பட்டுள்ளன"

#. :src: bpy.types.MovieTrackingTrack.margin
msgid "Distance from image boundary at which marker stops tracking"
msgstr "மார்க்கர் கண்காணிப்பதை நிறுத்தும் பட எல்லையிலிருந்து தூரம்"

#. :src: bpy.types.MovieTrackingTrack.offset
msgid "Offset of track from the parenting point"
msgstr "பெற்றோருக்குரிய புள்ளியிலிருந்து பாதையின் ஆஃப்செட்"

#. :src: bpy.types.MovieTrackingTrack.select
msgid "Track is selected"
msgstr "டிராக் தேர்ந்தெடுக்கப்பட்டது"

#. :src: bpy.types.MovieTrackingTrack.select_anchor
msgid "Select Anchor"
msgstr "நங்கூரத்தைத் தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.MovieTrackingTrack.select_anchor
msgid "Track's anchor point is selected"
msgstr "டிராக்கின் நங்கூரம் புள்ளி தேர்ந்தெடுக்கப்பட்டது"

#. :src: bpy.types.MovieTrackingTrack.select_pattern
msgid "Select Pattern"
msgstr "வடிவத்தைத் தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.MovieTrackingTrack.select_pattern
msgid "Track's pattern area is selected"
msgstr "டிராக்கின் முறை பரப்பு தேர்ந்தெடுக்கப்பட்டுள்ளது"

#. :src: bpy.types.MovieTrackingTrack.select_search
msgid "Select Search"
msgstr "தேடலைத் தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.MovieTrackingTrack.select_search
msgid "Track's search area is selected"
msgstr "டிராக்கின் தேடல் பரப்பு தேர்ந்தெடுக்கப்பட்டது"

#. :src: bpy.types.MovieTrackingTrack.use_alpha_preview
msgid "Apply track's mask on displaying preview"
msgstr "முன்னோட்டத்தைக் காண்பிப்பதில் ட்ராக் முகமூடியைப் பயன்படுத்துங்கள்"

#. :src: bpy.types.MovieTrackingTrack.use_brute
msgid "Use a brute-force translation only pre-track before refinement"
msgstr ""
"சுத்திகரிப்புக்கு முன் மட்டுமே முன்-தடத்தை ஒரு முரட்டுத்தனமான-சக்தி "
"மொழிபெயர்ப்பைப் பயன்படுத்தவும்"

#. :src: bpy.types.MovieTrackingTrack.use_custom_color
#. :src: bpy.types.Node.use_custom_color
#: scripts/startup/bl_ui/properties_animviz.py:110
msgid "Custom Color"
msgstr "தனிப்பயன் நிறம்"

#. :src: bpy.types.MovieTrackingTrack.use_custom_color
msgid "Use custom color instead of theme-defined"
msgstr ""
"கருப்பொருள் வரையறுக்கப்பட்டதற்கு பதிலாக தனிப்பயன் வண்ணத்தைப் பயன்படுத்தவும்"

#. :src: bpy.types.MovieTrackingTrack.use_grayscale_preview
msgid "Display what the tracking algorithm sees in the preview"
msgstr "முன்னோட்டத்தில் கண்காணிப்பு வழிமுறை என்ன பார்க்கிறது என்பதைக் காண்பி"

#. :src: bpy.types.MovieTrackingTrack.weight
msgid "Influence of this track on a final solution"
msgstr "இறுதி தீர்வில் இந்த பாதையின் செல்வாக்கு"

#. :src: bpy.types.MovieTrackingTrack.weight_stab
msgid "Stab Weight"
msgstr "எடை"

#. :src: bpy.types.MovieTrackingTrack.weight_stab
msgid "Influence of this track on 2D stabilization"
msgstr "2 டி உறுதிப்படுத்தலில் இந்த பாதையின் செல்வாக்கு"

#. :src: bpy.types.MovieTrackingTracks.active
msgid ""
"Active track in this tracking data object. Deprecated, use "
"objects[name].tracks.active"
msgstr ""
"இந்த கண்காணிப்பு தரவு பொருளில் செயலில் தடம். நீக்கப்பட்டது, பொருள்களைப் "
"பயன்படுத்துங்கள் [பெயர்] .tracks.active"

#. :src: bpy.types.NDOFMotionEventData
msgid "NDOF Motion Data"
msgstr "NDOF இயக்க தரவு"

#. :src: bpy.types.NDOFMotionEventData
msgid "NDOF motion data for window manager events"
msgstr "சாளர மேலாளர் நிகழ்வுகளுக்கான NDOF இயக்க தரவு"

#. :src: bpy.types.NDOFMotionEventData.progress
msgid "Progress"
msgstr "முன்னேற்றம்"

#. :src: bpy.types.NDOFMotionEventData.progress
msgid "Indicates the gesture phase"
msgstr "சைகை கட்டத்தைக் குறிக்கிறது"

#. :src: bpy.types.NDOFMotionEventData.progress:'STARTING'
msgid "Starting"
msgstr "தொடங்குகிறது"

#. :src: bpy.types.NDOFMotionEventData.progress:'IN_PROGRESS'
msgid "In progress"
msgstr "முன்னேற்றத்தில் உள்ளது"

#. :src: bpy.types.NDOFMotionEventData.progress:'FINISHING'
msgid "Finishing"
msgstr "முடித்தல்"

#. :src: bpy.types.NDOFMotionEventData.rotation
msgid ""
"Axis-angle rotation of this motion event. The vector magnitude is the angle "
"where 1.0 represents 360 degrees. The angle is typically scaled by the time-"
"delta before use."
msgstr ""
"இந்த இயக்க நிகழ்வின் அச்சு-கோண சுழற்சி. திசையன் அளவு என்பது 1.0 360 "
"டிகிரியைக் குறிக்கும் கோணம். கோணம் பொதுவாக பயன்பாட்டிற்கு முன் "
"நேர-டெல்டாவால் அளவிடப்படுகிறது."

#. :src: bpy.types.NDOFMotionEventData.time_delta
msgid "Time Delta"
msgstr "நேரம் டெல்டா"

#. :src: bpy.types.NDOFMotionEventData.time_delta
msgid "Time since previous motion event (in seconds)"
msgstr "முந்தைய இயக்க நிகழ்வின் நேரம் (நொடிகளில்)"

#. :src: bpy.types.NDOFMotionEventData.translation
msgid ""
"The translation of this motion event. The range on each axis is [-1 to 1], "
"before being multiplied by the sensitivity preference. This is typically "
"scaled by the time-delta before use."
msgstr ""
"இந்த இயக்க நிகழ்வின் மொழிபெயர்ப்பு. ஒவ்வொரு அச்சிலும் உள்ள வரம்பு [-1 முதல் "
"1], உணர்திறன் விருப்பத்தால் பெருக்கப்படுவதற்கு முன்பு. இது பொதுவாக "
"பயன்பாட்டிற்கு முன் நேர-டெல்டாவால் அளவிடப்படுகிறது."

#. :src: bpy.types.NlaStrip
#: source/blender/blenkernel/intern/nla.cc:1920
msgid "NLA Strip"
msgstr "என்எல்ஏ உரி"

#. :src: bpy.types.NlaStrip
msgid "A container referencing an existing Action"
msgstr "ஏற்கனவே உள்ள செயலைக் குறிக்கும் கொள்கலன்"

#. :src: bpy.types.NlaStrip.action
msgid "Action referenced by this strip"
msgstr "இந்த துண்டு குறிப்பிடும் செயல்"

#. :src: bpy.types.NlaStrip.action_frame_end
msgid "Action End Frame"
msgstr "செயல் இறுதி சட்டகம்"

#. :src: bpy.types.NlaStrip.action_frame_end
msgid "Last frame from action to use"
msgstr "பயன்பாட்டிலிருந்து கடைசி சட்டகம்"

#. :src: bpy.types.NlaStrip.action_frame_start
msgid "Action Start Frame"
msgstr "செயல் தொடக்க சட்டகம்"

#. :src: bpy.types.NlaStrip.action_frame_start
msgid "First frame from action to use"
msgstr "பயன்படுத்த செயலிலிருந்து முதல் சட்டகம்"

#. :src: bpy.types.NlaStrip.action_slot_handle
msgid ""
"A number that identifies which sub-set of the Action is considered to be for"
" this NLA strip"
msgstr ""
"இந்த என்எல்ஏ துண்டுக்கு எந்தத் துணைத் தொகுப்பு செயலாகக் கருதப்படுகிறது "
"என்பதைக் குறிக்கும் எண்"

#. :src: bpy.types.NlaStrip.active
msgid "NLA Strip is active"
msgstr "என்எல்ஏ துண்டு செயலில் உள்ளது"

#. :src: bpy.types.NlaStrip.blend_in
msgid "Number of frames at start of strip to fade in influence"
msgstr "செல்வாக்கில் மங்குவதற்கு உரிபின் தொடக்கத்தில் பிரேம்களின் எண்ணிக்கை"

#. :src: bpy.types.NlaStrip.blend_type
#: source/blender/editors/space_nla/nla_buttons.cc:354
msgid "Blending"
msgstr "கலத்தல்"

#. :src: bpy.types.NlaStrip.blend_type
msgid "Method used for combining strip's result with accumulated result"
msgstr "உரிபின் முடிவை திரட்டப்பட்ட முடிவுடன் இணைக்கப் பயன்படுத்தப்படும் முறை"

#. :src: bpy.types.NlaStrip.extrapolation
msgid "Action to take for gaps past the strip extents"
msgstr "துண்டு விரிவாக்கங்களை கடந்த இடைவெளிகளை எடுக்க நடவடிக்கை"

#. :src: bpy.types.NlaStrip.fcurves
msgid "F-Curves for controlling the strip's influence and timing"
msgstr "உரிபின் செல்வாக்கு மற்றும் நேரத்தைக் கட்டுப்படுத்த எஃப்-வளைவுகள்"

#. :src: bpy.types.NlaStrip.frame_end_raw
msgid "End Frame (raw value)"
msgstr "இறுதி சட்டகம் (மூல மதிப்பு)"

#. :src: bpy.types.NlaStrip.frame_end_raw
msgid ""
"Same as frame_end, except that any value can be set, including ones that "
"create an invalid state"
msgstr ""
"பிரேம்_எண்டைப் போலவே, தவறான நிலையை உருவாக்கும் எந்தவொரு மதிப்பையும் அமைக்க "
"முடியும் என்பதைத் தவிர"

#. :src: bpy.types.NlaStrip.frame_end_ui
msgid "End Frame (manipulated from UI)"
msgstr "இறுதி சட்டகம் (ui இலிருந்து கையாளப்படுகிறது)"

#. :src: bpy.types.NlaStrip.frame_end_ui
msgid ""
"End frame of the NLA strip. Note: changing this value also updates the value"
" of the strip's repeats or its action's end frame. If only the end frame "
"should be changed, see the \"frame_end\" property instead."
msgstr ""
"என்.எல்.ஏ துண்டின் இறுதி சட்டகம். குறிப்பு: இந்த மதிப்பை மாற்றுவது "
"ச்ட்ரிப்பின் மறுபடியும் அல்லது அதன் செயலின் இறுதி சட்டகத்தின் மதிப்பையும் "
"புதுப்பிக்கிறது. இறுதி சட்டத்தை மட்டுமே மாற்ற வேண்டும் என்றால், அதற்கு "
"பதிலாக \"பிரேம்_எண்ட்\" சொத்தைப் பார்க்கவும்."

#. :src: bpy.types.NlaStrip.frame_start_raw
msgid "Start Frame (raw value)"
msgstr "தொடக்க சட்டகம் (மூல மதிப்பு)"

#. :src: bpy.types.NlaStrip.frame_start_raw
msgid ""
"Same as frame_start, except that any value can be set, including ones that "
"create an invalid state"
msgstr ""
"பிரேம்_ச்டார்ட் போலவே, தவறான நிலையை உருவாக்கும் எந்தவொரு மதிப்பையும் அமைக்க "
"முடியும் என்பதைத் தவிர"

#. :src: bpy.types.NlaStrip.frame_start_ui
msgid "Start Frame (manipulated from UI)"
msgstr "தொடக்க சட்டகம் (ui இலிருந்து கையாளப்படுகிறது)"

#. :src: bpy.types.NlaStrip.frame_start_ui
msgid ""
"Start frame of the NLA strip. Note: changing this value also updates the "
"value of the strip's end frame. If only the start frame should be changed, "
"see the \"frame_start\" property instead."
msgstr ""
"என்.எல்.ஏ. குறிப்பு: இந்த மதிப்பை மாற்றுவது ச்ட்ரிப்பின் இறுதி சட்டத்தின் "
"மதிப்பையும் புதுப்பிக்கிறது. தொடக்க சட்டகத்தை மட்டுமே மாற்ற வேண்டும் "
"என்றால், அதற்கு பதிலாக \"பிரேம்_ச்டார்ட்\" சொத்தைப் பார்க்கவும்."

#. :src: bpy.types.NlaStrip.influence
msgid "Amount the strip contributes to the current result"
msgstr "தற்போதைய முடிவுக்கு துண்டு பங்களிக்கிறது"

#. :src: bpy.types.NlaStrip.last_slot_identifier
msgid ""
"The identifier of the most recently assigned action slot. The slot "
"identifies which sub-set of the Action is considered to be for this strip, "
"and its identifier is used to find the right slot when assigning an Action."
msgstr ""
"மிக அண்மைக் காலத்தில் ஒதுக்கப்பட்ட அதிரடி ச்லாட்டின் அடையாளங்காட்டி. இந்த "
"துண்டுக்கு செயலின் எந்த துணைத் தொகுப்பு கருதப்படுகிறது என்பதை ச்லாட் "
"அடையாளம் காட்டுகிறது, மேலும் ஒரு செயலை ஒதுக்கும்போது சரியான ச்லாட்டைக் "
"கண்டுபிடிக்க அதன் அடையாளங்காட்டி பயன்படுத்தப்படுகிறது."

#. :src: bpy.types.NlaStrip.modifiers
msgid "Modifiers affecting all the F-Curves in the referenced Action"
msgstr ""
"குறிப்பிடப்பட்ட செயலில் அனைத்து எஃப்-வளைவுகளையும் பாதிக்கும் "
"மாற்றியமைப்பாளர்கள்"

#. :src: bpy.types.NlaStrip.mute
msgid "Disable NLA Strip evaluation"
msgstr "என்எல்ஏ துண்டு மதிப்பீட்டை முடக்கு"

#. :src: bpy.types.NlaStrip.repeat
msgid "Number of times to repeat the action range"
msgstr "செயல் வரம்பை மீண்டும் செய்ய எண்ணிக்கை"

#. :src: bpy.types.NlaStrip.scale
msgid "Scaling factor for action"
msgstr "செயலுக்கான அளவிடுதல் காரணி"

#. :src: bpy.types.NlaStrip.select
msgid "NLA Strip is selected"
msgstr "என்எல்ஏ துண்டு தேர்ந்தெடுக்கப்பட்டுள்ளது"

#. :src: bpy.types.NlaStrip.strip_time
msgid "Strip Time"
msgstr "உரி நேரம்"

#. :src: bpy.types.NlaStrip.strip_time
msgid "Frame of referenced Action to evaluate"
msgstr "மதிப்பீடு செய்ய குறிப்பிடப்பட்ட செயலின் சட்டகம்"

#. :src: bpy.types.NlaStrip.strips
#. :src: bpy.types.NlaStrips
#. :src: bpy.types.NlaTrack.strips
#. :src: bpy.types.EXPORT_SCENE_OT_fbx.bake_anim_use_nla_strips
msgid "NLA Strips"
msgstr "என்எல்ஏ கீற்றுகள்"

#. :src: bpy.types.NlaStrip.strips
msgid ""
"NLA Strips that this strip acts as a container for (if it is of type Meta)"
msgstr ""
"இந்த துண்டு ஒரு கொள்கலனாக செயல்படும் என்எல்ஏ கீற்றுகள் (இது வகை மேவு "
"என்றால்)"

#. :src: bpy.types.NlaStrip.type
msgid "Type of NLA Strip"
msgstr "என்எல்ஏ துண்டு வகை"

#. :src: bpy.types.NlaStrip.type:'CLIP'
#: source/blender/editors/space_nla/nla_buttons.cc:687
msgid "Action Clip"
msgstr "செயல் கிளிப்"

#. :src: bpy.types.NlaStrip.type:'CLIP'
msgid "NLA Strip references some Action"
msgstr "என்எல்ஏ உரி சில செயல்களைக் குறிப்பிடுகிறது"

#. :src: bpy.types.NlaStrip.type:'TRANSITION'
msgid "NLA Strip 'transitions' between adjacent strips"
msgstr "என்எல்ஏ உரி அருகிலுள்ள கீற்றுகளுக்கு இடையில் 'மாற்றங்கள்'"

#. :src: bpy.types.NlaStrip.type:'META'
#. :src: bpy.types.SpaceView3D.show_object_select_meta
#. :src: bpy.types.SpaceView3D.show_object_viewport_meta
#. :src: bpy.types.XrSessionSettings.show_object_select_meta
#. :src: bpy.types.XrSessionSettings.show_object_viewport_meta
#: source/blender/blenkernel/intern/nla.cc:1917
msgid "Meta"
msgstr "மேவு"

#. :src: bpy.types.NlaStrip.type:'META'
msgid "NLA Strip acts as a container for adjacent strips"
msgstr "என்எல்ஏ உரி அருகிலுள்ள கீற்றுகளுக்கான கொள்கலனாக செயல்படுகிறது"

#. :src: bpy.types.NlaStrip.type:'SOUND'
msgid "Sound Clip"
msgstr "ஒலி கிளிப்"

#. :src: bpy.types.NlaStrip.type:'SOUND'
msgid "NLA Strip representing a sound event for speakers"
msgstr "பேச்சாளர்களுக்கான ஒலி நிகழ்வைக் குறிக்கும் என்எல்ஏ துண்டு"

#. :src: bpy.types.NlaStrip.use_animated_influence
#: source/blender/editors/space_nla/nla_buttons.cc:698
msgid "Animated Influence"
msgstr "அனிமேசன் செல்வாக்கு"

#. :src: bpy.types.NlaStrip.use_animated_influence
msgid ""
"Influence setting is controlled by an F-Curve rather than automatically "
"determined"
msgstr ""
