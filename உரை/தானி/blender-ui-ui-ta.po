#. :src: bpy.types.GREASE_PENCIL_OT_dissolve.type:'BETWEEN'
msgid "Dissolve points between selected points"
msgstr "தேர்ந்தெடுக்கப்பட்ட புள்ளிகளுக்கு இடையில் புள்ளிகளைக் கரைக்கவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_dissolve.type:'UNSELECT'
msgctxt "GPencil"
