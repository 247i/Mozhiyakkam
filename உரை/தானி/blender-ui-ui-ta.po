msgstr "போச்"

#: source/blender/editors/armature/pose_lib_2.cc:370
msgid "Pose lib is only for armatures in pose mode"
msgstr "போச் நூலகம் போச் பயன்முறையில் ஆர்மேச்சருக்கு மட்டுமே"

#: source/blender/editors/armature/pose_lib_2.cc:383
