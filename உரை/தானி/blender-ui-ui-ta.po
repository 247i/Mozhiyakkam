#. :src: bpy.types.SolidifyModifier.nonmanifold_thickness_mode:'FIXED'
msgid "Most basic thickness calculation"
msgstr "மிகவும் அடிப்படை தடிமன் கணக்கீடு"

#. :src: bpy.types.SolidifyModifier.nonmanifold_thickness_mode:'EVEN'
#. :src: bpy.types.TRANSFORM_OT_edge_slide.use_even
#. :src: bpy.types.TRANSFORM_OT_vert_slide.use_even
#. :src: bpy.types.UV_OT_follow_active_quads.mode:'EVEN'
#: source/blender/editors/transform/transform_mode_edge_slide.cc:834
#: source/blender/editors/transform/transform_mode_vert_slide.cc:546
#: source/blender/modifiers/intern/MOD_wireframe.cc:118
msgid "Even"
msgstr "இரட்டை"

#. :src: bpy.types.SolidifyModifier.nonmanifold_thickness_mode:'EVEN'
msgid ""
"Even thickness calculation which takes the angle between faces into account"
msgstr "முகங்களுக்கு இடையிலான கோணத்தை கணக்கில் எடுக்கும் தடிமன் கணக்கீடு கூட"

#. :src: bpy.types.SolidifyModifier.nonmanifold_thickness_mode:'CONSTRAINTS'
msgid "Thickness calculation using constraints, most advanced"
msgstr "தடைகளைப் பயன்படுத்தி தடிமன் கணக்கீடு, மிகவும் மேம்பட்டது"

#. :src: bpy.types.SolidifyModifier.offset
#. :src: bpy.types.WireframeModifier.offset
msgid "Offset the thickness from the center"
msgstr "மையத்திலிருந்து தடிமன் ஈடுசெய்யவும்"

#. :src: bpy.types.SolidifyModifier.rim_vertex_group
msgid "Rim Vertex Group"
msgstr "ரிம் வெர்டெக்ச் குழு"

#. :src: bpy.types.SolidifyModifier.rim_vertex_group
msgid "Vertex group that the generated rim geometry will be weighted to"
msgstr "உருவாக்கப்பட்ட ரிம் வடிவியல் எடையுள்ள வெர்டெக்ச் குழு"

#. :src: bpy.types.SolidifyModifier.shell_vertex_group
msgid "Shell Vertex Group"
msgstr "செல் வெர்டெக்ச் குழு"

#. :src: bpy.types.SolidifyModifier.shell_vertex_group
msgid "Vertex group that the generated shell geometry will be weighted to"
msgstr "உருவாக்கப்பட்ட செல் வடிவியல் எடையுள்ள வெர்டெக்ச் குழு"

#. :src: bpy.types.SolidifyModifier.solidify_mode
msgid "Selects the used algorithm"
msgstr "பயன்படுத்தப்பட்ட வழிமுறையைத் தேர்ந்தெடுக்கிறது"

#. :src: bpy.types.SolidifyModifier.solidify_mode:'EXTRUDE'
msgid "Output a solidified version of a mesh by simple extrusion"
msgstr "எளிய வெளியேற்றத்தால் கண்ணி ஒரு திடமான பதிப்பை வெளியீடு செய்யுங்கள்"

#. :src: bpy.types.SolidifyModifier.solidify_mode:'NON_MANIFOLD'
msgid "Complex"
msgstr "சிக்கலான"

#. :src: bpy.types.SolidifyModifier.solidify_mode:'NON_MANIFOLD'
msgid ""
"Output a manifold mesh even if the base mesh is non-manifold, where edges "
"have 3 or more connecting faces. This method is slower."
msgstr ""
"ஒரு பன்மடங்கு கண்ணி ஒரு பன்மடங்கு கண்ணி பஞ்சமற்றதாக இருந்தாலும், விளிம்புகள்"
" 3 அல்லது அதற்கு மேற்பட்ட இணைக்கும் முகங்களைக் கொண்டிருந்தாலும் கூட. இந்த "
"முறை மெதுவாக உள்ளது."

#. :src: bpy.types.SolidifyModifier.thickness
msgid "Thickness of the shell"
msgstr "செல்லின் தடிமன்"

#. :src: bpy.types.SolidifyModifier.thickness_clamp
msgid "Offset clamp based on geometry scale"
msgstr "வடிவியல் அளவின் அடிப்படையில் ஆஃப்செட் கிளாம்ப்"

#. :src: bpy.types.SolidifyModifier.thickness_vertex_group
#. :src: bpy.types.WireframeModifier.thickness_vertex_group
msgid "Vertex Group Factor"
msgstr "வெர்டெக்ச் குழு காரணி"

#. :src: bpy.types.SolidifyModifier.thickness_vertex_group
#. :src: bpy.types.WireframeModifier.thickness_vertex_group
msgid "Thickness factor to use for zero vertex group influence"
msgstr "சுழிய வெர்டெக்ச் குழு செல்வாக்கிற்கு பயன்படுத்த தடிமன் காரணி"

#. :src: bpy.types.SolidifyModifier.use_even_offset
#. :src: Socket name from node group Duplicate Hair Curves, file
#. procedural_hair_node_assets.blend
#: source/blender/editors/transform/transform_mode_shrink_fatten.cc:168
msgid "Even Thickness"
msgstr "கூட தடிமன்"

#. :src: bpy.types.SolidifyModifier.use_even_offset
msgid ""
"Maintain thickness by adjusting for sharp corners (slow, disable when not "
"needed)"
msgstr ""
"கூர்மையான மூலைகளுக்கு சரிசெய்வதன் மூலம் தடிமன் பராமரிக்கவும் (மெதுவாக, "
"தேவையில்லை போது முடக்கு)"

#. :src: bpy.types.SolidifyModifier.use_flat_faces
msgid "Flat Faces"
msgstr "தட்டையான முகங்கள்"

#. :src: bpy.types.SolidifyModifier.use_flat_faces
msgid ""
"Make faces use the minimal vertex weight assigned to their vertices (ensures"
" new faces remain parallel to their original ones, slow, disable when not "
"needed)"
msgstr ""
"முகங்கள் அவற்றின் செங்குத்துகளுக்கு ஒதுக்கப்பட்ட குறைந்தபட்ச வெர்டெக்ச் "
"எடையைப் பயன்படுத்துங்கள் (புதிய முகங்கள் அவற்றின் அசல்வற்றுக்கு இணையாக "
"இருப்பதை உறுதி செய்கிறது, மெதுவாக, தேவையில்லை போது முடக்கு)"

#. :src: bpy.types.SolidifyModifier.use_flip_normals
#. :src: bpy.types.MESH_OT_extrude_context.use_normal_flip
#. :src: bpy.types.MESH_OT_extrude_edges_indiv.use_normal_flip
#. :src: bpy.types.MESH_OT_extrude_region.use_normal_flip
#. :src: bpy.types.MESH_OT_spin.use_normal_flip
msgid "Flip Normals"
msgstr "இயல்பான புரட்டுதல்"

#. :src: bpy.types.SolidifyModifier.use_flip_normals
msgid "Invert the face direction"
msgstr "முக திசையை தலைகீழாக மாற்றவும்"

#. :src: bpy.types.SolidifyModifier.use_quality_normals
#. :src: bpy.types.RenderSettings.use_high_quality_normals
msgid "High Quality Normals"
msgstr "உயர் தரமான இயல்பு"

#. :src: bpy.types.SolidifyModifier.use_quality_normals
msgid ""
"Calculate normals which result in more even thickness (slow, disable when "
"not needed)"
msgstr ""
"மேலும் தடிமன் விளைவிக்கும் இயல்புகளைக் கணக்கிடுங்கள் (மெதுவாக, தேவையில்லை "
"போது முடக்கு)"

#. :src: bpy.types.SolidifyModifier.use_rim
msgid "Fill Rim"
msgstr "விளிம்பு நிரப்பவும்"

#. :src: bpy.types.SolidifyModifier.use_rim
msgid ""
"Create edge loops between the inner and outer surfaces on face edges (slow, "
"disable when not needed)"
msgstr ""
"முக விளிம்புகளில் உள் மற்றும் வெளிப்புற மேற்பரப்புகளுக்கு இடையில் விளிம்பு "
"சுழல்களை உருவாக்கவும் (மெதுவாக, தேவையில்லை போது முடக்கு)"

#. :src: bpy.types.SolidifyModifier.use_rim_only
msgid "Only Rim"
msgstr "விளிம்பு மட்டுமே"

#. :src: bpy.types.SolidifyModifier.use_rim_only
msgid "Only add the rim to the original data"
msgstr "அசல் தரவுக்கு விளிம்பைச் சேர்க்கவும்"

#. :src: bpy.types.SolidifyModifier.use_thickness_angle_clamp
msgid "Angle Clamp"
msgstr "கோண கவ்வியில்"

#. :src: bpy.types.SolidifyModifier.use_thickness_angle_clamp
msgid "Clamp thickness based on angles"
msgstr "கோணங்களின் அடிப்படையில் தடிமன்"

#. :src: bpy.types.SubsurfModifier
msgid "Subdivision Surface Modifier"
msgstr "உட்பிரிவு மேற்பரப்பு மாற்றியமைத்தல்"

#. :src: bpy.types.SubsurfModifier
msgid "Subdivision surface modifier"
msgstr "உட்பிரிவு மேற்பரப்பு மாற்றியமைத்தல்"

#. :src: bpy.types.SubsurfModifier.levels
msgid "Number of subdivisions to perform in the 3D viewport"
msgstr "3D வியாபோர்ட்டில் செய்ய துணைப்பிரிவுகளின் எண்ணிக்கை"

#. :src: bpy.types.SubsurfModifier.render_levels
msgid "Number of subdivisions to perform when rendering"
msgstr "வழங்குதல் போது செய்ய வேண்டிய துணைப்பிரிவுகளின் எண்ணிக்கை"

#. :src: bpy.types.SubsurfModifier.show_only_control_edges
msgid "Skip displaying interior subdivided edges"
msgstr "உள்துறை துணைப்பிரிவு விளிம்புகளைக் காண்பிப்பதைத் தவிர்க்கவும்"

#. :src: bpy.types.SubsurfModifier.subdivision_type:'CATMULL_CLARK'
msgid ""
"Create a smooth curved surface using the Catmull-Clark subdivision scheme"
msgstr ""
"கேட்மல்-கிளார்க் துணைப்பிரிவு திட்டத்தைப் பயன்படுத்தி மென்மையான வளைந்த "
"மேற்பரப்பை உருவாக்கவும்"

#. :src: bpy.types.SubsurfModifier.subdivision_type:'SIMPLE'
msgid "Subdivide faces without changing shape"
msgstr "வடிவத்தை மாற்றாமல் முகங்களை உட்பிரிவு செய்யுங்கள்"

#. :src: bpy.types.SubsurfModifier.use_limit_surface
msgid "Use Limit Surface"
msgstr "வரம்பு மேற்பரப்பைப் பயன்படுத்தவும்"

#. :src: bpy.types.SubsurfModifier.use_limit_surface
#: source/blender/nodes/geometry/nodes/node_geo_subdivision_surface.cc:47
msgid ""
"Place vertices at the surface that would be produced with infinite levels of"
" subdivision (smoothest possible shape)"
msgstr ""
"எல்லையற்ற அளவிலான துணைப்பிரிவுடன் விளைவாக்கம் செய்யப்படும் மேற்பரப்பில் "
"செங்குத்துகளை வைக்கவும் (மென்மையான சாத்தியமான வடிவம்)"

#. :src: bpy.types.SurfaceDeformModifier
msgid "SurfaceDeform Modifier"
msgstr "surfacedeform மாற்றியமைப்பாளர்"

#. :src: bpy.types.SurfaceDeformModifier.falloff
msgid "Interpolation Falloff"
msgstr "இடைக்கணிப்பு வீழ்ச்சி"

#. :src: bpy.types.SurfaceDeformModifier.falloff
msgid "Controls how much nearby polygons influence deformation"
msgstr ""
"அருகிலுள்ள பலகோணங்கள் சிதைவை எவ்வளவு பாதிக்கின்றன என்பதைக் "
"கட்டுப்படுத்துகிறது"

#. :src: bpy.types.SurfaceDeformModifier.is_bound
msgid "Whether geometry has been bound to target mesh"
msgstr "வடிவியல் கண்ணி குறிவைக்கப்படுகிறதா என்பது"

#. :src: bpy.types.SurfaceDeformModifier.strength
msgid "Strength of modifier deformations"
msgstr "மாற்றியமைக்கும் சிதைவுகளின் வலிமை"

#. :src: bpy.types.SurfaceDeformModifier.use_sparse_bind
msgid "Sparse Bind"
msgstr "சிதறிய பிணைப்பு"

#. :src: bpy.types.SurfaceDeformModifier.use_sparse_bind
msgid ""
"Only record binding data for vertices matching the vertex group at the time "
"of bind"
msgstr ""
"பிணைப்பு நேரத்தில் வெர்டெக்ச் குழுவுடன் பொருந்தக்கூடிய செங்குத்துகளுக்கான "
"பிணைப்பு தரவை மட்டுமே பதிவுசெய்க"

#. :src: bpy.types.SurfaceModifier
msgid "Surface Modifier"
msgstr "மேற்பரப்பு மாற்றியமைப்பாளர்"

#. :src: bpy.types.SurfaceModifier
msgid ""
"Surface modifier defining modifier stack position used for surface fields"
msgstr ""
"மேற்பரப்பு மாற்றி மேற்பரப்பு புலங்களுக்குப் பயன்படுத்தப்படும் "
"மாற்றியமைக்கும் அடுக்கு நிலையை வரையறுத்தல்"

#. :src: bpy.types.TriangulateModifier
msgid "Triangulate Modifier"
msgstr "முக்கோண மாற்றி"

#. :src: bpy.types.TriangulateModifier
msgid "Triangulate Mesh"
msgstr "முக்கோண கண்ணி"

#. :src: bpy.types.TriangulateModifier.keep_custom_normals
msgid "Keep Normals"
msgstr "இயல்புநிலைகளை வைத்திருங்கள்"

#. :src: bpy.types.TriangulateModifier.keep_custom_normals
msgid ""
"Try to preserve custom normals.\n"
"Warning: Depending on chosen triangulation method, shading may not be fully preserved, \"Fixed\" method usually gives the best result here"
msgstr ""
"தனிப்பயன் இயல்புகளை பாதுகாக்க முயற்சிக்கவும்.\n"
" எச்சரிக்கை: தேர்ந்தெடுக்கப்பட்ட முக்கோண முறையைப் பொறுத்து, நிழல் முழுமையாக பாதுகாக்கப்படாமல் போகலாம், \"நிலையான\" முறை பொதுவாக இங்கே சிறந்த முடிவை அளிக்கிறது"

#. :src: bpy.types.TriangulateModifier.min_vertices
msgid "Minimum Vertices"
msgstr "குறைந்தபட்ச செங்குத்துகள்"

#. :src: bpy.types.TriangulateModifier.min_vertices
msgid ""
"Triangulate only polygons with vertex count greater than or equal to this "
"number"
msgstr ""
"இந்த எண்ணை விட அதிகமாகவோ அல்லது சமமாகவோ வெர்டெக்ச் எண்ணிக்கை கொண்ட "
"பலகோணங்களை மட்டுமே முக்கோணப்படுத்துங்கள்"

#. :src: bpy.types.TriangulateModifier.ngon_method
#. :src: bpy.types.MESH_OT_quads_convert_to_tris.ngon_method
#. :src: bpy.types.WM_OT_alembic_export.ngon_method
#. :src: bpy.types.WM_OT_usd_export.ngon_method
#: source/blender/nodes/geometry/nodes/node_geo_triangulate.cc:72
msgid "N-gon Method"
msgstr "என்-கோன் முறை"

#. :src: bpy.types.TriangulateModifier.ngon_method
#. :src: bpy.types.MESH_OT_quads_convert_to_tris.ngon_method
#. :src: bpy.types.WM_OT_alembic_export.ngon_method
#. :src: bpy.types.WM_OT_usd_export.ngon_method
#: source/blender/nodes/geometry/nodes/node_geo_triangulate.cc:75
msgid "Method for splitting the n-gons into triangles"
msgstr "என்-கின்களை முக்கோணங்களாக பிரிப்பதற்கான முறை"

#. :src: bpy.types.TriangulateModifier.ngon_method:'BEAUTY'
#. :src: bpy.types.TriangulateModifier.quad_method:'BEAUTY'
#. :src: bpy.types.MESH_OT_fill.use_beauty
#. :src: bpy.types.MESH_OT_quads_convert_to_tris.ngon_method:'BEAUTY'
#. :src: bpy.types.MESH_OT_quads_convert_to_tris.quad_method:'BEAUTY'
#. :src: bpy.types.WM_OT_alembic_export.ngon_method:'BEAUTY'
#. :src: bpy.types.WM_OT_alembic_export.quad_method:'BEAUTY'
#. :src: bpy.types.WM_OT_usd_export.ngon_method:'BEAUTY'
#. :src: bpy.types.WM_OT_usd_export.quad_method:'BEAUTY'
msgid "Beauty"
msgstr "அழகு"

#. :src: bpy.types.TriangulateModifier.ngon_method:'BEAUTY'
#. :src: bpy.types.MESH_OT_quads_convert_to_tris.ngon_method:'BEAUTY'
#. :src: bpy.types.WM_OT_alembic_export.ngon_method:'BEAUTY'
#. :src: bpy.types.WM_OT_usd_export.ngon_method:'BEAUTY'
msgid "Arrange the new triangles evenly (slow)"
msgstr "புதிய முக்கோணங்களை சமமாக (மெதுவாக) ஏற்பாடு செய்யுங்கள்"

#. :src: bpy.types.TriangulateModifier.ngon_method:'CLIP'
#. :src: bpy.types.MESH_OT_quads_convert_to_tris.ngon_method:'CLIP'
#. :src: bpy.types.WM_OT_alembic_export.ngon_method:'CLIP'
#. :src: bpy.types.WM_OT_usd_export.ngon_method:'CLIP'
msgid "Split the polygons with an ear clipping algorithm"
msgstr "பலகோணங்களை காது கிளிப்பிங் வழிமுறையுடன் பிரிக்கவும்"

#. :src: bpy.types.TriangulateModifier.quad_method
#. :src: bpy.types.MESH_OT_quads_convert_to_tris.quad_method
#. :src: bpy.types.WM_OT_alembic_export.quad_method
#. :src: bpy.types.WM_OT_usd_export.quad_method
#: source/blender/nodes/geometry/nodes/node_geo_triangulate.cc:68
msgid "Quad Method"
msgstr "குவாட் முறை"

#. :src: bpy.types.TriangulateModifier.quad_method
#. :src: bpy.types.MESH_OT_quads_convert_to_tris.quad_method
#. :src: bpy.types.WM_OT_alembic_export.quad_method
#. :src: bpy.types.WM_OT_usd_export.quad_method
