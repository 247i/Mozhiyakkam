msgstr ""
"முந்தைய மற்றும் பின்வரும் கிரீச் பென்சில் பிரேம்களுக்கு இடையிலான பிரிவின் "
"முடிவுகள் இடைக்கணிப்பை எளிதாக்குகின்றன"

#. :src: bpy.types.GREASE_PENCIL_OT_interpolate_sequence.easing:'AUTO'
msgctxt "GPencil"
msgid "Automatic Easing"
msgstr "தானியங்கி தளர்த்தல்"

#. :src: bpy.types.GREASE_PENCIL_OT_interpolate_sequence.easing:'EASE_IN'
msgctxt "GPencil"
msgid "Ease In"
msgstr "எளிதாக"

#. :src: bpy.types.GREASE_PENCIL_OT_interpolate_sequence.easing:'EASE_OUT'
msgctxt "GPencil"
msgid "Ease Out"
msgstr "எளிதாக்குங்கள்"

#. :src: bpy.types.GREASE_PENCIL_OT_interpolate_sequence.easing:'EASE_IN_OUT'
msgctxt "GPencil"
msgid "Ease In and Out"
msgstr "உள்ளேயும் வெளியேயும் எளிதாக்குங்கள்"

