msgid "Number of frames to offset original keyframe number or frame to fix"
msgstr ""
"அசல் கீஃப்ரேம் எண் அல்லது சரிசெய்ய சட்டத்தை ஈடுசெய்ய பிரேம்களின் எண்ணிக்கை"

#. :src: bpy.types.GreasePencilTimeModifier.segment_active_index
msgid "Active Time Segment Index"
msgstr "செயலில் நேர பிரிவு அட்டவணை"

#. :src: bpy.types.GreasePencilTimeModifier.use_custom_frame_range
#. :src: bpy.types.RENDER_PT_eevee_volumes_range
#: source/blender/nodes/geometry/nodes/node_geo_bake.cc:847
msgid "Custom Range"
msgstr "தனிப்பயன் வரம்பு"

