#: source/blender/editors/transform/transform_mode_vert_slide.cc:542
#: source/blender/nodes/geometry/nodes/node_geo_uv_pack_islands.cc:66
msgid "Rotate"
msgstr "சுழற்றுங்கள்"

#. :src: bpy.types.CompositorNodeRotate
msgid "Rotate image by specified angle"
msgstr "குறிப்பிட்ட கோணத்தால் படத்தை சுழற்றுங்கள்"

#. :src: bpy.types.CompositorNodeScale
msgid "Change the size of the image"
msgstr "படத்தின் அளவை மாற்றவும்"

#. :src: bpy.types.CompositorNodeScale.space
msgid "Coordinate space to scale relative to"
msgstr "தொடர்புடைய அளவிற்கு இடத்தை ஒருங்கிணைத்தல்"

#. :src: bpy.types.CompositorNodeSceneTime
#. :src: bpy.types.GeometryNodeInputSceneTime
msgid "Scene Time"
msgstr "காட்சி நேரம்"

#. :src: bpy.types.CompositorNodeSceneTime
msgid "Input the current scene time in seconds or frames"
msgstr "தற்போதைய காட்சி நேரத்தை நொடிகளில் அல்லது பிரேம்களில் உள்ளிடவும்"

#. :src: bpy.types.CompositorNodeSeparateColor
#. :src: bpy.types.FunctionNodeSeparateColor
#. :src: bpy.types.ShaderNodeSeparateColor
#. :src: bpy.types.TextureNodeSeparateColor
msgid "Separate Color"
msgstr "தனி நிறம்"

#. :src: bpy.types.CompositorNodeSeparateColor
msgid "Split an image into its composite color channels"
msgstr "ஒரு படத்தை அதன் கலப்பு வண்ண சேனல்களில் பிரிக்கவும்"

#. :src: bpy.types.CompositorNodeSetAlpha
msgid "Set Alpha"
msgstr "ஆல்பாவை அமைக்கவும்"

#. :src: bpy.types.CompositorNodeSetAlpha
msgid "Add an alpha channel to an image"
msgstr "ஒரு படத்தில் ஆல்பா சேனலைச் சேர்க்கவும்"

#. :src: bpy.types.CompositorNodeSetAlpha.mode:'APPLY'
msgid "Apply Mask"
msgstr "முகமூடியைப் பயன்படுத்துங்கள்"

#. :src: bpy.types.CompositorNodeSetAlpha.mode:'APPLY'
msgid "Multiply the input image's RGBA channels by the alpha input value"
msgstr ""
"உள்ளீட்டு படத்தின் rgba சேனல்களை ஆல்பா உள்ளீட்டு மதிப்பால் பெருக்கவும்"

#. :src: bpy.types.CompositorNodeSetAlpha.mode:'REPLACE_ALPHA'
msgid "Replace Alpha"
msgstr "ஆல்பாவை மாற்றவும்"

#. :src: bpy.types.CompositorNodeSetAlpha.mode:'REPLACE_ALPHA'
msgid "Replace the input image's alpha channel by the alpha input value"
msgstr "ஆல்பா உள்ளீட்டு மதிப்பால் உள்ளீட்டு பட ஆல்பா சேனலை மாற்றவும்"

#. :src: bpy.types.CompositorNodeSplit
msgid ""
"Combine two images for side-by-side display. Typically used in combination "
"with a Viewer node"
msgstr ""
"பக்கவாட்டு காட்சிக்கு இரண்டு படங்களை இணைக்கவும். பொதுவாக பார்வையாளர் "
"முனையுடன் இணைந்து பயன்படுத்தப்படுகிறது"

#. :src: bpy.types.CompositorNodeStabilize
msgid "Stabilize 2D"
msgstr "2d ஐ உறுதிப்படுத்தவும்"

#. :src: bpy.types.CompositorNodeStabilize
msgid "Stabilize footage using 2D stabilization motion tracking settings"
msgstr ""
"2 டி உறுதிப்படுத்தல் இயக்க கண்காணிப்பு அமைப்புகளைப் பயன்படுத்தி காட்சிகளை "
"உறுதிப்படுத்தவும்"

#. :src: bpy.types.CompositorNodeStabilize.filter_type
msgid "Method to use to filter stabilization"
msgstr "உறுதிப்படுத்தல் வடிகட்ட பயன்படுத்த முறை"

#. :src: bpy.types.CompositorNodeSunBeams
msgid "Create sun beams based on image brightness"
msgstr "பட பிரகாசத்தின் அடிப்படையில் சூரிய விட்டங்களை உருவாக்கவும்"

#. :src: bpy.types.CompositorNodeSwitch
