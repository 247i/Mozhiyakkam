msgid ""
"Converts values that are relative to the image size to be in terms of pixels"
msgstr "பட அளவோடு தொடர்புடைய மதிப்புகளை பிக்சல்களின் அடிப்படையில் மாற்றுகிறது"

#. :src: bpy.types.CompositorNodeRelativeToPixel.data_type
msgid "The type of data"
msgstr "தரவு வகை"

#. :src: bpy.types.CompositorNodeRelativeToPixel.data_type:'FLOAT'
msgid "Float value"
msgstr "மிதவை மதிப்பு"

#. :src: bpy.types.CompositorNodeRelativeToPixel.data_type:'VECTOR'
msgid "Vector value"
msgstr "திசையன் மதிப்பு"

#. :src: bpy.types.CompositorNodeRelativeToPixel.reference_dimension
msgid "Reference Dimension"
msgstr "குறிப்பு பரிமாணம்"

#. :src: bpy.types.CompositorNodeRelativeToPixel.reference_dimension
msgid ""
"Defines the dimension of the image that the relative value is in reference "
"to"
msgstr "உறவினர் மதிப்பு குறிப்பிடப்பட்டுள்ள படத்தின் பரிமாணத்தை வரையறுக்கிறது"

#. :src:
#. bpy.types.CompositorNodeRelativeToPixel.reference_dimension:'PER_DIMENSION'
msgid "Per Dimension"
msgstr "ஒரு பரிமாணத்திற்கு"

#. :src:
#. bpy.types.CompositorNodeRelativeToPixel.reference_dimension:'PER_DIMENSION'
msgid ""
"The value is relative to each of the dimensions of the image independently"
msgstr "மதிப்பு படத்தின் ஒவ்வொரு பரிமாணங்களுக்கும் சுயாதீனமாக தொடர்புடையது"

#. :src: bpy.types.CompositorNodeRelativeToPixel.reference_dimension:'X'
msgid "The value is relative to the X dimension of the image"
msgstr "மதிப்பு படத்தின் ஃச் பரிமாணத்துடன் தொடர்புடையது"

#. :src: bpy.types.CompositorNodeRelativeToPixel.reference_dimension:'Y'
msgid "The value is relative to the Y dimension of the image"
msgstr "மதிப்பு படத்தின் ஒய் பரிமாணத்துடன் தொடர்புடையது"

#. :src: bpy.types.CompositorNodeRelativeToPixel.reference_dimension:'Greater'
#. :src: bpy.types.CURVE_OT_select_similar.compare:'GREATER'
#. :src: bpy.types.MESH_OT_select_similar.compare:'GREATER'
#. :src: bpy.types.UV_OT_select_similar.compare:'GREATER'
msgid "Greater"
msgstr "பெரிய"

#. :src: bpy.types.CompositorNodeRelativeToPixel.reference_dimension:'Greater'
msgid "The value is relative to the greater dimension of the image"
msgstr "மதிப்பு படத்தின் அதிக பரிமாணத்துடன் தொடர்புடையது"

#. :src: bpy.types.CompositorNodeRelativeToPixel.reference_dimension:'Smaller'
msgid "Smaller"
msgstr "சிறிய"

#. :src: bpy.types.CompositorNodeRelativeToPixel.reference_dimension:'Smaller'
msgid "The value is relative to the smaller dimension of the image"
msgstr "மதிப்பு படத்தின் சிறிய பரிமாணத்துடன் தொடர்புடையது"

#. :src:
#. bpy.types.CompositorNodeRelativeToPixel.reference_dimension:'Diagonal'
msgid "The value is relative to the diagonal of the image"
msgstr "மதிப்பு படத்தின் மூலைவிட்டத்துடன் தொடர்புடையது"

#. :src: bpy.types.CompositorNodeRotate
