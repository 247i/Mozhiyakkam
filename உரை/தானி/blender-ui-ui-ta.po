#. :src: bpy.types.ShrinkwrapModifier.auxiliary_target
msgid "Additional mesh target to shrink to"
msgstr "சுருங்குவதற்கு கூடுதல் கண்ணி இலக்கு"

#. :src: bpy.types.GreasePencilShrinkwrapModifier.offset
#. :src: bpy.types.ShrinkwrapModifier.offset
msgid "Distance to keep from the target"
msgstr "இலக்கிலிருந்து வைத்திருக்க வேண்டிய தூரம்"

#. :src: bpy.types.GreasePencilShrinkwrapModifier.project_limit
#. :src: bpy.types.ShrinkwrapModifier.project_limit
msgid "Project Limit"
msgstr "திட்ட வரம்பு"

