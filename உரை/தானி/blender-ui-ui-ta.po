#. :src: bpy.types.ParticleInstanceModifier.space:'WORLD'
msgid "Use world space offset in the instance object"
msgstr "நிகழ்வு பொருளில் உலக விண்வெளி ஆஃப்செட் பயன்படுத்தவும்"

#. :src: bpy.types.ParticleInstanceModifier.use_children
#. :src: bpy.types.PARTICLE_PT_children
msgctxt "ParticleSettings"
msgid "Children"
msgstr "குழந்தைகள்"

#. :src: bpy.types.ParticleInstanceModifier.use_children
msgid "Create instances from child particles"
msgstr "குழந்தை துகள்களிலிருந்து நிகழ்வுகளை உருவாக்கவும்"

#. :src: bpy.types.ParticleInstanceModifier.use_normal
msgid "Create instances from normal particles"
msgstr "சாதாரண துகள்களிலிருந்து நிகழ்வுகளை உருவாக்கவும்"

#. :src: bpy.types.ParticleInstanceModifier.use_path
msgid "Create instances along particle paths"
msgstr "துகள் பாதைகளில் நிகழ்வுகளை உருவாக்கவும்"

#. :src: bpy.types.ParticleInstanceModifier.use_preserve_shape
msgid "Don't stretch the object"
msgstr "பொருளை நீட்ட வேண்டாம்"

#. :src: bpy.types.ParticleInstanceModifier.use_size
msgid "Use particle size to scale the instances"
msgstr "நிகழ்வுகளை அளவிட துகள் அளவைப் பயன்படுத்தவும்"

#. :src: bpy.types.ParticleInstanceModifier.value_layer_name
msgid "Value Layer Name"
msgstr "மதிப்பு அடுக்கு பெயர்"

#. :src: bpy.types.ParticleInstanceModifier.value_layer_name
msgid "Custom data layer name for the randomized value"
msgstr "சீரற்ற மதிப்புக்கு தனிப்பயன் தரவு அடுக்கு பெயர்"

#. :src: bpy.types.ParticleSystemModifier
msgid "ParticleSystem Modifier"
msgstr "துகள்கள் அமைப்பு மாற்றியமைப்பாளர்"

#. :src: bpy.types.ParticleSystemModifier
msgid "Particle system simulation modifier"
msgstr "துகள் அமைப்பு உருவகப்படுத்துதல் மாற்றியமைப்பாளர்"

#. :src: bpy.types.ParticleSystemModifier.particle_system
msgid "Particle System that this modifier controls"
msgstr "இந்த மாற்றியமைக்கும் துகள் அமைப்பு"

#. :src: bpy.types.RemeshModifier
msgid "Remesh Modifier"
msgstr "remesh மாற்றியமைப்பாளர்"

#. :src: bpy.types.RemeshModifier
msgid ""
"Generate a new surface with regular topology that follows the shape of the "
"input mesh"
msgstr ""
"உள்ளீட்டு கண்ணி வடிவத்தைப் பின்பற்றும் வழக்கமான இடவியலுடன் புதிய மேற்பரப்பை "
"உருவாக்கவும்"

#. :src: bpy.types.RemeshModifier.mode
msgctxt "Modifier"
msgid "Mode"
msgstr "பயன்முறை"

#. :src: bpy.types.RemeshModifier.mode:'BLOCKS'
msgctxt "Modifier"
msgid "Blocks"
msgstr "தொகுதிகள்"

#. :src: bpy.types.RemeshModifier.mode:'BLOCKS'
msgid "Output a blocky surface with no smoothing"
msgstr "மென்மையாக்காமல் ஒரு தடுப்பு மேற்பரப்பை வெளியிடுங்கள்"

#. :src: bpy.types.RemeshModifier.mode:'SMOOTH'
msgctxt "Modifier"
msgid "Smooth"
msgstr "மென்மையான"

#. :src: bpy.types.RemeshModifier.mode:'SMOOTH'
msgid "Output a smooth surface with no sharp-features detection"
msgstr ""
"கூர்மையான நற்பொருத்தங்கள் கண்டறிதல் இல்லாத மென்மையான மேற்பரப்பை வெளியிடு"

#. :src: bpy.types.RemeshModifier.mode:'SHARP'
msgctxt "Modifier"
msgid "Sharp"
msgstr "கூர்மையான"

#. :src: bpy.types.RemeshModifier.mode:'SHARP'
msgid ""
"Output a surface that reproduces sharp edges and corners from the input mesh"
msgstr ""
"உள்ளீட்டு மெசிலிருந்து கூர்மையான விளிம்புகள் மற்றும் மூலைகளை இனப்பெருக்கம் "
"செய்யும் மேற்பரப்பை வெளியிடுங்கள்"

#. :src: bpy.types.RemeshModifier.mode:'VOXEL'
msgctxt "Modifier"
msgid "Voxel"
msgstr "வோக்சல்"

#. :src: bpy.types.RemeshModifier.mode:'VOXEL'
msgid "Output a mesh corresponding to the volume of the original mesh"
msgstr "அசல் கண்ணி அளவோடு தொடர்புடைய ஒரு கண்ணி வெளியீடு"

#. :src: bpy.types.RemeshModifier.octree_depth
msgid "Octree Depth"
msgstr "ஆக்ட்ரீ ஆழம்"

#. :src: bpy.types.RemeshModifier.octree_depth
msgid "Resolution of the octree; higher values give finer details"
msgstr "ஆக்ட்ரீ தீர்மானம்; அதிக மதிப்புகள் சிறந்த விவரங்களைத் தருகின்றன"

#. :src: bpy.types.RemeshModifier.scale
msgid ""
"The ratio of the largest dimension of the model over the size of the grid"
msgstr "கட்டத்தின் அளவிற்கு மேல் மாதிரியின் மிகப்பெரிய பரிமாணத்தின் விகிதம்"

#. :src: bpy.types.RemeshModifier.sharpness
#. :src: bpy.types.GeometryNodeSetMeshNormal.mode:'SHARPNESS'
#. :src: bpy.types.GRAPH_OT_ease.sharpness
#. :src: bpy.types.MESH_OT_edges_select_sharp.sharpness
#. :src: bpy.types.MESH_OT_faces_select_linked_flat.sharpness
#: source/blender/nodes/composite/nodes/node_composite_kuwahara.cc:51
msgid "Sharpness"
msgstr "கூர்மையானது"

#. :src: bpy.types.RemeshModifier.sharpness
msgid ""
"Tolerance for outliers; lower values filter noise while higher values will "
"reproduce edges closer to the input"
msgstr ""
"வெளியீட்டாளர்களுக்கு சகிப்புத்தன்மை; குறைந்த மதிப்புகள் வடிகட்டி ஒலி, அதிக "
