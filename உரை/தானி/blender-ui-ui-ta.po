#. :src: bpy.types.IMPORT_ANIM_OT_bvh.axis_forward:'Y'
#. :src: bpy.types.IMPORT_SCENE_OT_fbx.axis_forward:'Y'
msgid "Y Forward"
msgstr "ஒய் முன்னோக்கி"

#. :src: bpy.types.EXPORT_SCENE_OT_fbx.axis_forward:'Z'
#. :src: bpy.types.IMPORT_ANIM_OT_bvh.axis_forward:'Z'
#. :src: bpy.types.IMPORT_SCENE_OT_fbx.axis_forward:'Z'
