msgstr "அனைத்தையும் மறைக்க/காட்டு"

#. :src: bpy.types.PAINT_OT_hide_show_all
msgid "Hide/show all vertices"
msgstr "எல்லா செங்குத்துகளையும் மறைக்க/காட்டு"

#. :src: bpy.types.PAINT_OT_hide_show_lasso_gesture
msgctxt "Operator"
msgid "Hide/Show Lasso"
msgstr "லாசோவை மறைக்க/காட்டு"

#. :src: bpy.types.PAINT_OT_hide_show_line_gesture
msgctxt "Operator"
msgid "Hide/Show Line"
msgstr "வரி மறைக்க/காட்டு"

#. :src: bpy.types.PAINT_OT_hide_show_line_gesture.use_limit_to_segment
#. :src: bpy.types.PAINT_OT_mask_line_gesture.use_limit_to_segment
#. :src: bpy.types.SCULPT_OT_face_set_line_gesture.use_limit_to_segment
#. :src: bpy.types.SCULPT_OT_project_line_gesture.use_limit_to_segment
#. :src: bpy.types.SCULPT_OT_trim_line_gesture.use_limit_to_segment
msgid "Limit to Segment"
msgstr "பிரிவுக்கு வரம்பு"

#. :src: bpy.types.PAINT_OT_hide_show_line_gesture.use_limit_to_segment
#. :src: bpy.types.PAINT_OT_mask_line_gesture.use_limit_to_segment
#. :src: bpy.types.SCULPT_OT_face_set_line_gesture.use_limit_to_segment
#. :src: bpy.types.SCULPT_OT_project_line_gesture.use_limit_to_segment
#. :src: bpy.types.SCULPT_OT_trim_line_gesture.use_limit_to_segment
msgid ""
"Apply the gesture action only to the area that is contained within the "
"segment without extending its effect to the entire line"
msgstr ""
"சைகை நடவடிக்கையை பிரிவுக்குள் உள்ள பரப்புக்கு மட்டுமே அதன் விளைவை முழு "
"வரியிலும் நீட்டிக்காமல் பயன்படுத்துங்கள்"

#. :src: bpy.types.PAINT_OT_hide_show_masked
msgctxt "Operator"
msgid "Hide/Show Masked"
msgstr "மறைக்க/முகமூடி"

#. :src: bpy.types.PAINT_OT_hide_show_masked
msgid "Hide/show all masked vertices above a threshold"
msgstr ""
"முகமூடி அணிந்த அனைத்து செங்குத்துகளையும் ஒரு வாசலுக்கு மேலே மறைக்க/காட்டு"

#. :src: bpy.types.PAINT_OT_hide_show_polyline_gesture
msgctxt "Operator"
msgid "Hide/Show Polyline"
msgstr "பாலிலைனை மறைக்க/காட்டு"

#. :src: bpy.types.PAINT_OT_image_from_view
msgctxt "Operator"
msgid "Image from View"
msgstr "பார்வையில் இருந்து படம்"

#. :src: bpy.types.PAINT_OT_image_from_view
msgid "Make an image from biggest 3D view for reprojection"
msgstr ""
"மறுபரிசீலனைக்கு மிகப்பெரிய 3d பார்வையில் இருந்து ஒரு படத்தை உருவாக்கவும்"

#. :src: bpy.types.PAINT_OT_image_from_view.filepath
#. :src: bpy.types.WM_OT_append.filename
#. :src: bpy.types.WM_OT_id_linked_relocate.filename
#. :src: bpy.types.WM_OT_lib_reload.filename
#. :src: bpy.types.WM_OT_lib_relocate.filename
#. :src: bpy.types.WM_OT_link.filename
msgid "Name of the file"
msgstr "கோப்பின் பெயர்"

#. :src: bpy.types.PAINT_OT_image_paint
msgctxt "Operator"
msgid "Image Paint"
msgstr "உருவ வண்ணப்பூச்சு"

#. :src: bpy.types.PAINT_OT_image_paint
msgid "Paint a stroke into the image"
msgstr "படத்தில் ஒரு வீச்சு வரை வண்ணம் தீட்டவும்"

#. :src: bpy.types.PAINT_OT_mask_box_gesture
msgctxt "Operator"
msgid "Mask Box Gesture"
msgstr "முகமூடி பெட்டி சைகை"

#. :src: bpy.types.PAINT_OT_mask_box_gesture
msgid "Mask within a rectangle defined by the cursor"
msgstr "கர்சரால் வரையறுக்கப்பட்ட ஒரு செவ்வகத்திற்குள் முகமூடி"

#. :src: bpy.types.PAINT_OT_mask_box_gesture.mode:'VALUE'
#. :src: bpy.types.PAINT_OT_mask_flood_fill.mode:'VALUE'
#. :src: bpy.types.PAINT_OT_mask_lasso_gesture.mode:'VALUE'
#. :src: bpy.types.PAINT_OT_mask_line_gesture.mode:'VALUE'
#. :src: bpy.types.PAINT_OT_mask_polyline_gesture.mode:'VALUE'
msgid "Set mask to the level specified by the 'value' property"
msgstr "'மதிப்பு' சொத்து மூலம் குறிப்பிடப்பட்ட நிலைக்கு முகமூடியை அமைக்கவும்"

#. :src: bpy.types.PAINT_OT_mask_box_gesture.mode:'VALUE_INVERSE'
#. :src: bpy.types.PAINT_OT_mask_flood_fill.mode:'VALUE_INVERSE'
#. :src: bpy.types.PAINT_OT_mask_lasso_gesture.mode:'VALUE_INVERSE'
#. :src: bpy.types.PAINT_OT_mask_line_gesture.mode:'VALUE_INVERSE'
#. :src: bpy.types.PAINT_OT_mask_polyline_gesture.mode:'VALUE_INVERSE'
msgid "Value Inverted"
msgstr "மதிப்பு தலைகீழ்"

#. :src: bpy.types.PAINT_OT_mask_box_gesture.mode:'VALUE_INVERSE'
#. :src: bpy.types.PAINT_OT_mask_flood_fill.mode:'VALUE_INVERSE'
#. :src: bpy.types.PAINT_OT_mask_lasso_gesture.mode:'VALUE_INVERSE'
#. :src: bpy.types.PAINT_OT_mask_line_gesture.mode:'VALUE_INVERSE'
#. :src: bpy.types.PAINT_OT_mask_polyline_gesture.mode:'VALUE_INVERSE'
msgid "Set mask to the level specified by the inverted 'value' property"
msgstr ""
"தலைகீழ் 'மதிப்பு' சொத்து மூலம் குறிப்பிடப்பட்ட நிலைக்கு முகமூடியை அமைக்கவும்"

#. :src: bpy.types.PAINT_OT_mask_box_gesture.mode:'INVERT'
#. :src: bpy.types.PAINT_OT_mask_flood_fill.mode:'INVERT'
#. :src: bpy.types.PAINT_OT_mask_lasso_gesture.mode:'INVERT'
#. :src: bpy.types.PAINT_OT_mask_line_gesture.mode:'INVERT'
#. :src: bpy.types.PAINT_OT_mask_polyline_gesture.mode:'INVERT'
msgid "Invert the mask"
msgstr "முகமூடியைத் தலைகீழாக மாற்றவும்"

#. :src: bpy.types.PAINT_OT_mask_box_gesture.value
#. :src: bpy.types.PAINT_OT_mask_flood_fill.value
#. :src: bpy.types.PAINT_OT_mask_lasso_gesture.value
#. :src: bpy.types.PAINT_OT_mask_line_gesture.value
#. :src: bpy.types.PAINT_OT_mask_polyline_gesture.value
msgid ""
"Mask level to use when mode is 'Value'; zero means no masking and one is "
"fully masked"
msgstr ""
"பயன்முறை 'மதிப்பு' ஆக இருக்கும்போது பயன்படுத்த முகமூடி நிலை; பூச்சியம் "
"என்றால் முகமூடி இல்லை, ஒன்று முழுமையாக மறைக்கப்படுகிறது"

#. :src: bpy.types.PAINT_OT_mask_flood_fill
msgctxt "Operator"
msgid "Mask Flood Fill"
msgstr "முகமூடி வெள்ள நிரப்புதல்"

#. :src: bpy.types.PAINT_OT_mask_flood_fill
msgid "Fill the whole mask with a given value, or invert its values"
msgstr ""
"கொடுக்கப்பட்ட மதிப்புடன் முழு முகமூடியையும் நிரப்பவும் அல்லது அதன் "
"மதிப்புகளைத் தலைகீழாக மாற்றவும்"

#. :src: bpy.types.PAINT_OT_mask_lasso_gesture
msgctxt "Operator"
msgid "Mask Lasso Gesture"
msgstr "முகமூடி லச்சோ சைகை"

#. :src: bpy.types.PAINT_OT_mask_lasso_gesture
#. :src: bpy.types.PAINT_OT_mask_polyline_gesture
msgid "Mask within a shape defined by the cursor"
msgstr "கர்சரால் வரையறுக்கப்பட்ட வடிவத்திற்குள் மறைக்கவும்"

#. :src: bpy.types.PAINT_OT_mask_line_gesture
msgctxt "Operator"
msgid "Mask Line Gesture"
msgstr "முகமூடி வரி சைகை"

#. :src: bpy.types.PAINT_OT_mask_line_gesture
msgid "Mask to one side of a line defined by the cursor"
msgstr "கர்சரால் வரையறுக்கப்பட்ட ஒரு வரியின் ஒரு பக்கத்திற்கு மறைக்கவும்"

#. :src: bpy.types.PAINT_OT_mask_polyline_gesture
msgctxt "Operator"
msgid "Mask Polyline Gesture"
msgstr "முகமூடி பாலிலைன் சைகை"

#. :src: bpy.types.PAINT_OT_project_image
msgctxt "Operator"
msgid "Project Image"
msgstr "திட்ட படம்"

#. :src: bpy.types.PAINT_OT_project_image
msgid "Project an edited render from the active camera back onto the object"
msgstr ""
"செயலில் உள்ள கேமராவிலிருந்து திருத்தப்பட்ட ரெண்டரை மீண்டும் பொருளின் மீது "
"திட்டமிடுங்கள்"

#. :src: bpy.types.PAINT_OT_sample_color
msgid "Use the mouse to sample a color in the image"
msgstr "படத்தில் ஒரு வண்ணத்தை மாதிரி செய்ய சுட்டியைப் பயன்படுத்தவும்"

#. :src: bpy.types.PAINT_OT_sample_color.merged
msgid "Sample Merged"
msgstr "மாதிரி ஒன்றிணைந்தது"

#. :src: bpy.types.PAINT_OT_sample_color.merged
msgid "Sample the output display color"
msgstr "வெளியீட்டு காட்சி நிறத்தை மாதிரி செய்யுங்கள்"

#. :src: bpy.types.PAINT_OT_sample_color.palette
msgid "Add to Palette"
msgstr "தட்டில் சேர்க்கவும்"

#. :src: bpy.types.PAINT_OT_texture_paint_toggle
msgctxt "Operator"
msgid "Texture Paint Mode"
msgstr "அமைப்பு வண்ணப்பூச்சு முறை"

#. :src: bpy.types.PAINT_OT_texture_paint_toggle
msgid "Toggle texture paint mode in 3D view"
msgstr "3d பார்வையில் அமைப்பு வண்ணப்பூச்சு பயன்முறையை மாற்றவும்"

#. :src: bpy.types.PAINT_OT_vert_select_all
msgid "Change selection for all vertices"
msgstr "எல்லா செங்குத்துகளுக்கும் தேர்வை மாற்றவும்"

#. :src: bpy.types.PAINT_OT_vert_select_hide
msgctxt "Operator"
msgid "Vertex Select Hide"
msgstr "வெர்டெக்ச் மறைக்க தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.PAINT_OT_vert_select_hide
msgid "Hide selected vertices"
msgstr "தேர்ந்தெடுக்கப்பட்ட செங்குத்துகளை மறைக்கவும்"

#. :src: bpy.types.PAINT_OT_vert_select_hide.unselected
msgid "Hide unselected rather than selected vertices"
msgstr "தேர்ந்தெடுக்கப்பட்ட செங்குத்துகளை விட தேர்வு செய்யப்படாததை மறைக்கவும்"

#. :src: bpy.types.PAINT_OT_vert_select_less
msgid "Deselect Vertices connected to existing selection"
msgstr "இருக்கும் தேர்வுடன் இணைக்கப்பட்ட செங்குத்துகளைத் தேர்வுசெய்க"

#. :src: bpy.types.PAINT_OT_vert_select_linked
msgctxt "Operator"
msgid "Select Linked Vertices"
msgstr "இணைக்கப்பட்ட செங்குத்துகளைத் தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.PAINT_OT_vert_select_linked
msgid "Select linked vertices"
msgstr "இணைக்கப்பட்ட செங்குத்துகளைத் தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.PAINT_OT_vert_select_linked_pick
msgctxt "Operator"
msgid "Select Linked Vertices Pick"
msgstr "இணைக்கப்பட்ட செங்குத்துகள் தேர்வு என்பதைத் தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.PAINT_OT_vert_select_linked_pick
msgid "Select linked vertices under the cursor"
msgstr "கர்சரின் கீழ் இணைக்கப்பட்ட செங்குத்துகளைத் தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.PAINT_OT_vert_select_linked_pick.select
msgid "Whether to select or deselect linked vertices under the cursor"
msgstr ""
"கர்சரின் கீழ் இணைக்கப்பட்ட செங்குத்துகளைத் தேர்ந்தெடுக்க வேண்டுமா அல்லது "
"தேர்வுநீக்க வேண்டுமா"

#. :src: bpy.types.PAINT_OT_vert_select_more
msgid "Select Vertices connected to existing selection"
msgstr "இருக்கும் தேர்வுடன் இணைக்கப்பட்ட செங்குத்துகளைத் தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.PAINT_OT_vertex_color_dirt.blur_iterations
msgid "Blur Iterations"
msgstr "மங்கலான மறு செய்கைகள்"

#. :src: bpy.types.PAINT_OT_vertex_color_dirt.blur_iterations
msgid "Number of times to blur the colors (higher blurs more)"
msgstr "வண்ணங்களை மங்கச் செய்ய எண்ணிக்கை (அதிக மங்கலானது)"

#. :src: bpy.types.PAINT_OT_vertex_color_dirt.blur_strength
msgid "Blur Strength"
msgstr "மங்கலான வலிமை"

#. :src: bpy.types.PAINT_OT_vertex_color_dirt.blur_strength
msgid "Blur strength per iteration"
msgstr "மறு செய்கைக்கு மங்கலான வலிமை"

#. :src: bpy.types.PAINT_OT_vertex_color_dirt.clean_angle
msgid "Highlight Angle"
msgstr "கோணம் முன்னிலைப்படுத்தவும்"

#. :src: bpy.types.PAINT_OT_vertex_color_dirt.clean_angle
#. :src: bpy.types.PAINT_OT_vertex_color_dirt.dirt_angle
msgid "Less than 90 limits the angle used in the tonal range"
msgstr ""
"90 க்கும் குறைவானது டோனல் வரம்பில் பயன்படுத்தப்படும் கோணத்தை "
"கட்டுப்படுத்துகிறது"

#. :src: bpy.types.PAINT_OT_vertex_color_dirt.dirt_angle
msgid "Dirt Angle"
msgstr "அழுக்கு கோணம்"

#. :src: bpy.types.PAINT_OT_vertex_color_dirt.dirt_only
msgid "Dirt Only"
msgstr "அழுக்கு மட்டுமே"

#. :src: bpy.types.PAINT_OT_vertex_color_dirt.dirt_only
msgid "Don't calculate cleans for convex areas"
msgstr "குவிந்த பகுதிகளுக்கு சுத்தங்களை கணக்கிட வேண்டாம்"

#. :src: bpy.types.PAINT_OT_vertex_color_dirt.normalize
msgid "Normalize the colors, increasing the contrast"
msgstr "வண்ணங்களை இயல்பாக்குங்கள், மாறுபாட்டை அதிகரிக்கும்"

#. :src: bpy.types.PAINT_OT_vertex_color_from_weight
msgctxt "Operator"
msgid "Vertex Color from Weight"
msgstr "எடையிலிருந்து வெர்டெக்ச் நிறம்"

#. :src: bpy.types.PAINT_OT_vertex_color_from_weight
msgid "Convert active weight into gray scale vertex colors"
msgstr "செயலில் எடையை சாம்பல் அளவிலான வெர்டெக்ச் வண்ணங்களாக மாற்றவும்"

#. :src: bpy.types.PAINT_OT_vertex_color_hsv
msgid "Adjust vertex color Hue/Saturation/Value"
msgstr "வெர்டெக்ச் வண்ண சாயல்/செறிவு/மதிப்பை சரிசெய்யவும்"

#. :src: bpy.types.PAINT_OT_vertex_color_set
msgctxt "Operator"
msgid "Set Vertex Colors"
msgstr "வெர்டெக்ச் வண்ணங்களை அமைக்கவும்"

#. :src: bpy.types.PAINT_OT_vertex_color_set
msgid "Fill the active vertex color layer with the current paint color"
msgstr ""
"தற்போதைய வண்ணப்பூச்சு வண்ணத்துடன் செயலில் உள்ள வெர்டெக்ச் வண்ண அடுக்கை "
"நிரப்பவும்"

#. :src: bpy.types.PAINT_OT_vertex_color_set.use_alpha
msgid "Set color completely opaque instead of reusing existing alpha"
msgstr ""
"ஏற்கனவே உள்ள ஆல்பாவை மீண்டும் பயன்படுத்துவதற்கு பதிலாக வண்ணத்தை முற்றிலும் "
"ஒளிபுகாதாக அமைக்கவும்"

#. :src: bpy.types.PAINT_OT_vertex_color_smooth
msgctxt "Operator"
msgid "Smooth Vertex Colors"
msgstr "மென்மையான வெர்டெக்ச் வண்ணங்கள்"

#. :src: bpy.types.PAINT_OT_vertex_color_smooth
msgid "Smooth colors across vertices"
msgstr "செங்குத்துகள் முழுவதும் மென்மையான வண்ணங்கள்"

#. :src: bpy.types.PAINT_OT_vertex_paint
msgctxt "Operator"
msgid "Vertex Paint"
msgstr "வெர்டெக்ச் பெயிண்ட்"

#. :src: bpy.types.PAINT_OT_vertex_paint
msgid "Paint a stroke in the active color attribute layer"
msgstr "செயலில் உள்ள வண்ண பண்புக்கூறு அடுக்கில் ஒரு வீச்சு வண்ணம் தீட்டவும்"

#. :src: bpy.types.PAINT_OT_vertex_paint.override_location
#. :src: bpy.types.PAINT_OT_weight_paint.override_location
#. :src: bpy.types.SCULPT_OT_brush_stroke.override_location
msgid "Override Location"
