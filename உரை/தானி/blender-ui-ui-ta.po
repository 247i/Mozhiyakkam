#. :src: bpy.types.UV_OT_cylinder_project.correct_aspect
#. :src: bpy.types.UV_OT_project_from_view.correct_aspect
#. :src: bpy.types.UV_OT_smart_project.correct_aspect
#. :src: bpy.types.UV_OT_sphere_project.correct_aspect
