msgstr ""
"இந்த கண்காணிப்பு தரவு பொருளில் செயலில் வானூர்தி கண்காணிப்பு. நீக்கப்பட்டது, "
"பொருள்களைப் பயன்படுத்துங்கள் [பெயர்] .plane_tracks.active"

#. :src: bpy.types.MovieTrackingReconstructedCameras
msgid "Reconstructed Cameras"
msgstr "புனரமைக்கப்பட்ட கேமராக்கள்"

#. :src: bpy.types.MovieTrackingReconstructedCameras
#. :src: bpy.types.MovieTrackingReconstruction.cameras
msgid "Collection of solved cameras"
msgstr "தீர்க்கப்பட்ட கேமராக்களின் சேகரிப்பு"

#. :src: bpy.types.MovieTrackingReconstruction
msgid "Movie tracking reconstruction data"
msgstr "திரைப்பட கண்காணிப்பு புனரமைப்பு தரவு"

#. :src: bpy.types.MovieTrackingReconstruction
msgid "Match-moving reconstruction data from tracker"
msgstr "டிராக்கரிடமிருந்து மேட்ச்-நகரும் புனரமைப்பு தரவு"

#. :src: bpy.types.MovieTrackingReconstruction.is_valid
msgid "Reconstructed"
msgstr "புனரமைக்கப்பட்டது"

#. :src: bpy.types.MovieTrackingReconstruction.is_valid
msgid "Whether the tracking data contains valid reconstruction information"
msgstr ""
"கண்காணிப்பு தரவுகளில் செல்லுபடியாகும் புனரமைப்பு தகவல்கள் உள்ளதா என்பது"

#. :src: bpy.types.MovieTrackingSettings
msgid "Movie tracking settings"
msgstr "திரைப்பட கண்காணிப்பு அமைப்புகள்"

#. :src: bpy.types.MovieTrackingSettings
msgid "Match moving settings"
msgstr "நகரும் அமைப்புகளை பொருத்தவும்"

#. :src: bpy.types.MovieTrackingSettings.clean_action
#. :src: bpy.types.CLIP_OT_clean_tracks.action
msgid "Cleanup action to execute"
msgstr "செயல்படுத்த தூய்மைப்படுத்தும் நடவடிக்கை"

#. :src: bpy.types.MovieTrackingSettings.clean_action:'SELECT'
#. :src: bpy.types.CLIP_OT_clean_tracks.action:'SELECT'
msgid "Select unclean tracks"
msgstr "அசுத்தமான தடங்களைத் தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.MovieTrackingSettings.clean_action:'DELETE_TRACK'
#. :src: bpy.types.CLIP_OT_clean_tracks.action:'DELETE_TRACK'
msgid "Delete Track"
msgstr "தடத்தை நீக்கு"

#. :src: bpy.types.MovieTrackingSettings.clean_action:'DELETE_TRACK'
#. :src: bpy.types.CLIP_OT_clean_tracks.action:'DELETE_TRACK'
msgid "Delete unclean tracks"
msgstr "அசுத்தமான தடங்களை நீக்கு"

#. :src: bpy.types.MovieTrackingSettings.clean_action:'DELETE_SEGMENTS'
#. :src: bpy.types.CLIP_OT_clean_tracks.action:'DELETE_SEGMENTS'
msgid "Delete Segments"
msgstr "பிரிவுகளை நீக்கு"

#. :src: bpy.types.MovieTrackingSettings.clean_action:'DELETE_SEGMENTS'
#. :src: bpy.types.CLIP_OT_clean_tracks.action:'DELETE_SEGMENTS'
msgid "Delete unclean segments of tracks"
msgstr "தடங்களின் அசுத்தமான பிரிவுகளை நீக்கு"

#. :src: bpy.types.MovieTrackingSettings.clean_error
#. :src: bpy.types.CLIP_OT_clean_tracks.error
msgid "Reprojection Error"
msgstr "மறுபரிசீலனை பிழை"

#. :src: bpy.types.MovieTrackingSettings.clean_error
msgid "Effect on tracks which have a larger re-projection error"
msgstr "பெரிய மறு-திட்ட பிழையைக் கொண்ட தடங்களில் விளைவு"

#. :src: bpy.types.MovieTrackingSettings.clean_frames
#. :src: bpy.types.CLIP_OT_clean_tracks.frames
msgid "Tracked Frames"
msgstr "கண்காணிக்கப்பட்ட பிரேம்கள்"

#. :src: bpy.types.MovieTrackingSettings.clean_frames
msgid ""
"Effect on tracks which are tracked less than the specified amount of frames"
msgstr ""
"குறிப்பிட்ட அளவு பிரேம்களைக் காட்டிலும் குறைவாக கண்காணிக்கப்படும் தடங்களின் "
"விளைவு"

#. :src: bpy.types.MovieTrackingSettings.default_correlation_min
#. :src: bpy.types.MovieTrackingTrack.correlation_min
msgid "Correlation"
msgstr "தொடர்பு"

#. :src: bpy.types.MovieTrackingSettings.default_correlation_min
msgid ""
"Default minimum value of correlation between matched pattern and reference "
"that is still treated as successful tracking"
msgstr ""
"பொருந்திய வடிவத்திற்கும் குறிப்புக்கும் இடையிலான தொடர்புகளின் இயல்புநிலை "
"குறைந்தபட்ச மதிப்பு இன்னும் வெற்றிகரமான கண்காணிப்பாக கருதப்படுகிறது"

#. :src: bpy.types.MovieTrackingSettings.default_frames_limit
#. :src: bpy.types.MovieTrackingTrack.frames_limit
msgid "Frames Limit"
msgstr "பிரேம்கள் வரம்பு"

#. :src: bpy.types.MovieTrackingSettings.default_frames_limit
#. :src: bpy.types.MovieTrackingTrack.frames_limit
msgid "Every tracking cycle, this number of frames are tracked"
msgstr ""
"ஒவ்வொரு கண்காணிப்பு சுழற்சியும், இந்த எண்ணிக்கையிலான பிரேம்கள் "
"கண்காணிக்கப்படுகின்றன"

#. :src: bpy.types.MovieTrackingSettings.default_margin
msgid "Default distance from image boundary at which marker stops tracking"
msgstr "மார்க்கர் கண்காணிப்பதை நிறுத்தும் பட எல்லையிலிருந்து இயல்புநிலை தூரம்"

#. :src: bpy.types.MovieTrackingSettings.default_motion_model
#. :src: bpy.types.MovieTrackingTrack.motion_model
msgid "Motion Model"
msgstr "இயக்க மாதிரி"

#. :src: bpy.types.MovieTrackingSettings.default_motion_model
#. :src: bpy.types.MovieTrackingTrack.motion_model
msgid "Default motion model to use for tracking"
msgstr "கண்காணிப்புக்கு பயன்படுத்த இயல்புநிலை இயக்க மாதிரி"

#. :src: bpy.types.MovieTrackingSettings.default_motion_model:'Perspective'
#. :src: bpy.types.MovieTrackingTrack.motion_model:'Perspective'
msgid ""
"Search for markers that are perspectively deformed (homography) between "
"frames"
msgstr ""
"பிரேம்களுக்கு இடையில் முன்னோக்கி சிதைந்த (ஓமோகிராஃபி) குறிப்பான்களைத் "
"தேடுங்கள்"

#. :src: bpy.types.MovieTrackingSettings.default_motion_model:'Affine'
#. :src: bpy.types.MovieTrackingTrack.motion_model:'Affine'
msgid "Affine"
msgstr "மண்டை"

#. :src: bpy.types.MovieTrackingSettings.default_motion_model:'Affine'
#. :src: bpy.types.MovieTrackingTrack.motion_model:'Affine'
msgid ""
"Search for markers that are affine-deformed (t, r, k, and skew) between "
"frames"
msgstr ""
"பிரேம்களுக்கு இடையில் அஃபைன்-சிதைந்த (t, r, k, மற்றும் skew) குறிப்பான்களைத்"
" தேடுங்கள்"

#. :src: bpy.types.MovieTrackingSettings.default_motion_model:'LocRotScale'
#. :src: bpy.types.MovieTrackingTrack.motion_model:'LocRotScale'
msgid ""
"Search for markers that are translated, rotated, and scaled between frames"
msgstr ""
"மொழிபெயர்க்கப்பட்ட, சுழற்றப்பட்ட மற்றும் பிரேம்களுக்கு இடையில் அளவிடப்படும் "
"குறிப்பான்களைத் தேடுங்கள்"

#. :src: bpy.types.MovieTrackingSettings.default_motion_model:'LocScale'
#. :src: bpy.types.MovieTrackingTrack.motion_model:'LocScale'
msgid "Search for markers that are translated and scaled between frames"
msgstr ""
"பிரேம்களுக்கு இடையில் மொழிபெயர்க்கப்பட்ட மற்றும் அளவிடப்பட்ட குறிப்பான்களைத்"
" தேடுங்கள்"

#. :src: bpy.types.MovieTrackingSettings.default_motion_model:'LocRot'
#. :src: bpy.types.MovieTrackingTrack.motion_model:'LocRot'
msgid "Search for markers that are translated and rotated between frames"
msgstr ""
"பிரேம்களுக்கு இடையில் மொழிபெயர்க்கப்பட்டு சுழற்றப்படும் குறிப்பான்களைத் "
"தேடுங்கள்"

#. :src: bpy.types.MovieTrackingSettings.default_motion_model:'Loc'
#. :src: bpy.types.MovieTrackingTrack.motion_model:'Loc'
msgid "Search for markers that are translated between frames"
msgstr "பிரேம்களுக்கு இடையில் மொழிபெயர்க்கப்பட்ட குறிப்பான்களைத் தேடுங்கள்"

#. :src: bpy.types.MovieTrackingSettings.default_pattern_match
#. :src: bpy.types.MovieTrackingTrack.pattern_match
msgid "Pattern Match"
msgstr "முறை போட்டி"

#. :src: bpy.types.MovieTrackingSettings.default_pattern_match
#. :src: bpy.types.MovieTrackingTrack.pattern_match
msgid "Track pattern from given frame when tracking marker to next frame"
msgstr ""
"மார்க்கரைக் கண்காணிக்கும் போது கொடுக்கப்பட்ட சட்டத்திலிருந்து அடுத்த "
"சட்டகத்திற்கு கண்காணிப்பு முறை"

#. :src: bpy.types.MovieTrackingSettings.default_pattern_match:'KEYFRAME'
#. :src: bpy.types.MovieTrackingTrack.pattern_match:'KEYFRAME'
msgid "Track pattern from keyframe to next frame"
msgstr "கீஃப்ரேமில் இருந்து அடுத்த சட்டகம் வரை கண்காணிப்பு முறை"

#. :src: bpy.types.MovieTrackingSettings.default_pattern_match:'PREV_FRAME'
#. :src: bpy.types.MovieTrackingTrack.pattern_match:'PREV_FRAME'
msgid "Previous frame"
msgstr "முந்தைய சட்டகம்"

#. :src: bpy.types.MovieTrackingSettings.default_pattern_match:'PREV_FRAME'
#. :src: bpy.types.MovieTrackingTrack.pattern_match:'PREV_FRAME'
msgid "Track pattern from current frame to next frame"
msgstr "தற்போதைய சட்டகத்திலிருந்து அடுத்த சட்டகம் வரை கண்காணிப்பு முறை"

#. :src: bpy.types.MovieTrackingSettings.default_pattern_size
msgid "Pattern Size"
msgstr "முறை அளவு"

#. :src: bpy.types.MovieTrackingSettings.default_pattern_size
msgid "Size of pattern area for newly created tracks"
msgstr "புதிதாக உருவாக்கப்பட்ட தடங்களுக்கான மாதிரி பரப்பின் அளவு"

#. :src: bpy.types.MovieTrackingSettings.default_search_size
msgid "Search Size"
msgstr "தேடல் அளவு"

#. :src: bpy.types.MovieTrackingSettings.default_search_size
msgid "Size of search area for newly created tracks"
msgstr "புதிதாக உருவாக்கப்பட்ட தடங்களுக்கான தேடல் பரப்பின் அளவு"

#. :src: bpy.types.MovieTrackingSettings.default_weight
msgid "Influence of newly created track on a final solution"
msgstr "இறுதி தீர்வில் புதிதாக உருவாக்கப்பட்ட பாதையின் தாக்கம்"

#. :src: bpy.types.MovieTrackingSettings.distance
msgid "Distance between two bundles used for scene scaling"
msgstr ""
"காட்சி அளவிடுவதற்கு பயன்படுத்தப்படும் இரண்டு மூட்டைகளுக்கு இடையிலான தூரம்"

#. :src: bpy.types.MovieTrackingSettings.object_distance
msgid "Distance between two bundles used for object scaling"
msgstr ""
"பொருள் அளவிடுதலுக்குப் பயன்படுத்தப்படும் இரண்டு மூட்டைகளுக்கு இடையிலான தூரம்"

#. :src: bpy.types.MovieTrackingSettings.refine_intrinsics_focal_length
msgid "Refine Focal Length"
msgstr "குவிய நீளத்தை செம்மைப்படுத்துங்கள்"

#. :src: bpy.types.MovieTrackingSettings.refine_intrinsics_focal_length
msgid "Refine focal length during camera solving"
msgstr "கேமரா தீர்க்கும் போது குவிய நீளத்தை செம்மைப்படுத்தவும்"

#. :src: bpy.types.MovieTrackingSettings.refine_intrinsics_principal_point
msgid "Refine Principal Point"
msgstr "முதன்மை புள்ளியைச் சுத்திகரிக்கவும்"

#. :src: bpy.types.MovieTrackingSettings.refine_intrinsics_principal_point
msgid "Refine principal point during camera solving"
msgstr "கேமரா தீர்க்கும் போது முதன்மை புள்ளியைச் செம்மைப்படுத்துங்கள்"

#. :src: bpy.types.MovieTrackingSettings.refine_intrinsics_radial_distortion
msgid "Refine Radial"
msgstr "ரேடியல் சண்டை"

#. :src: bpy.types.MovieTrackingSettings.refine_intrinsics_radial_distortion
msgid "Refine radial coefficients of distortion model during camera solving"
msgstr ""
"கேமரா தீர்க்கும் போது விலகல் மாதிரியின் ரேடியல் குணகங்களை "
"செம்மைப்படுத்துங்கள்"

#. :src:
#. bpy.types.MovieTrackingSettings.refine_intrinsics_tangential_distortion
msgid "Refine Tangential"
msgstr "தொடுநிலை செம்மைப்படுத்துங்கள்"

#. :src:
#. bpy.types.MovieTrackingSettings.refine_intrinsics_tangential_distortion
msgid ""
"Refine tangential coefficients of distortion model during camera solving"
msgstr ""
"கேமரா தீர்க்கும் போது விலகல் மாதிரியின் உறுதியான குணகங்களை "
"செம்மைப்படுத்துங்கள்"

#. :src: bpy.types.MovieTrackingSettings.speed
msgid ""
"Limit speed of tracking to make visual feedback easier (this does not affect"
" the tracking quality)"
msgstr ""
"காட்சி பின்னூட்டத்தை எளிதாக்க கண்காணிப்பின் வேகத்தை கட்டுப்படுத்துங்கள் (இது"
" கண்காணிப்பு தரத்தை பாதிக்காது)"

#. :src: bpy.types.MovieTrackingSettings.speed:'FASTEST'
msgid "Fastest"
msgstr "வேகமான"

#. :src: bpy.types.MovieTrackingSettings.speed:'FASTEST'
msgid "Track as fast as possible"
msgstr "முடிந்தவரை வேகமாக கண்காணிக்கவும்"

#. :src: bpy.types.MovieTrackingSettings.speed:'DOUBLE'
#. :src: bpy.types.GeometryNodeStoreNamedGrid.data_type:'DOUBLE'
#. :src:
#. bpy.types.SEQUENCER_OT_strip_modifier_equalizer_redefine.graphs:'DOUBLE'
msgid "Double"
msgstr "இரட்டை"

#. :src: bpy.types.MovieTrackingSettings.speed:'DOUBLE'
msgid "Track with double speed"
msgstr "இரட்டை வேகத்துடன் கண்காணிக்கவும்"

#. :src: bpy.types.MovieTrackingSettings.speed:'REALTIME'
msgid "Track with realtime speed"
msgstr "நிகழ்நேர வேகத்துடன் கண்காணிக்கவும்"

#. :src: bpy.types.MovieTrackingSettings.speed:'HALF'
msgid "Track with half of realtime speed"
msgstr "நிகழ்நேர வேகத்தில் பாதியைக் கண்காணிக்கவும்"

#. :src: bpy.types.MovieTrackingSettings.speed:'QUARTER'
msgid "Quarter"
msgstr "கால்"

#. :src: bpy.types.MovieTrackingSettings.speed:'QUARTER'
msgid "Track with quarter of realtime speed"
msgstr "நிகழ்நேர வேகத்தின் காலாண்டுடன் கண்காணிக்கவும்"

#. :src: bpy.types.MovieTrackingSettings.use_default_blue_channel
#. :src: bpy.types.MovieTrackingTrack.use_blue_channel
msgid "Use Blue Channel"
msgstr "நீல சேனலைப் பயன்படுத்தவும்"

#. :src: bpy.types.MovieTrackingSettings.use_default_blue_channel
#. :src: bpy.types.MovieTrackingTrack.use_blue_channel
msgid "Use blue channel from footage for tracking"
msgstr "கண்காணிப்புக்கு காட்சிகளிலிருந்து நீல சேனலைப் பயன்படுத்தவும்"

#. :src: bpy.types.MovieTrackingSettings.use_default_brute
#. :src: bpy.types.MovieTrackingTrack.use_brute
msgid "Prepass"
msgstr "முன்கூட்டியே"

#. :src: bpy.types.MovieTrackingSettings.use_default_brute
msgid "Use a brute-force translation-only initialization when tracking"
msgstr ""
"கண்காணிக்கும்போது முரட்டுத்தனமான-சக்தி மொழிபெயர்ப்பு-மட்டும் துவக்கத்தைப் "
"பயன்படுத்தவும்"

#. :src: bpy.types.MovieTrackingSettings.use_default_green_channel
#. :src: bpy.types.MovieTrackingTrack.use_green_channel
msgid "Use Green Channel"
msgstr "பச்சை சேனலைப் பயன்படுத்தவும்"

#. :src: bpy.types.MovieTrackingSettings.use_default_green_channel
#. :src: bpy.types.MovieTrackingTrack.use_green_channel
msgid "Use green channel from footage for tracking"
msgstr "கண்காணிப்புக்கு காட்சிகளிலிருந்து பச்சை சேனலைப் பயன்படுத்தவும்"

#. :src: bpy.types.MovieTrackingSettings.use_default_mask
#. :src: bpy.types.MovieTrackingTrack.use_mask
msgid "Use Mask"
msgstr "முகமூடியைப் பயன்படுத்தவும்"

#. :src: bpy.types.MovieTrackingSettings.use_default_mask
#. :src: bpy.types.MovieTrackingTrack.use_mask
msgid ""
"Use a Grease Pencil data-block as a mask to use only specified areas of "
"pattern when tracking"
msgstr ""
"கண்காணிக்கும்போது குறிப்பிட்ட வடிவிலான பகுதிகளை மட்டுமே பயன்படுத்த கிரீச் "
"பென்சில் தரவு-தொகுதியைப் பயன்படுத்தவும்"

#. :src: bpy.types.MovieTrackingSettings.use_default_normalization
#. :src: bpy.types.MovieTrackingTrack.use_normalization
msgid "Normalize light intensities while tracking (slower)"
msgstr "கண்காணிக்கும் போது ஒளி தீவிரங்களை இயல்பாக்குங்கள் (மெதுவாக)"

#. :src: bpy.types.MovieTrackingSettings.use_default_red_channel
#. :src: bpy.types.MovieTrackingTrack.use_red_channel
msgid "Use Red Channel"
msgstr "சிவப்பு சேனலைப் பயன்படுத்தவும்"

#. :src: bpy.types.MovieTrackingSettings.use_default_red_channel
#. :src: bpy.types.MovieTrackingTrack.use_red_channel
msgid "Use red channel from footage for tracking"
msgstr "கண்காணிப்புக்கு காட்சிகளிலிருந்து சிவப்பு சேனலைப் பயன்படுத்தவும்"

#. :src: bpy.types.MovieTrackingSettings.use_keyframe_selection
msgid "Keyframe Selection"
msgstr "கீஃப்ரேம் தேர்வு"

#. :src: bpy.types.MovieTrackingSettings.use_keyframe_selection
msgid "Automatically select keyframes when solving camera/object motion"
msgstr ""
"கேமரா/பொருள் இயக்கத்தை தீர்க்கும்போது தானாக கீஃப்ரேம்களைத் தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.MovieTrackingSettings.use_tripod_solver
msgid "Tripod Motion"
msgstr "முக்காலி இயக்கம்"

#. :src: bpy.types.MovieTrackingSettings.use_tripod_solver
msgid "Use special solver to track a stable camera position, such as a tripod"
msgstr ""
"முக்காலி போன்ற நிலையான கேமரா நிலையைக் கண்காணிக்க சிறப்பு தீர்வைப் "
"பயன்படுத்தவும்"

#. :src: bpy.types.MovieTrackingStabilization
msgid "Movie tracking stabilization data"
msgstr "திரைப்பட கண்காணிப்பு உறுதிப்படுத்தல் தரவு"

#. :src: bpy.types.MovieTrackingStabilization
msgid "2D stabilization based on tracking markers"
msgstr "கண்காணிப்பு குறிப்பான்களின் அடிப்படையில் 2 டி உறுதிப்படுத்தல்"

#. :src: bpy.types.MovieTrackingStabilization.active_rotation_track_index
msgid "Active Rotation Track Index"
msgstr "செயலில் சுழற்சி தட அட்டவணை"

#. :src: bpy.types.MovieTrackingStabilization.active_rotation_track_index
msgid "Index of active track in rotation stabilization tracks list"
msgstr ""
"சுழற்சி உறுதிப்படுத்தல் தடங்கள் பட்டியலில் செயலில் உள்ள பாதையின் அட்டவணை"

#. :src: bpy.types.MovieTrackingStabilization.active_track_index
msgid "Active Track Index"
msgstr "ஆக்டிவ் டிராக் இன்டெக்ச்"

#. :src: bpy.types.MovieTrackingStabilization.active_track_index
msgid "Index of active track in translation stabilization tracks list"
msgstr ""
"மொழிபெயர்ப்பு உறுதிப்படுத்தல் தடங்கள் பட்டியலில் செயலில் உள்ள பாதையின் "
"அட்டவணை"

#. :src: bpy.types.MovieTrackingStabilization.anchor_frame
msgid "Anchor Frame"
msgstr "நங்கூரம் சட்டகம்"

#. :src: bpy.types.MovieTrackingStabilization.anchor_frame
msgid ""
"Reference point to anchor stabilization (other frames will be adjusted "
"relative to this frame's position)"
msgstr ""
"நங்கூரம் உறுதிப்படுத்தலுக்கான குறிப்பு புள்ளி (இந்த சட்டகத்தின் நிலைக்கு "
"ஒப்பிடும்போது பிற பிரேம்கள் சரிசெய்யப்படும்)"

#. :src: bpy.types.MovieTrackingStabilization.filter_type
