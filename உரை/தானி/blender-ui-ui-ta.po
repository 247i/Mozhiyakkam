msgid "Start Radius"
msgstr "ஆரம் தொடங்கவும்"

#: source/blender/nodes/geometry/nodes/node_geo_curve_primitive_spiral.cc:27
msgid "End Radius"
msgstr "ஆரம் இறுதி"

#: source/blender/nodes/geometry/nodes/node_geo_curve_primitive_spiral.cc:18
msgctxt "NodeTree"
msgid "Rotations"
msgstr "சுழற்சிகள்"

#: source/blender/nodes/geometry/nodes/node_geo_curve_primitive_spiral.cc:17
msgid "Number of points in one rotation of the spiral"
msgstr "சுழற்சியின் ஒரு சுழற்சியில் புள்ளிகளின் எண்ணிக்கை"

#: source/blender/nodes/geometry/nodes/node_geo_curve_primitive_spiral.cc:21
msgid "Number of times the spiral makes a full rotation"
msgstr "சுழல் ஒரு முழு சுழற்சியை உருவாக்குகிறது"

#: source/blender/nodes/geometry/nodes/node_geo_curve_primitive_spiral.cc:26
msgid "Horizontal Distance from the Z axis at the start of the spiral"
msgstr "சுழல் தொடக்கத்தில் சட் அச்சிலிருந்து கிடைமட்ட தூரம்"

#: source/blender/nodes/geometry/nodes/node_geo_curve_primitive_spiral.cc:30
msgid "Horizontal Distance from the Z axis at the end of the spiral"
msgstr "சுழல் முடிவில் சட் அச்சிலிருந்து கிடைமட்ட தூரம்"

#: source/blender/nodes/geometry/nodes/node_geo_curve_primitive_spiral.cc:34
msgid "The height perpendicular to the base of the spiral"
msgstr "சுழல் அடிப்பகுதிக்கு செங்குத்தாக உயரம்"

#: source/blender/nodes/geometry/nodes/node_geo_curve_primitive_spiral.cc:35
msgid "Switch the direction from clockwise to counterclockwise"
msgstr "கடிகார திசையில் இருந்து எதிரெதிர் திசையில் திசையை மாற்றவும்"

#: source/blender/nodes/geometry/nodes/node_geo_curve_primitive_star.cc:18
msgid "Inner Radius"
msgstr "உள் ஆரம்"

#: source/blender/nodes/geometry/nodes/node_geo_curve_primitive_star.cc:23
msgid "Outer Radius"
msgstr "வெளிப்புற ஆரம்"

#: source/blender/nodes/geometry/nodes/node_geo_curve_primitive_star.cc:32
msgid "Outer Points"
msgstr "வெளிப்புற புள்ளிகள்"

#: source/blender/nodes/geometry/nodes/node_geo_curve_primitive_star.cc:17
msgid "Number of points on each of the circles"
msgstr "ஒவ்வொரு வட்டத்திலும் புள்ளிகளின் எண்ணிக்கை"

#: source/blender/nodes/geometry/nodes/node_geo_curve_primitive_star.cc:22
msgid "Radius of the inner circle; can be larger than outer radius"
msgstr "உள் வட்டத்தின் ஆரம்; வெளிப்புற ஆரம் விட பெரியதாக இருக்கலாம்"

#: source/blender/nodes/geometry/nodes/node_geo_curve_primitive_star.cc:27
msgid "Radius of the outer circle; can be smaller than inner radius"
msgstr "வெளிப்புற வட்டத்தின் ஆரம்; உள் ஆரம் விட சிறியதாக இருக்கலாம்"

#: source/blender/nodes/geometry/nodes/node_geo_curve_primitive_star.cc:30
msgid "The counterclockwise rotation of the inner set of points"
msgstr "புள்ளிகளின் உள் தொகுப்பின் எதிரெதிர் திசையில் சுழற்சி"

#: source/blender/nodes/geometry/nodes/node_geo_curve_primitive_star.cc:34
msgid "An attribute field with a selection of the outer points"
msgstr "வெளிப்புற புள்ளிகளின் தேர்வைக் கொண்ட ஒரு பண்புக்கூறு புலம்"

#: source/blender/nodes/geometry/nodes/node_geo_curve_resample.cc:47
msgid "Curves to resample"
msgstr "மறுசீரமைக்க வளைவுகள்"

#: source/blender/nodes/geometry/nodes/node_geo_curve_resample.cc:52
msgid "How to specify the amount of samples"
msgstr "மாதிரிகளின் அளவைக் குறிப்பிடுவது எப்படி"

#: source/blender/nodes/geometry/nodes/node_geo_curve_reverse.cc:17
msgid "Curves to switch the start and end of"
msgstr "தொடக்க மற்றும் முடிவை மாற்ற வளைவுகள்"

