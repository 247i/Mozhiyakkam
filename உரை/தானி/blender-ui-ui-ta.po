#. :src: bpy.types.PAINT_OT_mask_lasso_gesture.smooth_stroke_factor
#. :src: bpy.types.SCULPT_OT_face_set_lasso_gesture.smooth_stroke_factor
#. :src: bpy.types.SCULPT_OT_trim_lasso_gesture.smooth_stroke_factor
#. :src: bpy.types.UV_OT_select_lasso.smooth_stroke_factor
#. :src: bpy.types.VIEW3D_OT_select_lasso.smooth_stroke_factor
msgid "Smooth Stroke Factor"
msgstr "மென்மையான வீச்சு காரணி"

#. :src: bpy.types.Brush.smooth_stroke_factor
msgid "Higher values give a smoother stroke"
msgstr "அதிக மதிப்புகள் மென்மையான பக்கவாதத்தை அளிக்கின்றன"

#. :src: bpy.types.Brush.smooth_stroke_radius
#. :src: bpy.types.ACTION_OT_select_lasso.smooth_stroke_radius
#. :src: bpy.types.CLIP_OT_select_lasso.smooth_stroke_radius
#. :src: bpy.types.GRAPH_OT_select_lasso.smooth_stroke_radius
#. :src: bpy.types.GREASE_PENCIL_OT_erase_lasso.smooth_stroke_radius
#. :src: bpy.types.GREASE_PENCIL_OT_stroke_trim.smooth_stroke_radius
#. :src: bpy.types.MASK_OT_select_lasso.smooth_stroke_radius
#. :src: bpy.types.NODE_OT_select_lasso.smooth_stroke_radius
