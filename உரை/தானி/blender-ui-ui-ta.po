msgid "Copy Modifiers to Selected Objects"
msgstr "தேர்ந்தெடுக்கப்பட்ட பொருள்களுக்கு மாற்றியமைப்பாளர்களை நகலெடுக்கவும்"

#. :src: bpy.types.OBJECT_OT_modifiers_copy_to_selected
msgid "Copy modifiers to other selected objects"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட பிற பொருட்களுக்கு மாற்றியமைப்பாளர்களை நகலெடுக்கவும்"

#. :src: bpy.types.OBJECT_OT_move_to_collection
msgid "Move objects to a collection"
msgstr "பொருள்களை ஒரு சேகரிப்புக்கு நகர்த்தவும்"

#. :src: bpy.types.OBJECT_OT_move_to_collection.collection_uid
msgid "Session UID of the collection to move to"
msgstr "சேகரிப்பின் அமர்வு uid க்கு செல்ல"

#. :src: bpy.types.OBJECT_OT_move_to_collection.is_new
msgid "Move objects to a new collection"
msgstr "புதிய சேகரிப்புக்கு பொருள்களை நகர்த்தவும்"

#. :src: bpy.types.OBJECT_OT_multires_base_apply
msgctxt "Operator"
msgid "Multires Apply Base"
msgstr "பன்முகத்தன்மை தளத்தைப் பயன்படுத்துகிறது"

#. :src: bpy.types.OBJECT_OT_multires_base_apply
msgid "Modify the base mesh to conform to the displaced mesh"
msgstr "இடம்பெயர்ந்த கண்ணிக்கு இணங்க அடிப்படை கண்ணி மாற்றவும்"

#. :src: bpy.types.OBJECT_OT_multires_external_pack
msgctxt "Operator"
msgid "Multires Pack External"
msgstr "பன்முகத்தன்மை கொண்டது"

#. :src: bpy.types.OBJECT_OT_multires_external_pack
msgid "Pack displacements from an external file"
msgstr "வெளிப்புற கோப்பிலிருந்து இடப்பெயர்வுகளை பேக் செய்யுங்கள்"

#. :src: bpy.types.OBJECT_OT_multires_external_save
msgctxt "Operator"
msgid "Multires Save External"
msgstr "பன்முகத்தன்மை வெளிப்புறத்தை சேமிக்கிறது"

#. :src: bpy.types.OBJECT_OT_multires_external_save
msgid "Save displacements to an external file"
msgstr "வெளிப்புற கோப்பில் இடப்பெயர்வுகளைச் சேமிக்கவும்"

#. :src: bpy.types.OBJECT_OT_multires_higher_levels_delete
msgctxt "Operator"
msgid "Delete Higher Levels"
msgstr "உயர் மட்டங்களை நீக்கவும்"

#. :src: bpy.types.OBJECT_OT_multires_higher_levels_delete
msgid "Deletes the higher resolution mesh, potential loss of detail"
msgstr "அதிக தெளிவுத்திறன் கண்ணி நீக்குகிறது, விவரம் இழப்பு"

#. :src: bpy.types.OBJECT_OT_multires_rebuild_subdiv
msgctxt "Operator"
msgid "Rebuild Lower Subdivisions"
msgstr "குறைந்த துணைப்பிரிவுகளை மீண்டும் உருவாக்குங்கள்"

#. :src: bpy.types.OBJECT_OT_multires_rebuild_subdiv
msgid ""
"Rebuilds all possible subdivisions levels to generate a lower resolution "
"base mesh"
msgstr ""
"குறைந்த தீர்மானம் அடிப்படை கண்ணி உருவாக்க சாத்தியமான அனைத்து "
"துணைப்பிரிவுகளின் நிலைகளையும் மீண்டும் உருவாக்குகிறது"

#. :src: bpy.types.OBJECT_OT_multires_reshape
msgctxt "Operator"
msgid "Multires Reshape"
msgstr "மறுசீரமைப்பு"

#. :src: bpy.types.OBJECT_OT_multires_reshape
msgid "Copy vertex coordinates from other object"
msgstr "மற்ற பொருளிலிருந்து வெர்டெக்ச் ஆயங்களை நகலெடுக்கவும்"

#. :src: bpy.types.OBJECT_OT_multires_subdivide
msgctxt "Operator"
msgid "Multires Subdivide"
msgstr "பன்முகத்தன்மை கொண்ட துணைப்பிரிவு"

#. :src: bpy.types.OBJECT_OT_multires_subdivide
msgid "Add a new level of subdivision"
msgstr "புதிய அளவிலான துணைப்பிரிவைச் சேர்க்கவும்"

#. :src: bpy.types.OBJECT_OT_multires_subdivide.mode
msgid "Subdivision Mode"
msgstr "துணைப்பிரிவு முறை"

#. :src: bpy.types.OBJECT_OT_multires_subdivide.mode
msgid "How the mesh is going to be subdivided to create a new level"
msgstr "ஒரு புதிய நிலையை உருவாக்க கண்ணி எவ்வாறு பிரிக்கப் போகிறது"

#. :src: bpy.types.OBJECT_OT_multires_subdivide.mode:'CATMULL_CLARK'
msgid "Create a new level using Catmull-Clark subdivisions"
msgstr ""
"கேட்மல்-கிளார்க் துணைப்பிரிவுகளைப் பயன்படுத்தி புதிய நிலையை உருவாக்கவும்"

#. :src: bpy.types.OBJECT_OT_multires_subdivide.mode:'SIMPLE'
msgid "Create a new level using simple subdivisions"
msgstr "எளிய உட்பிரிவுகளைப் பயன்படுத்தி புதிய நிலையை உருவாக்கவும்"

#. :src: bpy.types.OBJECT_OT_multires_subdivide.mode:'LINEAR'
msgid ""
"Create a new level using linear interpolation of the sculpted displacement"
msgstr ""
"செதுக்கப்பட்ட இடப்பெயர்ச்சியின் நேரியல் இடைக்கணிப்பைப் பயன்படுத்தி புதிய "
"நிலையை உருவாக்கவும்"

#. :src: bpy.types.OBJECT_OT_multires_unsubdivide
msgctxt "Operator"
msgid "Unsubdivide"
msgstr "subdivide"

#. :src: bpy.types.OBJECT_OT_multires_unsubdivide
msgid "Rebuild a lower subdivision level of the current base mesh"
msgstr ""
"தற்போதைய அடிப்படை கண்ணி குறைந்த உட்பிரிவு அளவை மீண்டும் உருவாக்குங்கள்"

#. :src: bpy.types.OBJECT_OT_ocean_bake
msgctxt "Operator"
msgid "Bake Ocean"
msgstr "சுட்டுக்கொள்ளும் கடல்"

#. :src: bpy.types.OBJECT_OT_ocean_bake
msgid "Bake an image sequence of ocean data"
msgstr "கடல் தரவின் பட வரிசையை சுட்டுக்கொள்ளுங்கள்"

#. :src: bpy.types.OBJECT_OT_ocean_bake.free
msgid "Free the bake, rather than generating it"
msgstr "சுட்டுக்கொள்ளுவதை விட, சுட்டுக்கொள்ளுங்கள்"

#. :src: bpy.types.OBJECT_OT_origin_clear
msgctxt "Operator"
msgid "Clear Origin"
msgstr "தெளிவான தோற்றம்"

#. :src: bpy.types.OBJECT_OT_origin_clear
msgid "Clear the object's origin"
msgstr "பொருளின் தோற்றத்தை அழிக்கவும்"

#. :src: bpy.types.OBJECT_OT_origin_set
msgid ""
"Set the object's origin, by either moving the data, or set to center of "
"data, or use 3D cursor"
msgstr ""
"தரவை நகர்த்துவதன் மூலமாகவோ அல்லது தரவின் மையமாக அமைக்கவோ அல்லது 3d கர்சரைப் "
"பயன்படுத்தவும் பொருளின் தோற்றத்தை அமைக்கவும்"

#. :src: bpy.types.OBJECT_OT_origin_set.center:'MEDIAN'
msgid "Median Center"
msgstr "சராசரி நடுவண்"

#. :src: bpy.types.OBJECT_OT_origin_set.center:'BOUNDS'
msgid "Bounds Center"
msgstr "எல்லைகள் நடுவண்"

#. :src: bpy.types.OBJECT_OT_origin_set.type:'GEOMETRY_ORIGIN'
msgid "Geometry to Origin"
msgstr "தோற்றத்திற்கு வடிவியல்"

#. :src: bpy.types.OBJECT_OT_origin_set.type:'GEOMETRY_ORIGIN'
msgid "Move object geometry to object origin"
msgstr "பொருள் வடிவவியலை பொருள் தோற்றத்திற்கு நகர்த்தவும்"

#. :src: bpy.types.OBJECT_OT_origin_set.type:'ORIGIN_GEOMETRY'
msgid "Origin to Geometry"
msgstr "வடிவவியலுக்கான தோற்றம்"

#. :src: bpy.types.OBJECT_OT_origin_set.type:'ORIGIN_GEOMETRY'
msgid ""
"Calculate the center of geometry based on the current pivot point (median, "
"otherwise bounding box)"
msgstr ""
"தற்போதைய பிவோட் புள்ளியின் அடிப்படையில் வடிவவியலின் மையத்தைக் கணக்கிடுங்கள் "
"(சராசரி, இல்லையெனில் எல்லை பெட்டி)"

#. :src: bpy.types.OBJECT_OT_origin_set.type:'ORIGIN_CURSOR'
msgid "Origin to 3D Cursor"
msgstr "3d கர்சருக்கு தோற்றம்"

#. :src: bpy.types.OBJECT_OT_origin_set.type:'ORIGIN_CURSOR'
msgid "Move object origin to position of the 3D cursor"
msgstr "பொருள் தோற்றத்தை 3d கர்சரின் நிலைக்கு நகர்த்தவும்"

#. :src: bpy.types.OBJECT_OT_origin_set.type:'ORIGIN_CENTER_OF_MASS'
msgid "Origin to Center of Mass (Surface)"
msgstr "வெகுசன மையத்திற்கு தோற்றம் (மேற்பரப்பு)"

#. :src: bpy.types.OBJECT_OT_origin_set.type:'ORIGIN_CENTER_OF_MASS'
msgid "Calculate the center of mass from the surface area"
msgstr "மேற்பரப்பு பரப்பிலிருந்து வெகுசன மையத்தை கணக்கிடுங்கள்"

#. :src: bpy.types.OBJECT_OT_origin_set.type:'ORIGIN_CENTER_OF_VOLUME'
msgid "Origin to Center of Mass (Volume)"
msgstr "வெகுசன மையத்திற்கு தோற்றம் (தொகுதி)"

#. :src: bpy.types.OBJECT_OT_origin_set.type:'ORIGIN_CENTER_OF_VOLUME'
msgid ""
"Calculate the center of mass from the volume (must be manifold geometry with"
" consistent normals)"
msgstr ""
"அளவிலிருந்து வெகுசன மையத்தைக் கணக்கிடுங்கள் (நிலையான இயல்புடன் பன்மடங்கு "
"வடிவவியலாக இருக்க வேண்டும்)"

#. :src: bpy.types.OBJECT_OT_parent_clear
msgid "Clear the object's parenting"
msgstr "பொருளின் பெற்றோரை அழிக்கவும்"

#. :src: bpy.types.OBJECT_OT_parent_clear.type:'CLEAR'
msgid ""
"Completely clear the parenting relationship, including involved modifiers if"
" any"
msgstr ""
"சம்பந்தப்பட்ட மாற்றியமைப்பாளர்கள் ஏதேனும் இருந்தால் பெற்றோருக்குரிய உறவை "
"முற்றிலுமாக அழிக்கவும்"

#. :src: bpy.types.OBJECT_OT_parent_clear.type:'CLEAR_KEEP_TRANSFORM'
msgid "Clear and Keep Transformation"
msgstr "தெளிவான மற்றும் மாற்றத்தை வைத்திருங்கள்"

#. :src: bpy.types.OBJECT_OT_parent_clear.type:'CLEAR_KEEP_TRANSFORM'
msgid ""
"As 'Clear Parent', but keep the current visual transformations of the object"
msgstr ""
"'தெளிவான பெற்றோர்', ஆனால் பொருளின் தற்போதைய காட்சி மாற்றங்களை வைத்திருங்கள்"

#. :src: bpy.types.OBJECT_OT_parent_clear.type:'CLEAR_INVERSE'
msgid "Clear Parent Inverse"
msgstr "பெற்றோர் தலைகீழ்"

#. :src: bpy.types.OBJECT_OT_parent_clear.type:'CLEAR_INVERSE'
msgid ""
"Reset the transform corrections applied to the parenting relationship, does "
"not remove parenting itself"
msgstr ""
"பெற்றோருக்குரிய உறவுக்கு பயன்படுத்தப்படும் உருமாற்ற திருத்தங்களை "
"மீட்டமைக்கவும், பெற்றோருக்குரியது நீக்காது"

#. :src: bpy.types.OBJECT_OT_parent_inverse_apply
msgctxt "Operator"
msgid "Apply Parent Inverse"
msgstr "பெற்றோர் தலைகீழ் பயன்படுத்துங்கள்"

#. :src: bpy.types.OBJECT_OT_parent_inverse_apply
msgid "Apply the object's parent inverse to its data"
msgstr "பொருளின் பெற்றோர் அதன் தரவுக்கு நேர்மாறாகப் பயன்படுத்துங்கள்"

#. :src: bpy.types.OBJECT_OT_parent_no_inverse_set
msgctxt "Operator"
msgid "Make Parent without Inverse"
msgstr "தலைகீழ் இல்லாமல் பெற்றோரை உருவாக்குங்கள்"

#. :src: bpy.types.OBJECT_OT_parent_no_inverse_set
msgid ""
"Set the object's parenting without setting the inverse parent correction"
msgstr "தலைகீழ் பெற்றோர் திருத்தத்தை அமைக்காமல் பொருளின் பெற்றோரை அமைக்கவும்"

#. :src: bpy.types.OBJECT_OT_parent_no_inverse_set.keep_transform
#. :src: bpy.types.OBJECT_OT_parent_set.keep_transform
msgid "Keep Transform"
msgstr "மாற்றத்தைத் தொடருங்கள்"

#. :src: bpy.types.OBJECT_OT_parent_no_inverse_set.keep_transform
msgid "Preserve the world transform throughout parenting"
msgstr "பெற்றோர் முழுவதும் உலக மாற்றத்தை பாதுகாக்கவும்"

#. :src: bpy.types.OBJECT_OT_parent_set
msgid "Set the object's parenting"
msgstr "பொருளின் பெற்றோரை அமைக்கவும்"

#. :src: bpy.types.OBJECT_OT_parent_set.keep_transform
msgid "Apply transformation before parenting"
msgstr "பெற்றோருக்கு முன் மாற்றத்தைப் பயன்படுத்துங்கள்"

#. :src: bpy.types.OBJECT_OT_parent_set.type:'ARMATURE'
#: source/blender/editors/object/object_relations.cc:1008
msgid "Armature Deform"
msgstr "ஆர்மேச்சர் சிதைவு"

#. :src: bpy.types.OBJECT_OT_parent_set.type:'ARMATURE_NAME'
#: source/blender/editors/object/object_relations.cc:1012
msgid "   With Empty Groups"
msgstr "   வெற்று குழுக்களுடன்"

#. :src: bpy.types.OBJECT_OT_parent_set.type:'ARMATURE_AUTO'
#: source/blender/editors/object/object_relations.cc:1020
msgid "   With Automatic Weights"
msgstr "   தானியங்கி எடையுடன்"

#. :src: bpy.types.OBJECT_OT_parent_set.type:'ARMATURE_ENVELOPE'
#: source/blender/editors/object/object_relations.cc:1016
msgid "   With Envelope Weights"
msgstr "   உறை எடையுடன்"

#. :src: bpy.types.OBJECT_OT_parent_set.type:'BONE_RELATIVE'
#: source/blender/editors/object/object_relations.cc:1025
msgid "Bone Relative"
msgstr "எலும்பு உறவினர்"

#. :src: bpy.types.OBJECT_OT_parent_set.type:'CURVE'
#: scripts/startup/bl_ui/properties_data_curve.py:114
#: source/blender/editors/object/object_relations.cc:1029
msgid "Curve Deform"
msgstr "வளைவு சிதைவு"

#. :src: bpy.types.OBJECT_OT_parent_set.type:'PATH_CONST'
#: source/blender/editors/object/object_relations.cc:1033
msgid "Path Constraint"
msgstr "பாதை கட்டுப்பாடு"

#. :src: bpy.types.OBJECT_OT_parent_set.type:'LATTICE'
#: source/blender/editors/object/object_relations.cc:1037
msgid "Lattice Deform"
msgstr "லட்டு சிதைவு"

#. :src: bpy.types.OBJECT_OT_parent_set.type:'VERTEX_TRI'
#: source/blender/editors/object/object_relations.cc:1050
msgid "Vertex (Triangle)"
msgstr "வெர்டெக்ச் (முக்கோணம்)"

#. :src: bpy.types.OBJECT_OT_parent_set.xmirror
msgid "X Mirror"
msgstr "ஃச் கண்ணாடி"

#. :src: bpy.types.OBJECT_OT_parent_set.xmirror
msgid ""
"Apply weights symmetrically along X axis, for Envelope/Automatic vertex "
"groups creation"
msgstr ""
"உறை/தானியங்கி வெர்டெக்ச் குழுக்கள் உருவாக்குவதற்கு ஃச் அச்சில் சமச்சீராக "
"எடையை பயன்படுத்துங்கள்"

#. :src: bpy.types.OBJECT_OT_particle_system_add
msgctxt "Operator"
msgid "Add Particle System Slot"
msgstr "துகள் அமைப்பு ச்லாட் சேர்க்கவும்"

#. :src: bpy.types.OBJECT_OT_particle_system_add
msgid "Add a particle system"
msgstr "ஒரு துகள் அமைப்பைச் சேர்க்கவும்"

#. :src: bpy.types.OBJECT_OT_particle_system_remove
msgctxt "Operator"
msgid "Remove Particle System Slot"
msgstr "துகள் அமைப்பு ச்லாட்டை அகற்று"

#. :src: bpy.types.OBJECT_OT_particle_system_remove
msgid "Remove the selected particle system"
msgstr "தேர்ந்தெடுக்கப்பட்ட துகள் அமைப்பை அகற்று"

#. :src: bpy.types.OBJECT_OT_paste_transform
msgid ""
"Pastes the matrix from the clipboard to the currently active pose bone or "
"object. Uses world-space matrices"
msgstr ""
"கிளிப்போர்டிலிருந்து தற்போது செயலில் உள்ள போச் எலும்பு அல்லது பொருளுக்கு "
"மேட்ரிக்சை ஒட்டுகிறது. உலக-விண்வெளி மெட்ரிக்குகளைப் பயன்படுத்துகிறது"

#. :src: bpy.types.OBJECT_OT_paste_transform.bake_step
msgid ""
"Only used for baking. Step=1 creates a key on every frame, step=2 bakes on "
"2s, etc"
msgstr ""
"பேக்கிங்கிற்கு மட்டுமே பயன்படுத்தப்படுகிறது. படி = 1 ஒவ்வொரு சட்டகத்திலும் "
"ஒரு விசையை உருவாக்குகிறது, 2s இல் படி = 2 பேக்ச், முதலியன"

#. :src: bpy.types.OBJECT_OT_paste_transform.method
msgid "Paste Method"
msgstr "முறை முறை"

#. :src: bpy.types.OBJECT_OT_paste_transform.method
msgid ""
"Update the current transform, selected keyframes, or even create new keys"
msgstr ""
"தற்போதைய உருமாற்றம், தேர்ந்தெடுக்கப்பட்ட கீஃப்ரேம்களைப் புதுப்பிக்கவும் "
"அல்லது புதிய விசைகளை உருவாக்கவும்"

#. :src: bpy.types.OBJECT_OT_paste_transform.method:'CURRENT'
msgid "Current Transform"
msgstr "தற்போதைய உருமாற்றம்"

#. :src: bpy.types.OBJECT_OT_paste_transform.method:'CURRENT'
msgid ""
"Paste onto the current values only, only manipulating the animation data if "
"auto-keying is enabled"
msgstr ""
"தற்போதைய மதிப்புகளில் மட்டுமே ஒட்டவும், ஆட்டோ-கீட்டிங் இயக்கப்பட்டிருந்தால் "
"மட்டுமே அனிமேசன் தரவை கையாளுகிறது"

#. :src: bpy.types.OBJECT_OT_paste_transform.method:'EXISTING_KEYS'
msgid ""
"Paste onto frames that have a selected key, potentially creating new keys on"
" those frames"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட விசையைக் கொண்ட பிரேம்களில் ஒட்டவும், அந்த பிரேம்களில் "
"புதிய விசைகளை உருவாக்கும்"

#. :src: bpy.types.OBJECT_OT_paste_transform.method:'BAKE'
msgid "Bake on Key Range"
msgstr "முக்கிய வரம்பில் சுட்டுக்கொள்ளுங்கள்"

#. :src: bpy.types.OBJECT_OT_paste_transform.method:'BAKE'
msgid ""
"Paste onto all frames between the first and last selected key, creating new "
"keyframes if necessary"
msgstr ""
"முதல் மற்றும் கடைசி தேர்ந்தெடுக்கப்பட்ட விசைக்கு இடையில் உள்ள அனைத்து "
"பிரேம்களிலும் ஒட்டவும், தேவைப்பட்டால் புதிய கீஃப்ரேம்களை உருவாக்கவும்"

#. :src: bpy.types.OBJECT_OT_paste_transform.mirror_axis_loc
msgid "Location Axis"
msgstr "இருப்பிட அச்சு"

#. :src: bpy.types.OBJECT_OT_paste_transform.mirror_axis_loc
msgid "Coordinate axis used to mirror the location part of the transform"
msgstr ""
"உருமாற்றத்தின் இருப்பிட பகுதியை பிரதிபலிக்க பயன்படுத்தப்படும் ஒருங்கிணைப்பு "
"அச்சு"

#. :src: bpy.types.OBJECT_OT_paste_transform.mirror_axis_rot
#. :src: bpy.types.RigifyParameters.rotation_axis
msgid "Rotation Axis"
msgstr "சுழற்சி அச்சு"

#. :src: bpy.types.OBJECT_OT_paste_transform.mirror_axis_rot
msgid "Coordinate axis used to mirror the rotation part of the transform"
msgstr ""
"உருமாற்றத்தின் சுழற்சி பகுதியை பிரதிபலிக்க பயன்படுத்தப்படும் ஒருங்கிணைப்பு "
"அச்சு"

#. :src: bpy.types.OBJECT_OT_paste_transform.use_mirror
msgid "Mirror Transform"
msgstr "கண்ணாடி உருமாற்றம்"

#. :src: bpy.types.OBJECT_OT_paste_transform.use_mirror
msgid ""
"When pasting, mirror the transform relative to a specific object or bone"
msgstr ""
"ஒட்டும்போது, ஒரு குறிப்பிட்ட பொருள் அல்லது எலும்புடன் தொடர்புடைய "
"உருமாற்றத்தை பிரதிபலிக்கவும்"

#. :src: bpy.types.OBJECT_OT_paste_transform.use_relative
msgid "Use Relative Paste"
msgstr "உறவினர் பேச்டைப் பயன்படுத்தவும்"

#. :src: bpy.types.OBJECT_OT_paste_transform.use_relative
msgid ""
"When pasting, assume the pasted matrix is relative to another object (set in"
" the user interface)"
msgstr ""
"ஒட்டும்போது, ஒட்டப்பட்ட மேட்ரிக்ச் மற்றொரு பொருளுடன் தொடர்புடையது என்று "
"வைத்துக் கொள்ளுங்கள் (பயனர் இடைமுகத்தில் அமைக்கவும்)"

#. :src: bpy.types.OBJECT_OT_paths_calculate
msgctxt "Operator"
msgid "Calculate Object Motion Paths"
msgstr "பொருள் இயக்க பாதைகளைக் கணக்கிடுங்கள்"

#. :src: bpy.types.OBJECT_OT_paths_calculate
msgid "Generate motion paths for the selected objects"
msgstr "தேர்ந்தெடுக்கப்பட்ட பொருள்களுக்கான இயக்க பாதைகளை உருவாக்குங்கள்"

#. :src: bpy.types.OBJECT_OT_paths_calculate.display_type
#. :src: bpy.types.POSE_OT_paths_calculate.display_type
msgid "Display type"
msgstr "காட்சி வகை"

#. :src: bpy.types.OBJECT_OT_paths_calculate.range
#. :src: bpy.types.POSE_OT_paths_calculate.range
msgid "Computation Range"
msgstr "கணக்கீட்டு வரம்பு"

#. :src: bpy.types.OBJECT_OT_paths_clear
msgctxt "Operator"
msgid "Clear Object Paths"
msgstr "பொருள் பாதைகளை அழிக்கவும்"

#. :src: bpy.types.OBJECT_OT_paths_clear.only_selected
msgid "Only clear motion paths of selected objects"
msgstr "தேர்ந்தெடுக்கப்பட்ட பொருட்களின் தெளிவான இயக்க பாதைகள் மட்டுமே"

#. :src: bpy.types.OBJECT_OT_paths_update
msgctxt "Operator"
msgid "Update Object Paths"
msgstr "பொருள் பாதைகளைப் புதுப்பிக்கவும்"

#. :src: bpy.types.OBJECT_OT_paths_update
msgid "Recalculate motion paths for selected objects"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட பொருள்களுக்கான இயக்க பாதைகளை மீண்டும் கணக்கிடுங்கள்"

#. :src: bpy.types.OBJECT_OT_paths_update_visible
msgctxt "Operator"
msgid "Update All Object Paths"
msgstr "அனைத்து பொருள் பாதைகளையும் புதுப்பிக்கவும்"

#. :src: bpy.types.OBJECT_OT_paths_update_visible
msgid "Recalculate all visible motion paths for objects and poses"
msgstr ""
"பொருள்கள் மற்றும் போச்களுக்கான அனைத்து புலப்படும் இயக்க பாதைகளையும் மீண்டும்"
" கணக்கிடுங்கள்"

#. :src: bpy.types.OBJECT_OT_pointcloud_random_add
msgctxt "Operator"
msgid "Add Point Cloud"
msgstr "புள்ளி மேகத்தைச் சேர்க்கவும்"

#. :src: bpy.types.OBJECT_OT_pointcloud_random_add
msgid "Add a point cloud object to the scene"
msgstr "காட்சியில் ஒரு புள்ளி மேகக்கணி பொருளைச் சேர்க்கவும்"

#. :src: bpy.types.OBJECT_OT_posemode_toggle
msgctxt "Operator"
msgid "Toggle Pose Mode"
msgstr "போச் பயன்முறையை மாற்றவும்"

#. :src: bpy.types.OBJECT_OT_posemode_toggle
msgid "Enable or disable posing/selecting bones"
msgstr "எலும்புகளை ஏற்படுத்தும்/தேர்ந்தெடுப்பது அல்லது முடக்கு"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh
#: scripts/startup/bl_ui/properties_data_mesh.py:403
msgctxt "Operator"
msgid "QuadriFlow Remesh"
msgstr "குவாட்ரிப்லோ ரெமெச்"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh
msgid ""
"Create a new quad based mesh using the surface data of the current mesh. All"
" data layers will be lost"
msgstr ""
"தற்போதைய கண்ணி மேற்பரப்பு தரவைப் பயன்படுத்தி புதிய குவாட் அடிப்படையிலான "
"கண்ணி உருவாக்கவும். அனைத்து தரவு அடுக்குகளும் இழக்கப்படும்"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.mesh_area
msgid "Old Object Face Area"
msgstr "பழைய பொருள் முகம் பரப்பு"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.mesh_area
msgid ""
"This property is only used to cache the object area for later calculations"
msgstr ""
"இந்த சொத்து பின்னர் கணக்கீடுகளுக்கு பொருள் பரப்பை தற்காலிகமாக சேமிக்க "
"மட்டுமே பயன்படுத்தப்படுகிறது"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.mode
msgid "How to specify the amount of detail for the new mesh"
msgstr "புதிய கண்ணி விவரங்களின் அளவை எவ்வாறு குறிப்பிடுவது"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.mode:'RATIO'
msgid "Specify target number of faces relative to the current mesh"
msgstr ""
"தற்போதைய கண்ணி தொடர்புடைய முகங்களின் இலக்கு எண்ணிக்கையைக் குறிப்பிடவும்"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.mode:'EDGE'
#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.target_edge_length
#. :src: bpy.types.View3DOverlay.show_extra_edge_length
#: scripts/startup/bl_ui/space_view3d.py:7328
msgid "Edge Length"
msgstr "விளிம்பு நீளம்"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.mode:'EDGE'
msgid "Input target edge length in the new mesh"
msgstr "புதிய கண்ணி இலக்கு விளிம்பு நீளத்தை உள்ளிடவும்"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.mode:'FACES'
msgid "Input target number of faces in the new mesh"
msgstr "புதிய கண்ணி இல் உள்ள உள்ளீட்டு இலக்கு எண்ணிக்கை"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.preserve_attributes
msgid "Reproject attributes onto the new mesh"
msgstr "புதிய கண்ணி மீது இனப்பெருக்கம் பண்புக்கூறுகள்"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.seed
msgid ""
"Random seed to use with the solver. Different seeds will cause the remesher "
"to come up with different quad layouts on the mesh"
msgstr ""
"தீர்வுடன் பயன்படுத்த சீரற்ற விதை. வெவ்வேறு விதைகள் மெசில் வெவ்வேறு குவாட் "
"தளவமைப்புகளுடன் ரெமிசர் கொண்டு வரக்கூடும்"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.smooth_normals
msgid "Smooth Normals"
msgstr "மென்மையான இயல்பு"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.smooth_normals
msgid "Set the output mesh normals to smooth"
msgstr "வெளியீட்டு கண்ணி இயல்புகளை மென்மையாக அமைக்கவும்"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.target_edge_length
msgid "Target edge length in the new mesh"
msgstr "புதிய கண்ணி இலக்கு விளிம்பு நீளம்"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.target_faces
msgid "Number of Faces"
msgstr "முகங்களின் எண்ணிக்கை"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.target_faces
msgid "Approximate number of faces (quads) in the new mesh"
msgstr "புதிய கண்ணி மீது தோராயமான முகங்களின் (குவாட்ச்)"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.target_ratio
msgid "Relative number of faces compared to the current mesh"
msgstr "தற்போதைய கண்ணி உடன் ஒப்பிடும்போது முகங்களின் எண்ணிக்கை"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.use_mesh_symmetry
msgid "Use Mesh Symmetry"
msgstr "கண்ணி சமச்சீர் பயன்படுத்தவும்"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.use_mesh_symmetry
msgid "Generates a symmetrical mesh using the mesh symmetry configuration"
msgstr ""
"கண்ணி சமச்சீர் உள்ளமைவைப் பயன்படுத்தி ஒரு சமச்சீர் கண்ணி உருவாக்குகிறது"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.use_preserve_boundary
msgid "Preserve Mesh Boundary"
msgstr "கண்ணி எல்லையைப் பாதுகாக்கவும்"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.use_preserve_boundary
msgid "Try to preserve mesh boundary on the mesh"
msgstr "கண்ணி மீது கண்ணி எல்லையைப் பாதுகாக்க முயற்சிக்கவும்"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.use_preserve_sharp
msgid "Preserve Sharp"
msgstr "கூர்மையாக பாதுகாக்கவும்"

#. :src: bpy.types.OBJECT_OT_quadriflow_remesh.use_preserve_sharp
msgid "Try to preserve sharp features on the mesh"
msgstr "கண்ணி மீது கூர்மையான அம்சங்களை பாதுகாக்க முயற்சிக்கவும்"

#. :src: bpy.types.OBJECT_OT_quick_explode.amount
msgid "Number of Pieces"
msgstr "துண்டுகளின் எண்ணிக்கை"

#. :src: bpy.types.OBJECT_OT_quick_explode.fade
msgid "Fade the pieces over time"
msgstr "காலப்போக்கில் துண்டுகளை மங்கச் செய்யுங்கள்"

#. :src: bpy.types.OBJECT_OT_quick_explode.style
msgid "Explode Style"
msgstr "வெடிக்கும் நடை"

#. :src: bpy.types.OBJECT_OT_quick_explode.velocity
msgid "Outwards Velocity"
msgstr "வெளிப்புற விரைவு"

#. :src: bpy.types.OBJECT_OT_quick_fur.apply_hair_guides
msgid "Apply Hair Guides"
msgstr "முடி வழிகாட்டிகளைப் பயன்படுத்துங்கள்"

#. :src: bpy.types.OBJECT_OT_quick_fur.radius
msgid "Hair Radius"
msgstr "முடி ஆரம்"

#. :src: bpy.types.OBJECT_OT_quick_fur.use_frizz
msgid "Frizz"
msgstr "ஃப்ரிச்"

#. :src: bpy.types.OBJECT_OT_quick_fur.view_percentage
msgid "View Percentage"
msgstr "சதவீதத்தைக் காண்க"

#. :src: bpy.types.OBJECT_OT_quick_liquid.show_flows
msgid "Render Liquid Objects"
msgstr "திரவ பொருள்களை வழங்கவும்"

#. :src: bpy.types.OBJECT_OT_quick_liquid.show_flows
msgid "Keep the liquid objects visible during rendering"
msgstr "வழங்குதல் போது திரவ பொருட்களைத் தெரியும்"

#. :src: bpy.types.OBJECT_OT_quick_smoke.show_flows
msgid "Render Smoke Objects"
msgstr "புகை பொருள்களை வழங்கவும்"

#. :src: bpy.types.OBJECT_OT_quick_smoke.show_flows
msgid "Keep the smoke objects visible during rendering"
msgstr "வழங்குதல் போது புகை பொருட்களைத் தெரியும்"

#. :src: bpy.types.OBJECT_OT_quick_smoke.style
msgid "Smoke Style"
msgstr "புகை நடை"

#. :src: bpy.types.OBJECT_OT_quick_smoke.style:'BOTH'
msgid "Smoke & Fire"
msgstr "புகை & தீ"

#. :src: bpy.types.OBJECT_OT_randomize_transform.loc
#. :src: bpy.types.UV_OT_randomize_uv_transform.loc
msgid "Maximum distance the objects can spread over each axis"
msgstr "ஒவ்வொரு அச்சிலும் பொருள்கள் பரவக்கூடிய அதிகபட்ச தூரம்"

#. :src: bpy.types.OBJECT_OT_randomize_transform.random_seed
#. :src: bpy.types.UV_OT_randomize_uv_transform.random_seed
msgid "Seed value for the random generator"
msgstr "சீரற்ற செனரேட்டருக்கான விதை மதிப்பு"

#. :src: bpy.types.OBJECT_OT_randomize_transform.rot
msgid "Maximum rotation over each axis"
msgstr "ஒவ்வொரு அச்சிலும் அதிகபட்ச சுழற்சி"

#. :src: bpy.types.OBJECT_OT_randomize_transform.scale
#. :src: bpy.types.UV_OT_randomize_uv_transform.scale
msgid "Maximum scale randomization over each axis"
msgstr "ஒவ்வொரு அச்சிலும் அதிகபட்ச அளவிலான சீரற்றமயமாக்கல்"

#. :src: bpy.types.OBJECT_OT_randomize_transform.scale_even
#. :src: bpy.types.UV_OT_randomize_uv_transform.scale_even
msgid "Scale Even"
msgstr "அளவு கூட"

#. :src: bpy.types.OBJECT_OT_randomize_transform.scale_even
msgid "Use the same scale value for all axis"
msgstr "அனைத்து அச்சுகளுக்கும் ஒரே அளவிலான மதிப்பைப் பயன்படுத்தவும்"

#. :src: bpy.types.OBJECT_OT_randomize_transform.use_delta
msgid "Transform Delta"
msgstr "டெல்டாவை மாற்றவும்"

#. :src: bpy.types.OBJECT_OT_randomize_transform.use_delta
msgid "Randomize delta transform values instead of regular transform"
msgstr ""
"வழக்கமான உருமாற்றத்திற்கு பதிலாக டெல்டா உருமாற்ற மதிப்புகளை "
"சீரற்றதாக்குங்கள்"

#. :src: bpy.types.OBJECT_OT_randomize_transform.use_loc
#. :src: bpy.types.UV_OT_randomize_uv_transform.use_loc
msgid "Randomize Location"
msgstr "இருப்பிடத்தை சீரற்றதாக்குங்கள்"

#. :src: bpy.types.OBJECT_OT_randomize_transform.use_loc
#. :src: bpy.types.UV_OT_randomize_uv_transform.use_loc
msgid "Randomize the location values"
msgstr "இருப்பிட மதிப்புகளை சீரற்றதாக்குங்கள்"

#. :src: bpy.types.OBJECT_OT_randomize_transform.use_rot
#. :src: bpy.types.UV_OT_randomize_uv_transform.use_rot
msgid "Randomize Rotation"
msgstr "சீரற்ற சுழற்சியை"

#. :src: bpy.types.OBJECT_OT_randomize_transform.use_rot
msgid "Randomize the rotation values"
msgstr "சுழற்சி மதிப்புகளை சீரற்றதாக்குங்கள்"

#. :src: bpy.types.OBJECT_OT_randomize_transform.use_scale
#. :src: bpy.types.UV_OT_randomize_uv_transform.use_scale
msgid "Randomize Scale"
msgstr "சீரற்ற அளவை"

#. :src: bpy.types.OBJECT_OT_randomize_transform.use_scale
#. :src: bpy.types.UV_OT_randomize_uv_transform.use_scale
msgid "Randomize the scale values"
msgstr "அளவிலான மதிப்புகளை சீரற்றதாக்குங்கள்"

#. :src: bpy.types.OBJECT_OT_reset_override_library
#. :src: bpy.types.UI_OT_override_idtemplate_reset
msgctxt "Operator"
msgid "Reset Library Override"
msgstr "நூலகத்தை மீறுங்கள்"

#. :src: bpy.types.OBJECT_OT_reset_override_library
#. :src:
#. bpy.types.OUTLINER_OT_liboverride_operation.type:'OVERRIDE_LIBRARY_RESET'
msgid "Reset the selected local overrides to their linked references values"
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட உள்ளக மேலெழுதல்களை அவற்றின் இணைக்கப்பட்ட குறிப்புகள் "
"மதிப்புகளுக்கு மீட்டமைக்கவும்"

#. :src: bpy.types.OBJECT_OT_rotation_clear
msgctxt "Operator"
msgid "Clear Rotation"
msgstr "தெளிவான சுழற்சி"

#. :src: bpy.types.OBJECT_OT_rotation_clear
msgid "Clear the object's rotation"
msgstr "பொருளின் சுழற்சியை அழிக்கவும்"

#. :src: bpy.types.OBJECT_OT_rotation_clear.clear_delta
msgid ""
"Clear delta rotation in addition to clearing the normal rotation transform"
msgstr ""
"சாதாரண சுழற்சி உருமாற்றத்தை அழிப்பதோடு கூடுதலாக டெல்டா சுழற்சியை அழிக்கவும்"

#. :src: bpy.types.OBJECT_OT_scale_clear
msgid "Clear the object's scale"
msgstr "பொருளின் அளவை அழிக்கவும்"

#. :src: bpy.types.OBJECT_OT_scale_clear.clear_delta
msgid "Clear delta scale in addition to clearing the normal scale transform"
msgstr ""
"சாதாரண அளவிலான உருமாற்றத்தை அழிப்பதோடு கூடுதலாக டெல்டா அளவை அழிக்கவும்"

#. :src: bpy.types.OBJECT_OT_select_all
msgid "Change selection of all visible objects in scene"
msgstr "காட்சியில் காணக்கூடிய அனைத்து பொருட்களின் தேர்வையும் மாற்றவும்"

#. :src: bpy.types.OBJECT_OT_select_by_type
msgctxt "Operator"
msgid "Select by Type"
msgstr "வகை மூலம் தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.OBJECT_OT_select_by_type
msgid "Select all visible objects that are of a type"
msgstr ""
"ஒரு வகையைச் சேர்ந்த அனைத்து புலப்படும் பொருட்களையும் தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.OBJECT_OT_select_grouped
msgid "Select all visible objects grouped by various properties"
msgstr ""
"பல்வேறு பண்புகளால் தொகுக்கப்பட்ட அனைத்து புலப்படும் பொருட்களையும் "
"தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.OBJECT_OT_select_grouped.type:'SIBLINGS'
msgid "Shared parent"
msgstr "பகிரப்பட்ட பெற்றோர்"

#. :src: bpy.types.OBJECT_OT_select_grouped.type:'TYPE'
msgid "Shared object type"
msgstr "பகிரப்பட்ட பொருள் வகை"

#. :src: bpy.types.OBJECT_OT_select_grouped.type:'COLLECTION'
msgid "Shared collection"
msgstr "பகிரப்பட்ட சேகரிப்பு"

#. :src: bpy.types.OBJECT_OT_select_grouped.type:'PASS'
msgid "Render pass index"
msgstr "பாச் குறியீட்டை வழங்கவும்"

#. :src: bpy.types.OBJECT_OT_select_grouped.type:'COLOR'
msgid "Object color"
msgstr "பொருள் நிறம்"

#. :src: bpy.types.OBJECT_OT_select_grouped.type:'KEYINGSET'
msgid "Objects included in active Keying Set"
msgstr "செயலில் கீயிங் தொகுப்பில் சேர்க்கப்பட்ட பொருள்கள்"

#. :src: bpy.types.OBJECT_OT_select_grouped.type:'LIGHT_TYPE'
msgid "Light Type"
msgstr "ஒளி வகை"

#. :src: bpy.types.OBJECT_OT_select_grouped.type:'LIGHT_TYPE'
msgid "Matching light types"
msgstr "பொருந்தும் ஒளி வகைகள்"

#. :src: bpy.types.OBJECT_OT_select_hierarchy.direction
msgid "Direction to select in the hierarchy"
msgstr "வரிசைமுறையில் தேர்ந்தெடுக்க திசை"

#. :src: bpy.types.OBJECT_OT_select_hierarchy.direction:'CHILD'
#. :src: bpy.types.PoseBone.child
msgid "Child"
msgstr "குழந்தை"

#. :src: bpy.types.OBJECT_OT_select_less
msgid "Deselect objects at the boundaries of parent/child relationships"
msgstr "பெற்றோர்/குழந்தை உறவுகளின் எல்லைகளில் பொருட்களைத் தேர்வுசெய்க"

#. :src: bpy.types.OBJECT_OT_select_linked
msgid "Select all visible objects that are linked"
msgstr "இணைக்கப்பட்ட அனைத்து புலப்படும் பொருட்களையும் தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.OBJECT_OT_select_linked.type:'DUPGROUP'
msgid "Instanced Collection"
msgstr "நிறுவப்பட்ட சேகரிப்பு"

#. :src: bpy.types.OBJECT_OT_select_linked.type:'LIBRARY_OBDATA'
msgid "Library (Object Data)"
msgstr "நூலகம் (பொருள் தரவு)"

#. :src: bpy.types.OBJECT_OT_select_mirror
msgid ""
"Select the mirror objects of the selected object e.g. \"L.sword\" and "
"\"R.sword\""
msgstr ""
"தேர்ந்தெடுக்கப்பட்ட பொருளின் கண்ணாடி பொருள்களைத் தேர்ந்தெடுக்கவும் எ.கா. "
"\"எல்.கத்தி\" மற்றும் \"ஆர்.கத்தி\""

#. :src: bpy.types.OBJECT_OT_select_more
msgid "Select connected parent/child objects"
msgstr "இணைக்கப்பட்ட பெற்றோர்/குழந்தை பொருள்களைத் தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.OBJECT_OT_select_pattern.case_sensitive
#. :src: bpy.types.BatchRenameAction.replace_match_case
#: scripts/startup/bl_ui/space_outliner.py:454
msgid "Case Sensitive"
msgstr "வழக்கு உணர்திறன்"

#. :src: bpy.types.OBJECT_OT_select_pattern.case_sensitive
msgid "Do a case sensitive compare"
msgstr "ஒரு வழக்கு உணர்திறன் ஒப்பிட்டுப் பாருங்கள்"

#. :src: bpy.types.OBJECT_OT_select_pattern.pattern
msgctxt "Text"
msgid "Pattern"
msgstr "முறை"

#. :src: bpy.types.OBJECT_OT_select_pattern.pattern
msgid "Name filter using '*', '?' and '[abc]' unix style wildcards"
msgstr ""
"பெயர் வடிகட்டி '*', '?' மற்றும் '[ஏபிசி]' யூனிக்ச் பாணி காட்டு அட்டைகள்"

#. :src: bpy.types.OBJECT_OT_select_random
msgid "Select or deselect random visible objects"
msgstr ""
"சீரற்ற புலப்படும் பொருள்களைத் தேர்ந்தெடுக்கவும் அல்லது தேர்வுநீக்கவும்"

#. :src: bpy.types.OBJECT_OT_select_same_collection
msgctxt "Operator"
msgid "Select Same Collection"
msgstr "அதே தொகுப்பைத் தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.OBJECT_OT_select_same_collection
msgid "Select object in the same collection"
msgstr "அதே தொகுப்பில் பொருளைத் தேர்ந்தெடுக்கவும்"

#. :src: bpy.types.OBJECT_OT_select_same_collection.collection
msgid "Name of the collection to select"
msgstr "தேர்ந்தெடுக்க சேகரிப்பின் பெயர்"

#. :src: bpy.types.OBJECT_OT_shade_auto_smooth
msgctxt "Operator"
msgid "Shade Auto Smooth"
msgstr "நிழல் ஆட்டோ மென்மையானது"

#. :src: bpy.types.OBJECT_OT_shade_auto_smooth
msgid ""
"Add modifier to automatically set the sharpness of mesh edges based on the "
"angle between the neighboring faces"
msgstr ""
"அண்டை முகங்களுக்கு இடையிலான கோணத்தின் அடிப்படையில் கண்ணி விளிம்புகளின் "
"கூர்மையை தானாக அமைக்க மாற்றியமைப்பாளரைச் சேர்க்கவும்"

#. :src: bpy.types.OBJECT_OT_shade_auto_smooth.angle
#. :src: bpy.types.OBJECT_OT_shade_smooth_by_angle.angle
msgid "Maximum angle between face normals that will be considered as smooth"
msgstr ""
"முக இயல்புகளுக்கு இடையில் அதிகபட்ச கோணம் மென்மையானது என்று கருதப்படும்"

#. :src: bpy.types.OBJECT_OT_shade_auto_smooth.use_auto_smooth
#: source/blender/blenkernel/intern/mesh_legacy_convert.cc:2103
#: source/blender/blenkernel/intern/mesh_legacy_convert.cc:2311
msgid "Auto Smooth"
msgstr "ஆட்டோ மென்மையான"

#. :src: bpy.types.OBJECT_OT_shade_auto_smooth.use_auto_smooth
msgid "Add modifier to set edge sharpness automatically"
msgstr "விளிம்பு கூர்மையை தானாக அமைக்க மாற்றியமைப்பைச் சேர்க்கவும்"

#. :src: bpy.types.OBJECT_OT_shade_flat
msgid "Render and display faces uniform, using face normals"
msgstr "முக இயல்பைப் பயன்படுத்தி, சீரான முகங்களை வழங்கவும் காண்பிக்கவும்"

#. :src: bpy.types.OBJECT_OT_shade_flat.keep_sharp_edges
msgid "Don't remove sharp edges, which are redundant with faces shaded smooth"
msgstr "கூர்மையான விளிம்புகளை அகற்ற வேண்டாம், அவை முகங்களுடன் தேவையற்றவை"

#. :src: bpy.types.OBJECT_OT_shade_smooth
msgid "Render and display faces smooth, using interpolated vertex normals"
msgstr ""
"இடைக்கணிக்கப்பட்ட வெர்டெக்ச் இயல்புகளைப் பயன்படுத்தி, முகங்களை "
"மென்மையாக்கவும் காண்பிக்கவும்"

#. :src: bpy.types.OBJECT_OT_shade_smooth.keep_sharp_edges
msgid "Don't remove sharp edges. Tagged edges will remain sharp"
msgstr ""
"கூர்மையான விளிம்புகளை அகற்ற வேண்டாம். குறிக்கப்பட்ட விளிம்புகள் கூர்மையாக "
"இருக்கும்"

#. :src: bpy.types.OBJECT_OT_shade_smooth_by_angle
msgctxt "Operator"
msgid "Shade Smooth by Angle"
msgstr "கோணத்தால் நிழல் மென்மையானது"

#. :src: bpy.types.OBJECT_OT_shade_smooth_by_angle
#. :src: Asset description from file smooth_by_angle.blend
msgid ""
"Set the sharpness of mesh edges based on the angle between the neighboring "
"faces"
msgstr ""
"அண்டை முகங்களுக்கு இடையிலான கோணத்தின் அடிப்படையில் கண்ணி விளிம்புகளின் "
"கூர்மையை அமைக்கவும்"

#. :src: bpy.types.OBJECT_OT_shade_smooth_by_angle.keep_sharp_edges
msgid "Only add sharp edges instead of clearing existing tags first"
msgstr ""
"முதலில் இருக்கும் குறிச்சொற்களை அழிப்பதற்கு பதிலாக கூர்மையான விளிம்புகளை "
"மட்டுமே சேர்க்கவும்"

#. :src: bpy.types.OBJECT_OT_shaderfx_add
msgctxt "Operator"
msgid "Add Effect"
msgstr "விளைவைச் சேர்க்கவும்"

#. :src: bpy.types.OBJECT_OT_shaderfx_add
msgid "Add a visual effect to the active object"
msgstr "செயலில் உள்ள பொருளுக்கு காட்சி விளைவைச் சேர்க்கவும்"

#. :src: bpy.types.OBJECT_OT_shaderfx_add.type:'FX_BLUR'
#. :src: bpy.types.ShaderFx.type:'FX_BLUR'
msgctxt "ID"
msgid "Blur"
msgstr "மங்கலானது"

