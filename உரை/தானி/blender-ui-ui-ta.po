msgid "Use only selected strokes for interpolating"
msgstr "இடைக்கணிப்புக்கு தேர்ந்தெடுக்கப்பட்ட பக்கவாதம் மட்டுமே பயன்படுத்தவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_interpolate_sequence
#: scripts/startup/bl_ui/space_view3d.py:2242
#: scripts/startup/bl_ui/space_view3d.py:5770
msgctxt "Operator"
msgid "Interpolate Sequence"
msgstr "இடைக்கணிப்பு வரிசை"

#. :src: bpy.types.GREASE_PENCIL_OT_interpolate_sequence
msgid ""
"Generate 'in-betweens' to smoothly interpolate between Grease Pencil frames"
msgstr ""
"பசை எழுதுகோல் பிரேம்களுக்கு இடையில் சீராக இடைக்கணிக்க 'இன்-பெட்வீன்ச்' ஐ "
"உருவாக்கவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_interpolate_sequence.back
#. :src: bpy.types.GREASE_PENCIL_OT_interpolate_sequence.type:'BACK'
msgctxt "GPencil"
msgid "Back"
msgstr "மீண்டும்"

#. :src: bpy.types.GREASE_PENCIL_OT_interpolate_sequence.easing
msgctxt "GPencil"
msgid "Easing"
msgstr "எளிதாக்குதல்"

