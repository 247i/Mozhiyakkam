#. :src: bpy.types.GREASE_PENCIL_OT_extrude
#. :src: bpy.types.GREASE_PENCIL_OT_extrude_move.GREASE_PENCIL_OT_extrude
msgid "Extrude the selected points"
msgstr "தேர்ந்தெடுக்கப்பட்ட புள்ளிகளை வெளியேற்றவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_extrude_move
msgid "Extrude selected points and move them"
msgstr "தேர்ந்தெடுக்கப்பட்ட புள்ளிகளை வெளியேற்றி அவற்றை நகர்த்தவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_extrude_move.GREASE_PENCIL_OT_extrude
msgid "Extrude Stroke Points"
msgstr "எக்ச்ட்ரூட் ச்ட்ரோக் புள்ளிகள்"

#. :src: bpy.types.GREASE_PENCIL_OT_fill
msgctxt "Operator"
msgid "Grease Pencil Fill"
msgstr "பசை எழுதுகோல் நிரப்பு"

#. :src: bpy.types.GREASE_PENCIL_OT_fill
msgid "Fill with color the shape formed by strokes"
msgstr "வீச்சுகள் மூலம் உருவாகும் வடிவத்தை வண்ணத்துடன் நிரப்பவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_fill.invert
msgid "Find boundary of unfilled instead of filled regions"
msgstr "நிரப்பப்பட்ட பகுதிகளுக்கு பதிலாக நிரப்பப்படாத எல்லையைக் கண்டறியவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_fill.precision
msgid "Use precision movement for extension lines"
msgstr "நீட்டிப்பு வரிகளுக்கு துல்லியமான இயக்கத்தைப் பயன்படுத்தவும்"

#. :src: bpy.types.GREASE_PENCIL_OT_frame_clean_duplicate
msgctxt "Operator"
msgid "Delete Duplicate Frames"
