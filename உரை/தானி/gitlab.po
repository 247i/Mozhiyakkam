msgstr "adminusers|அங்கீகரிக்கப்பட்ட பயனர்கள்:"

msgid "AdminUsers|Auditor"
msgstr "நிர்வாகிகள்|ஆடிட்டர்"

msgid ""
"AdminUsers|Auditors have read-only access to all groups, projects, and "
