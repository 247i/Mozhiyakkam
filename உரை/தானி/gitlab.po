msgstr[1] "ClusterAgents|கடந்த %d நாட்களில் எந்த நடவடிக்கையும் நடக்கவில்லை"

msgid "ClusterAgents|No agent access token"
msgstr "clusteragents|ஏசென்ட் அணுகல் கிள்ளாக்கு இல்லை"

msgid "ClusterAgents|No agents"
msgstr "clusteragents|முகவர்கள் இல்லை"

msgid "ClusterAgents|No clusters connected through cluster certificates"
msgstr ""
"clusteragents|கிளச்டர் சான்றிதழ்கள் மூலம் எந்த கிளச்டர்களும் "
"இணைக்கப்படவில்லை"

msgid "ClusterAgents|Not connected"
msgstr "clusteragents|இணைக்கப்படவில்லை"

msgid "ClusterAgents|Option 1: Bootstrap the agent with Flux"
msgstr "கொத்து உடைகள் | விருப்பம் 1: தொடக்கவார் முகவர் ஃப்ளக்ச்"

msgid "ClusterAgents|Option 2: Create and register an agent with the UI"
msgstr ""
"கொத்து உடைகள் | விருப்பம் 2: இடைமுகம் உடன் ஒரு முகவரை உருவாக்கி பதிவு "
"செய்யுங்கள்"

msgid ""
"ClusterAgents|Optionally, for additional configuration settings, a "
"%{linkStart}configuration file%{linkEnd} can be created in the repository. "
"You can do so within the default branch by creating the file at: "
"%{codeStart}.gitlab/agents/%{agentName}/config.yaml%{codeEnd}"
msgstr ""
"கொத்து உடைகள் | விருப்பமாக, கூடுதல் உள்ளமைவு அமைப்புகளுக்கு, ஒரு "
"%{linkStart} உள்ளமைவு கோப்பு %{linkEnd} களஞ்சியத்தில் உருவாக்கப்படலாம். "
"கோப்பை உருவாக்குவதன் மூலம் இயல்புநிலை கிளைக்குள் நீங்கள் அவ்வாறு "
"செய்யலாம்:%{codeStart} .gitlab/முகவர்கள்/%{agentName} /config.yaml% "
"{codeEnd}"

msgid "ClusterAgents|Premium"
msgstr "clusteragents|பிரீமியம்"

msgid "ClusterAgents|Project"
msgstr "கொத்து உடைகள் | திட்டம்"

msgid "ClusterAgents|Project agents"
msgstr "கொத்து உடைகள் | திட்ட முகவர்கள்"

msgid "ClusterAgents|Receptive"
msgstr "கொத்து உடைகள் | வரவேற்பு"

msgid "ClusterAgents|Recommended"
msgstr "clusteragents|பரிந்துரைக்கப்பட்டது"

msgid "ClusterAgents|Register an agent"
msgstr "கிளஸ்டர் முகவர்கள்|ஒரு முகவரைப் பதிவு செய்யவும்"

msgid "ClusterAgents|Requires a Maintainer or greater role to delete agents"
msgstr ""
"clusteragents|ஏசெண்டுகளை நீக்க ஒரு பராமரிப்பாளர் அல்லது அதிக பங்கு தேவை"

msgid ""
"ClusterAgents|Requires a Maintainer or greater role to perform these actions"
msgstr ""
"clusteragents|இந்தச் செயல்களைச் செய்ய ஒரு பராமரிப்பாளர் அல்லது அதிகப் பங்கு "
"தேவை"

msgid ""
"ClusterAgents|Requires a Maintainer or greater role to perform this action"
msgstr ""
"clusteragents|இந்தச் செயலைச் செய்ய ஒரு பராமரிப்பாளர் அல்லது அதிகப் பங்கு "
"தேவை"

msgid "ClusterAgents|Revoke access token?"
msgstr "clusteragents|அணுகல் கிள்ளாக்கை திரும்பப் பெறவா?"

msgid "ClusterAgents|Revoke token"
msgstr "clusteragents|டோக்கனை ரத்து செய்"

msgid "ClusterAgents|Security"
msgstr "clusteragents|பாதுகாப்பு"

msgid ""
"ClusterAgents|See agent activity updates, like tokens created or revoked and"
" clusters connected or not connected."
msgstr ""
"clusteragents|உருவாக்கப்பட்ட அல்லது ரத்துசெய்யப்பட்ட டோக்கன்கள் மற்றும் "
"இணைக்கப்பட்ட அல்லது இணைக்கப்படாத க்ளச்டர்கள் போன்ற முகவர் செயல்பாடு "
"புதுப்பிப்புகளைப் பார்க்கவும்."

msgid "ClusterAgents|Shared"
msgstr "கொத்து உடைகள் | பகிரப்பட்டது"

msgid "ClusterAgents|Shared agents"
msgstr "கொத்து உடைகள் | பகிரப்பட்ட முகவர்கள்"

msgid "ClusterAgents|Tell us what you think"
msgstr "clusteragents|நீங்கள் என்ன நினைக்கிறீர்கள் என்பதை எங்களிடம் கூறுங்கள்"

msgid ""
"ClusterAgents|The GitLab agent provides an increased level of security when "
"connecting Kubernetes clusters to GitLab. %{linkStart}Learn more about the "
"GitLab agent.%{linkEnd}"
msgstr ""
"clusteragents|gitlab முகவர் kubernetes க்ளச்டர்களை gitlab உடன் இணைக்கும்போது"
" அதிக அளவிலான பாதுகாப்பை வழங்குகிறது. %{linkStart}gitlab முகவர் பற்றி மேலும்"
" அறிக.%{linkEnd}"

msgid ""
"ClusterAgents|The agent has not been connected in a long time. There might "
"be a connectivity issue. Last contact was %{timeAgo}."
msgstr ""
"clusteragents|நீண்ட காலமாக முகவர் இணைக்கப்படவில்லை. இணைப்புச் சிக்கல் "
"இருக்கலாம். கடைசி தொடர்பு %{timeAgo}ஆகும்."

msgid "ClusterAgents|The agent uses the token to connect with GitLab."
msgstr ""
"clusteragents|gitlab உடன் இணைக்க முகவர் கிள்ளாக்கைப் பயன்படுத்துகிறார்."

msgid ""
"ClusterAgents|The agent version do not match each other across your "
"cluster's pods. This can happen when a new agent version was just deployed "
"and Kubernetes is shutting down the old pods."
msgstr ""
"clusteragents|உங்கள் கிளச்டரின் காய்கள் முழுவதும் முகவர் பதிப்பு "
"ஒன்றுக்கொன்று பொருந்தவில்லை. புதிய ஏசென்ட் பதிப்பு பயன்படுத்தப்பட்டு, "
"குபெர்னெட்டச் பழைய காய்களை மூடும்போது இது நிகழலாம்."

msgid "ClusterAgents|This agent has no tokens"
msgstr "clusteragents|இந்த ஏசெண்டிற்கு டோக்கன்கள் இல்லை"

msgid "ClusterAgents|This field is required."
msgstr "கொத்து உடைகள் | இந்த புலம் தேவை."

msgid "ClusterAgents|To delete the agent, type %{name} to confirm:"
msgstr "clusteragents|முகவரை நீக்க, உறுதிப்படுத்த %{name} உள்ளிடவும்:"

msgid ""
"ClusterAgents|To manage more agents, %{linkStart}use Terraform%{linkEnd}."
msgstr ""
"clusteragents|அதிக முகவர்களை நிர்வகிக்க, %{linkStart}terraform%{linkEnd}ஐப் "
"பயன்படுத்தவும்."

msgid "ClusterAgents|To revoke the token, type %{name} to confirm:"
msgstr ""
"clusteragents|டோக்கனை திரும்பப் பெற, உறுதிப்படுத்த %{name} உள்ளிடவும்:"

msgid "ClusterAgents|Token created by %{userName}"
msgstr "clusteragents|டோக்கன் %{userName}ஆல் உருவாக்கப்பட்டது"

msgid "ClusterAgents|Token revoked by %{userName}"
msgstr "clusteragents|டோக்கன் %{userName}ஆல் ரத்து செய்யப்பட்டது"

msgid "ClusterAgents|Unknown user"
msgstr "clusteragents|தெரியாத பயனர்"

msgid ""
"ClusterAgents|Use a Helm version compatible with your Kubernetes version "
"(see %{linkStart}Helm version support policy%{linkEnd})."
msgstr ""
"clusteragents|உங்கள் kubernetes பதிப்பிற்கு இணக்கமான எல்ம் பதிப்பைப் "
"பயன்படுத்தவும் (%{linkStart}எல்ம் பதிப்பு ஆதரவுக் கொள்கை%{linkEnd}ஐப் "
"பார்க்கவும்)."

msgid "ClusterAgents|Valid access token"
msgstr "clusteragents|சரியான அணுகல் கிள்ளாக்கு"

msgid "ClusterAgents|View all %{number} agents"
msgstr "clusteragents|எல்லா %{number} முகவர்களையும் காண்க"

msgid "ClusterAgents|View all %{number} clusters"
msgstr "clusteragents|எல்லா %{number} கிளச்டர்களையும் காண்க"

msgid "ClusterAgents|We only support 100 agents on the UI."
msgstr "clusteragents|ui இல் 100 முகவர்களை மட்டுமே நாங்கள் ஆதரிக்கிறோம்."

msgid ""
"ClusterAgents|We would love to learn more about your experience with the "
"GitLab Agent."
msgstr ""
"clusteragents|gitlab முகவருடனான உங்கள் அனுபவத்தைப் பற்றி மேலும் அறிய நாங்கள்"
" விரும்புகிறோம்."

msgid "ClusterAgents|What is agent activity?"
msgstr "clusteragents|ஏசென்ட் செயல்பாடு என்றால் என்ன?"

msgid "ClusterAgents|What is default configuration?"
msgstr "clusteragents|இயல்புநிலை கட்டமைப்பு என்றால் என்ன?"

msgid ""
"ClusterAgents|You can connect to your cluster from the command line. "
"Configure %{linkStart}kubectl%{linkEnd} command-line access by running the "
"following command:"
msgstr ""
"கொத்து உடைகள் | கட்டளை வரியிலிருந்து உங்கள் கிளச்டருடன் இணைக்க முடியும். "
"பின்வரும் கட்டளையை இயக்குவதன் மூலம் %{linkStart} kubectl %{linkEnd} "
"கட்டளை-வரி அணுகலை உள்ளமைக்கவும்:"

msgid ""
"ClusterAgents|You can connect to your cluster from the command line. To use "
"this feature, configure %{monotypeStart}user_access%{monotypeEnd} in the "
"agent configuration project."
msgstr ""
"கொத்து உடைகள் | கட்டளை வரியிலிருந்து உங்கள் கிளச்டருடன் இணைக்க முடியும். "
"இந்த அம்சத்தைப் பயன்படுத்த, முகவர் உள்ளமைவு திட்டத்தில் %{monotypeStart} "
"user_access %{monotypeEnd} உள்ளமைக்கவும்."

msgid ""
"ClusterAgents|You can view a list of options with "
"%{codeStart}--help%{codeEnd}."
msgstr ""
"கொத்து உடைகள் | %{codestart with உடன் விருப்பங்களின் பட்டியலை நீங்கள் "
"காணலாம்-உதவி %{codeStart}."

msgid ""
"ClusterAgents|You cannot see this token again after you close this window."
msgstr ""
"clusteragents|இந்தச் சாளரத்தை மூடிய பிறகு இந்த கிள்ளாக்கை உங்களால் மீண்டும் "
"பார்க்க முடியாது."

msgid "ClusterAgents|You will need to create a token to connect to your agent"
msgstr ""
"clusteragents|உங்கள் முகவருடன் இணைக்க நீங்கள் ஒரு கிள்ளாக்கை உருவாக்க "
"வேண்டும்"

msgid ""
"ClusterAgents|Your instance doesn't have the %{linkStart}GitLab Agent Server"
" (KAS)%{linkEnd} set up. Ask a GitLab Administrator to install it."
msgstr ""
"clusteragents|உங்கள் நிகழ்வில் %{linkStart}gitlab முகவர் சேவையகம் "
"(kas)%{linkEnd} அமைக்கப்படவில்லை. அதை நிறுவ gitlab நிர்வாகியிடம் கேளுங்கள்."

msgid "ClusterAgent|An agent can have only two active tokens at a time"
msgstr ""
"clusteragent|ஒரு முகவர் ஒரு நேரத்தில் இரண்டு செயலில் உள்ள டோக்கன்களை மட்டுமே"
" வைத்திருக்க முடியும்"

msgid "ClusterAgent|Receptive agents are disabled for this GitLab instance"
msgstr ""
"இந்த அறிவிலிஆய்வு உதாரணத்திற்கு கொத்தாக | ஏற்றுக்கொள்ளும் முகவர்கள் "
"முடக்கப்பட்டுள்ளனர்"

msgid "ClusterAgent|Receptive agents are unavailable for this GitLab instance"
msgstr ""
"இந்த அறிவிலிஆய்வு நிகழ்வுக்கு கொத்தாக | ஏற்றுக்கொள்ளும் முகவர்கள் "
"கிடைக்கவில்லை"

msgid "ClusterAgent|URL configuration already exists for this agent"
msgstr "CLUSTERAGENT | இந்த முகவருக்கு முகவரி உள்ளமைவு ஏற்கனவே உள்ளது"

msgid ""
"ClusterAgent|User has insufficient permissions to create a token for this "
"project"
msgstr ""
"clusteragent|இந்த திட்டத்திற்கான கிள்ளாக்கை உருவாக்க பயனருக்கு போதுமான "
"அனுமதிகள் இல்லை"

msgid ""
"ClusterAgent|User has insufficient permissions to revoke the token for this "
"project"
msgstr ""
"clusteragent|இந்தத் திட்டத்திற்கான டோக்கனைத் திரும்பப்பெற பயனரிடம் போதிய "
"அனுமதிகள் இல்லை"

msgid ""
"ClusterAgent|You have insufficient permissions to create a cluster agent for"
" this project"
msgstr ""
"clusteragent|இந்த திட்டத்திற்கான கிளச்டர் ஏசென்ட்டை உருவாக்க உங்களுக்கு "
"போதுமான அனுமதிகள் இல்லை"

msgid ""
"ClusterAgent|You have insufficient permissions to create an url "
"configuration for this agent"
msgstr ""
"CLUSTERAGENT | இந்த முகவருக்கு முகவரி உள்ளமைவை உருவாக்க உங்களுக்கு போதுமான "
"அனுமதிகள் இல்லை"

msgid ""
"ClusterAgent|You have insufficient permissions to delete this agent url "
"configuration"
msgstr ""
"CLUSTERAGENT | இந்த முகவர் முகவரி உள்ளமைவை நீக்க உங்களுக்கு போதுமான "
"அனுமதிகள் இல்லை"

msgid ""
"ClusterAgent|You have insufficient permissions to delete this cluster agent"
msgstr ""
"clusteragent|இந்த கிளச்டர் ஏசென்ட்டை நீக்க உங்களுக்கு போதுமான அனுமதிகள் "
"இல்லை"

msgid "ClusterIntegration|%{linkStart}More information%{linkEnd}"
msgstr "கிளச்டர் ஒருங்கிணைப்பு|%{linkStart}மேலும் தகவல்%{linkEnd}"

msgid ""
"ClusterIntegration|A cluster management project can be used to run "
"deployment jobs with Kubernetes %{code_open}cluster-admin%{code_close} "
"privileges."
msgstr ""
"clusterintegration|குபெர்னெட்டச் %{code_open}cluster-admin%{code_close} "
"சலுகைகளுடன் வரிசைப்படுத்தல் வேலைகளை இயக்க ஒரு கிளச்டர் மேலாண்மை திட்டம் "
"பயன்படுத்தப்படலாம்."

msgid ""
"ClusterIntegration|A service token scoped to %{code}kube-system%{end_code} "
"with %{code}cluster-admin%{end_code} privileges."
msgstr ""
"clusterintegration| %{code}cluster-admin%{end_code} சலுகைகளுடன் %{code}kube-"
"system%{end_code} க்கு ச்கோப் செய்யப்பட்ட ஒரு பணி கிள்ளாக்கு."

msgid "ClusterIntegration|API URL"
msgstr "clusterintegration|api முகவரி"

msgid "ClusterIntegration|API URL should be a valid http/https url."
msgstr ""
"clusterintegration|api முகவரி சரியான http/https முகவரி ஆக இருக்க வேண்டும்."

msgid "ClusterIntegration|Add Kubernetes cluster"
msgstr "clusterintegration|குபெர்னெட்ச் கிளச்டரைச் சேர்க்கவும்"

msgid ""
"ClusterIntegration|Adding a Kubernetes cluster will automatically share the "
"cluster across all projects. Use review apps, deploy your applications, and "
"easily run your pipelines for all projects using the same cluster."
msgstr ""
"clusterintegration|குபெர்னெட்ச் கிளச்டரைச் சேர்ப்பது அனைத்து திட்டங்களிலும் "
"தானாகவே கிளச்டரைப் பகிரும். மதிப்பாய்வு பயன்பாடுகளைப் பயன்படுத்தவும், உங்கள்"
" பயன்பாடுகளை வரிசைப்படுத்தவும் மற்றும் ஒரே கிளச்டரைப் பயன்படுத்தி அனைத்து "
