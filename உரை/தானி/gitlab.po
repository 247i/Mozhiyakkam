msgstr "adminsettings|git துச்பிரயோக விகிதம் வரம்பு"

msgid ""
"AdminSettings|GitLab uses the %{bold_start}Rails%{bold_end} and "
"%{bold_start}Browser JavaScript%{bold_end} Sentry SDKs to send events to "
