msgstr "ஓட்டப்பந்தய வீரர்கள்| இந்த குழுவில்%{count} ரன்னர்கள்"

msgid "Runners|%{highlightStart}%{duration}%{highlightEnd} second"
msgid_plural "Runners|%{highlightStart}%{duration}%{highlightEnd} seconds"
msgstr[0] ""
"ஓட்டப்பந்தய வீரர்கள்|%{highlightStart}%{duration}%{highlightEnd} வினாடி"
msgstr[1] ""
