msgid "You are currently offline, or the GitLab instance is not reachable."
msgstr ""
"நீங்கள் தற்போது ஆஃப்லைனில் உள்ளீர்கள் அல்லது gitlab நிகழ்வை அணுக "
"முடியவில்லை."

msgid ""
"You are going to delete %{project_full_name}. Deleted projects CANNOT be "
"restored! Are you ABSOLUTELY sure?"
msgstr ""
"நீங்கள் %{project_full_name}நீக்கப் போகிறீர்கள். நீக்கப்பட்ட திட்டப்பணிகளை "
"மீட்டெடுக்க முடியாது! நீங்கள் முற்றிலும் உறுதியாக இருக்கிறீர்களா?"

msgid ""
"You are going to remove the fork relationship from %{project_full_name}. Are"
" you ABSOLUTELY sure?"
msgstr ""
"நீங்கள் %{project_full_name}இலிருந்து ஃபோர்க் உறவை அகற்றப் போகிறீர்கள். "
"நீங்கள் முற்றிலும் உறுதியாக இருக்கிறீர்களா?"

msgid ""
"You are going to turn off the confidentiality. This means "
"%{strongStart}everyone%{strongEnd} will be able to see%{commentText} this "
"%{issuableType}."
msgstr ""
"நீங்கள் ரகசியத்தன்மையை முடக்கப் போகிறீர்கள். இதன் பொருள் "
"%{strongStart}அனைவரும்%{strongEnd}%{commentText} இந்த %{issuableType}பார்க்க"
" முடியும்."

msgid ""
"You are going to turn on confidentiality. Only %{context} members with "
"%{strongStart}%{permissions}%{strongEnd} can view or be notified about this "
"%{issuableType}."
msgstr ""
"நீங்கள் ரகசியத்தன்மையை இயக்கப் போகிறீர்கள். "
"%{strongEnd}%{strongStart}%{permissions} உடன் %{context} உறுப்பினர்கள் "
"மட்டுமே இந்த %{issuableType}ஐப் பார்க்க முடியும் அல்லது அறிவிக்க முடியும்."

msgid "You are not allowed to %{action} a user"
msgstr "நீங்கள் %{action} ஒரு பயனர் அனுமதிக்கப்படவில்லை"

msgid "You are not allowed to approve a user"
msgstr "ஒரு பயனரை அங்கீகரிக்க உங்களுக்கு இசைவு இல்லை"

msgid "You are not allowed to change the Work Item type to %{name}."
msgstr "பணி உருப்படி வகையை %{name}க்கு மாற்ற உங்களுக்கு இசைவு இல்லை."

msgid "You are not allowed to create this tag as it is protected."
msgstr ""
"இந்தக் குறிச்சொல் பாதுகாக்கப்பட்டுள்ளதால் அதை உருவாக்க உங்களுக்கு இசைவு "
"இல்லை."

msgid "You are not allowed to download code from this project."
msgstr ""
"இந்தத் திட்டத்திலிருந்து குறியீட்டைப் பதிவிறக்க உங்களுக்கு இசைவு இல்லை."

msgid "You are not allowed to reject a user"
msgstr "பயனரை நிராகரிக்க உங்களுக்கு இசைவு இல்லை"

msgid "You are not allowed to unlink your primary login account"
msgstr ""
"உங்கள் முதன்மை உள்நுழைவு கணக்கின் இணைப்பை நீக்க உங்களுக்கு இசைவு இல்லை"

msgid "You are not authorized to delete this site profile"
msgstr "இந்த தள சுயவிவரத்தை நீக்க உங்களுக்கு ஏற்பு இல்லை"

msgid "You are not authorized to perform this action"
msgstr "இந்தச் செயலைச் செய்ய உங்களுக்கு ஏற்பு இல்லை"

msgid "You are not authorized to run this manual job"
msgstr "இந்த கைமுறை வேலையை இயக்க உங்களுக்கு ஏற்பு இல்லை"

msgid "You are not authorized to update this profile"
msgstr "இந்தச் சுயவிவரத்தைப் புதுப்பிக்க உங்களுக்கு ஏற்பு இல்லை"

msgid "You are not authorized to update this scanner profile"
msgstr "இந்த ச்கேனர் சுயவிவரத்தைப் புதுப்பிக்க உங்களுக்கு ஏற்பு இல்லை"

msgid "You are not authorized to upload metric images"
msgstr "மெட்ரிக் படங்களை பதிவேற்ற உங்களுக்கு ஏற்பு இல்லை"

msgid "You are now impersonating %{username}"
msgstr "நீங்கள் இப்போது %{username}என்று ஆள்மாறாட்டம் செய்கிறீர்கள்"

msgid "You are on a read-only GitLab instance."
msgstr "நீங்கள் படிக்க மட்டுமேயான gitlab நிகழ்வில் உள்ளீர்கள்."

msgid ""
"You are out of Pages parallel deployments. Delete some existing deployments "
"to be able to create new ones. %{link}."
msgstr ""
"நீங்கள் பக்கங்களின் இணையான வரிசைப்படுத்தல்களுக்கு வெளியே இருக்கிறீர்கள். "
"புதியவற்றை உருவாக்கக்கூடிய சில வரிசைப்படுத்தல்களை நீக்கவும். %{link}."

msgid "You are receiving this email because you are an Owner of the Group."
msgstr ""
"நீங்கள் குழுவின் உரிமையாளராக இருப்பதால் இந்த மின்னஞ்சலைப் பெறுகிறீர்கள்."

msgid ""
"You are receiving this email because you are either an Owner or Maintainer "
"of the project."
msgstr ""
"நீங்கள் இந்த மின்னஞ்சலைப் பெறுகிறீர்கள், ஏனெனில் நீங்கள் திட்டத்தின் "
"உரிமையாளர் அல்லது பராமரிப்பாளர்."

msgid ""
"You are receiving this message because you are a GitLab administrator for "
"%{url}."
msgstr ""
"நீங்கள் %{url}க்கான gitlab நிர்வாகியாக இருப்பதால் இந்தச் செய்தியைப் "
"பெறுகிறீர்கள்."

msgid ""
"You are trying to upload something other than an image. Please upload a "
".png, .jpg, .jpeg, .gif, .bmp, .tiff or .ico."
msgstr ""
"படத்தைத் தவிர வேறு எதையாவது பதிவேற்ற முயற்சிக்கிறீர்கள். .png, .jpg, .jpeg, "
".gif, .bmp, .tiff அல்லது .ico ஐப் பதிவேற்றவும்."

msgid ""
"You are using a trial license. When you use a paid subscription, you'll be "
"charged for %{trueUpLinkStart}users over license%{trueUpLinkEnd}."
msgstr ""
"நீங்கள் சோதனை உரிமத்தைப் பயன்படுத்துகிறீர்கள். நீங்கள் கட்டண சந்தாவைப் "
"பயன்படுத்தும்போது, ​​உரிமம் %{trueUpLinkStart} க்கு மேல் %{trueUpLinkEnd} "
"பயனர்களுக்கு கட்டணம் வசூலிக்கப்படும்."

msgid ""
"You can %{gitlabLinkStart}resolve conflicts on GitLab%{gitlabLinkEnd} or "
"%{resolveLocallyStart}resolve them locally%{resolveLocallyEnd}."
msgstr ""
"gitlab%{gitlabLinkStart} அல்லது %{gitlabLinkEnd}இல் உள்ள முரண்பாடுகளை "
"நீங்கள் %{resolveLocallyStart}தீர்க்கலாம், அவற்றை உள்ளூரில் "
"தீர்க்கலாம்%{resolveLocallyEnd}."

msgid ""
"You can %{resolveLocallyStart}resolve them locally%{resolveLocallyEnd}."
msgstr ""
"நீங்கள் %{resolveLocallyStart}அவற்றை உள்ளூரில் "
"தீர்க்கலாம்%{resolveLocallyEnd}."

msgid "You can adjust rules on auto-banning %{link_start}here%{link_end}."
msgstr ""
"%{link_start}தானாகத் தடைசெய்வதற்கான விதிகளை நீங்கள் இங்கே "
"சரிசெய்யலாம்%{link_end}."

msgid "You can adjust rules on auto-banning here: %{url}."
msgstr "தானாகத் தடைசெய்வதற்கான விதிகளை நீங்கள் இங்கே சரிசெய்யலாம்: %{url}."

msgid "You can also create a project from the command line."
msgstr "கட்டளை வரியிலிருந்தும் நீங்கள் ஒரு திட்டத்தை உருவாக்கலாம்."

msgid "You can also press Ctrl-Enter"
msgstr "நீங்கள் ctrl-enter ஐ அழுத்தவும்"

msgid "You can also press ⌘-Enter"
msgstr "நீங்கள் ⌘-enter ஐ அழுத்தவும்"

msgid "You can also star a label to make it a priority label."
msgstr "முன்னுரிமை லேபிளாக மாற்ற லேபிளை நட்சத்திரமிடலாம்."

msgid ""
"You can also upload existing files from your computer using the instructions"
" below."
msgstr ""
"கீழே உள்ள வழிமுறைகளைப் பயன்படுத்தி உங்கள் கணினியிலிருந்து ஏற்கனவே உள்ள "
"கோப்புகளையும் பதிவேற்றலாம்."

msgid ""
"You can also use group access tokens with Git to authenticate over HTTP(S). "
"%{link_start}Learn more.%{link_end}"
msgstr ""
"http(s) மூலம் அங்கீகரிக்க git உடன் குழு அணுகல் டோக்கன்களையும் "
"பயன்படுத்தலாம். %{link_start}மேலும் அறிக.%{link_end}"

msgid ""
"You can also use project access tokens with Git to authenticate over "
"HTTP(S). %{link_start}Learn more.%{link_end}"
msgstr ""
"http(s) மூலம் அங்கீகரிக்க git உடன் திட்ட அணுகல் டோக்கன்களையும் நீங்கள் "
"பயன்படுத்தலாம். %{link_start}மேலும் அறிக.%{link_end}"

msgid "You can always edit this later"
msgstr "இதை நீங்கள் எப்போது வேண்டுமானாலும் திருத்தலாம்"

msgid ""
"You can check it in your %{pat_link_start}personal access "
"tokens%{pat_link_end} settings."
msgstr ""
"உங்கள் %{pat_link_start}தனிப்பட்ட அணுகல் டோக்கன்கள்%{pat_link_end} "
"அமைப்புகளில் அதைச் சரிபார்க்கலாம்."

msgid ""
"You can check it in your in your personal access tokens settings "
"%{pat_link}."
msgstr ""
"உங்கள் தனிப்பட்ட அணுகல் டோக்கன்கள் அமைப்பு %{pat_link}இல் அதை நீங்கள் "
"சரிபார்க்கலாம்."

msgid ""
"You can check your tokens or create a new one in your "
"%{pat_link_start}personal access tokens settings%{pat_link_end}."
msgstr ""
"உங்கள் டோக்கன்களைச் சரிபார்க்கலாம் அல்லது உங்கள் %{pat_link_start}தனிப்பட்ட "
"அணுகல் டோக்கன்கள் அமைப்புகளில் புதிய ஒன்றை உருவாக்கலாம்%{pat_link_end}."

msgid ""
"You can check your tokens or create a new one in your personal access tokens"
" settings %{pat_link}."
msgstr ""
"உங்கள் தனிப்பட்ட அணுகல் டோக்கன்கள் அமைப்புகளில் உங்கள் டோக்கன்களைச் "
"சரிபார்க்கலாம் அல்லது புதிய ஒன்றை உருவாக்கலாம் %{pat_link}."

msgid "You can create a new %{link}."
msgstr "நீங்கள் ஒரு புதிய %{link}உருவாக்கலாம்."

msgid ""
"You can create a new %{name} inside this project by sending an email to the "
"following email address:"
msgstr ""
"பின்வரும் மின்னஞ்சல் முகவரிக்கு மின்னஞ்சலை அனுப்புவதன் மூலம் இந்தத் "
"திட்டத்தில் புதிய %{name} உருவாக்கலாம்:"

msgid "You can create a new SSH key by visiting %{link}"
msgstr "%{link}பார்வையிடுவதன் மூலம் புதிய பாஓடு விசையை உருவாக்கலாம்"

msgid ""
"You can create a new one or check them in your %{link_start}access "
"tokens%{link_end} settings."
msgstr ""
"நீங்கள் புதிய ஒன்றை உருவாக்கலாம் அல்லது உங்கள் %{link_start}அணுகல் "
"டோக்கன்கள்%{link_end} அமைப்புகளில் அவற்றைச் சரிபார்க்கலாம்."

msgid ""
"You can create a new one or check them in your %{pat_link_start}personal "
"access tokens%{pat_link_end} settings."
msgstr ""
"நீங்கள் புதிய ஒன்றை உருவாக்கலாம் அல்லது உங்கள் %{pat_link_start}தனிப்பட்ட "
"அணுகல் டோக்கன்கள்%{pat_link_end} அமைப்புகளில் அவற்றைச் சரிபார்க்கலாம்."

msgid ""
"You can create a new one or check them in your %{ssh_key_link_start}SSH "
"keys%{ssh_key_link_end} settings."
msgstr ""
"நீங்கள் புதிய ஒன்றை உருவாக்கலாம் அல்லது உங்கள் %{ssh_key_link_start}ssh "
"விசைகள்%{ssh_key_link_end} அமைப்புகளில் அவற்றைச் சரிபார்க்கலாம்."

msgid ""
"You can create a new one or check them in your SSH keys settings "
"%{ssh_key_link}."
msgstr ""
"நீங்கள் புதிய ஒன்றை உருவாக்கலாம் அல்லது உங்கள் பாஓடு விசைகள் அமைப்புகளில் "
"அவற்றைச் சரிபார்க்கலாம் %{ssh_key_link}."

msgid ""
"You can create a new one or check them in your access token settings: "
"%{target_url}"
msgstr ""
"நீங்கள் புதிய ஒன்றை உருவாக்கலாம் அல்லது உங்கள் அணுகல் கிள்ளாக்கு "
"அமைப்புகளில் அவற்றைச் சரிபார்க்கலாம்: %{target_url}"

msgid ""
"You can create a new one or check them in your personal access tokens "
"settings %{pat_link}."
msgstr ""
"நீங்கள் புதிய ஒன்றை உருவாக்கலாம் அல்லது உங்கள் தனிப்பட்ட அணுகல் டோக்கன்கள் "
"அமைப்புகளில் அவற்றைச் சரிபார்க்கலாம் %{pat_link}."

msgid "You can create a new personal access token by visiting %{link}"
msgstr ""

msgid ""
"You can create new ones at your %{pat_link_start}personal access "
"tokens%{pat_link_end} settings"
msgstr ""
"உங்கள் %{pat_link_start} தனிப்பட்ட அணுகல் டோக்கன்கள் %{pat_link_end} "
"அமைப்புகளில் புதியவற்றை உருவாக்கலாம்"

msgid ""
"You can create new ones at your personal access tokens settings %{pat_link}"
msgstr ""
"உங்கள் தனிப்பட்ட அணுகல் டோக்கன்கள் அமைப்புகளில் புதியவற்றை உருவாக்கலாம் "
"%{pat_link}"

msgid ""
"You can enable group access token creation in %{link_start}group "
"settings%{link_end}."
msgstr ""
"நீங்கள் குழு அணுகல் கிள்ளாக்கு உருவாக்கத்தை %{link_start}குழு "
"அமைப்புகள்%{link_end}இல் இயக்கலாம்."

msgid ""
"You can enable project access token creation in %{link_start}group "
"settings%{link_end}."
msgstr ""
"%{link_start}குழு அமைப்புகள்%{link_end}இல் திட்ட அணுகல் கிள்ளாக்கு "
"உருவாக்கத்தை நீங்கள் இயக்கலாம்."

msgid "You can enter up to 280 characters"
msgstr "நீங்கள் 280 எழுத்துகள் வரை உள்ளிடலாம்"

msgid ""
"You can filter by 'days to merge' by clicking on the columns in the chart."
msgstr ""
"விளக்கப்படத்தில் உள்ள நெடுவரிசைகளைக் சொடுக்கு செய்வதன் மூலம் 'ஒன்றுபட "
"வேண்டிய நாட்கள்' மூலம் வடிகட்டலாம்."

msgid ""
"You can find more information about GitLab subscriptions in "
"%{subscriptions_doc_link}."
msgstr ""
"gitlab சந்தாக்கள் பற்றிய கூடுதல் தகவலை %{subscriptions_doc_link}இல் காணலாம்."

msgid ""
"You can invite a new member to %{project_name} or invite another group."
msgstr ""
"நீங்கள் ஒரு புதிய உறுப்பினரை %{project_name} க்கு அழைக்கலாம் அல்லது மற்றொரு "
"குழுவை அழைக்கலாம்."

msgid "You can invite a new member to %{project_name}."
msgstr "நீங்கள் ஒரு புதிய உறுப்பினரை %{project_name}க்கு அழைக்கலாம்."

msgid "You can invite another group to %{project_name}."
msgstr "நீங்கள் மற்றொரு குழுவை %{project_name}க்கு அழைக்கலாம்."

msgid "You can modify this job's CI/CD variables before running it again."
msgstr ""
"இந்த வேலையை மீண்டும் இயக்கும் முன் அதன் ci/cd மாறிகளை நீங்கள் மாற்றலாம்."

msgid "You can move around the graph by using the arrow keys."
msgstr "அம்புக்குறி விசைகளைப் பயன்படுத்தி வரைபடத்தைச் சுற்றிச் செல்லலாம்."

msgid ""
"You can notify the app / group or a project by sending them an email "
"notification"
msgstr ""
"மின்னஞ்சல் அறிவிப்பை அனுப்புவதன் மூலம் நீங்கள் பயன்பாடு / குழு அல்லது "
"திட்டப்பணிக்கு தெரிவிக்கலாம்"

msgid "You can now close this window."
msgstr "நீங்கள் இப்போது இந்த சாளரத்தை மூடலாம்."

msgid ""
"You can now submit a merge request to get this change into the original "
"branch."
msgstr ""
"இந்த மாற்றத்தை அசல் கிளையில் பெற நீங்கள் இப்போது ஒன்றிணைப்பு கோரிக்கையைச் "
"சமர்ப்பிக்கலாம்."

msgid ""
"You can now submit a merge request to get this change into the original "
"project."
msgstr ""
"இந்த மாற்றத்தை அசல் திட்டத்தில் பெற நீங்கள் இப்போது ஒன்றிணைக்கும் "
"கோரிக்கையைச் சமர்ப்பிக்கலாம்."

msgid "You can only add up to %{max_contacts} contacts at one time"
msgstr ""
"நீங்கள் ஒரே நேரத்தில் %{max_contacts} தொடர்புகள் வரை மட்டுமே சேர்க்க "
"முடியும்"

msgid "You can only edit files when you are on a branch"
msgstr ""
"நீங்கள் ஒரு கிளையில் இருக்கும்போது மட்டுமே கோப்புகளைத் திருத்த முடியும்"

msgid "You can only merge once the items above are resolved."
msgstr ""
"மேலே உள்ள உருப்படிகள் தீர்க்கப்பட்டவுடன் மட்டுமே நீங்கள் ஒன்றிணைக்க "
"முடியும்."

msgid "You can only transfer the project to namespaces you manage."
msgstr ""
"நீங்கள் நிர்வகிக்கும் பெயர்வெளிகளுக்கு மட்டுமே திட்டத்தை மாற்ற முடியும்."

msgid "You can specify notification level per group or per project."
msgstr ""
"ஒரு குழுவிற்கு அல்லது ஒரு திட்டத்திற்கான அறிவிப்பு அளவை நீங்கள் "
"குறிப்பிடலாம்."

msgid ""
"You can still use and manage existing tokens. %{link_start}Learn "
"more.%{link_end}"
msgstr ""
"நீங்கள் தற்போதுள்ள டோக்கன்களைப் பயன்படுத்தலாம் மற்றும் நிர்வகிக்கலாம். "
"%{link_start}மேலும் அறிக.%{link_end}"

msgid ""
"You can unsubscribe from further updates to this ticket. To receive updates "
"in the future, you will have to be added again as a participant."
msgstr ""
"இந்த டிக்கெட்டுக்கு மேலதிக புதுப்பிப்புகளிலிருந்து நீங்கள் குழுவிலகலாம். "
"எதிர்காலத்தில் புதுப்பிப்புகளைப் பெற, நீங்கள் மீண்டும் பங்கேற்பாளராக "
"சேர்க்கப்பட வேண்டும்."

msgid ""
"You can view the source or %{linkStart}%{cloneIcon} clone the "
"repository%{linkEnd}"
msgstr ""
"நீங்கள் மூலத்தைப் பார்க்கலாம் அல்லது களஞ்சியத்தை %{linkStart}%{cloneIcon} "
"நகலி செய்யலாம்%{linkEnd}"

msgid ""
"You can't approve because you added one or more commits to this merge "
"request."
msgstr ""
"இந்த ஒன்றிணைப்பு கோரிக்கையில் ஒன்று அல்லது அதற்கு மேற்பட்ட கமிட்களைச் "
"சேர்த்துள்ளதால் உங்களால் அங்கீகரிக்க முடியாது."

msgid ""
"You can't follow more than %{limit} users. To follow more users, unfollow "
"some others."
msgstr ""
"நீங்கள் %{limit} பயனர்களுக்கு மேல் பின்தொடர முடியாது. அதிகமான பயனர்களைப் "
"பின்தொடர, சிலரைப் பின்தொடர வேண்டாம்."

msgid ""
"You can't override the request for changes because you don't have permission"
" to merge this merge request. To override, ask someone who is eligible to "
"merge this merge request."
msgstr ""
"மாற்றங்களுக்கான கோரிக்கையை நீங்கள் மேலெழுத முடியாது, ஏனெனில் இந்த "
"ஒன்றிணைக்கும் கோரிக்கையை இணைக்க உங்களுக்கு இசைவு இல்லை. மேலெழுத, இந்த "
"ஒன்றிணைக்கும் கோரிக்கையை இணைக்க தகுதியான ஒருவரிடம் கேளுங்கள்."

msgid "You cannot %{action} %{state} users."
msgstr "உங்களால் %{action} %{state} பயனர்கள் இருக்க முடியாது."

msgid "You cannot access the raw file. Please wait a minute."
msgstr ""
"நீங்கள் மூல கோப்பை அணுக முடியாது. தயவு செய்து ஒரு மணித்துளி காத்திருக்கவும்."

msgid ""
"You cannot add any more epics. This epic already has maximum number of child"
" issues & epics."
msgstr ""
"நீங்கள் மேலும் காவியங்களைச் சேர்க்க முடியாது. இந்த காவியத்தில் ஏற்கனவே "
"அதிகபட்ச எண்ணிக்கையிலான குழந்தை சிக்கல்கள் மற்றும் காவியங்கள் உள்ளன."

msgid ""
"You cannot add any more issues. This epic already has maximum number of "
"child issues & epics."
msgstr ""
"நீங்கள் இன்னும் சிக்கல்களைச் சேர்க்க முடியாது. இந்த காவியத்தில் ஏற்கனவே "
"அதிகபட்ச எண்ணிக்கையிலான குழந்தை சிக்கல்கள் மற்றும் காவியங்கள் உள்ளன."

msgid ""
"You cannot approve your own deployment. This configuration can be adjusted "
"in the protected environment settings."
msgstr ""
"உங்கள் சொந்த வரிசைப்படுத்தலை நீங்கள் அங்கீகரிக்க முடியாது. பாதுகாக்கப்பட்ட "
"சூழல் அமைப்புகளில் இந்த உள்ளமைவை சரிசெய்யலாம்."

msgid ""
"You cannot assign or unassign frameworks to a project that has more than one"
" associated framework."
msgstr ""
"ஒன்றுக்கு மேற்பட்ட தொடர்புடைய கட்டமைப்பைக் கொண்ட ஒரு திட்டத்திற்கு நீங்கள் "
"கட்டமைப்பை ஒதுக்கவோ அல்லது ஒதுக்கவோ முடியாது."

msgid "You cannot ban paid users."
msgstr "பணம் செலுத்தும் பயனர்களை நீங்கள் தடை செய்ய முடியாது."

msgid "You cannot change the access of the last owner from the organization"
msgstr "நிறுவனத்திலிருந்து கடைசி உரிமையாளரின் அணுகலை நீங்கள் மாற்ற முடியாது"

msgid "You cannot combine replace_ids with add_ids or remove_ids"
msgstr "நீங்கள் add_ids அல்லது remove_ids உடன் replace_idகளை இணைக்க முடியாது"

msgid ""
"You cannot create new projects in your personal namespace because you have "
"reached your personal project limit."
msgstr ""
"உங்கள் தனிப்பட்ட திட்ட வரம்பை நீங்கள் அடைந்துவிட்டதால், உங்கள் தனிப்பட்ட "
"பெயர்வெளியில் புதிய திட்டங்களை உருவாக்க முடியாது."

msgid ""
"You cannot create projects in your personal namespace. Contact your GitLab "
"administrator."
msgstr ""
"உங்கள் தனிப்பட்ட பெயர்வெளியில் திட்டங்களை உருவாக்க முடியாது. உங்கள் gitlab "
"நிர்வாகியைத் தொடர்புகொள்ளவும்."

msgid "You cannot impersonate a blocked user"
msgstr "தடுக்கப்பட்ட பயனரை ஆள்மாறாட்டம் செய்ய முடியாது"

msgid "You cannot impersonate a user who cannot log in"
msgstr "உள்நுழைய முடியாத பயனரை நீங்கள் ஆள்மாறாட்டம் செய்ய முடியாது"

msgid "You cannot impersonate a user with an expired password"
msgstr "காலாவதியான கடவுச்சொல்லைக் கொண்டு பயனராக ஆள்மாறாட்டம் செய்ய முடியாது"

msgid "You cannot impersonate an internal user"
msgstr "உள் பயனராக நீங்கள் ஆள்மாறாட்டம் செய்ய முடியாது"

msgid ""
"You cannot invite a new member to %{strong_start}%{group_name}%{strong_end}."
" User invitations are disabled by the %{actor}."
msgstr ""

msgid ""
"You cannot invite a new member to "
"%{strong_start}%{project_name}%{strong_end}. User invitations are disabled "
"by the %{actor}."
msgstr ""

msgid ""
"You cannot play this scheduled pipeline at the moment. Please wait a minute."
msgstr ""
"தற்போது இந்த திட்டமிடப்பட்ட பைப்லைனை உங்களால் இயக்க முடியாது. தயவு செய்து "
"ஒரு மணித்துளி காத்திருக்கவும்."

msgid "You cannot rename an environment after it's created."
msgstr "சூழலை உருவாக்கிய பிறகு அதை மறுபெயரிட முடியாது."

msgid "You cannot set yourself to awaiting"
msgstr "நீங்கள் காத்திருப்பதை அமைக்க முடியாது"

msgid ""
"You cannot verify %{value} because it is a popular public email domain."
msgstr ""
"இது ஒரு பிரபலமான பொது மின்னஞ்சல் டொமைன் என்பதால் உங்களால் %{value} "
"சரிபார்க்க முடியாது."

msgid ""
"You cannot write to a read-only secondary GitLab Geo instance. Please use "
"%{link_to_primary_node} instead."
msgstr ""
"நீங்கள் படிக்க மட்டுமேயான இரண்டாம் நிலை gitlab சியோ நிகழ்விற்கு எழுத "
"முடியாது. அதற்கு பதிலாக %{link_to_primary_node} பயன்படுத்தவும்."

msgid "You cannot write to this read-only GitLab instance."
msgstr "இந்த படிக்க-மட்டும் gitlab நிகழ்விற்கு நீங்கள் எழுத முடியாது."

msgid "You can’t edit files directly in this project."
msgstr "இந்தத் திட்டப்பணியில் நேரடியாக கோப்புகளைத் திருத்த முடியாது."

msgid ""
"You can’t edit files directly in this project. Fork this project and submit "
"a merge request with your changes."
msgstr ""
"இந்தத் திட்டப்பணியில் நேரடியாக கோப்புகளைத் திருத்த முடியாது. இந்தத் "
"திட்டத்தைப் பிரித்து, உங்கள் மாற்றங்களுடன் ஒன்றிணைக்கும் கோரிக்கையைச் "
"சமர்ப்பிக்கவும்."

msgid "You commented"
msgstr "நீங்கள் கருத்து தெரிவித்தீர்கள்"

msgid "You currently have no custom domains."
msgstr "உங்களிடம் தற்போது தனிப்பயன் டொமைன்கள் இல்லை."

msgid "You do not belong to any groups yet."
msgstr "நீங்கள் இதுவரை எந்தக் குழுவிலும் சேரவில்லை."

msgid "You do not belong to any projects yet."
msgstr "நீங்கள் இதுவரை எந்த திட்டத்திலும் சேரவில்லை."

msgid "You do not have access to any projects for creating incidents."
msgstr ""
"சம்பவங்களை உருவாக்குவதற்கான எந்த திட்டங்களுக்கும் உங்களுக்கு அணுகல் இல்லை."

msgid "You do not have any subscriptions yet"
msgstr "உங்களிடம் இதுவரை சந்தாக்கள் எதுவும் இல்லை"

msgid "You do not have permission to access DORA4 metrics."
msgstr "dora4 அளவீடுகளை அணுக உங்களுக்கு இசைவு இல்லை."

msgid "You do not have permission to access dora metrics."
msgstr "டோரா அளவீடுகளை அணுக உங்களுக்கு இசைவு இல்லை."

msgid "You do not have permission to approve a member"
msgstr "உறுப்பினரை அங்கீகரிக்க உங்களுக்கு இசைவு இல்லை"

msgid "You do not have permission to leave this %{namespaceType}."
msgstr "இந்த %{namespaceType}விட்டு வெளியேற உங்களுக்கு இசைவு இல்லை."

msgid "You do not have permission to lock this"
msgstr "இதைப் பூட்ட உங்களுக்கு இசைவு இல்லை"

msgid "You do not have permission to run a pipeline on this branch."
msgstr "இந்தக் கிளையில் பைப்லைனை இயக்க உங்களுக்கு இசைவு இல்லை."

msgid "You do not have permission to set a member awaiting"
msgstr "ஒரு உறுப்பினர் காத்திருப்பதை அமைக்க உங்களுக்கு இசைவு இல்லை"

msgid "You do not have permission to unlock it"
msgstr "அதைத் திறக்க உங்களுக்கு இசைவு இல்லை"

msgid "You do not have permission to update the environment."
msgstr "சூழலைப் புதுப்பிக்க உங்களுக்கு இசைவு இல்லை."

msgid "You do not have permissions to run the import."
msgstr "இறக்குமதியை இயக்க உங்களுக்கு இசைவு இல்லை."

msgid "You don't have any WebAuthn devices registered yet."
msgstr "உங்களிடம் இதுவரை webauthn சாதனங்கள் எதுவும் பதிவு செய்யப்படவில்லை."

