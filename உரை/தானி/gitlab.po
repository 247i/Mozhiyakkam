msgstr "adminsettings|preview payload"

msgid "AdminSettings|Project export"
msgstr "adminsettings|திட்ட ஏற்றுமதி"

msgid "AdminSettings|Project runners expiration"
msgstr "adminsettings|திட்ட ரன்னர்கள் காலாவதியாகும்"

