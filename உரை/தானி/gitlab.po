msgstr "webhooks|webhook முடக்கப்பட்டது"

msgid "Webhooks|Webhook rate limit has been reached"
msgstr "webhooks|webhook விகித வரம்பை அடைந்துவிட்டது"

msgid "Webhooks|Webhook temporarily disabled"
msgstr "வெப்ஊக்ச் | வெப்ஊக் தற்காலிகமாக முடக்கப்பட்டுள்ளது"

